{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/earth-observability-soe-v0-1/research/earth-observability/SENSOR_OBSERVABILITY_FIXTURE_V0_1.schema.json",
  "title": "Sol-Atlas Sensor Observability Analytic Fixture v0.1",
  "description": "Structural interchange schema for abstract sensor-detection trials. It does not validate probability calibration, source authenticity, sensor physics, spatial overlap, or physical qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "fixture_id",
    "fixture_version",
    "seed",
    "status",
    "geography",
    "claim_boundary",
    "envelope",
    "trials"
  ],
  "properties": {
    "benchmark_id": {
      "const": "EARTH-OBSERVABILITY-SENSOR-OBSERVABILITY-001"
    },
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "const": "synthetic_analytic_detection_trials_not_physical_data"
    },
    "geography": {
      "const": "abstract_non_geographic"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 20
    },
    "envelope": {
      "$ref": "#/$defs/envelope"
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trial"
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "source_evidence_id",
        "sensor_id",
        "configuration_id",
        "calibration_id",
        "target_class",
        "spatial_support_id",
        "valid_from_unix_s",
        "valid_until_unix_s",
        "target_size_m",
        "target_depth_m",
        "target_contrast",
        "environmental_domain",
        "minimum_pod_requirement",
        "maximum_false_alarms_per_km"
      ],
      "properties": {
        "envelope_id": {
          "type": "string",
          "minLength": 1
        },
        "source_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1
        },
        "target_class": {
          "type": "string",
          "minLength": 1
        },
        "spatial_support_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from_unix_s": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_unix_s": {
          "type": "integer",
          "minimum": 1
        },
        "target_size_m": {
          "$ref": "#/$defs/range"
        },
        "target_depth_m": {
          "$ref": "#/$defs/range"
        },
        "target_contrast": {
          "$ref": "#/$defs/range"
        },
        "environmental_domain": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/range"
          }
        },
        "minimum_pod_requirement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_false_alarms_per_km": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trial_id",
        "partition",
        "target_id",
        "site_id",
        "acquisition_id",
        "observed_at_unix_s",
        "sensor_id",
        "configuration_id",
        "calibration_id",
        "target_class",
        "target_present",
        "detector_detected",
        "target_size_m",
        "target_depth_m",
        "target_contrast",
        "environmental_values",
        "surveyed_route_km",
        "localization_error_m"
      ],
      "properties": {
        "trial_id": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "enum": [
            "calibration",
            "blind_test"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at_unix_s": {
          "type": "integer",
          "minimum": 0
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1
        },
        "target_class": {
          "type": "string",
          "minLength": 1
        },
        "target_present": {
          "type": "boolean"
        },
        "detector_detected": {
          "type": "boolean"
        },
        "target_size_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "target_depth_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "target_contrast": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "environmental_values": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "surveyed_route_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "localization_error_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
