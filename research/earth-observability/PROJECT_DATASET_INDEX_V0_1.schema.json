{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/earth-observability-joint-network-hypotheses-v0-1/research/earth-observability/PROJECT_DATASET_INDEX_V0_1.schema.json",
  "title": "Project-clustered physical benchmark dataset index v0.1",
  "description": "Project/activity index for grouped evaluation splits. This is structural metadata, not real UT-Gold-D project identity or physical data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "projects"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "projects": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "activity_ids"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "activity_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
