{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/earth-observability-joint-network-hypotheses-v0-1/research/earth-observability/FIELD_ACTIVITY_ADMISSION_V0_1.schema.json",
  "title": "Per-activity field benchmark truth and metric admissibility v0.1",
  "description": "Structural input schema. Rust cross-field rules determine track-specific metric eligibility.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "dataset_id",
      "project_id",
      "activity_id",
      "raw_radargram_sha256",
      "truth_tier",
      "target_truth",
      "truth_evidence_ids",
      "target_linkage_reviewed",
      "target_reference_id",
      "spatial_reference_status",
      "spatial_support_id",
      "positioning_source",
      "positions_trace_aligned",
      "positioning_calibration_receipt_id",
      "horizontal_position_sigma_m",
      "wheel_contact_status",
      "geometry_reference_id",
      "trench_geometry_registration_receipt_id",
      "has_3d_geometry",
      "connected_topology_reference_id"
    ],
    "properties": {
      "dataset_id": {
        "type": "string",
        "minLength": 1
      },
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "activity_id": {
        "type": "string",
        "minLength": 1
      },
      "raw_radargram_sha256": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Fa-f0-9]{64}$"
      },
      "truth_tier": {
        "enum": [
          "structured_independent_survey",
          "trench_image_interpreted",
          "owner_record_only",
          "conflicted",
          "insufficient"
        ]
      },
      "target_truth": {
        "enum": [
          "present",
          "absent_within_inspected_support",
          "unknown",
          "conflicted"
        ]
      },
      "truth_evidence_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "target_linkage_reviewed": {
        "type": "boolean"
      },
      "target_reference_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "spatial_reference_status": {
        "enum": [
          "qualified",
          "partial",
          "missing",
          "invalid"
        ]
      },
      "spatial_support_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "positioning_source": {
        "enum": [
          "gnss_rtk",
          "wheel_encoder_only",
          "mixed",
          "missing"
        ]
      },
      "positions_trace_aligned": {
        "type": "boolean"
      },
      "positioning_calibration_receipt_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "horizontal_position_sigma_m": {
        "type": [
          "number",
          "null"
        ],
        "exclusiveMinimum": 0
      },
      "wheel_contact_status": {
        "enum": [
          "verified",
          "compromised",
          "unknown",
          "not_applicable"
        ]
      },
      "geometry_reference_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "trench_geometry_registration_receipt_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "has_3d_geometry": {
        "type": "boolean"
      },
      "connected_topology_reference_id": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
