{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/earth-observability-joint-network-hypotheses-v0-1/research/earth-observability/EVIDENCE_DEPENDENCY_GRAPH_V0_1.schema.json",
  "title": "Evidence dependency graph v0.1",
  "description": "Dependency declaration for deterministic downstream invalidation. Schema validation does not prove dependency completeness or truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "snapshot_id",
    "nodes"
  ],
  "properties": {
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_kind",
        "revision_id",
        "dependency_ids",
        "status"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_kind": {
          "enum": [
            "source_evidence",
            "spatial_transform",
            "sensor_calibration",
            "observation",
            "event",
            "asset_hypothesis",
            "geometry_claim",
            "network_hypothesis",
            "decision",
            "export"
          ]
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "dependency_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "superseded",
            "conflicted",
            "invalid"
          ]
        }
      }
    }
  }
}
