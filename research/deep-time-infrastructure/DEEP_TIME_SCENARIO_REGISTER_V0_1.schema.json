{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/deep-time-scenario-register-v0.1.schema.json",
  "title": "Deep-Time Infrastructure Scenario Register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "register_id",
    "classification",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "luminous.deep-time-scenario-register.v0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "register_id": {
      "const": "DEEP-TIME-SCENARIO-REGISTER-V0.1"
    },
    "classification": {
      "const": "source_catalogue_not_forecast"
    },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "name",
          "scenario_family",
          "time_reference",
          "mechanism",
          "estimate",
          "model_family",
          "source_references",
          "limitations",
          "allowed_use",
          "claim_ceiling"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^DTS-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scenario_family": {
            "enum": [
              "present_day_ice_inventory_equivalent",
              "anthropogenic_projection",
              "paleogeographic_reconstruction",
              "synthetic_stress_test",
              "future_earth_boundary_condition"
            ]
          },
          "time_reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "inventory_snapshot",
                  "projection_horizon",
                  "geological_age",
                  "synthetic_offset",
                  "future_boundary_condition"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "start_year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "end_year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "age_ma": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "mechanism": {
            "type": "string",
            "minLength": 1
          },
          "estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "lower_m",
              "upper_m",
              "nominal_m",
              "reference",
              "estimate_class",
              "confidence"
            ],
            "properties": {
              "quantity": {
                "enum": [
                  "global_mean_sea_level_equivalent",
                  "global_mean_sea_level_change",
                  "global_eustatic_sea_level_change",
                  "modern_terrain_surface_offset",
                  "not_applicable"
                ]
              },
              "lower_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "upper_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "nominal_m": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "estimate_class": {
                "enum": [
                  "approximate_equivalent",
                  "likely_range",
                  "low_likelihood_high_impact_lower_bound",
                  "published_reconstruction_peak_estimate",
                  "published_reconstruction_range",
                  "synthetic_offset",
                  "no_sea_level_estimate"
                ]
              },
              "confidence": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "model_family": {
            "type": "string",
            "minLength": 1
          },
          "source_references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "title",
                "url",
                "publication_year",
                "source_role"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "publication_year": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2100
                },
                "source_role": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_use": {
            "enum": [
              "climate_adaptation_context",
              "paleogeographic_comparison",
              "synthetic_robustness_test",
              "future_earth_boundary_condition_comparison"
            ]
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}