{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/deep-time-belief-viability-case-register-v0.1.schema.json",
  "title": "Deep-Time Belief Viability Case Register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "register_id",
    "parent_issue",
    "classification",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.deep-time-belief-viability-case-register.v0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "register_id": {
      "const": "DEEP-TIME-BELIEF-VIABILITY-CASE-REGISTER-V0.1"
    },
    "parent_issue": {
      "type": "string",
      "format": "uri"
    },
    "classification": {
      "const": "finite_partial_observation_software_semantics_not_physical_validation"
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "classification",
        "title",
        "scenario",
        "expected",
        "oracle",
        "claim_ceiling"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^DBV-[0-9]{3}$"
        },
        "classification": {
          "enum": [
            "synthetic_hand_computable_reference",
            "specification_only",
            "bounded_control"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "object",
          "minProperties": 1
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
