    {
      "case_id": "DVK-001",
      "domain": "finite_reachability",
      "classification": "synthetic_hand_computable_reference",
      "title": "Single service-preserving transition path",
      "scenario": "A start configuration has one admissible commission action that reaches a terminal configuration and preserves every floor.",
      "inputs": {
        "horizon": 1,
        "states": [
          {
            "id": "start",
            "stage": 0,
            "floors": {
              "water": "pass",
              "freight": "pass"
            }
          },
          {
            "id": "commissioned",
            "stage": 1,
            "floors": {
              "water": "pass",
              "freight": "pass"
            }
          }
        ],
        "disturbances_by_stage": {
          "0": [
            "none"
          ]
        },
        "actions": [
          {
            "id": "commission",
            "from": "start",
            "admissible": true,
            "next_by_disturbance": {
              "none": "commissioned"
            }
          }
        ],
        "terminal_states": [
          "commissioned"
        ],
        "initial_states": [
          "start"
        ]
      },
      "expected": {
        "viable_states": [
          "commissioned",
          "start"
        ],
        "infeasible_states": [],
        "unresolved_states": [],
        "initial_viability": {
          "start": true
        },
        "disposition": "exact"
      },
      "oracle": "Backward reachability: commissioned is a floor-passing terminal state; start has an action whose every disturbance successor is viable.",
      "claim_ceiling": "Finite synthetic viability semantics only; no real-world service, ecological, legal, financial, hydraulic or construction feasibility claim."
    },
    {
      "case_id": "DVK-002",
      "domain": "buffer_lead_time",
      "classification": "synthetic_hand_computable_reference",
      "title": "Two-period buffer supports a two-step relocation; one-period buffer does not",
      "scenario": "A replacement service needs two transitions to commission. One old service buffer expires after one period; another after two.",
      "inputs": {
        "horizon": 2,
        "states": [
          {
            "id": "buffer1_start",
            "stage": 0,
            "floors": {
              "freight": "pass"
            }
          },
          {
            "id": "buffer1_exhausted",
            "stage": 1,
            "floors": {
              "freight": "fail"
            }
          },
          {
            "id": "buffer2_start",
            "stage": 0,
            "floors": {
              "freight": "pass"
            }
          },
          {
            "id": "buffer2_mid",
            "stage": 1,
            "floors": {
              "freight": "pass"
            }
          },
          {
            "id": "new_service",
            "stage": 2,
            "floors": {
              "freight": "pass"
            }
          }
        ],
        "disturbances_by_stage": {
          "0": [
            "none"
          ],
          "1": [
            "none"
          ]
        },
        "actions": [
          {
            "id": "relocate_from_buffer1",
            "from": "buffer1_start",
            "admissible": true,
            "next_by_disturbance": {
              "none": "buffer1_exhausted"
            }
          },
          {
            "id": "continue_buffer2",
            "from": "buffer2_start",
            "admissible": true,
            "next_by_disturbance": {
              "none": "buffer2_mid"
            }
          },
          {
            "id": "commission_replacement",
            "from": "buffer2_mid",
            "admissible": true,
            "next_by_disturbance": {
              "none": "new_service"
            }
          }
        ],
        "terminal_states": [
          "new_service"
        ],
        "initial_states": [
          "buffer1_start",
          "buffer2_start"
        ]
      },
      "expected": {
        "initial_viability": {
          "buffer1_start": false,
          "buffer2_start": true
        },
        "reason_codes": {
          "buffer1_start": "service_floor_breach_before_commission",
          "buffer2_start": "all_transition_steps_preserve_service"
        },
        "disposition": "exact"
      },
      "oracle": "Backward recursion leaves buffer2_start viable through two pass states; buffer1_start transitions to a state whose freight floor fails.",
      "claim_ceiling": "Finite synthetic viability semantics only; no real-world service, ecological, legal, financial, hydraulic or construction feasibility claim."
    },
