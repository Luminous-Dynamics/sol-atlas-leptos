{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/deep-time-sa-corridor-source-register-v0.1.schema.json",
  "title": "Deep-Time South African Corridor Source Register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "register_id",
    "as_of",
    "classification",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "luminous.deep-time-sa-corridor-source-register.v0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "register_id": {
      "const": "DEEP-TIME-SA-CORRIDOR-SOURCE-REGISTER-V0.1"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "classification": {
      "const": "public_source_catalogue_not_project_feasibility"
    },
    "sources": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "url",
        "publication_date",
        "observed_period_start",
        "observed_period_end",
        "evidence_class",
        "source_statement",
        "permitted_use",
        "prohibited_inference",
        "required_qualification",
        "status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^SA-[A-Z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_period_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_period_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "source_statement": {
          "type": "string",
          "minLength": 1
        },
        "permitted_use": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prohibited_inference": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_qualification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
