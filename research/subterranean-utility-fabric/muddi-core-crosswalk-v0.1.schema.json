{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/suf-muddi-interoperability-v0-1/research/subterranean-utility-fabric/muddi-core-crosswalk-v0.1.schema.json",
  "title": "Luminous SUF MUDDI Core Crosswalk v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "status",
    "created_date",
    "standard",
    "claim_ceiling",
    "identifier_contract",
    "core_classes",
    "extended_concepts",
    "evidence_envelope",
    "spatial_temporal_contract",
    "epistemic_and_availability_states",
    "disclosure_classes",
    "synthetic_fixture_policy",
    "conformance_status",
    "unresolved"
  ],
  "properties": {
    "profile_id": {
      "const": "luminous.suf.muddi_profile.v0.1"
    },
    "status": {
      "enum": [
        "draft_crosswalk_only",
        "logical_model_draft",
        "conformance_tested"
      ]
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "standard": {
      "type": "object",
      "required": [
        "name",
        "version",
        "document",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "const": "1.0"
        },
        "document": {
          "const": "OGC 23-024"
        },
        "approval_date": {
          "type": "string"
        },
        "publication_date": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": true
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 30
    },
    "identifier_contract": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "muddi_identifier",
          "meaning",
          "owner",
          "sol_atlas_role"
        ],
        "properties": {
          "muddi_identifier": {
            "enum": [
              "ObjectID",
              "RecordID",
              "SystemID"
            ]
          },
          "meaning": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "sol_atlas_role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "core_classes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "class",
          "status",
          "owner",
          "role"
        ],
        "properties": {
          "class": {
            "enum": [
              "MUDDIObject",
              "MUDDIAsset",
              "MUDDIEvent",
              "MUDDISpace",
              "Network",
              "NetworkAsset",
              "NetworkConveyance",
              "NetworkNode",
              "NetworkLink",
              "NetworkAccessory"
            ]
          },
          "status": {
            "enum": [
              "mapped_by_reference",
              "mapped_to_existing_owner",
              "externally_owned",
              "extension_candidate",
              "unresolved"
            ]
          },
          "owner": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "extended_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "class",
          "status",
          "owner",
          "role"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_envelope": {
      "type": "object",
      "required": [
        "required_fields",
        "relations",
        "integrity_limit"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "relations": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "integrity_limit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "spatial_temporal_contract": {
      "type": "object",
      "required": [
        "required",
        "dimensions",
        "coordinate_rule"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "2D",
              "2.5D",
              "3D",
              "topology_only"
            ]
          }
        },
        "coordinate_rule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "epistemic_and_availability_states": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "disclosure_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "class",
          "audience",
          "geometry"
        ],
        "properties": {
          "class": {
            "enum": [
              "public_aggregate",
              "partner_generalized",
              "operational",
              "restricted_critical"
            ]
          },
          "audience": {
            "type": "string"
          },
          "geometry": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "synthetic_fixture_policy": {
      "type": "object",
      "required": [
        "abstract_only",
        "real_coordinates_permitted",
        "secrets_permitted",
        "status"
      ],
      "properties": {
        "abstract_only": {
          "const": true
        },
        "real_coordinates_permitted": {
          "const": false
        },
        "secrets_permitted": {
          "const": false
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "conformance_status": {
      "type": "object",
      "required": [
        "core_concepts_mapped_or_owned",
        "core_concepts_total",
        "abstract_tests_executed",
        "logical_model_complete",
        "claim"
      ],
      "properties": {
        "core_concepts_mapped_or_owned": {
          "type": "integer",
          "minimum": 0
        },
        "core_concepts_total": {
          "const": 10
        },
        "abstract_tests_executed": {
          "type": "boolean"
        },
        "logical_model_complete": {
          "type": "boolean"
        },
        "claim": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
