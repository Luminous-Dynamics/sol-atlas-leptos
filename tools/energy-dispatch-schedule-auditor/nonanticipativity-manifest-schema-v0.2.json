{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/energy-dispatch-nonanticipativity-manifest-v0.2.json",
  "title": "Energy Dispatch Non-Anticipativity Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_set_id", "scenarios"],
  "properties": {
    "schema_version": { "const": "energy-dispatch-nonanticipativity-manifest-v0.2" },
    "scenario_set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "request_path",
          "schedule_path",
          "information_sets_by_interval"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "request_path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "schedule_path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "information_sets_by_interval": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "forecast_as_of_unix_seconds",
                "forecast_bundle_path"
              ],
              "properties": {
                "forecast_as_of_unix_seconds": { "type": "integer" },
                "forecast_bundle_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            }
          }
        }
      }
    }
  }
}
