{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/energy-dispatch-forecast-bundle-v0.1.json",
  "title": "Energy Dispatch Forecast Bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_set_id",
    "bundle_id",
    "issued_at_unix_seconds",
    "valid_from_unix_seconds",
    "valid_through_unix_seconds",
    "forecast_payload"
  ],
  "properties": {
    "schema_version": { "const": "energy-dispatch-forecast-bundle-v0.1" },
    "scenario_set_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "issued_at_unix_seconds": { "type": "integer" },
    "valid_from_unix_seconds": { "type": "integer" },
    "valid_through_unix_seconds": { "type": "integer" },
    "forecast_payload": {
      "type": "object",
      "minProperties": 1
    }
  }
}
