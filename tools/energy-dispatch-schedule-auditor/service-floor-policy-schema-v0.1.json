{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/energy-service-floor-policy-v0.1.json",
  "title": "Energy Service Floor Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "minimum_essential_service_bps_per_interval",
    "max_total_essential_unserved_quanta",
    "max_consecutive_below_floor_intervals",
    "minimum_terminal_soc_quanta"
  ],
  "properties": {
    "schema_version": { "const": "energy-service-floor-policy-v0.1" },
    "policy_id": { "type": "string", "minLength": 1 },
    "minimum_essential_service_bps_per_interval": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "max_total_essential_unserved_quanta": { "type": "integer", "minimum": 0 },
    "max_consecutive_below_floor_intervals": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "minimum_terminal_soc_quanta": { "type": "integer", "minimum": 0, "maximum": 65535 }
  }
}
