{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/energy-dispatch-nonanticipativity-receipt-v0.2.json",
  "title": "Energy Dispatch Non-Anticipativity Receipt v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema",
    "scenario_set_id",
    "auditor_id",
    "auditor_version",
    "auditor_binary_sha256",
    "scenario_count",
    "interval_count",
    "scenario_bindings",
    "shared_information_set_count",
    "checked_action_comparison_count",
    "disposition",
    "findings",
    "receipt_sha256",
    "claim_ceiling"
  ],
  "properties": {
    "receipt_schema": { "const": "energy-dispatch-nonanticipativity-receipt-v0.2" },
    "scenario_set_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "auditor_id": { "const": "energy-dispatch-nonanticipativity-auditor" },
    "auditor_version": { "type": "string", "minLength": 1 },
    "auditor_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "scenario_count": { "type": "integer", "minimum": 2, "maximum": 256 },
    "interval_count": { "type": "integer", "minimum": 1, "maximum": 128 },
    "scenario_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "request_sha256",
          "schedule_sha256",
          "information_sets_by_interval",
          "information_set_sha256_by_interval"
        ],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
          "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "schedule_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "information_sets_by_interval": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["forecast_as_of_unix_seconds", "forecast_bundle_sha256"],
              "properties": {
                "forecast_as_of_unix_seconds": { "type": "integer" },
                "forecast_bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "information_set_sha256_by_interval": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "shared_information_set_count": { "type": "integer", "minimum": 0 },
    "checked_action_comparison_count": { "type": "integer", "minimum": 0 },
    "disposition": { "enum": ["accepted", "rejected"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "predicate",
          "interval_index",
          "information_set_sha256",
          "observation_prefix_sha256",
          "scenario_ids",
          "passed",
          "detail"
        ],
        "properties": {
          "predicate": { "type": "string", "minLength": 1 },
          "interval_index": { "type": ["integer", "null"], "minimum": 0 },
          "information_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "observation_prefix_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "scenario_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" }
          },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim_ceiling": { "type": "string", "minLength": 1 }
  }
}
