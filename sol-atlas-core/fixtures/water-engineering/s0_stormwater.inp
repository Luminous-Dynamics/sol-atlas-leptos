[TITLE]
S0 synthetic stormwater and sewer reference network
; SYNTHETIC ONLY: illustrative event, not a real catchment.
; Baseline plus one explicitly declared conduit diameter restriction.

[OPTIONS]
FLOW_UNITS CMS
INFILTRATION HORTON
FLOW_ROUTING DYNWAVE
LINK_OFFSETS DEPTH
MIN_SLOPE 0
ALLOW_PONDING YES
START_DATE 01/01/2020
START_TIME 00:00:00
REPORT_START_DATE 01/01/2020
REPORT_START_TIME 00:00:00
END_DATE 01/01/2020
END_TIME 02:00:00
REPORT_STEP 00:05:00
WET_STEP 00:01:00
DRY_STEP 01:00:00
ROUTING_STEP 00:00:30

[EVAPORATION]
CONSTANT 0.0

[RAINGAGES]
;Name Format Interval SCF Source
G1 INTENSITY 0:05 1.0 TIMESERIES RAIN1

[SUBCATCHMENTS]
;Name RainGage Outlet Area PercentImperv Width PercentSlope CurbLength
S1 G1 J1 1.0 50.0 100.0 1.0 0.0

[SUBAREAS]
;Name N-Imperv N-Perv S-Imperv S-Perv PctZero RouteTo
S1 0.015 0.25 2.0 0.1 25 OUTLET

[INFILTRATION]
;Name MaxRate MinRate Decay DryTime MaxInfil
S1 50.0 5.0 4.0 7.0 0.0

[JUNCTIONS]
;Name InvertElev MaxDepth InitDepth SurDepth Aponded
J1 10.0 3.0 0.0 0.0 100.0

[OUTFALLS]
;Name Elev Type StageData Gated
O1 8.0 FREE NO

[CONDUITS]
;Name FromNode ToNode Length Roughness InOffset OutOffset InitFlow MaxFlow
C1 J1 O1 100.0 0.013 0.0 0.0 0.0 0.0

[XSECTIONS]
;Link Shape Geom1 Geom2 Geom3 Barrels
C1 CIRCULAR 0.6 0.0 0.0 1

[TIMESERIES]
;Series Date Time Value
RAIN1 01/01/2020 00:00 0.0
RAIN1 01/01/2020 00:05 20.0
RAIN1 01/01/2020 00:10 60.0
RAIN1 01/01/2020 00:15 60.0
RAIN1 01/01/2020 00:20 30.0
RAIN1 01/01/2020 00:25 0.0
RAIN1 01/01/2020 00:30 0.0
RAIN1 01/01/2020 01:00 0.0
RAIN1 01/01/2020 02:00 0.0

[REPORT]
INPUT YES
CONTINUITY YES
FLOWSTATS YES
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[END]
