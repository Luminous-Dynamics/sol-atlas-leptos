{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-scenario-corpus-plan-v0.1.schema.json",
  "title": "Deterministic Synthetic Water Scenario Corpus Plan v0.1",
  "description": "A frozen deterministic perturbation plan for running small synthetic EPANET INP cases. It is not a physical leak model or benchmark result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "plan_id",
    "base_input",
    "observation_node_ids",
    "scenarios",
    "assumptions",
    "nonclaims",
    "unit_system"
  ],
  "properties": {
    "schema_version": {
      "const": "water-scenario-corpus-plan/v0.1"
    },
    "classification": {
      "const": "synthetic_public"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "base_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observation_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,30}$"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "ground_truth_class",
              "target_junction_id",
              "additional_demand"
            ],
            "properties": {
              "scenario_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
              },
              "ground_truth_class": {
                "const": "no_fault"
              },
              "target_junction_id": {
                "type": "null"
              },
              "additional_demand": {
                "const": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "ground_truth_class",
              "target_junction_id",
              "additional_demand"
            ],
            "properties": {
              "scenario_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
              },
              "ground_truth_class": {
                "const": "synthetic_withdrawal"
              },
              "target_junction_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,30}$"
              },
              "additional_demand": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unit_system": {
      "enum": [
        "LPS",
        "GPM"
      ]
    }
  }
}
