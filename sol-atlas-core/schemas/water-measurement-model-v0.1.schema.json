{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-measurement-model-v0.1.schema.json",
  "title": "Declared Synthetic Measurement Probability Model v0.1",
  "description": "Explicit categorical prior, measurement likelihoods and decision-loss matrix for an illustrative information-value calculation. No field or hydraulic validity is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "model_id",
    "hypothesis_ids",
    "prior",
    "decision_ids",
    "decision_loss_matrix",
    "loss_unit",
    "cost_unit",
    "cost_comparability",
    "actions",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "water-measurement-model/v0.1"
    },
    "classification": {
      "const": "synthetic_illustrative"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "hypothesis_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
      }
    },
    "prior": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "decision_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
      }
    },
    "decision_loss_matrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "loss_unit": {
      "type": "string",
      "minLength": 1
    },
    "cost_unit": {
      "type": "string",
      "minLength": 1
    },
    "cost_comparability": {
      "enum": [
        "same_declared_unit",
        "not_comparable"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "outcome_ids",
          "likelihoods",
          "acquisition_cost"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
          },
          "outcome_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
            }
          },
          "likelihoods": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "acquisition_cost": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": []
}
