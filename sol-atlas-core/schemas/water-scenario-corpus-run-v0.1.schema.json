{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-scenario-corpus-run-v0.1.schema.json",
  "title": "Executed Synthetic Water Scenario Corpus Run v0.1",
  "description": "Hash-bound manifest for executed synthetic EPANET perturbation scenarios. It records failed cases and does not establish model calibration or field validity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_sha256",
    "base_input_sha256",
    "unit_system",
    "flow_unit",
    "pressure_unit",
    "report_policy",
    "solver",
    "observation_node_ids",
    "scenario_count",
    "completed_count",
    "failed_count",
    "run_state",
    "scenarios",
    "claim_ceiling",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-scenario-corpus-run/v0.1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "base_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_sha256",
        "source_commit"
      ],
      "properties": {
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "observation_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,30}$"
      }
    },
    "scenario_count": {
      "type": "integer",
      "minimum": 1
    },
    "completed_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "run_state": {
      "enum": [
        "Completed",
        "CompletedWithFailures"
      ]
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "claim_ceiling": {
      "const": "synthetic_single_topology_hydraulic_pilot"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unit_system": {
      "enum": [
        "LPS",
        "GPM"
      ]
    },
    "flow_unit": {
      "enum": [
        "L/s",
        "GPM"
      ]
    },
    "pressure_unit": {
      "enum": [
        "m",
        "psi"
      ]
    },
    "report_policy": {
      "const": "NODES ALL; LINKS ALL"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pressure_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "state",
        "pressure_value",
        "reason"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,30}$"
        },
        "state": {
          "enum": [
            "measured",
            "unavailable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "pressure_value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "measured"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "pressure_value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unavailable"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "pressure_value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "ground_truth_class",
        "target_junction_id",
        "additional_demand",
        "generated_input",
        "run_state",
        "solver_exit_code",
        "solver_output_sha256",
        "report",
        "binary_output",
        "pressure_readings",
        "failure_reasons"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "ground_truth_class": {
          "enum": [
            "no_fault",
            "synthetic_withdrawal"
          ]
        },
        "target_junction_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,30}$"
        },
        "generated_input": {
          "$ref": "#/$defs/artifact"
        },
        "run_state": {
          "enum": [
            "Completed",
            "Failed"
          ]
        },
        "solver_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "solver_output_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "report": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "binary_output": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "pressure_readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pressure_reading"
          }
        },
        "failure_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additional_demand": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "run_state": {
                "const": "Completed"
              }
            },
            "required": [
              "run_state"
            ]
          },
          "then": {
            "properties": {
              "failure_reasons": {
                "maxItems": 0
              },
              "report": {
                "$ref": "#/$defs/artifact"
              },
              "binary_output": {
                "$ref": "#/$defs/artifact"
              },
              "solver_exit_code": {
                "const": 0
              },
              "pressure_readings": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "state": {
                      "const": "measured"
                    }
                  },
                  "required": [
                    "state"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_state": {
                "const": "Failed"
              }
            },
            "required": [
              "run_state"
            ]
          },
          "then": {
            "properties": {
              "failure_reasons": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ground_truth_class": {
                "const": "no_fault"
              }
            },
            "required": [
              "ground_truth_class"
            ]
          },
          "then": {
            "properties": {
              "target_junction_id": {
                "type": "null"
              },
              "additional_demand_lps": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ground_truth_class": {
                "const": "synthetic_withdrawal"
              }
            },
            "required": [
              "ground_truth_class"
            ]
          },
          "then": {
            "properties": {
              "target_junction_id": {
                "type": "string"
              },
              "additional_demand_lps": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "Completed"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "failed_count": {
            "const": 0
          },
          "completed_count": {
            "minimum": 1
          },
          "scenario_count": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "CompletedWithFailures"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "failed_count": {
            "minimum": 1
          },
          "completed_count": {
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit_system": {
            "const": "LPS"
          }
        },
        "required": [
          "unit_system"
        ]
      },
      "then": {
        "properties": {
          "flow_unit": {
            "const": "L/s"
          },
          "pressure_unit": {
            "const": "m"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit_system": {
            "const": "GPM"
          }
        },
        "required": [
          "unit_system"
        ]
      },
      "then": {
        "properties": {
          "flow_unit": {
            "const": "GPM"
          },
          "pressure_unit": {
            "const": "psi"
          }
        }
      }
    }
  ]
}
