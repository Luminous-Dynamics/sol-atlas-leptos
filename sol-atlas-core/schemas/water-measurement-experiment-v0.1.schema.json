{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-measurement-experiment-v0.1.schema.json",
  "title": "Water Measurement Experiment v0.1",
  "description": "Machine-readable protocol for comparing decision-directed measurement strategies on synthetic water-network scenarios. It records assumptions and prevents unrun experiments from claiming numerical results. Schema validity is not evidence of performance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "classification",
    "research_question",
    "model_reference",
    "scenario_corpus",
    "candidate_actions",
    "baseline_strategies",
    "metric_definitions",
    "acceptance_criteria",
    "comparison_policy",
    "evaluation",
    "safety_and_privacy",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-measurement-experiment/v0.1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "classification": {
      "enum": [
        "synthetic_public",
        "public_reviewed",
        "restricted"
      ]
    },
    "research_question": {
      "type": "string",
      "minLength": 24
    },
    "model_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "solver_family",
        "state",
        "input_sha256",
        "evidence_ceiling",
        "notes"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "solver_family": {
          "enum": [
            "EPANET",
            "SWMM",
            "other_declared"
          ]
        },
        "state": {
          "enum": [
            "NotRun",
            "Completed",
            "Blocked"
          ]
        },
        "input_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ceiling": {
          "enum": [
            "contract_only",
            "synthetic_unvalidated",
            "synthetic_reproduced",
            "empirically_validated"
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NotRun"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "input_sha256": {
                "type": "null"
              },
              "evidence_ceiling": {
                "const": "contract_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "Completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_ceiling": {
                "enum": [
                  "synthetic_unvalidated",
                  "synthetic_reproduced",
                  "empirically_validated"
                ]
              }
            }
          }
        }
      ]
    },
    "scenario_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "scenario_count",
        "manifest_sha256",
        "planned_axes",
        "random_seed_policy",
        "negative_controls"
      ],
      "properties": {
        "state": {
          "enum": [
            "NotGenerated",
            "Generated",
            "IndependentlyReviewed"
          ]
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_axes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "random_seed_policy": {
          "type": "string",
          "minLength": 16
        },
        "negative_controls": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NotGenerated"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "scenario_count": {
                "const": 0
              },
              "manifest_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "Generated",
                  "IndependentlyReviewed"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "scenario_count": {
                "minimum": 1
              },
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "candidate_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "kind",
          "question",
          "decision_target",
          "expected_evidence_type",
          "action_state",
          "acquisition_cost",
          "information_model",
          "permission_state",
          "location_specificity",
          "privacy_risk",
          "fieldwork_authorization",
          "blocking_unknowns"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "kind": {
            "enum": [
              "pressure_logging",
              "flow_meter_validation",
              "targeted_leak_survey",
              "water_quality_sample",
              "asset_record_inspection",
              "report_table_verification",
              "other"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 16
          },
          "decision_target": {
            "type": "string",
            "minLength": 8
          },
          "expected_evidence_type": {
            "type": "string",
            "minLength": 3
          },
          "action_state": {
            "enum": [
              "proposed",
              "blocked",
              "included_in_synthetic_evaluation"
            ]
          },
          "acquisition_cost": {
            "$ref": "#/$defs/estimate"
          },
          "information_model": {
            "$ref": "#/$defs/information_model"
          },
          "permission_state": {
            "enum": [
              "not_requested",
              "requested",
              "approved",
              "denied",
              "not_applicable_synthetic_only"
            ]
          },
          "location_specificity": {
            "enum": [
              "none",
              "coarse_aggregate",
              "exact_location_restricted"
            ]
          },
          "privacy_risk": {
            "enum": [
              "not_assessed",
              "low",
              "moderate",
              "high"
            ]
          },
          "fieldwork_authorization": {
            "const": "not_authorized"
          },
          "blocking_unknowns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "permission_state": {
                  "const": "denied"
                }
              },
              "required": [
                "permission_state"
              ]
            },
            "then": {
              "properties": {
                "action_state": {
                  "const": "blocked"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action_state": {
                  "const": "included_in_synthetic_evaluation"
                }
              },
              "required": [
                "action_state"
              ]
            },
            "then": {
              "properties": {
                "permission_state": {
                  "enum": [
                    "approved",
                    "not_applicable_synthetic_only"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "location_specificity": {
                  "const": "exact_location_restricted"
                }
              },
              "required": [
                "location_specificity"
              ]
            },
            "then": {
              "properties": {
                "permission_state": {
                  "const": "approved"
                }
              }
            }
          }
        ]
      }
    },
    "baseline_strategies": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "items": {
        "enum": [
          "information_directed",
          "random_seeded",
          "spatial_coverage_greedy",
          "fixed_heuristic"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "information_directed"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "random_seeded"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "spatial_coverage_greedy"
          },
          "minContains": 1
        },
        {
          "contains": {
            "const": "fixed_heuristic"
          },
          "minContains": 1
        }
      ]
    },
    "metric_definitions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "definition",
          "unit",
          "direction",
          "evidence_requirement",
          "aggregation",
          "prohibited_interpretation"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
          },
          "definition": {
            "type": "string",
            "minLength": 8
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "lower_is_better",
              "higher_is_better",
              "diagnostic_only",
              "target_range"
            ]
          },
          "evidence_requirement": {
            "enum": [
              "synthetic_labelled_truth",
              "reproduced_solver_artifact",
              "independent_review",
              "cost_model_with_basis"
            ]
          },
          "aggregation": {
            "enum": [
              "mean",
              "median",
              "p95",
              "worst_case",
              "per_scenario",
              "top_k"
            ]
          },
          "prohibited_interpretation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "criteria",
        "freeze_before_evaluation",
        "notes"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_frozen",
            "frozen"
          ]
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "freeze_before_evaluation": {
          "const": true
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_frozen"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "criteria": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "frozen"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "criteria": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategies_must_share_corpus",
        "same_seed_policy",
        "report_all_scenarios",
        "scalar_score_allowed",
        "missing_outcome_behavior",
        "selection_basis"
      ],
      "properties": {
        "strategies_must_share_corpus": {
          "const": true
        },
        "same_seed_policy": {
          "type": "string",
          "minLength": 16
        },
        "report_all_scenarios": {
          "const": true
        },
        "scalar_score_allowed": {
          "const": false
        },
        "missing_outcome_behavior": {
          "const": "explicit_failure_not_zero"
        },
        "selection_basis": {
          "const": "factor_level_and_pareto_no_hidden_weights"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "evaluation_manifest_sha256",
        "strategy_results",
        "failure_log",
        "claim_ceiling"
      ],
      "properties": {
        "state": {
          "enum": [
            "NotRun",
            "Completed",
            "Blocked"
          ]
        },
        "evaluation_manifest_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "strategy_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy_id",
              "state",
              "metrics",
              "notes"
            ],
            "properties": {
              "strategy_id": {
                "enum": [
                  "information_directed",
                  "random_seeded",
                  "spatial_coverage_greedy",
                  "fixed_heuristic"
                ]
              },
              "state": {
                "enum": [
                  "NotRun",
                  "Completed",
                  "Failed",
                  "Blocked"
                ]
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "metric_id",
                    "state",
                    "value",
                    "unit",
                    "evidence_reference",
                    "uncertainty_note"
                  ],
                  "properties": {
                    "metric_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
                    },
                    "state": {
                      "enum": [
                        "measured",
                        "unavailable",
                        "failed"
                      ]
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "unit": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_reference": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "uncertainty_note": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "const": "measured"
                          }
                        },
                        "required": [
                          "state"
                        ]
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "number"
                          },
                          "evidence_reference": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "state": {
                            "enum": [
                              "unavailable",
                              "failed"
                            ]
                          }
                        },
                        "required": [
                          "state"
                        ]
                      },
                      "then": {
                        "properties": {
                          "value": {
                            "type": "null"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "notes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "NotRun"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "properties": {
                    "metrics": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "Completed"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "properties": {
                    "metrics": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "failure_log": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ceiling": {
          "enum": [
            "protocol_only",
            "synthetic_unvalidated",
            "synthetic_reproduced",
            "empirically_validated"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "NotRun"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evaluation_manifest_sha256": {
                "type": "null"
              },
              "strategy_results": {
                "maxItems": 0
              },
              "claim_ceiling": {
                "const": "protocol_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "Completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evaluation_manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "strategy_results": {
                "minItems": 4,
                "maxItems": 4
              },
              "claim_ceiling": {
                "enum": [
                  "synthetic_unvalidated",
                  "synthetic_reproduced",
                  "empirically_validated"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "Completed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "strategy_results": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "strategy_id": {
                          "const": "information_directed"
                        }
                      },
                      "required": [
                        "strategy_id"
                      ]
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "strategy_id": {
                          "const": "random_seeded"
                        }
                      },
                      "required": [
                        "strategy_id"
                      ]
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "strategy_id": {
                          "const": "spatial_coverage_greedy"
                        }
                      },
                      "required": [
                        "strategy_id"
                      ]
                    },
                    "minContains": 1
                  },
                  {
                    "contains": {
                      "properties": {
                        "strategy_id": {
                          "const": "fixed_heuristic"
                        }
                      },
                      "required": [
                        "strategy_id"
                      ]
                    },
                    "minContains": 1
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "safety_and_privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_mode",
        "fieldwork_authorization",
        "public_location_policy",
        "owner_permission_required",
        "security_review_state"
      ],
      "properties": {
        "operating_mode": {
          "const": "offline_read_only"
        },
        "fieldwork_authorization": {
          "const": "not_authorized"
        },
        "public_location_policy": {
          "const": "no_sensitive_coordinates_or_asset_ids"
        },
        "owner_permission_required": {
          "const": true
        },
        "security_review_state": {
          "enum": [
            "not_assessed",
            "required",
            "completed"
          ]
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "unit",
        "basis_reference",
        "assumptions"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_estimated",
            "estimated"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_estimated"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "basis_reference": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "estimated"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "basis_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "information_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "expected_information_gain_bits",
        "expected_decision_value",
        "decision_value_unit",
        "model_reference",
        "assumptions"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_estimated",
            "information_gain_only",
            "decision_value_estimated"
          ]
        },
        "expected_information_gain_bits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "expected_decision_value": {
          "type": [
            "number",
            "null"
          ]
        },
