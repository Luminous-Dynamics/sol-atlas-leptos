{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-localization-split-audit-v0.1.schema.json",
  "title": "Water localization split audit receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_state",
    "benchmark_id",
    "protocol",
    "plan_sha256",
    "implementation_revision",
    "case_count",
    "family_count",
    "family_counts",
    "cases",
    "issues",
    "claim_ceiling",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-localization-split-audit/v0.1"
    },
    "run_state": {
      "enum": [
        "Passed",
        "Rejected"
      ]
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "const": "leave_topology_family_out"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "family_count": {
      "type": "integer",
      "minimum": 0
    },
    "family_counts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/familyCount"
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseFingerprint"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "claim_ceiling": {
      "const": "SplitIntegrityOnly"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "familyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology_family_id",
        "split",
        "case_count",
        "topology_sha256",
        "node_count",
        "link_count"
      ],
      "properties": {
        "topology_family_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "calibration",
            "test"
          ]
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "topology_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "node_count": {
          "type": "integer",
          "minimum": 2
        },
        "link_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "caseFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "topology_family_id",
        "topology_sha256",
        "scenario_spec_sha256",
        "observation_signature_sha256",
        "observed_reading_count",
        "missing_reading_count"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "calibration",
            "test"
          ]
        },
        "topology_family_id": {
          "type": "string",
          "minLength": 1
        },
        "topology_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scenario_spec_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observation_signature_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_reading_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_reading_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "case_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "Passed"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          },
          "family_count": {
            "minimum": 3
          },
          "case_count": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "Rejected"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
