{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-storm-ensemble-run-v0.1.schema.json",
  "title": "Synthetic stormwater stress ensemble run receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_state",
    "synthetic_only",
    "benchmark_id",
    "implementation_revision",
    "plan_sha256",
    "source_input_sha256",
    "source_input_byte_length",
    "solver",
    "case_count",
    "completed_case_count",
    "failed_case_count",
    "cases",
    "claim_ceiling",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-storm-ensemble-run/v0.1"
    },
    "run_state": {
      "enum": [
        "Passed",
        "Failed"
      ]
    },
    "synthetic_only": {
      "const": true
    },
    "benchmark_id": {
      "const": "water-storm-ensemble-001"
    },
    "implementation_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_input_byte_length": {
      "const": 1660
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "source_commit",
        "executable_sha256"
      ],
      "properties": {
        "engine": {
          "const": "EPA_SWMM"
        },
        "version": {
          "const": "5.2.4"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "case_count": {
      "const": 54
    },
    "completed_case_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 54
    },
    "failed_case_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 54
    },
    "cases": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "claim_ceiling": {
      "const": "SyntheticScenarioEnvelopeOnly"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "metric": {
      "type": [
        "number",
        "null"
      ]
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "rainfall_profile_id",
        "rainfall_depth_multiplier",
        "conduit_diameter_m",
        "paired_baseline_case_id",
        "case_state",
        "exit_code",
        "derived_input_sha256",
        "report_sha256",
        "binary_output_sha256",
        "stdout_sha256",
        "metrics",
        "paired_deltas"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^S1-(REF|SHORT|EARLY|LATE|DOUBLE|SUSTAIN)-X(050|100|150)-D(060|040|025)$"
        },
        "rainfall_profile_id": {
          "enum": [
            "reference",
            "short_burst",
            "early_peak",
            "delayed_peak",
            "double_peak",
            "sustained_moderate"
          ]
        },
        "rainfall_depth_multiplier": {
          "enum": [
            0.5,
            1,
            1.5
          ]
        },
        "conduit_diameter_m": {
          "enum": [
            0.6,
            0.4,
            0.25
          ]
        },
        "paired_baseline_case_id": {
          "type": "string",
          "pattern": "^S1-(REF|SHORT|EARLY|LATE|DOUBLE|SUSTAIN)-X(050|100|150)-D060$"
        },
        "case_state": {
          "enum": [
            "Completed",
            "Failed",
            "NotRun"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "derived_input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "binary_output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "stdout_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runoff_continuity_error_percent",
            "routing_continuity_error_percent",
            "rainfall_depth_mm",
            "total_runoff_depth_mm",
            "total_runoff_volume_million_liters",
            "peak_runoff_m3_s",
            "peak_j1_depth_m",
            "peak_j1_time",
            "peak_conduit_flow_m3_s",
            "peak_conduit_velocity_m_s",
            "conduit_max_full_flow_ratio",
            "conduit_max_full_depth_ratio",
            "peak_outfall_flow_m3_s",
            "outfall_volume_million_liters",
            "flooding_loss_million_liters",
            "surcharged",
            "flooded"
          ],
          "properties": {
            "runoff_continuity_error_percent": {
              "$ref": "#/$defs/metric"
            },
            "routing_continuity_error_percent": {
              "$ref": "#/$defs/metric"
            },
            "rainfall_depth_mm": {
              "$ref": "#/$defs/metric"
            },
            "total_runoff_depth_mm": {
              "$ref": "#/$defs/metric"
            },
            "total_runoff_volume_million_liters": {
              "$ref": "#/$defs/metric"
            },
            "peak_runoff_m3_s": {
              "$ref": "#/$defs/metric"
            },
            "peak_j1_depth_m": {
              "$ref": "#/$defs/metric"
            },
            "peak_j1_time": {
              "type": [
                "string",
                "null"
              ]
            },
            "peak_conduit_flow_m3_s": {
              "$ref": "#/$defs/metric"
            },
            "peak_conduit_velocity_m_s": {
              "$ref": "#/$defs/metric"
            },
            "conduit_max_full_flow_ratio": {
              "$ref": "#/$defs/metric"
            },
            "conduit_max_full_depth_ratio": {
              "$ref": "#/$defs/metric"
            },
            "peak_outfall_flow_m3_s": {
              "$ref": "#/$defs/metric"
            },
            "outfall_volume_million_liters": {
              "$ref": "#/$defs/metric"
            },
            "flooding_loss_million_liters": {
              "$ref": "#/$defs/metric"
            },
            "surcharged": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "flooded": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "paired_deltas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peak_j1_depth_m",
            "peak_conduit_velocity_m_s",
            "peak_outfall_flow_m3_s",
            "flooding_loss_million_liters"
          ],
          "properties": {
            "peak_j1_depth_m": {
              "$ref": "#/$defs/metric"
            },
            "peak_conduit_velocity_m_s": {
              "$ref": "#/$defs/metric"
            },
            "peak_outfall_flow_m3_s": {
              "$ref": "#/$defs/metric"
            },
            "flooding_loss_million_liters": {
              "$ref": "#/$defs/metric"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "Passed"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "completed_case_count": {
            "const": 54
          },
          "failed_case_count": {
            "const": 0
          },
          "cases": {
            "items": {
              "properties": {
                "case_state": {
                  "const": "Completed"
                },
                "exit_code": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "Failed"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "failed_case_count": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
