{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-localization-split-plan-v0.1.schema.json",
  "title": "Water localization topology split plan v0.1",
  "description": "Synthetic split-integrity fixture; not a localization benchmark result or field dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "benchmark_id",
    "protocol",
    "pressure_unit",
    "train_topology_families",
    "calibration_topology_families",
    "test_topology_families",
    "cases",
    "assumptions",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-localization-split-plan/v0.1"
    },
    "classification": {
      "const": "synthetic_public"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "const": "leave_topology_family_out"
    },
    "pressure_unit": {
      "type": "string",
      "minLength": 1
    },
    "train_topology_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "calibration_topology_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_topology_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "link_id",
        "from_node_id",
        "to_node_id"
      ],
      "properties": {
        "link_id": {
          "type": "string",
          "minLength": 1
        },
        "from_node_id": {
          "type": "string",
          "minLength": 1
        },
        "to_node_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "links"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "perturbation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault_class",
        "target_node_id",
        "withdrawal_gpm",
        "scenario_seed"
      ],
      "properties": {
        "fault_class": {
          "enum": [
            "no_fault",
            "single_withdrawal",
            "incipient_withdrawal"
          ]
        },
        "target_node_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "withdrawal_gpm": {
          "type": "number",
          "minimum": 0
        },
        "scenario_seed": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fault_class": {
                "const": "no_fault"
              }
            },
            "required": [
              "fault_class"
            ]
          },
          "then": {
            "properties": {
              "target_node_id": {
                "type": "null"
              },
              "withdrawal_gpm": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "fault_class": {
                "enum": [
                  "single_withdrawal",
                  "incipient_withdrawal"
                ]
              },
              "target_node_id": {
                "type": "string"
              }
            },
            "required": [
              "fault_class",
              "target_node_id"
            ]
          },
          "then": {
            "properties": {
              "withdrawal_gpm": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "state",
        "pressure_delta_psi"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "observed",
            "missing"
          ]
        },
        "pressure_delta_psi": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "pressure_delta_psi": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "missing"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "pressure_delta_psi": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "topology_family_id",
        "topology",
        "perturbation",
        "sensor_readings"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "calibration",
            "test"
          ]
        },
        "topology_family_id": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "$ref": "#/$defs/topology"
        },
        "perturbation": {
          "$ref": "#/$defs/perturbation"
        },
        "sensor_readings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reading"
          }
        }
      }
    }
  }
}
