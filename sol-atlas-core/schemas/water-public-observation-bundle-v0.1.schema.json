{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-public-observation-bundle-v0.1.schema.json",
  "title": "Water Public Observation Bundle v0.1",
  "description": "Source-attributed public aggregate observations and plans. This is not a hydraulic model input or calibration dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "retrieved_on",
    "scope",
    "source_records",
    "observations",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-public-observation-bundle/v0.1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "retrieved_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geography",
        "purpose",
        "classification"
      ],
      "properties": {
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "public_aggregate_research",
            "synthetic",
            "restricted"
          ]
        }
      }
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "publisher",
        "publication_title",
        "publication_url",
        "official_source_url",
        "published_on",
        "source_kind",
        "access_state",
        "granularity",
        "reuse_terms",
        "known_limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publication_title": {
          "type": "string",
          "minLength": 1
        },
        "publication_url": {
          "type": "string",
          "format": "uri"
        },
        "official_source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_kind": {
          "enum": [
            "published_report",
            "published_notice",
            "planned_program",
            "interactive_dashboard",
            "monitoring_dataset",
            "service_notice"
          ]
        },
        "access_state": {
          "enum": [
            "public_page_observed",
            "public_summary_observed",
            "interactive_export_not_yet_captured",
            "request_or_permission_required",
            "unknown"
          ]
        },
        "granularity": {
          "type": "string",
          "minLength": 1
        },
        "reuse_terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "source_id",
        "name",
        "value",
        "unit",
        "observation_kind",
        "statistic",
        "period_start",
        "period_end",
        "period_label",
        "population_or_scope",
        "reference_text",
        "interpretation_state",
        "notes"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "observation_kind": {
          "enum": [
            "published_aggregate",
            "planned_target",
            "reported_reference"
          ]
        },
        "statistic": {
          "type": "string",
          "minLength": 1
        },
        "period_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "period_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "period_label": {
          "type": "string",
          "minLength": 1
        },
        "population_or_scope": {
          "type": "string",
          "minLength": 1
        },
        "reference_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "interpretation_state": {
          "enum": [
            "reported_not_independently_reproduced",
            "not_applicable",
            "not_assessed",
            "provisional_needs_primary_document_check"
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
