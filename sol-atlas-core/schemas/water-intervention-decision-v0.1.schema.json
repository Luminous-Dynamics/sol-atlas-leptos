{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-intervention-decision-v0.1.schema.json",
  "title": "Water Intervention Decision Packet v0.1",
  "description": "Evidence-first comparison contract for water-system interventions. It prevents unavailable measures from becoming zero, separates hard service constraints from trade-offs, and records uncertainty and human review. Schema validity is not engineering approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "classification",
    "decision_question",
    "baseline",
    "alternatives",
    "comparison_policy",
    "uncertainty_review",
    "equity_review",
    "decision_state",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-intervention-decision/v0.1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "classification": {
      "enum": [
        "synthetic_public",
        "public_reviewed",
        "restricted"
      ]
    },
    "decision_question": {
      "type": "string",
      "minLength": 16
    },
    "baseline": {
      "$ref": "#/$defs/baseline_case"
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate_case"
      }
    },
    "comparison_policy": {
      "$ref": "#/$defs/comparison_policy"
    },
    "uncertainty_review": {
      "$ref": "#/$defs/uncertainty_review"
    },
    "equity_review": {
      "$ref": "#/$defs/equity_review"
    },
    "decision_state": {
      "$ref": "#/$defs/decision_state"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "lower_bound",
        "upper_bound",
        "method_note"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_assessed",
            "point_estimate_only",
            "interval",
            "scenario_sweep",
            "sensitivity_analysis"
          ]
        },
        "lower_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper_bound": {
          "type": [
            "number",
            "null"
          ]
        },
        "method_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_assessed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "lower_bound": {
                "type": "null"
              },
              "upper_bound": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "interval",
                  "scenario_sweep",
                  "sensitivity_analysis"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "lower_bound": {
                "type": "number"
              },
              "upper_bound": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "domain",
        "availability_state",
        "value",
        "unit",
        "direction",
        "evidence_class",
        "comparability_state",
        "scope",
        "period_label",
        "uncertainty",
        "source_references",
        "reason"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "domain": {
          "enum": [
            "service_reliability",
            "water_quality",
            "water_loss",
            "energy",
            "lifecycle_cost",
            "environment",
            "equity",
            "diagnostic"
          ]
        },
        "availability_state": {
          "enum": [
            "available",
            "unavailable",
            "not_comparable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "lower_is_better",
            "higher_is_better",
            "target_range",
            "diagnostic_only"
          ]
        },
        "evidence_class": {
          "enum": [
            "observed",
            "derived",
            "simulated",
            "estimated",
            "hypothesis",
            "synthetic_placeholder",
            "unavailable"
          ]
        },
        "comparability_state": {
          "enum": [
            "comparable",
            "not_comparable",
            "not_assessed"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "period_label": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "source_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability_state": {
                "const": "available"
              }
            },
            "required": [
              "availability_state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "availability_state": {
                "enum": [
                  "unavailable",
                  "not_comparable"
                ]
              }
            },
            "required": [
              "availability_state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "run_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "manifest_sha256",
        "run_state",
        "evidence_ceiling"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_state": {
          "enum": [
            "NotRun",
            "Completed",
            "Failed",
            "Blocked"
          ]
        },
        "evidence_ceiling": {
          "enum": [
            "contract_only",
            "synthetic_unvalidated",
            "synthetic_reproduced",
            "empirically_validated"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "run_state": {
                "const": "NotRun"
              }
            },
            "required": [
              "run_state"
            ]
          },
          "then": {
            "properties": {
              "manifest_sha256": {
                "type": "null"
              },
              "evidence_ceiling": {
                "const": "contract_only"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_state": {
                "const": "Completed"
              }
            },
            "required": [
              "run_state"
            ]
          },
          "then": {
            "properties": {
              "manifest_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence_ceiling": {
                "enum": [
                  "synthetic_unvalidated",
                  "synthetic_reproduced",
                  "empirically_validated"
                ]
              }
            }
          }
        }
      ]
    },
    "hard_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "requirement",
        "status",
        "validation_basis",
        "evidence_reference",
        "notes"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "requirement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "validation_basis": {
          "enum": [
            "regulatory_or_contractual",
            "engineer_defined",
            "research_hypothesis",
            "not_defined"
          ]
        },
        "evidence_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_reference": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "baseline_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "role",
        "scenario_id",
        "run_reference",
        "metrics",
        "hard_constraints"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "role": {
          "const": "baseline"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "run_reference": {
          "$ref": "#/$defs/run_reference"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "hard_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hard_constraint"
          }
        }
      }
    },
    "candidate_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_id",
        "role",
        "scenario_id",
        "run_reference",
        "metrics",
        "hard_constraints"
      ],
      "properties": {
        "alternative_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "role": {
          "const": "candidate"
        },
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "run_reference": {
          "$ref": "#/$defs/run_reference"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "hard_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hard_constraint"
          }
        }
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "hard_constraints_first",
        "scalar_score_allowed",
        "unknown_metric_behavior",
        "non_comparable_metric_behavior"
      ],
      "properties": {
        "method": {
          "const": "pareto_frontier"
        },
        "hard_constraints_first": {
          "const": true
        },
        "scalar_score_allowed": {
          "const": false
        },
        "unknown_metric_behavior": {
          "const": "not_zero_and_not_rankable"
        },
        "non_comparable_metric_behavior": {
          "const": "retain_separately"
        }
      }
    },
    "uncertainty_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sensitivity_state",
        "material_unknowns",
        "next_evidence_actions"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_assessed",
            "partial",
            "assessed"
          ]
        },
        "sensitivity_state": {
          "enum": [
            "not_run",
            "ran",
            "blocked"
          ]
        },
        "material_unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_evidence_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_action"
          }
        }
      }
    },
    "evidence_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "description",
        "uncertainty_target",
        "blocking"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_target": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        }
      }
    },
    "equity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "dimensions_considered",
        "unresolved_impacts"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_assessed",
            "partial",
            "assessed"
          ]
        },
        "dimensions_considered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_impacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "selected_alternative_id",
        "authorization_state",
        "independent_engineer_review"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_decided",
            "review_required",
            "recorded"
          ]
        },
        "selected_alternative_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "authorization_state": {
          "enum": [
            "not_authorized",
            "planning_only"
          ]
        },
        "independent_engineer_review": {
          "enum": [
            "not_requested",
            "required",
            "completed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not_decided",
                  "review_required"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "selected_alternative_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "recorded"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "selected_alternative_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
              }
            }
          }
        }
      ]
    }
  }
}
