{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.luminousdynamics.io/schemas/mycelix-multiworld-sim-tech-tree-v1.schema.json",
  "title": "Mycelix Multiworld Sim Technology Tree v1",
  "description": "Versioned simulated-scenario technology milestones. A per-tick probability is a model parameter, not a calibrated event forecast.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "source_model",
    "definition_sha256",
    "definition_source",
    "ticks_per_year",
    "year_zero_semantics",
    "milestones"
  ],
  "properties": {
    "schema_version": {
      "const": "mycelix-multiworld-sim.tech-tree.v1"
    },
    "classification": {
      "const": "simulated_scenario"
    },
    "source_model": {
      "type": "string",
      "minLength": 1
    },
    "ticks_per_year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "year_zero_semantics": {
      "const": "relative_to_scenario_start"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "definition_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the versioned model-definition projection, excluding run-specific achievement outcomes."
    },
    "definition_source": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "milestoneId": {
      "type": "string",
      "pattern": "^mycelix-multiworld-sim:tech:[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "sectorPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sector_index",
        "minimum_level"
      ],
      "properties": {
        "sector_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "minimum_level": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "techEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tech_level_boost",
        "power_multiplier",
        "propulsion_unlock",
        "resource_efficiency"
      ],
      "properties": {
        "tech_level_boost": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "power_multiplier": {
          "type": "number",
          "minimum": 0
        },
        "propulsion_unlock": {
          "type": "boolean"
        },
        "resource_efficiency": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "earliest_tick",
        "latest_tick",
        "base_probability_per_tick",
        "sector_prerequisites",
        "prerequisite_milestone_ids",
        "prerequisite_milestone_names",
        "effects",
        "achieved",
        "achieved_tick"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/milestoneId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "earliest_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "latest_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "base_probability_per_tick": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sector_prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sectorPrerequisite"
          }
        },
        "prerequisite_milestone_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/milestoneId"
          }
        },
        "prerequisite_milestone_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effects": {
          "$ref": "#/$defs/techEffects"
        },
        "achieved": {
          "type": "boolean"
        },
        "achieved_tick": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "achieved": {
                "const": true
              }
            },
            "required": [
              "achieved"
            ]
          },
          "then": {
            "properties": {
              "achieved_tick": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "achieved": {
                "const": false
              }
            },
            "required": [
              "achieved"
            ]
          },
          "then": {
            "properties": {
              "achieved_tick": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
