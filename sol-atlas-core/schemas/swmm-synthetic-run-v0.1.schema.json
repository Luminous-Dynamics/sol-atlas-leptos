{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/swmm-synthetic-run-v0.1.schema.json",
  "title": "Synthetic SWMM reference run evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_state",
    "synthetic_only",
    "failure_stage",
    "failure_exit_code",
    "failure_line",
    "failure_message",
    "solver",
    "execution_identity",
    "source_fixture",
    "scenario_bundle",
    "baseline",
    "candidate",
    "continuity",
    "checks",
    "claim_ceiling",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "swmm-synthetic-run/v0.1"
    },
    "run_state": {
      "enum": [
        "Completed",
        "Failed"
      ]
    },
    "synthetic_only": {
      "const": true
    },
    "failure_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "failure_line": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "failure_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version",
        "source_commit",
        "executable_sha256"
      ],
      "properties": {
        "engine": {
          "const": "EPA_SWMM"
        },
        "version": {
          "const": "5.2.4"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "executable_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "execution_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_sha",
        "github_ref",
        "workflow_run_id",
        "workflow_run_attempt"
      ],
      "properties": {
        "github_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "github_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflow_run_attempt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "scenario_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bundle_id",
        "scenario_id",
        "target_asset_id",
        "parameter",
        "baseline_value_m",
        "candidate_value_m"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "target_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "const": "circular_diameter_m"
        },
        "baseline_value_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "candidate_value_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "baseline": {
      "$ref": "#/$defs/runArtifact"
    },
    "candidate": {
      "$ref": "#/$defs/runArtifact"
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_abs_percent",
        "baseline",
        "candidate"
      ],
      "properties": {
        "max_abs_percent": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "baseline": {
          "$ref": "#/$defs/continuityReadings"
        },
        "candidate": {
          "$ref": "#/$defs/continuityReadings"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_digest_matches",
        "baseline_outputs_present",
        "candidate_outputs_present",
        "reports_differ",
        "binary_outputs_differ",
        "continuity_within_tolerance"
      ],
      "properties": {
        "input_digest_matches": {
          "type": "boolean"
        },
        "baseline_outputs_present": {
          "type": "boolean"
        },
        "candidate_outputs_present": {
          "type": "boolean"
        },
        "reports_differ": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "binary_outputs_differ": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "continuity_within_tolerance": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "claim_ceiling": {
      "const": "synthetic_swmm_single_event_adapter_smoke"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "runArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "exit_code",
        "input_sha256",
        "report_sha256",
        "output_sha256",
        "stdout_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "NotRun",
            "Completed",
            "Failed"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "input_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "stdout_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "continuityReadings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runoff_percent",
        "routing_percent"
      ],
      "properties": {
        "runoff_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "routing_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_state": {
            "const": "Completed"
          }
        },
        "required": [
          "run_state"
        ]
      },
      "then": {
        "properties": {
          "failure_stage": {
            "type": "null"
          },
          "failure_exit_code": {
            "type": "null"
          },
          "failure_line": {
            "type": "null"
          },
          "failure_message": {
            "type": "null"
          },
          "baseline": {
            "properties": {
              "state": {
                "const": "Completed"
              },
              "exit_code": {
                "const": 0
              },
              "report_sha256": {
                "type": "string"
              },
              "output_sha256": {
                "type": "string"
              }
            }
          },
          "candidate": {
            "properties": {
              "state": {
                "const": "Completed"
              },
              "exit_code": {
                "const": 0
              },
              "report_sha256": {
                "type": "string"
              },
              "output_sha256": {
                "type": "string"
              }
            }
          },
          "checks": {
            "properties": {
              "input_digest_matches": {
                "const": true
              },
              "baseline_outputs_present": {
                "const": true
              },
              "candidate_outputs_present": {
                "const": true
              },
              "reports_differ": {
                "const": true
              },
              "binary_outputs_differ": {
                "const": true
              },
              "continuity_within_tolerance": {
                "const": true
              }
            }
          },
          "solver": {
            "properties": {
              "executable_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "source_fixture": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_length": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "scenario_bundle": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
