{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/sol-atlas-core/schemas/water-localization-evaluation-v0.1.schema.json",
  "title": "Synthetic Water Localization Baseline Evaluation v0.1",
  "description": "Evaluation of leave-one-withdrawal-magnitude-out nearest-example baselines over completed hash-bound scenario corpus runs. It is not real-leak validation. The source topology is loaded from the exact INP whose SHA-256 is bound into the run manifest; localization error is also reported in unweighted undirected link hops.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest_sha256",
    "evaluation",
    "source_topology_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "water-localization-evaluation-envelope/v0.1"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "source_topology_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "metric": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_state",
        "unit_system",
        "flow_unit",
        "pressure_unit",
        "baseline_scenario_id",
        "negative_control_count",
        "fault_scenario_count",
        "observation_node_ids",
        "candidate_target_count",
        "held_out_magnitudes",
        "top_k",
        "models",
        "claim_ceiling",
        "nonclaims",
        "topology_node_count",
        "topology_link_count",
        "distance_semantics"
      ],
      "properties": {
        "schema_version": {
          "const": "water-localization-evaluation/v0.1"
        },
        "run_state": {
          "const": "Completed"
        },
        "unit_system": {
          "enum": [
            "LPS",
            "GPM"
          ]
        },
        "flow_unit": {
          "enum": [
            "L/s",
            "GPM"
          ]
        },
        "pressure_unit": {
          "enum": [
            "m",
            "psi"
          ]
        },
        "baseline_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "negative_control_count": {
          "const": 1
        },
        "fault_scenario_count": {
          "type": "integer",
          "minimum": 1
        },
        "observation_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_target_count": {
          "type": "integer",
          "minimum": 2
        },
        "held_out_magnitudes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "models": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "claim_ceiling": {
          "const": "synthetic_withdrawal_localization_baseline_only"
        },
        "nonclaims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "topology_node_count": {
          "type": "integer",
          "minimum": 1
        },
        "topology_link_count": {
          "type": "integer",
          "minimum": 1
        },
        "distance_semantics": {
          "const": "unweighted_undirected_link_hops"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit_system": {
                "const": "LPS"
              }
            },
            "required": [
              "unit_system"
            ]
          },
          "then": {
            "properties": {
              "flow_unit": {
                "const": "L/s"
              },
              "pressure_unit": {
                "const": "m"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit_system": {
                "const": "GPM"
              }
            },
            "required": [
              "unit_system"
            ]
          },
          "then": {
            "properties": {
              "flow_unit": {
                "const": "GPM"
              },
              "pressure_unit": {
                "const": "psi"
              }
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "distance_metric",
        "test_count",
        "top1_accuracy",
        "top_k_accuracy",
        "mean_reciprocal_rank",
        "predictions",
        "folds",
        "mean_topological_error_hops",
        "p95_topological_error_hops",
        "worst_topological_error_hops",
        "disconnected_prediction_count"
      ],
      "properties": {
        "model_id": {
          "enum": [
            "euclidean-nearest-example",
            "cosine-nearest-example"
          ]
        },
        "distance_metric": {
          "enum": [
            "euclidean",
            "cosine"
          ]
        },
        "test_count": {
          "type": "integer",
          "minimum": 1
        },
        "top1_accuracy": {
          "$ref": "#/$defs/metric"
        },
        "top_k_accuracy": {
          "$ref": "#/$defs/metric"
        },
        "mean_reciprocal_rank": {
          "$ref": "#/$defs/metric"
        },
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prediction"
          }
        },
        "folds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/fold"
          }
        },
        "mean_topological_error_hops": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "p95_topological_error_hops": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "worst_topological_error_hops": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "disconnected_prediction_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "euclidean-nearest-example"
              }
            },
            "required": [
              "model_id"
            ]
          },
          "then": {
            "properties": {
              "distance_metric": {
                "const": "euclidean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "model_id": {
                "const": "cosine-nearest-example"
              }
            },
            "required": [
              "model_id"
            ]
          },
          "then": {
            "properties": {
              "distance_metric": {
                "const": "cosine"
              }
            }
          }
        }
      ]
    },
    "fold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "held_out_magnitude",
        "test_count",
        "top1_accuracy",
        "top_k_accuracy",
        "mean_reciprocal_rank"
      ],
      "properties": {
        "held_out_magnitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "test_count": {
          "type": "integer",
          "minimum": 1
        },
        "top1_accuracy": {
          "$ref": "#/$defs/metric"
        },
        "top_k_accuracy": {
          "$ref": "#/$defs/metric"
        },
        "mean_reciprocal_rank": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fold_magnitude",
        "scenario_id",
        "actual_target",
        "predicted_top1",
        "actual_rank",
        "top_k_hit",
        "ranked_candidates",
        "topological_error_hops"
      ],
      "properties": {
        "fold_magnitude": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "actual_target": {
          "type": "string",
          "minLength": 1
        },
        "predicted_top1": {
          "type": "string",
          "minLength": 1
        },
        "actual_rank": {
          "type": "integer",
          "minimum": 1
        },
        "top_k_hit": {
          "type": "boolean"
        },
        "ranked_candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/ranked_candidate"
          }
        },
        "topological_error_hops": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ranked_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_junction_id",
        "distance",
        "rank"
      ],
      "properties": {
        "target_junction_id": {
          "type": "string",
          "minLength": 1
        },
        "distance": {
          "type": "number",
          "minimum": 0
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
