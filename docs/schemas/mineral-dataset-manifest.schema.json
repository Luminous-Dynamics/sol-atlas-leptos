{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/schemas/mineral-dataset-manifest.schema.json",
  "title": "Mineral Prospectivity Dataset Manifest",
  "description": "Provenance, rights, geospatial semantics, and quality metadata for one source or derived dataset artifact. Unknown rights must remain unknown; this schema does not grant permission to use any source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "layer_id",
    "title",
    "source",
    "rights",
    "artifact",
    "spatial",
    "quality",
    "lineage"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "layer_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "canonical_url",
        "accessed_at"
      ],
      "properties": {
        "organization": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "product_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "citation": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "acquisition_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "acquisition_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "license_name",
        "redistribution_allowed",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "restricted",
            "unknown",
            "not_permitted"
          ]
        },
        "license_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "license_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "redistribution_allowed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attribution_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_type",
        "bytes",
        "digest"
      ],
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256",
                "blake3"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "withheld": {
          "type": "boolean",
          "default": false
        },
        "withheld_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crs",
        "geometry_type",
        "extent",
        "nominal_resolution",
        "units",
        "nodata"
      ],
      "properties": {
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "geometry_type": {
          "type": "string",
          "enum": [
            "raster",
            "point",
            "line",
            "polygon",
            "table",
            "mesh",
            "other"
          ]
        },
        "extent": {
          "type": [
            "object",
            "null"
          ]
        },
        "nominal_resolution": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "resolution_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        },
        "nodata": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "coordinate_uncertainty_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "temporal": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reference_epoch": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_semantics": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_fraction",
        "data_state",
        "limitations"
      ],
      "properties": {
        "coverage_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "data_state": {
          "type": "string",
          "enum": [
            "observed",
            "interpolated",
            "reconstructed",
            "model_derived",
            "mixed",
            "unknown"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "survey_spacing_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "effective_resolution_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_manifest_ids",
        "transformations"
      ],
      "properties": {
        "parent_manifest_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "software",
              "version",
              "parameters_digest"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "software": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "parameters_digest": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restricted_metadata": {
          "type": "boolean",
          "default": false
        },
        "public_coordinates_permitted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$comment": "Digest values for SHA-256 and BLAKE3 are lowercase or uppercase hexadecimal, exactly 64 characters. Keep source checksum algorithms explicit. Rights state consistency is enforced: verified terms require a named license/terms check; unknown rights cannot claim redistribution permission; restricted/not-permitted states cannot be treated as freely redistributable.",
  "allOf": [
    {
      "if": {
        "properties": {
          "rights": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "rights"
        ]
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "license_name": {
                "type": "string",
                "minLength": 1
              },
              "redistribution_allowed": {
                "type": "boolean"
              },
              "terms_checked_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "rights"
        ]
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "redistribution_allowed": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights": {
            "properties": {
              "status": {
                "const": "not_permitted"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "rights"
        ]
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "redistribution_allowed": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rights": {
            "properties": {
              "status": {
                "const": "restricted"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "rights"
        ]
      },
      "then": {
        "properties": {
          "rights": {
            "properties": {
              "redistribution_allowed": {
                "enum": [
                  false,
                  null
                ]
              }
            }
          }
        }
      }
    }
  ]
}
