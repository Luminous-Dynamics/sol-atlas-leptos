{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/home-freedom/HOME_FREEDOM_BENCHMARK_MANIFEST_V0.1.schema.json",
  "title": "Home Freedom Compiler benchmark manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "maturity",
    "execution_status",
    "region_profile",
    "functional_unit",
    "archetypes",
    "scenario_families",
    "comparators",
    "hard_gates",
    "metrics",
    "negative_controls",
    "protocol_requirements",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "const": "HOME-FREEDOM-COMPILER-001"
    },
    "maturity": {
      "const": "PROPOSED_NOT_EVALUATED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "region_profile": {
      "type": "string",
      "minLength": 1
    },
    "functional_unit": {
      "type": "string",
      "minLength": 1
    },
    "archetypes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "scenario_families": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "comparators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "hard_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "unit",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "MINIMIZE",
              "MAXIMIZE",
              "REPORT"
            ]
          }
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mutation",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mutation": {
            "type": "string"
          },
          "expected": {
            "enum": [
              "BLOCKED",
              "UNKNOWN",
              "NOT_COMPARABLE"
            ]
          }
        }
      }
    },
    "protocol_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
