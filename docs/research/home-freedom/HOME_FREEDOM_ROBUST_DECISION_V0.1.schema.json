{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/home-freedom-robust-decision-v0.1.schema.json",
  "title": "Home Freedom robust decision benchmark v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "brief_id",
    "design_revision",
    "maturity",
    "execution_status",
    "scenarios",
    "hard_constraints",
    "objectives",
    "candidates",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "HOME-FREEDOM-ROBUST-DECISION-001"
    },
    "brief_id": {
      "type": "string",
      "minLength": 1
    },
    "design_revision": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "SYNTHETIC"
    },
    "execution_status": {
      "const": "NOT_SIMULATED"
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hardConstraint"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "claim_ceiling": {
      "$ref": "#/$defs/claimCeiling"
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "exogenous_trace_id"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "exogenous_trace_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hardConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "unit",
        "direction"
      ],
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "MINIMIZE",
            "MAXIMIZE"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "scenario_results"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_results": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/scenarioResult"
          }
        }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "gate_results",
        "metric_intervals"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gateResult"
          }
        },
        "metric_intervals": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/metricInterval"
          }
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "state",
        "evidence_ref"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "evidence_ref": {
                "type": "string",
                "pattern": "^synthetic:"
              }
            }
          }
        }
      ]
    },
    "metricInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "state",
        "lower",
        "upper",
        "unit",
        "interval_basis"
      ],
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "KNOWN_INTERVAL",
            "UNKNOWN"
          ]
        },
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "interval_basis": {
          "enum": [
            "SYNTHETIC_BOUND",
            "UNKNOWN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "lower": {
                "type": "null"
              },
              "upper": {
                "type": "null"
              },
              "interval_basis": {
                "const": "UNKNOWN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "KNOWN_INTERVAL"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "interval_basis": {
                "const": "SYNTHETIC_BOUND"
              }
            }
          }
        }
      ]
    },
    "claimCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_simulation_performed",
        "measured_data_admitted",
        "professional_review_passed",
        "buildability_claimed",
        "sota_superiority_claimed",
        "scalar_score_emitted"
      ],
      "properties": {
        "physical_simulation_performed": {
          "const": false
        },
        "measured_data_admitted": {
          "const": false
        },
        "professional_review_passed": {
          "const": false
        },
        "buildability_claimed": {
          "const": false
        },
        "sota_superiority_claimed": {
          "const": false
        },
        "scalar_score_emitted": {
          "const": false
        }
      }
    }
  }
}
