{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/home-freedom/HOME_DESIGN_BRIEF_PROFILE_V0.1.schema.json",
  "title": "Resident-authored home design brief profile v0.1",
  "description": "A privacy-minimizing functional brief for synthetic or resident-authorized home design exploration. Not a permit, professional design or safety certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "maturity",
    "household_frame",
    "intent",
    "constraints",
    "preferences",
    "site_reference",
    "delivery",
    "privacy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "brief_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "maturity": {
      "enum": [
        "SYNTHETIC",
        "RESIDENT_AUTHORIZED",
        "RESTRICTED_PRIVATE"
      ]
    },
    "household_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usual_occupant_count",
        "occupancy_pattern"
      ],
      "properties": {
        "usual_occupant_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "occupancy_pattern": {
          "enum": [
            "SINGLE",
            "COUPLE",
            "FAMILY",
            "MULTIGENERATIONAL",
            "SHARED",
            "VARIABLE",
            "OTHER"
          ]
        },
        "guest_capacity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activities",
        "space_relationships"
      ],
      "properties": {
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "activity_id",
              "activity",
              "frequency"
            ],
            "properties": {
              "activity_id": {
                "type": "string",
                "pattern": "^[A-Z0-9_-]{2,48}$"
              },
              "activity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "frequency": {
                "enum": [
                  "DAILY",
                  "WEEKLY",
                  "OCCASIONAL",
                  "SEASONAL"
                ]
              },
              "dedicated_space_required": {
                "type": "boolean"
              },
              "privacy_requirement": {
                "enum": [
                  "OPEN",
                  "SEMI_PRIVATE",
                  "PRIVATE",
                  "NOT_STATED"
                ]
              }
            }
          }
        },
        "space_relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_activity_id",
              "to_activity_id",
              "relationship"
            ],
            "properties": {
              "from_activity_id": {
                "type": "string"
              },
              "to_activity_id": {
                "type": "string"
              },
              "relationship": {
                "enum": [
                  "ADJACENT",
                  "NEAR",
                  "SEPARATE",
                  "ACOUSTICALLY_SEPARATE",
                  "VISUALLY_PRIVATE",
                  "DIRECT_ACCESS",
                  "NO_REQUIREMENT"
                ]
              }
            }
          }
        },
        "outdoor_use": {
          "type": "array",
          "items": {
            "enum": [
              "PRIVATE_COURTYARD",
              "BALCONY",
              "GARDEN",
              "SERVICE_YARD",
              "ROOF_TERRACE",
              "SHARED_GREEN",
              "NONE",
              "OTHER"
            ]
          }
        },
        "future_adaptations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "domain",
          "statement",
          "severity",
          "verification_owner"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{2,48}$"
          },
          "domain": {
            "enum": [
              "FUNCTION",
              "ACCESSIBILITY",
              "SAFETY",
              "PRIVACY",
              "ACOUSTICS",
              "DAYLIGHT",
              "THERMAL",
              "WATER",
              "ENERGY",
              "BUDGET",
              "LEGAL",
              "SITE",
              "DELIVERY",
              "OTHER"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "severity": {
            "const": "NON_NEGOTIABLE"
          },
          "verification_owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "evidence_reference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          }
        }
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "preference_id",
          "domain",
          "statement",
          "priority"
        ],
        "properties": {
          "preference_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]{2,48}$"
          },
          "domain": {
            "enum": [
              "FORM",
              "MATERIAL",
              "COLOUR",
              "ROOM_LAYOUT",
              "OUTDOOR",
              "PRIVACY",
              "DAYLIGHT",
              "ENERGY",
              "WATER",
              "COST",
              "ADAPTABILITY",
              "OTHER"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "tradeable": {
            "type": "boolean"
          }
        }
      }
    },
    "site_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_artifact_ref",
        "jurisdiction",
        "authority_profile_ref",
        "survey_state",
        "rights_state",
        "climate_profile_ref"
      ],
      "properties": {
        "site_artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "authority_profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "survey_state": {
          "enum": [
            "QUALIFIED",
            "PROVISIONAL",
            "UNKNOWN",
            "CONFLICTED"
          ]
        },
        "rights_state": {
          "enum": [
            "QUALIFIED",
            "PROVISIONAL",
            "UNKNOWN",
            "CONFLICTED"
          ]
        },
        "soil_state": {
          "enum": [
            "QUALIFIED",
            "PROVISIONAL",
            "UNKNOWN",
            "NOT_REQUIRED_FOR_SCREENING"
          ]
        },
        "climate_profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "ZAR"
        },
        "initial_capital_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "initial_capital_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "whole_life_horizon_years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "monthly_housing_cost_ceiling": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_scope_ref": {
          "type": "string",
          "maxLength": 240
        },
        "price_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_count",
        "first_occupied_phase_must_be_complete",
        "local_supply_profile_ref",
        "construction_skill_profile_ref"
      ],
      "properties": {
        "phase_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "first_occupied_phase_must_be_complete": {
          "const": true
        },
        "local_supply_profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "construction_skill_profile_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "preferred_construction_modes": {
          "type": "array",
          "items": {
            "enum": [
              "LOCAL_TRADE",
              "PANELIZED",
              "PREFABRICATED",
              "3D_PRINTED_RESEARCH_ONLY",
              "SELF_BUILD_WITH_PROFESSIONAL_REVIEW",
              "HYBRID",
              "UNDECIDED"
            ]
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_sharing_mode",
        "purpose",
        "retention_policy_ref",
        "contains_direct_identifiers"
      ],
      "properties": {
        "data_sharing_mode": {
          "enum": [
            "LOCAL_ONLY",
            "EXPLICIT_PURPOSE_SCOPED_CONSENT",
            "SYNTHETIC_PUBLIC"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "retention_policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "contains_direct_identifiers": {
          "const": false
        },
        "consent_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        }
      }
    }
  }
}
