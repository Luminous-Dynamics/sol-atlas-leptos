{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Beverage Terroir Evidence Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_records",
    "derived_layers",
    "assessment_requests"
  ],
  "properties": {
    "schema_version": {
      "const": "beverage-terroir-evidence-v1"
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "publisher",
          "source_uri",
          "retrieved_at",
          "version_or_edition",
          "spatial_support",
          "crs",
          "native_resolution",
          "temporal_coverage",
          "units",
          "rights_status",
          "evidence_class",
          "claim_ceiling"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "version_or_edition": {
            "type": "string",
            "minLength": 1
          },
          "spatial_support": {
            "enum": [
              "POINT",
              "GRID",
              "POLYGON",
              "ADMINISTRATIVE_AREA",
              "STATION",
              "PLOT",
              "UNKNOWN"
            ]
          },
          "crs": {
            "type": "string",
            "minLength": 1
          },
          "native_resolution": {
            "type": "string",
            "minLength": 1
          },
          "temporal_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "time_standard"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "time_standard": {
                "enum": [
                  "UTC",
                  "LOCAL_SOLAR_TIME",
                  "LOCAL_CIVIL_TIME",
                  "UNKNOWN"
                ]
              }
            }
          },
          "units": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "rights_status": {
            "enum": [
              "OPEN_WITH_ATTRIBUTION",
              "PERMITTED",
              "RESTRICTED",
              "PROHIBITED",
              "UNKNOWN"
            ]
          },
          "evidence_class": {
            "enum": [
              "MEASURED",
              "REMOTE_SENSING",
              "MODELLED",
              "SIMULATED",
              "DECLARED",
              "UNKNOWN"
            ]
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uncertainty_method": {
            "type": "string"
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derived_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "source_ids",
          "transformations",
          "output_support",
          "uncertainty",
          "claim_ceiling"
        ],
        "properties": {
          "layer_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "transformations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output_support": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": "string",
            "minLength": 1
          },
          "model_or_code_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assessment_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assessment_id",
          "crop_or_input",
          "target_claim",
          "evaluation_period",
          "required_gates"
        ],
        "properties": {
          "assessment_id": {
            "type": "string",
            "minLength": 1
          },
          "crop_or_input": {
            "type": "string",
            "minLength": 1
          },
          "target_claim": {
            "enum": [
              "CLIMATE_CONTEXT",
              "WATER_SCARCITY_CONTEXT",
              "CROP_RESPONSE_PREDICTION",
              "INGREDIENT_QUALITY_PROXY",
              "SENSORY_OUTCOME",
              "RESOURCE_RESILIENCE",
              "OTHER"
            ]
          },
          "evaluation_period": {
            "type": "string",
            "minLength": 1
          },
          "required_gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ceiling": {
            "type": "string"
          }
        }
      }
    }
  }
}
