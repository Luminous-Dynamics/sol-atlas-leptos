{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/home-expression/HOME_EXPRESSION_BENCHMARK_EXTENSION_V0.1.schema.json",
  "title": "Home Expression Benchmark Extension v0.1",
  "description": "Synthetic, contract-level style/experience mutation extension over Home Freedom. Not a physical feasibility corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "maturity",
    "execution_status",
    "parent_home_freedom_corpus_ref",
    "purpose",
    "functional_unit",
    "counterfactual_pairs",
    "cases",
    "source_population_state",
    "source_case_count",
    "source_population_note"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "const": "HOME-EXPRESSION-BENCH-EXT-001"
    },
    "maturity": {
      "const": "PROPOSED_NOT_EVALUATED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "parent_home_freedom_corpus_ref": {
      "type": "string",
      "format": "uri"
    },
    "parent_expression_issue_ref": {
      "type": "string",
      "format": "uri"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "functional_unit": {
      "type": "string",
      "minLength": 1
    },
    "status_semantics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "counterfactual_pairs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "left_case",
          "right_case",
          "changed_dimension",
          "changed_fields",
          "held_constant_fields",
          "expected_invariant"
        ],
        "properties": {
          "pair_id": {
            "type": "string"
          },
          "left_case": {
            "type": "string"
          },
          "right_case": {
            "type": "string"
          },
          "changed_dimension": {
            "enum": [
              "STYLE",
              "AMENITY",
              "BUDGET",
              "HARD_CONSTRAINT"
            ]
          },
          "changed_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "held_constant_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected_invariant": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "dimension",
          "case_kind",
          "source_population_ref",
          "source_case_id",
          "source_case_binding_status",
          "mutation",
          "expected_disposition",
          "physical_evaluation",
          "claim_ceiling",
          "derivation_kind",
          "source_artifact_refs"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "dimension": {
            "enum": [
              "STYLE",
              "AMENITY",
              "BUDGET",
              "REVISION",
              "RIGHTS",
              "AGENCY",
              "HARD_CONSTRAINT"
            ]
          },
          "case_kind": {
            "const": "SYNTHETIC_CONTRACT_MUTATION"
          },
          "source_population_ref": {
            "type": "string"
          },
          "source_case_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_case_binding_status": {
            "enum": [
              "BOUND",
              "OWNER_CASE_BINDING_PENDING"
            ]
          },
          "mutation": {
            "type": "string"
          },
          "expected_disposition": {
            "type": "string"
          },
          "physical_evaluation": {
            "const": "NOT_PERFORMED"
          },
          "claim_ceiling": {
            "const": "CONTRACT_ORACLE_ONLY_NOT_BUILDING_FEASIBILITY"
          },
          "derivation_kind": {
            "const": "ONE_FACTOR_COUNTERFACTUAL_MUTATION"
          },
          "source_artifact_refs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "blob_sha"
              ],
              "properties": {
                "path": {
                  "enum": [
                    "docs/research/home-freedom/HOME_DESIGN_BRIEF_SYNTHETIC_EXAMPLE_V0.1.json",
                    "docs/research/home-freedom/HOME_DESIGN_CANDIDATE_SET_SYNTHETIC_EXAMPLE_V0.1.json"
                  ]
                },
                "blob_sha": {
                  "enum": [
                    "0090e2f0c883c62817d1b6da51d1a2dbe92a477f",
                    "030e6c0e71cef1a936738910409396a9a48dedcf"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "source_population_state": {
      "const": "ONE_SYNTHETIC_BASELINE_ONLY"
    },
    "source_case_count": {
      "const": 1
    },
    "source_population_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
