{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/home-expression/HOME_EXPRESSION_DECISION_RECEIPT_V0.1.schema.json",
  "title": "Home Expression Decision Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "study_id",
    "maturity",
    "execution_status",
    "source_binding",
    "candidate_receipts",
    "comparison_policy",
    "resident_choice",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "const": "HOME-EXPRESSION-DECISION-RECEIPT-001"
    },
    "maturity": {
      "const": "SYNTHETIC_CONTRACT_FIXTURE"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_artifact_ref",
        "profile_content_sha",
        "brief_id",
        "brief_artifact_ref",
        "brief_content_sha",
        "candidate_set_id",
        "candidate_set_artifact_ref",
        "candidate_set_content_sha",
        "design_revision"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "profile_content_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "brief_id": {
          "type": "string",
          "minLength": 1
        },
        "brief_artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "brief_content_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "candidate_set_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_set_artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_set_content_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "design_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate_receipts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "source_disposition",
          "space_program_state",
          "technical_disposition",
          "hard_gate_results"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "source_disposition": {
            "enum": [
              "CONDITIONAL_CONCEPT_ONLY",
              "SCREENING_ELIGIBLE",
              "BLOCKED",
              "NOT_COMPARABLE"
            ]
          },
          "space_program_state": {
            "type": "string",
            "minLength": 1
          },
          "technical_disposition": {
            "enum": [
              "BLOCKED",
              "CONDITIONAL_CONCEPT_ONLY",
              "ELIGIBLE_FOR_RESIDENT_PREFERENCE_COMPARISON"
            ]
          },
          "hard_gate_results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gate_id",
                "state",
                "reason",
                "evidence_ref"
              ],
              "properties": {
                "gate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "UNKNOWN"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_layer",
        "technical_pareto_status",
        "candidates_ranked",
        "scalar_score",
        "automatic_selection",
        "feasibility_claim_permitted",
        "pareto_comparison_requires_all_hard_gates_pass",
        "preference_source",
        "unknown_gate_semantics"
      ],
      "properties": {
        "comparison_layer": {
          "const": "EXPRESSION_PREVIEW_ONLY"
        },
        "technical_pareto_status": {
          "enum": [
            "NOT_COMPUTABLE_UNTIL_REQUIRED_GATES_PASS_AND_OBJECTIVES_ARE_ADMITTED",
            "READY_FOR_OWNER_NATIVE_PARETO_COMPARISON"
          ]
        },
        "candidates_ranked": {
          "const": false
        },
        "scalar_score": {
          "type": "null"
        },
        "automatic_selection": {
          "const": false
        },
        "feasibility_claim_permitted": {
          "const": false
        },
        "pareto_comparison_requires_all_hard_gates_pass": {
          "const": true
        },
        "preference_source": {
          "const": "RESIDENT_AUTHORED_PROFILE_ONLY"
        },
        "unknown_gate_semantics": {
          "const": "CONDITIONAL_NOT_PASS"
        }
      }
    },
    "resident_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "state",
        "selected_candidate_id",
        "pairwise_preferences",
        "decision_event"
      ],
      "properties": {
        "authority": {
          "const": "RESIDENT"
        },
        "state": {
          "enum": [
            "NOT_RECORDED",
            "UNDECIDED",
            "PREFERENCES_RECORDED",
            "CONCEPT_DIRECTION_SELECTED",
            "INCOMPARABLE"
          ]
        },
        "selected_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pairwise_preferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left_candidate_id",
              "right_candidate_id",
              "decision",
              "basis"
            ],
            "properties": {
              "left_candidate_id": {
                "type": "string"
              },
              "right_candidate_id": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "UNDECIDED",
                  "PREFER_LEFT",
                  "PREFER_RIGHT",
                  "EQUIVALENT",
                  "INCOMPARABLE"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "decision_event": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "participant_ref",
            "event_ref",
            "event_content_sha256",
            "decision_scope",
            "provenance_status",
            "design_revision"
          ],
          "properties": {
            "participant_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^participant:[A-Za-z0-9_-]+$"
            },
            "event_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^urn:mycelix:[A-Za-z0-9:_-]+$"
            },
            "event_content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decision_scope": {
              "const": "CONCEPT_DIRECTION_ONLY"
            },
            "provenance_status": {
              "const": "PENDING_MYCELIX_5149_VERIFICATION"
            },
            "design_revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "CONTRACT_ONLY_NO_TECHNICAL_FEASIBILITY_OR_PREFERENCE_WINNER"
    }
  }
}
