{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/home-expression/HOME_EXPRESSION_CATALOG_V0.2.schema.json",
  "title": "Home Expression Catalogue v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "maturity",
    "catalog_revision",
    "supersedes_catalog_revision",
    "non_goals",
    "impact_domains",
    "composition_model",
    "style_catalog",
    "experience_catalog",
    "regional_reference_modules",
    "community_authored_reference_policy",
    "spatial_typology_catalog",
    "material_tectonic_intent_catalog",
    "environmental_strategy_intent_catalog"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "maturity": {
      "const": "ILLUSTRATIVE_CATALOG_NOT_EVALUATED"
    },
    "catalog_revision": {
      "const": "HOME-EXPRESSION-CATALOG-0.2.0"
    },
    "supersedes_catalog_revision": {
      "const": "HOME-EXPRESSION-CATALOG-0.1.0"
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impact_domains": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "composition_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "independent_axes",
        "combination_rule",
        "scoring_rule"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "independent_axes": {
          "type": "array",
          "const": [
            "SPATIAL_TYPOLOGY",
            "ARCHITECTURAL_EXPRESSION",
            "MATERIAL_AND_TECTONIC_INTENT",
            "ENVIRONMENTAL_STRATEGY_INTENT",
            "EXPERIENCE_AND_PROGRAMME"
          ]
        },
        "combination_rule": {
          "type": "string",
          "const": "PRESERVE_RESIDENT_PARTIAL_PREFERENCES_AND_UNRESOLVED_CONFLICTS_NO_AUTOMATIC_STYLE_TO_GEOMETRY_MAPPING"
        },
        "scoring_rule": {
          "type": "string",
          "const": "NO_UNIVERSAL_BEAUTY_MEANING_OR_CULTURAL_FIT_SCORE"
        }
      }
    },
    "style_catalog": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "style_id",
          "display_name",
          "category",
          "description",
          "resident_may_blend",
          "resident_may_rename",
          "authenticity_note",
          "reference_policy",
          "reference_scope",
          "reference_sources",
          "not_a_typology",
          "selection_status",
          "must_not_assume"
        ],
        "properties": {
          "style_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,80}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resident_may_blend": {
            "type": "boolean"
          },
          "resident_may_rename": {
            "type": "boolean"
          },
          "authenticity_note": {
            "type": "string",
            "minLength": 1
          },
          "reference_policy": {
            "enum": [
              "GENERAL_EXPLORATION",
              "CONTEXT_AND_SOURCE_REQUIRED",
              "CONSERVATION_REVIEW_REQUIRED",
              "RESIDENT_AUTHORED"
            ]
          },
          "reference_scope": {
            "type": "string",
            "minLength": 1
          },
          "reference_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "not_a_typology": {
            "const": true
          },
          "selection_status": {
            "const": "ILLUSTRATIVE_NOT_EVALUATED"
          },
          "must_not_assume": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "experience_catalog": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "display_name",
          "category",
          "description",
          "optional_by_default",
          "selection_default",
          "claim_ceiling",
          "impact_domains",
          "priority_review_domains",
          "review_note"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "optional_by_default": {
            "const": true
          },
          "selection_default": {
            "const": "NOT_SELECTED"
          },
          "claim_ceiling": {
            "const": "CATALOG_ONLY_NO_COST_PERFORMANCE_OR_FEASIBILITY_CLAIM"
          },
          "impact_domains": {
            "type": "array",
            "minItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "priority_review_domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "regional_reference_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "display_name",
          "module_type",
          "geographic_scope",
          "historical_scope",
          "description",
          "attribution_guardrail",
          "reference_sources",
          "claim_ceiling",
          "selection_status"
        ],
        "properties": {
          "reference_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "module_type": {
            "const": "CONSERVATION_REFERENCE_ONLY"
          },
          "geographic_scope": {
            "type": "string"
          },
          "historical_scope": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "attribution_guardrail": {
            "type": "string"
          },
          "reference_sources": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "claim_ceiling": {
            "const": "HERITAGE_REFERENCE_ONLY_NO_NEW_BUILD_DETAIL_NO_STRUCTURAL_OR_CODE_APPROVAL"
          },
          "selection_status": {
            "const": "REFERENCE_ONLY_NOT_A_STYLE_PRESET"
          }
        }
      }
    },
    "community_authored_reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maturity",
        "prohibition",
        "required_fields",
        "default_state"
      ],
      "properties": {
        "maturity": {
          "const": "POLICY_ONLY_NO_COMMUNITY_MODULES_PUBLISHED"
        },
        "prohibition": {
          "const": "DO_NOT_CREATE_GENERIC_AFRICAN_OR_ETHNIC_STYLE_PRESETS"
        },
        "required_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "default_state": {
          "const": "UNAVAILABLE_UNTIL_ATTRIBUTION_RIGHTS_AND_REVIEW_ARE_ESTABLISHED"
        }
      }
    },
    "spatial_typology_catalog": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "display_name",
          "description",
          "claim_ceiling"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{2,80}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling": {
            "const": "INTENT_ONLY_NO_GEOMETRY_CODE_OR_ACCESSIBILITY_CLAIM"
          }
        }
      }
    },
    "material_tectonic_intent_catalog": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "display_name",
          "description",
          "claim_ceiling"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{2,80}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling": {
            "const": "INTENT_ONLY_NO_ASSEMBLY_STRUCTURAL_OR_SOURCING_CLAIM"
          }
        }
      }
    },
    "environmental_strategy_intent_catalog": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "display_name",
          "description",
          "claim_ceiling"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{2,80}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling": {
            "const": "INTENT_ONLY_NO_PHYSICAL_PERFORMANCE_OR_RESOURCE_CLAIM"
          }
        }
      }
    }
  }
}
