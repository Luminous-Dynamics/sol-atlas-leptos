{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/city-owner-payload-adapter-corpus-v0.1.schema.json",
  "title": "CityMaker Owner Payload Adapter Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "corpus_id",
    "classification",
    "purpose",
    "normative_notice",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "city-owner-payload-adapter-corpus/0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "CITY-OWNER-PAYLOAD-ADAPTER-CORPUS-V0.1"
    },
    "classification": {
      "const": "synthetic_fixture_only"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "normative_notice": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "name",
          "input",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^PA-[0-9]{2}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope_binding",
              "owner_artifacts",
              "report_binding"
            ],
            "properties": {
              "scope_binding": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "binding_disposition",
                  "scope_digest",
                  "artifact_bindings",
                  "required_use"
                ],
                "properties": {
                  "binding_disposition": {
                    "enum": [
                      "Bound",
                      "Unknown",
                      "NotComparable",
                      "Unsupported"
                    ]
                  },
                  "scope_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "artifact_bindings": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "artifact_id",
                        "binding_state",
                        "raw_owner_disposition",
                        "payload_bytes_verified"
                      ],
                      "properties": {
                        "artifact_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "binding_state": {
                          "enum": [
                            "Bound",
                            "Unknown",
                            "NotComparable",
                            "Unsupported"
                          ]
                        },
                        "raw_owner_disposition": {
                          "type": "string",
                          "minLength": 1
                        },
                        "payload_bytes_verified": {
                          "const": false
                        }
                      }
                    }
                  },
                  "required_use": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "owner_artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifact_id",
                    "payload_required",
                    "owner_repo",
                    "contract_id",
                    "contract_version",
                    "schema_digest_algorithm",
                    "schema_artifact_digest",
                    "source_revision",
                    "receipt_id",
                    "content_digest",
                    "subject_id",
                    "subject_digest",
                    "scope_digest",
                    "descriptor",
                    "descriptor_binding"
                  ],
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_required": {
                      "type": "boolean"
                    },
                    "owner_repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contract_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contract_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "schema_digest_algorithm": {
                      "enum": [
                        "git_blob_sha1",
                        "sha256"
                      ]
                    },
                    "schema_artifact_digest": {
                      "type": "string",
                      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    "source_revision": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "receipt_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "subject_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "scope_digest": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "descriptor": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "record_kind",
                        "case_record_id",
                        "owner_namespace",
                        "native_identity_components",
                        "source_payload",
                        "source_snapshot",
                        "observation_time",
                        "rights",
                        "attestation"
                      ],
                      "properties": {
                        "record_kind": {
                          "enum": [
                            "evidence",
                            "artifact",
                            "engineering_receipt",
                            "decision"
                          ]
                        },
                        "case_record_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_namespace": {
                          "type": "string",
                          "minLength": 1
                        },
                        "native_identity_components": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "name",
                              "value"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "value": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        },
                        "source_payload": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "sha256",
                            "digest_basis",
                            "bytes_retrieved",
                            "byte_length",
                            "payload_object_ref",
                            "media_type",
                            "schema_id",
                            "schema_version",
                            "schema_sha256"
                          ],
                          "properties": {
                            "sha256": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "description": "Digest text is intentionally allowed to be malformed in invalid-descriptor negative controls; runtime owner validation must reject malformed values."
                            },
                            "digest_basis": {
                              "enum": [
                                "locally_retrieved_and_hashed",
                                "source_owner_attested",
                                "external_reference",
                                "unavailable"
                              ]
                            },
                            "bytes_retrieved": {
                              "type": "boolean"
                            },
                            "byte_length": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 0
                            },
                            "payload_object_ref": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "media_type": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "schema_id": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "schema_version": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "schema_sha256": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          }
                        },
                        "source_snapshot": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source_id",
                            "snapshot_id",
                            "snapshot_sha256",
                            "captured_at",
                            "retrieved_at"
                          ],
                          "properties": {
                            "source_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "snapshot_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "snapshot_sha256": {
                              "type": "string"
                            },
                            "captured_at": {
                              "type": "string",
                              "minLength": 1
                            },
                            "retrieved_at": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "observation_time": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "observed_at",
                            "recorded_at"
                          ],
                          "properties": {
                            "observed_at": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "recorded_at": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "rights": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "state",
                            "permitted_uses",
                            "rights_evidence_ref"
                          ],
                          "properties": {
                            "state": {
                              "enum": [
                                "verified",
                                "restricted",
                                "unknown",
                                "not_applicable"
                              ]
                            },
                            "permitted_uses": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "rights_evidence_ref": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          }
                        },
                        "attestation": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "statement_ref",
                            "key_id",
                            "trust_evaluation"
                          ],
                          "properties": {
                            "statement_ref": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "key_id": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "trust_evaluation": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "descriptor_binding": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "record_key",
                        "case_id",
                        "case_representation_sha256",
                        "catalog_id",
                        "catalog_representation_sha256",
                        "owner_namespace",
                        "owner_receipt_id",
                        "source_revision",
                        "subject_id",
                        "schema_artifact_digest",
                        "schema_id",
                        "schema_version",
                        "owner_contract_id",
                        "owner_contract_version"
                      ],
                      "properties": {
                        "record_key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "case_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "case_representation_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "catalog_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "catalog_representation_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        },
                        "owner_namespace": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_receipt_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source_revision": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        "subject_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "schema_artifact_digest": {
                          "type": "string",
                          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                        },
                        "schema_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "schema_version": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_contract_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "owner_contract_version": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              "report_binding": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "report_reference",
                  "declared_report_sha256",
                  "expected_case_id",
                  "expected_case_representation_sha256",
                  "expected_catalog_id",
                  "expected_catalog_representation_sha256",
                  "raw_report_json"
                ],
                "properties": {
                  "report_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "declared_report_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "expected_case_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_case_representation_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "expected_catalog_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_catalog_representation_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "raw_report_json": {
                    "type": "string",
                    "minLength": 2
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "report_integrity_state",
              "report_disposition_state",
              "payload_verification_state",
              "artifact_payloads"
            ],
            "properties": {
              "report_integrity_state": {
                "enum": [
                  "verified",
                  "mismatch",
                  "unsupported"
                ]
              },
              "payload_verification_state": {
                "enum": [
                  "verified",
                  "mismatch",
                  "unavailable",
                  "indeterminate",
                  "unsupported"
                ]
              },
              "artifact_payloads": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "artifact_id",
                    "scope_binding_state",
                    "raw_owner_disposition",
                    "payload_verification_state",
                    "payload_bytes_verified",
                    "raw_byte_equality_verified",
                    "byte_length_comparison_state",
                    "owner_rights_state",
                    "rights_use_declaration_state"
                  ],
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope_binding_state": {
                      "enum": [
                        "Bound",
                        "Unknown",
                        "NotComparable",
                        "Unsupported"
                      ]
                    },
                    "raw_owner_disposition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload_verification_state": {
                      "enum": [
                        "verified",
                        "mismatch",
                        "unavailable",
                        "indeterminate",
                        "unsupported",
                        "not_required"
                      ]
                    },
                    "payload_bytes_verified": {
                      "type": "boolean"
                    },
                    "raw_byte_equality_verified": {
                      "type": "boolean"
                    },
                    "owner_rights_state": {
                      "enum": [
                        "verified",
                        "restricted",
                        "unknown",
                        "not_applicable"
                      ]
                    },
                    "rights_use_declaration_state": {
                      "enum": [
                        "owner_declares_permitted",
                        "owner_declares_restricted",
                        "unknown_or_not_authenticated",
                        "not_applicable"
                      ]
                    },
                    "byte_length_comparison_state": {
                      "enum": [
                        "matched",
                        "mismatch",
                        "not_declared",
                        "not_verified",
                        "not_available",
                        "not_assessed",
                        "not_required"
                      ]
                    }
                  }
                }
              },
              "report_disposition_state": {
                "enum": [
                  "complete",
                  "incomplete",
                  "invalid_input",
                  "unsupported"
                ]
              }
            }
          }
        }
      }
    }
  }
}
