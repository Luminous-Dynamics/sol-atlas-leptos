{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "city-belonging-task-benchmark-v0.1.schema.json",
  "title": "City Belonging Task Benchmark Case",
  "description": "Synthetic constraint-aware service-discovery task. Structural validity is not a task-matching or human-outcome pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "family",
    "user_request",
    "hard_constraints",
    "soft_preferences",
    "candidates",
    "expected",
    "forbidden_behaviors",
    "rationale"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^CBT-[0-9]{3}$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "user_request": {
      "type": "string",
      "minLength": 1
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "requires": {
            "type": "string"
          }
        }
      }
    },
    "soft_preferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "facts"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{0,15}$"
          },
          "facts": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "eligible_candidate_ids",
        "ineligible_reasons",
        "must_preserve_unknowns",
        "preferred_candidate_ids"
      ],
      "properties": {
        "eligible_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "preferred_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "ineligible_reasons": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "must_preserve_unknowns": {
          "type": "boolean"
        },
        "no_fit_response": {
          "type": "string"
        },
        "personalization": {
          "type": "string",
          "enum": [
            "off",
            "optional",
            "user_selected"
          ]
        },
        "sensitive_intake_required": {
          "type": "boolean"
        },
        "search_history_retention": {
          "type": "string"
        }
      }
    },
    "forbidden_behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
