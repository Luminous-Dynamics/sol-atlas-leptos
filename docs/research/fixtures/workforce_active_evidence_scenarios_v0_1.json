{
  "fixture_notice": "ALL VALUES ARE SYNTHETIC CONTRACT TEST DATA. They are not measured workforce data, local prices, real workers, observed outcomes or probabilities.",
  "schema_version": "0.1.0",
  "benchmark_id": "SA-WORKFORCE-ACTIVE-EVIDENCE-001",
  "synthetic_only": true,
  "claim_ceiling": "Synthetic acquisition-policy contract only; no field or SOTA effectiveness claim.",
  "units": {
    "cash_currency": "ZAR cents",
    "staff_effort": "person-minutes",
    "elapsed_delay": "hours"
  },
  "scenarios": [
    {
      "id": "AE-001",
      "description": "Trade off cash expenditure against staff time and delay when separating funding, spare-part and skill-capacity hypotheses.",
      "hypotheses": [
        {
          "id": "H_FUND",
          "description": "No approved payer or budget is evidenced.",
          "decision_class": "HOLD_ESTABLISH_FUNDING"
        },
        {
          "id": "H_TOOLS",
          "description": "A critical compatible spare is missing.",
          "decision_class": "HOLD_RESOLVE_PART"
        },
        {
          "id": "H_SKILL",
          "description": "Task-ready capacity is below the requirement.",
          "decision_class": "HOLD_SCOPE_CAPACITY_PATHWAY"
        }
      ],
      "queries": [
        {
          "id": "Q_PAYER",
          "description": "Verify approved payer/budget record in the authorized work context.",
          "permitted": true,
          "access_basis": "employer_authorized",
          "cost": {
            "staff_minutes": 20,
            "cash_zar_cents": 0,
            "delay_hours": 1
          },
          "outcomes": [
            {
              "outcome_id": "PAYER_ABSENT",
              "kind": "observed",
              "compatible_hypotheses": [
                "H_FUND"
              ]
            },
            {
              "outcome_id": "PAYER_CONFIRMED",
              "kind": "observed",
              "compatible_hypotheses": [
                "H_TOOLS",
                "H_SKILL"
              ]
            },
            {
              "outcome_id": "PAYER_RECORD_UNCLEAR",
              "kind": "unknown_or_unmodelled",
              "compatible_hypotheses": [
                "H_FUND",
                "H_TOOLS",
                "H_SKILL"
              ]
            }
          ]
        },
        {
          "id": "Q_SPARES",
          "description": "Check exact-model compatible spare inventory against an authorized inventory record.",
          "permitted": true,
          "access_basis": "employer_authorized",
          "cost": {
            "staff_minutes": 10,
            "cash_zar_cents": 5000,
            "delay_hours": 0
          },
          "outcomes": [
            {
              "outcome_id": "SPARE_MISSING",
              "kind": "observed",
              "compatible_hypotheses": [
                "H_TOOLS"
              ]
            },
            {
              "outcome_id": "SPARE_AVAILABLE",
              "kind": "observed",
              "compatible_hypotheses": [
                "H_FUND",
                "H_SKILL"
              ]
            },
            {
              "outcome_id": "INVENTORY_UNCLEAR",
              "kind": "unknown_or_unmodelled",
              "compatible_hypotheses": [
                "H_FUND",
                "H_TOOLS",
                "H_SKILL"
              ]
            }
          ]
        },
        {
          "id": "Q_CAPACITY",
          "description": "Run a scoped task-ready capacity assessment with appropriate human authorization.",
          "permitted": true,
          "access_basis": "worker_consent",
          "cost": {
            "staff_minutes": 50,
            "cash_zar_cents": 0,
            "delay_hours": 8
          },
          "outcomes": [
            {
              "outcome_id": "CAPACITY_GAP",
              "kind": "observed",
              "compatible_hypotheses": [
                "H_SKILL"
              ]
            },
            {
              "outcome_id": "CAPACITY_SUFFICIENT",
              "kind": "observed",
              "compatible_hypotheses": [
                "H_FUND",
                "H_TOOLS"
              ]
            },
            {
              "outcome_id": "ASSESSMENT_UNCLEAR",
              "kind": "unknown_or_unmodelled",
              "compatible_hypotheses": [
                "H_FUND",
                "H_TOOLS",
                "H_SKILL"
              ]
            }
          ]
        }
      ],
      "budget": {
        "staff_minutes": 100,
        "cash_zar_cents": 6000,
        "delay_hours": 12
      },
      "expected_status": "decision_resolved",
      "expected_remaining_hypotheses": [
        "H_FUND",
        "H_TOOLS",
        "H_SKILL"
      ],
      "hand_reference_frontier": [
        {
          "reference_id": "PLAN_LOW_STAFF_FAST",
          "cost": {
            "staff_minutes": 30,
            "cash_zar_cents": 5000,
            "delay_hours": 1
          },
          "policy_outline": [
            "Ask Q_SPARES first.",
            "If SPARE_MISSING, stop with HOLD_RESOLVE_PART.",
            "If SPARE_AVAILABLE, ask Q_PAYER; PAYER_ABSENT resolves H_FUND, and PAYER_CONFIRMED resolves H_SKILL within the remaining set."
          ]
        },
        {
          "reference_id": "PLAN_NO_CASH_HIGHER_STAFF",
          "cost": {
            "staff_minutes": 70,
            "cash_zar_cents": 0,
            "delay_hours": 9
          },
          "policy_outline": [
            "Ask Q_PAYER first.",
            "If PAYER_ABSENT, resolve H_FUND.",
            "If PAYER_CONFIRMED, ask Q_CAPACITY; CAPACITY_GAP resolves H_SKILL and CAPACITY_SUFFICIENT resolves H_TOOLS within the remaining set."
          ]
        }
      ],
      "notes": [
        "The listed vectors are hand-calculated reference policies, not results from a production solver.",
        "The two vectors are incomparable: one uses less staff/time; the other avoids cash spending.",
        "Unknown outcomes preserve all hypotheses and must trigger hold/revalidation rather than false certainty."
      ]
    },
    {
      "id": "AE-002",
      "description": "Stop when remaining hypotheses imply the same safe operational decision, even if the underlying root cause remains uncertain.",
      "hypotheses": [
        {
          "id": "H_FUND_UNKNOWN",
          "description": "Payer record has not yet been verified.",
          "decision_class": "HOLD_AND_REVALIDATE"
        },
        {
          "id": "H_DEMAND_STALE",
          "description": "Demand record may be stale and needs revalidation.",
          "decision_class": "HOLD_AND_REVALIDATE"
        }
      ],
      "queries": [
        {
          "id": "Q_DISTINGUISH_CAUSE",
          "description": "Optional permitted audit that could distinguish which uncertainty caused the hold.",
          "permitted": true,
