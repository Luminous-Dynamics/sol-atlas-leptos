      "expected_status": "stop_same_decision_class",
      "expected_remaining_hypotheses": [
        "H_FUND_UNKNOWN",
        "H_DEMAND_STALE"
      ],
      "hand_reference_frontier": [],
      "notes": [
        "The correct policy makes zero queries: both hypotheses imply HOLD_AND_REVALIDATE.",
        "Do not spend data or staff effort to identify an immaterial difference."
      ]
    },
    {
