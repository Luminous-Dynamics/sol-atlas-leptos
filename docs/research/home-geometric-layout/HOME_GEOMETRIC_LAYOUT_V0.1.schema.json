{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/home-geometric-layout/HOME_GEOMETRIC_LAYOUT_V0.1.schema.json",
  "title": "Home geometric layout qualification fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "maturity", "execution_status", "coordinate_system", "buildable_envelope", "layout_candidates", "comparison_policy", "claim_ceiling"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "study_id": { "const": "HOME-GEOMETRIC-LAYOUT-SYNTHETIC-001" },
    "maturity": { "const": "SYNTHETIC" },
    "execution_status": { "const": "SYNTHETIC_FIXTURE_NOT_FIELD_EVALUATED" },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "origin", "x_axis", "y_axis", "integer_grid_mm"],
      "properties": {
        "unit": { "const": "MILLIMETRE" },
        "origin": { "const": "BUILDABLE_ENVELOPE_SOUTH_WEST" },
        "x_axis": { "const": "EAST" },
        "y_axis": { "const": "NORTH" },
        "integer_grid_mm": { "const": 1 }
      }
    },
    "buildable_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "width_mm", "height_mm", "state"],
      "properties": {
        "geometry": { "const": "AXIS_ALIGNED_RECTANGLE" },
        "width_mm": { "type": "integer", "minimum": 1 },
        "height_mm": { "type": "integer", "minimum": 1 },
        "state": { "const": "SYNTHETIC_ENVELOPE_NOT_SURVEYED_OR_AUTHORITY_CONFIRMED" }
      }
    },
    "layout_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "source_graph_candidate_id", "geometry_state", "physical_verification_state", "rooms", "openings", "access_routes"],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "source_graph_candidate_id": { "type": "string", "minLength": 1 },
          "geometry_state": { "const": "SYNTHETIC_GEOMETRY_NOT_BUILDABLE" },
          "physical_verification_state": { "const": "UNKNOWN" },
          "rooms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["space_id", "space_type", "floor_index", "x_mm", "y_mm", "width_mm", "height_mm"],
              "properties": {
                "space_id": { "type": "string", "minLength": 1 },
                "space_type": { "enum": ["INDOOR", "OUTDOOR"] },
                "floor_index": { "const": 0 },
                "x_mm": { "type": "integer", "minimum": 0 },
                "y_mm": { "type": "integer", "minimum": 0 },
                "width_mm": { "type": "integer", "minimum": 1 },
                "height_mm": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["opening_id", "from_space_id", "to_space_id", "axis", "coordinate_mm", "span_start_mm", "span_end_mm"],
              "properties": {
                "opening_id": { "type": "string", "minLength": 1 },
                "from_space_id": { "type": "string", "minLength": 1 },
                "to_space_id": { "type": "string", "minLength": 1 },
                "axis": { "enum": ["HORIZONTAL", "VERTICAL"] },
                "coordinate_mm": { "type": "integer", "minimum": 0 },
                "span_start_mm": { "type": "integer", "minimum": 0 },
                "span_end_mm": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "access_routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["route_id", "from_space_id", "to_space_id"],
              "properties": {
                "route_id": { "type": "string", "minLength": 1 },
                "from_space_id": { "type": "string", "minLength": 1 },
                "to_space_id": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "comparison_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranking_state", "scalar_score", "resident_choice_required"],
      "properties": {
        "ranking_state": { "const": "UNRANKED" },
        "scalar_score": { "type": "null" },
        "resident_choice_required": { "const": true }
      }
    },
    "claim_ceiling": { "const": "Synthetic 2D orthogonal geometry consistency only. No site, code, professional, physical performance, cost, buildability or approval claim." }
  }
}