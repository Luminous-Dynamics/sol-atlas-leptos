{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home DfMA delivery benchmark manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "maturity",
    "execution_status",
    "region_profile",
    "functional_unit",
    "delivery_modes",
    "scenario_families",
    "hard_gates",
    "metrics",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "const": "HOME-DfMA-DELIVERY-001"
    },
    "maturity": {
      "const": "PROPOSED_NOT_EVALUATED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "region_profile": {
      "type": "string"
    },
    "functional_unit": {
      "type": "string"
    },
    "delivery_modes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          }
        }
      }
    },
    "scenario_families": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mutation",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mutation": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "hard_gates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "meaning"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "target": {
            "type": "number"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "unit",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "MINIMIZE",
              "MAXIMIZE",
              "REPORT"
            ]
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string"
    }
  }
}
