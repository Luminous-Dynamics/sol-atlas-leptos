{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/megastructure-design-context-cases-v0.1.schema.json",
  "title": "Synthetic Megastructure Design Context Cases v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "claim_class",
    "projection_policy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "suite_id": {
      "const": "MEGASTRUCTURE-DESIGN-CONTEXT-SYNTHETIC-001"
    },
    "claim_class": {
      "const": "SYNTHETIC_DATA_QUALITY_ONLY"
    },
    "projection_policy": {
      "const": "READ_ONLY_NO_APPROVAL_AUTHORITY"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "design_generation",
        "geometry_digest",
        "coordinate_system",
        "epoch"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "design_generation": {
          "type": "string",
          "minLength": 1
        },
        "geometry_digest": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_system": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "epoch",
        "resolution_m",
        "scenario"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "resolution_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scenario": {
          "type": "string"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_generation",
        "geometry_digest",
        "source_health",
        "feature_state",
        "data_class",
        "license"
      ],
      "properties": {
        "design_generation": {
          "type": "string",
          "minLength": 1
        },
        "geometry_digest": {
          "type": "string",
          "minLength": 1
        },
        "source_health": {
          "enum": [
            "loaded",
            "partially_loaded",
            "valid_empty",
            "unavailable",
            "stale",
            "malformed",
            "rejected"
          ]
        },
        "feature_state": {
          "type": "string",
          "minLength": 1
        },
        "data_class": {
          "enum": [
            "observed",
            "measured",
            "administrative",
            "modelled",
            "inferred",
            "proposed",
            "synthetic",
            "unknown"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "positional_uncertainty_m": {
          "type": "number",
          "minimum": 0
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "access_class": {
          "enum": [
            "public",
            "restricted_personal_or_community_sensitive",
            "internal_only",
            "unknown"
          ]
        },
        "render_view_includes_layer": {
          "type": "boolean"
        },
        "frame_id": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "ephemeris_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "publisher_authority": {
          "type": "string"
        },
        "source_identity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "candidate",
        "projection",
        "expected_disposition",
        "expected_reason_codes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "expected_disposition": {
          "enum": [
            "reject_or_mark_stale",
            "retain_uncertainty_and_require_review",
            "unknown_not_no_impact",
            "show_conflict_without_silent_precedence",
            "restrict_from_public_projection",
            "review_pack_incomplete",
            "reject_as_physical_orbital_context",
            "reject_claim_promotion"
          ]
        },
        "expected_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        }
      }
    }
  }
}
