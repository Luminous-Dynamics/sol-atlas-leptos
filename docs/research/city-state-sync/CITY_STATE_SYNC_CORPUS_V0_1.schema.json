{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/city-state-sync-corpus-v0.1.schema.json",
  "title": "CityMaker State Synchronization Synthetic Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "schema_version",
    "classification",
    "temporal_semantics",
    "cases"
  ],
  "properties": {
    "corpus_id": {
      "const": "CITY-STATE-SYNC-CORPUS-V0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "classification": {
      "const": "synthetic_fixture_only"
    },
    "temporal_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_basis",
        "as_of_dimensions",
        "ordering_authority",
        "validity_interval",
        "freshness_authority"
      ],
      "properties": {
        "time_basis": {
          "const": "UTC_UNIX_SECONDS"
        },
        "as_of_dimensions": {
          "const": [
            "valid_at",
            "recorded_at",
            "ingested_at"
          ]
        },
        "ordering_authority": {
          "const": "owner_sequence_within_owner_and_subject"
        },
        "validity_interval": {
          "const": "half_open_[valid_from,valid_until)"
        },
        "freshness_authority": {
          "const": "owner_declared_policy_only"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 36,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "description",
        "input",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^CS-[0-9]{3}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "expected": {
          "type": "object"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "freshness_policies",
        "owner_health",
        "required_subjects",
        "events",
        "intervention_stages",
        "identity_links"
      ],
      "properties": {
        "as_of": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid_at",
            "recorded_at",
            "ingested_at"
          ],
          "properties": {
            "valid_at": {
              "type": "integer"
            },
            "recorded_at": {
              "type": "integer"
            },
            "ingested_at": {
              "type": "integer"
            }
          }
        },
        "freshness_policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          }
        },
        "owner_health": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner_repo",
              "state"
            ],
            "properties": {
              "owner_repo": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "available",
                  "partial_outage",
                  "unknown"
                ]
              }
            }
          }
        },
        "required_subjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subject"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "intervention_stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intervention_stage"
          }
        },
        "identity_links": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "owner_repo",
        "contract_id",
        "contract_version",
        "expected_refresh_seconds",
        "max_observation_age_seconds",
        "max_record_delay_seconds",
        "max_ingest_lag_seconds",
        "max_clock_uncertainty_ms"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "owner_repo": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "expected_refresh_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_observation_age_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_record_delay_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_ingest_lag_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_clock_uncertainty_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repo",
        "subject_id",
        "subject_digest",
        "scope_digest",
        "contract_id",
        "contract_version"
      ],
      "properties": {
        "owner_repo": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/hash"
        },
        "scope_digest": {
          "$ref": "#/$defs/hash"
        },
        "contract_id": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "receipt_id",
        "owner_repo",
        "contract_id",
        "contract_version",
        "source_revision",
        "schema_sha256",
        "content_sha256",
        "subject_id",
        "subject_digest",
        "scope_digest",
        "owner_sequence",
        "event_kind",
        "target_event_id",
        "target_subject_id",
        "owner_state",
        "evidence_state",
        "valid_from",
        "valid_until",
        "observed_at",
        "recorded_at",
        "ingested_at",
        "time_basis",
        "timezone",
        "clock_id",
        "clock_uncertainty_ms",
        "freshness_policy_id"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "receipt_id": {
          "type": "string"
        },
        "owner_repo": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "schema_sha256": {
          "$ref": "#/$defs/hash"
        },
        "content_sha256": {
          "$ref": "#/$defs/hash"
        },
        "subject_id": {
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/hash"
        },
        "scope_digest": {
          "$ref": "#/$defs/hash"
        },
        "owner_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_kind": {
          "enum": [
            "assertion",
            "supersede",
            "correction",
            "revoke",
            "dispute",
            "identity_successor"
          ]
        },
        "target_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_state": {
          "type": "string"
        },
        "evidence_state": {
          "enum": [
            "admitted",
            "pending",
            "unknown",
            "revoked"
          ]
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": [
            "integer",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "recorded_at": {
          "type": "integer"
        },
        "ingested_at": {
          "type": "integer"
        },
        "time_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "clock_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "clock_uncertainty_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "freshness_policy_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "geometry_digest": {
          "type": "string"
        },
        "target_subject_digest": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "intervention_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "intervention_id",
        "stage",
        "predecessor_event_id",
        "owner_repo",
        "scope_digest",
        "horizon_id",
        "recorded_at",
        "ingested_at",
        "disposition",
        "occurred_at"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "intervention_id": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "proposal",
            "approval",
            "execution",
            "inspection",
            "outcome"
          ]
        },
        "predecessor_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner_repo": {
          "type": "string"
        },
        "scope_digest": {
          "$ref": "#/$defs/hash"
        },
        "horizon_id": {
          "type": "string"
        },
        "recorded_at": {
          "type": "integer"
        },
        "ingested_at": {
          "type": "integer"
        },
        "disposition": {
          "type": "string"
        },
        "occurred_at": {
          "type": "integer"
        }
      }
    }
  }
}
