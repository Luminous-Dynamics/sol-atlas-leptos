{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/gmd-service-continuity/GMD_SERVICE_CONTINUITY_RESULT_V0.1.schema.json",
  "title": "GMD Essential-Service Continuity Result v0.1",
  "description": "Per-service continuity and sustained-recovery result. Native units remain separate; no cross-service aggregate score is represented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "horizon_seconds", "dependency_graph_ref", "dependency_graph_sha256", "services"],
  "properties": {
    "scenario_id": { "type": "string", "minLength": 1 },
    "horizon_seconds": { "type": "integer", "minimum": 1 },
    "dependency_graph_ref": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "dependency_graph_sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/serviceMetrics" }
    }
  },
  "$defs": {
    "recoveryMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["began_after_seconds", "confirmed_after_seconds"],
      "properties": {
        "began_after_seconds": { "type": "integer", "minimum": 0 },
        "confirmed_after_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "serviceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id", "owner_ref", "geographic_scope_ref", "quantity_unit",
        "asset_revision", "source_ref", "source_sha256", "evidence_class",
        "horizon_seconds", "maximum_interval_seconds", "initially_above_service_floor",
        "initially_fully_served", "total_required_quantity", "total_delivered_quantity_capped",
        "total_surplus_quantity_excluded", "total_unserved_quantity", "demand_observed_seconds",
        "demand_weighted_served_fraction", "floor_time_availability_fraction",
        "total_floor_violation_seconds", "longest_floor_violation_seconds",
        "floor_violation_episode_count", "maximum_interval_deficit_fraction",
        "first_floor_violation_after_seconds", "floor_recovery", "full_service_recovery"
      ],
      "properties": {
        "service_id": { "type": "string", "minLength": 1 },
        "owner_ref": { "type": "string", "minLength": 1 },
        "geographic_scope_ref": { "type": "string", "minLength": 1 },
        "quantity_unit": { "type": "string", "minLength": 1 },
        "asset_revision": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence_class": {
          "type": "string",
          "enum": ["Measured", "PublishedDerived", "Modelled", "Inferred", "Simulated"]
        },
        "horizon_seconds": { "type": "integer", "minimum": 1 },
        "maximum_interval_seconds": { "type": "integer", "minimum": 1 },
        "initially_above_service_floor": { "type": "boolean" },
        "initially_fully_served": { "type": "boolean" },
        "total_required_quantity": { "type": "number", "exclusiveMinimum": 0 },
        "total_delivered_quantity_capped": { "type": "number", "minimum": 0 },
        "total_surplus_quantity_excluded": { "type": "number", "minimum": 0 },
        "total_unserved_quantity": { "type": "number", "minimum": 0 },
        "demand_observed_seconds": { "type": "integer", "minimum": 1 },
        "demand_weighted_served_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "floor_time_availability_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "total_floor_violation_seconds": { "type": "integer", "minimum": 0 },
        "longest_floor_violation_seconds": { "type": "integer", "minimum": 0 },
        "floor_violation_episode_count": { "type": "integer", "minimum": 0 },
        "maximum_interval_deficit_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "first_floor_violation_after_seconds": {
          "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "floor_recovery": {
          "oneOf": [{ "$ref": "#/$defs/recoveryMark" }, { "type": "null" }]
        },
        "full_service_recovery": {
          "oneOf": [{ "$ref": "#/$defs/recoveryMark" }, { "type": "null" }]
        }
      }
    }
  }
}
