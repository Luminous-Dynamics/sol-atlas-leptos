{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-refuge-network-case-v0.1.schema.json",
  "title": "Highveld aggregate refuge capacity and common-cause input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "case_id",
    "maturity",
    "execution_status",
    "network_state",
    "local_directory_state",
    "safe_water_l_per_place",
    "maximum_route_travel_time_s",
    "active_failure_domains",
    "demand_zones",
    "sites"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-REFUGE-NETWORK-001"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "SYNTHETIC_KNOWN_ANSWER"
    },
    "execution_status": {
      "const": "NO_SITE_OR_ROUTE_VALIDATION"
    },
    "network_state": {
      "enum": [
        "CONNECTED",
        "PARTITIONED",
        "UNKNOWN"
      ]
    },
    "local_directory_state": {
      "enum": [
        "QUALIFIED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "safe_water_l_per_place": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximum_route_travel_time_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "active_failure_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "demand_zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "total_places",
          "accessible_places",
          "route_options"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "minLength": 1
          },
          "total_places": {
            "type": "integer",
            "minimum": 1
          },
          "accessible_places": {
            "type": "integer",
            "minimum": 0
          },
          "route_options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "site_id",
                "route_state",
                "accessibility_state",
                "travel_time_s",
                "evidence_ref"
              ],
              "properties": {
                "site_id": {
                  "type": "string",
                  "minLength": 1
                },
                "route_state": {
                  "enum": [
                    "REACHABLE",
                    "BLOCKED",
                    "UNKNOWN"
                  ]
                },
                "accessibility_state": {
                  "enum": [
                    "QUALIFIED",
                    "FAILED",
                    "UNKNOWN"
                  ]
                },
                "travel_time_s": {
                  "type": "number",
                  "minimum": 0
                },
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id",
          "operating_state",
          "thermal_service_state",
          "ventilation_state",
          "safe_water_rights_state",
          "safe_water_quality_state",
          "staffing_state",
          "total_capacity",
          "current_occupancy",
          "committed_reserve",
          "accessible_capacity",
          "accessible_occupancy",
          "accessible_committed_reserve",
          "safe_water_available_l",
          "safe_water_committed_l",
          "safe_water_protected_reserve_l",
          "failure_domains",
          "site_evidence_ref",
          "capacity_evidence_ref",
          "water_evidence_ref",
          "service_evidence_ref"
        ],
        "properties": {
          "site_id": {
            "type": "string",
            "minLength": 1
          },
          "operating_state": {
            "enum": [
              "QUALIFIED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "thermal_service_state": {
            "enum": [
              "QUALIFIED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "ventilation_state": {
            "enum": [
              "QUALIFIED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "safe_water_rights_state": {
            "enum": [
              "QUALIFIED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "safe_water_quality_state": {
            "enum": [
              "QUALIFIED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "staffing_state": {
            "enum": [
              "QUALIFIED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "total_capacity": {
            "type": "integer",
            "minimum": 0
          },
          "current_occupancy": {
            "type": "integer",
            "minimum": 0
          },
          "committed_reserve": {
            "type": "integer",
            "minimum": 0
          },
          "accessible_capacity": {
            "type": "integer",
            "minimum": 0
          },
          "accessible_occupancy": {
            "type": "integer",
            "minimum": 0
          },
          "accessible_committed_reserve": {
            "type": "integer",
            "minimum": 0
          },
          "safe_water_available_l": {
            "type": "number",
            "minimum": 0
          },
          "safe_water_committed_l": {
            "type": "number",
            "minimum": 0
          },
          "safe_water_protected_reserve_l": {
            "type": "number",
            "minimum": 0
          },
          "failure_domains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "site_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "capacity_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "water_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "service_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
