              "max_valid_age_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_age_policy_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "capacity_freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_event_id",
              "age_elapsed_s",
              "max_valid_age_s",
              "max_age_policy_ref"
            ],
            "properties": {
              "source_event_id": {
                "type": "string",
                "minLength": 1
              },
              "age_elapsed_s": {
                "type": "number",
                "minimum": 0
              },
              "max_valid_age_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_age_policy_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "service_freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_event_id",
              "age_elapsed_s",
              "max_valid_age_s",
              "max_age_policy_ref"
            ],
