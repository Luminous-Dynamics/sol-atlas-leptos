              "source_event_id": {
                "type": "string",
                "minLength": 1
              },
              "age_elapsed_s": {
                "type": "number",
                "minimum": 0
              },
              "max_valid_age_s": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_age_policy_ref": {
                "type": "string",
                "minLength": 1
              }
            }
