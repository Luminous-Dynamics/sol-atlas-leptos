{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-energyplus-water-interface-map-v0.1.schema.json",
  "title": "Highveld EnergyPlus thermal water interface map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "model_engine",
    "model_engine_version",
    "maturity",
    "object_bindings",
    "outdoor_feature_boundary",
    "governance_owners",
    "execution_status"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-PASSIVE-COOLING-WATER-001"
    },
    "model_engine": {
      "const": "EnergyPlus"
    },
    "model_engine_version": {
      "const": "26.2.0"
    },
    "maturity": {
      "const": "INTERFACE_MAP_NOT_EXECUTED"
    },
    "object_bindings": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "role",
          "use_when",
          "do_not_infer",
          "external_validation_required"
        ],
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "use_when": {
            "type": "string",
            "minLength": 1
          },
          "do_not_infer": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "external_validation_required": {
            "const": true
          }
        }
      }
    },
    "outdoor_feature_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dedicated_swimmingpool_outdoor_object_found_in_inspected_v26_2_index",
        "interpretation",
        "required_external_model",
        "coupling_requirements"
      ],
      "properties": {
        "dedicated_swimmingpool_outdoor_object_found_in_inspected_v26_2_index": {
          "const": false
        },
        "interpretation": {
          "const": "SCOPED_DOCUMENTATION_OBSERVATION_NOT_ABSOLUTE_CAPABILITY_CLAIM"
        },
        "required_external_model": {
          "type": "string"
        },
        "coupling_requirements": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "governance_owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "events_and_trajectories",
        "rights_water_quality_and_instruments",
        "building_physics",
        "outdoor_airflow_and_surface_physics"
      ],
      "properties": {
        "geometry": {
          "const": "SOL_ATLAS"
        },
        "events_and_trajectories": {
          "const": "SYMTROPY"
        },
        "rights_water_quality_and_instruments": {
          "const": "MYCELIX"
        },
        "building_physics": {
          "const": "ENERGYPLUS"
        },
        "outdoor_airflow_and_surface_physics": {
          "type": "string"
        }
      }
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    }
  }
}
