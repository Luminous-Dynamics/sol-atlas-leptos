{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-refuge-network-flow-v0.1.schema.json",
  "title": "Highveld refuge network-flow feasibility case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "case_id",
    "maturity",
    "execution_status",
    "policy",
    "safe_water_l_per_place",
    "required_duration_h",
    "maximum_route_travel_time_s",
    "evidence_bundle_ref",
    "independent_oracle_ref",
    "demand_groups",
    "sites"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-REFUGE-NETWORK-FLOW-001"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "SYNTHETIC_KNOWN_ANSWER"
    },
    "execution_status": {
      "const": "NO_SITE_OR_ROUTE_VALIDATION"
    },
    "policy": {
      "const": "ACCESSIBLE_DEMAND_FIRST_THEN_GENERAL_MAX_FLOW"
    },
    "safe_water_l_per_place": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "required_duration_h": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximum_route_travel_time_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "evidence_bundle_ref": {
      "type": "string",
      "minLength": 1
    },
    "independent_oracle_ref": {
      "type": "string",
      "minLength": 1
    },
    "demand_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "total_places",
          "accessible_places",
          "routes"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "total_places": {
            "type": "integer",
            "minimum": 1
          },
          "accessible_places": {
            "type": "integer",
            "minimum": 0
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "site_id",
                "route_state",
                "accessibility_state",
                "travel_time_s",
                "route_evidence_ref",
                "accessibility_evidence_ref"
              ],
              "properties": {
                "site_id": {
                  "type": "string",
                  "minLength": 1
                },
                "route_state": {
                  "enum": [
                    "REACHABLE",
                    "BLOCKED",
                    "UNKNOWN"
                  ]
                },
                "accessibility_state": {
                  "enum": [
                    "ACCESSIBLE",
                    "NOT_ACCESSIBLE",
                    "UNKNOWN"
                  ]
                },
                "travel_time_s": {
                  "type": "number",
                  "minimum": 0
                },
                "route_evidence_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "accessibility_evidence_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id",
          "eligibility_state",
          "free_total_capacity",
          "free_accessible_capacity",
          "free_safe_water_l",
          "eligibility_receipt_ref",
          "capacity_evidence_ref",
          "water_evidence_ref"
        ],
        "properties": {
          "site_id": {
            "type": "string",
            "minLength": 1
          },
          "eligibility_state": {
            "enum": [
              "ELIGIBLE_FOR_HUMAN_CAPACITY_PLANNING",
              "UNAVAILABLE_OR_UNVERIFIED",
              "UNKNOWN"
            ]
          },
          "free_total_capacity": {
            "type": "integer",
            "minimum": 0
          },
          "free_accessible_capacity": {
            "type": "integer",
            "minimum": 0
          },
          "free_safe_water_l": {
            "type": "number",
            "minimum": 0
          },
          "eligibility_receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "capacity_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "water_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
