{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-refuge-supply-demand-degradation-v0.1.schema.json",
  "title": "Highveld refuge service supply-demand degradation sequence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "case_id",
    "maturity",
    "execution_status",
    "time_order_source",
    "time_slices"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-REFUGE-SUPPLY-DEMAND-DEGRADATION-001"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "SYNTHETIC_KNOWN_ANSWER"
    },
    "execution_status": {
      "const": "NO_NATIVE_EVENT_TIME_OR_SITE_VALIDATION"
    },
    "time_order_source": {
      "type": "string",
      "minLength": 1
    },
    "time_slices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timepoint_id",
          "scenario_id",
          "duration_h",
          "snapshot"
        ],
        "properties": {
          "timepoint_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "duration_h": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "snapshot": {
            "type": "object",
            "required": [
              "network_state",
              "local_refuge_directory_state",
              "safe_water_l_per_place",
              "cohorts",
              "sites",
              "routes"
            ],
            "properties": {
              "network_state": {
                "enum": [
                  "CONNECTED",
                  "PARTITIONED",
                  "UNKNOWN"
                ]
              },
              "local_refuge_directory_state": {
                "enum": [
                  "QUALIFIED",
                  "FAILED",
                  "UNKNOWN"
                ]
              },
              "safe_water_l_per_place": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "cohorts": {
                "type": "array",
                "minItems": 1
              },
              "sites": {
                "type": "array",
                "minItems": 1
              },
              "routes": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    }
  }
}
