{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-refuge-allocation-audit-v0.1.schema.json",
  "title": "Highveld shared refuge capacity audit input v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "case_id",
    "maturity",
    "execution_status",
    "sites",
    "demand_areas"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-REFUGE-ALLOCATION-AUDIT-001"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "const": "SYNTHETIC_KNOWN_ANSWER"
    },
    "execution_status": {
      "const": "NO_ALLOCATION_OR_BOOKING"
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "site_id",
          "availability_state",
          "free_total_places",
          "free_accessible_places",
          "free_safe_water_l",
          "site_evidence_ref",
          "capacity_evidence_ref",
          "water_evidence_ref"
        ],
        "properties": {
          "site_id": {
            "type": "string",
            "minLength": 1
          },
          "availability_state": {
            "enum": [
              "ELIGIBLE_FOR_HUMAN_CAPACITY_PLANNING",
              "UNAVAILABLE_OR_UNVERIFIED"
            ]
          },
          "free_total_places": {
            "type": "integer",
            "minimum": 0
          },
          "free_accessible_places": {
            "type": "integer",
            "minimum": 0
          },
          "free_safe_water_l": {
            "type": "number",
            "minimum": 0
          },
          "site_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "capacity_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "water_evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "demand_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "requested_total_places",
          "requested_accessible_places",
          "requested_safe_water_l",
          "allocations"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1
          },
          "requested_total_places": {
            "type": "integer",
            "minimum": 1
          },
          "requested_accessible_places": {
            "type": "integer",
            "minimum": 0
          },
          "requested_safe_water_l": {
            "type": "number",
            "minimum": 0
          },
          "allocations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "site_id",
                "total_places",
                "accessible_places",
                "safe_water_l",
                "route_state",
                "route_accessibility_state",
                "route_evidence_ref"
              ],
              "properties": {
                "site_id": {
                  "type": "string",
                  "minLength": 1
                },
                "total_places": {
                  "type": "integer",
                  "minimum": 0
                },
                "accessible_places": {
                  "type": "integer",
                  "minimum": 0
                },
                "safe_water_l": {
                  "type": "number",
                  "minimum": 0
                },
                "route_state": {
                  "enum": [
                    "REACHABLE",
                    "BLOCKED",
                    "UNKNOWN"
                  ]
                },
                "route_accessibility_state": {
                  "enum": [
                    "QUALIFIED",
                    "FAILED",
                    "UNKNOWN"
                  ]
                },
                "route_evidence_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
