{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-topology-removal-study-v0.1.schema.json",
  "title": "Highveld topology-removal study manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "parent_candidate",
    "maturity",
    "pr_736_matrix_change",
    "topology_arms",
    "comparison_modes",
    "frozen_inputs_required",
    "removals",
    "not_applicable_semantics",
    "adaptation_policy",
    "required_output_owner",
    "event_time_and_ids",
    "hard_gates",
    "result_vectors",
    "execution_status"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-TOPOLOGY-REMOVAL-001"
    },
    "parent_candidate": {
      "const": "NEIGHBORHOOD_RESILIENCE_COMMONS"
    },
    "maturity": {
      "const": "PROTOCOL_ONLY_NOT_EXECUTED"
    },
    "pr_736_matrix_change": {
      "const": false
    },
    "topology_arms": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CENTRAL_HUB",
          "DISTRIBUTED_NODES",
          "FEDERATED_PEER_MESH",
          "MOBILE_SUPPORT",
          "LAYERED_HYBRID"
        ]
      }
    },
    "comparison_modes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "held_constant"
        ],
        "properties": {
          "id": {
            "enum": [
              "CAPACITY_MATCHED",
              "BUDGET_MATCHED",
              "MAINTENANCE_CAPACITY_MATCHED"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "held_constant": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "frozen_inputs_required": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "removals": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "applies_to",
          "target",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "CENTRAL_HUB",
                "DISTRIBUTED_NODES",
                "FEDERATED_PEER_MESH",
                "MOBILE_SUPPORT",
                "LAYERED_HYBRID"
              ]
            }
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "COMPONENT_ABLATION",
              "DEPENDENCY_PARTITION",
              "ACCESS_CUT",
              "COMMON_CAUSE_ABLATION",
              "MAINTENANCE_ABLATION",
              "RESOURCE_EXHAUSTION",
              "AUTHORITY_WITHDRAWAL"
            ]
          }
        }
      }
    },
    "not_applicable_semantics": {
      "const": "EXPLICIT_NOT_APPLICABLE_WITH_REASON"
    },
    "adaptation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_pass",
        "second_pass",
        "future_information",
        "policy_must_be_predeclared"
      ],
      "properties": {
        "first_pass": {
          "const": "STRICT_ABLATION_NO_HIDDEN_RECONFIGURATION"
        },
        "second_pass": {
          "const": "OPTIONAL_SEPARATELY_VERSIONED_POLICY"
        },
        "future_information": {
          "const": "PROHIBITED"
        },
        "policy_must_be_predeclared": {
          "const": true
        }
      }
    },
    "required_output_owner": {
      "const": "SYMTROPY_NATIVE_TRAJECTORY_INTERFACE"
    },
    "event_time_and_ids": {
      "const": "MUST_NOT_BE_SYNTHESIZED_BY_THIS_MANIFEST"
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "household_floor_false_passes",
        "missing_household_service_outcomes",
        "availability_as_delivery_false_claims",
        "missed_common_causes_against_finite_oracle",
        "duplicate_resource_credits_or_double_commitments",
        "silent_unit_conversions",
        "unauthorized_shared_data_accesses",
        "unknown_or_out_of_domain_as_pass",
        "positive_control_false_blocks",
        "exact_finite_known_answer_agreement_percent"
      ],
      "properties": {
        "household_floor_false_passes": {
          "const": 0
        },
        "missing_household_service_outcomes": {
          "const": 0
        },
        "availability_as_delivery_false_claims": {
          "const": 0
        },
        "missed_common_causes_against_finite_oracle": {
          "const": 0
        },
        "duplicate_resource_credits_or_double_commitments": {
          "const": 0
        },
        "silent_unit_conversions": {
          "const": 0
        },
        "unauthorized_shared_data_accesses": {
          "const": 0
        },
        "unknown_or_out_of_domain_as_pass": {
          "const": 0
        },
        "positive_control_false_blocks": {
          "const": 0
        },
        "exact_finite_known_answer_agreement_percent": {
          "const": 100
        }
      }
    },
    "result_vectors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    }
  }
}
