{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/highveld-neighborhood-commons/NEIGHBORHOOD_COMMONS_STRESS_MATRIX_V0.1.schema.json",
  "title": "Highveld neighborhood commons stress matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "maturity",
    "evidence_class",
    "claim_ceiling",
    "scenario_families"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "HIGHVELD-NEIGHBORHOOD-COMMONS-STRESS-MATRIX"
    },
    "maturity": {
      "const": "PROPOSED_NOT_EVALUATED"
    },
    "evidence_class": {
      "const": "SyntheticScenarioDefinitions"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 50
    },
    "scenario_families": {
      "type": "array",
      "minItems": 15,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "failure_family",
        "stimulus",
        "owner_system",
        "required_observations",
        "expected_disposition",
        "claim_ceiling"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_family": {
          "type": "string",
          "minLength": 1
        },
        "stimulus": {
          "type": "string",
          "minLength": 20
        },
        "owner_system": {
          "enum": [
            "SOL_ATLAS",
            "SYMTROPY",
            "MYCELIX",
            "SPECIALIST_SOLVER"
          ]
        },
        "required_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_disposition": {
          "enum": [
            "BLOCK_SHARED_SERVICE_CLAIM",
            "REQUIRE_HOUSEHOLD_TRAJECTORY",
            "BLOCK_RESOURCE_COMMITMENT",
            "REJECT_DUPLICATE_CREDIT",
            "BLOCK_DATA_ACCESS",
            "REQUIRE_HUMAN_REVIEW",
            "OWNER_REVIEW",
            "REOPEN_AFFECTED_DECISIONS"
          ]
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}
