{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-multi-engine-thermal-water-benchmark-v0.1.schema.json",
  "title": "Highveld multi-engine thermal-water benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "parent_study_id",
    "maturity",
    "baseline",
    "engines",
    "scenarios",
    "frozen_inputs",
    "result_vectors",
    "target_gates",
    "co_simulation_requirements",
    "claim_ceiling",
    "execution_status"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-MULTI-ENGINE-THERMAL-WATER-001"
    },
    "parent_study_id": {
      "const": "HIGHVELD-PASSIVE-COOLING-WATER-001"
    },
    "maturity": {
      "const": "BENCHMARK_PREREGISTERED_NOT_EXECUTED"
    },
    "baseline": {
      "const": "S2_NO_WATER_PASSIVE_BASELINE"
    },
    "engines": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product",
          "version",
          "role",
          "independent_solver",
          "execution_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "distribution": {
            "type": "string"
          },
          "independent_solver": {
            "type": "boolean"
          },
          "execution_status": {
            "const": "NOT_EXECUTED"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "frozen_inputs": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "result_vectors": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "target_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unauthorized_essential_water_floor_violations",
        "unknown_or_failed_water_rights_quality_restriction_operations",
        "unqualified_useful_cooling_credits",
        "accepted_critical_out_of_domain_decisions",
        "hard_safety_constraint_violations",
        "predictive_interval_coverage_targets_percent",
        "provenance_completeness_percent"
      ],
      "properties": {
        "unauthorized_essential_water_floor_violations": {
          "const": 0
        },
        "unknown_or_failed_water_rights_quality_restriction_operations": {
          "const": 0
        },
        "unqualified_useful_cooling_credits": {
          "const": 0
        },
        "accepted_critical_out_of_domain_decisions": {
          "const": 0
        },
        "hard_safety_constraint_violations": {
          "const": 0
        },
        "predictive_interval_coverage_targets_percent": {
          "const": [
            90,
            95
          ]
        },
        "provenance_completeness_percent": {
          "const": 100
        }
      }
    },
    "co_simulation_requirements": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    }
  }
}
