{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-thermal-sink-cascade-v0.1.schema.json",
  "title": "Highveld thermal sink cascade manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "parent_study",
    "parent_candidate",
    "maturity",
    "climate_context",
    "execution_status",
    "architecture_arms",
    "sink_path_registry",
    "scenarios",
    "frozen_inputs_required",
    "hard_gates",
    "control_layers",
    "required_metrics",
    "case_expansion",
    "ownership",
    "claim_ceiling",
    "schema_engine"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-THERMAL-SINK-CASCADE-001"
    },
    "parent_study": {
      "const": "HIGHVELD-PASSIVE-COOLING-WATER-001"
    },
    "parent_candidate": {
      "const": "NEIGHBORHOOD_RESILIENCE_COMMONS"
    },
    "maturity": {
      "const": "PROTOCOL_ONLY_NOT_EXECUTED"
    },
    "climate_context": {
      "const": "JOHANNESBURG_HIGHVELD"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "architecture_arms": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "store_role",
          "sink_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "PRIMARY_CONTROL",
              "TEST_ARM",
              "NEGATIVE_CONTROL"
            ]
          },
          "store_role": {
            "type": "string",
            "minLength": 1
          },
          "sink_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sink_path_registry": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "water_consumption",
          "evidence_required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "water_consumption": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "frozen_inputs_required": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "essential_water_floor_violations",
        "unqualified_water_operation",
        "unmodelled_heat_or_water_terms",
        "useful_cooling_without_occupied_zone_evidence",
        "accepted_infinite_sink_assumptions",
        "missed_seeded_sensor_or_equipment_faults",
        "unknown_state_as_pass",
        "positive_control_false_blocks",
        "energy_and_water_balance_within_propagated_uncertainty",
        "seasonal_store_cycle_closure_required",
        "exact_input_model_controller_instrument_traceability_percent"
      ],
      "properties": {
        "essential_water_floor_violations": {
          "const": 0
        },
        "unqualified_water_operation": {
          "const": 0
        },
        "unmodelled_heat_or_water_terms": {
          "const": 0
        },
        "useful_cooling_without_occupied_zone_evidence": {
          "const": 0
        },
        "accepted_infinite_sink_assumptions": {
          "const": 0
        },
        "missed_seeded_sensor_or_equipment_faults": {
          "const": 0
        },
        "unknown_state_as_pass": {
          "const": 0
        },
        "positive_control_false_blocks": {
          "const": 0
        },
        "energy_and_water_balance_within_propagated_uncertainty": {
          "const": true
        },
        "seasonal_store_cycle_closure_required": {
          "const": true
        },
        "exact_input_model_controller_instrument_traceability_percent": {
          "const": 100
        }
      }
    },
    "control_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_feasibility_governor",
        "optimizer",
        "future_information",
        "human_authority_for_discretionary_water",
        "network_partition_fallback"
      ],
      "properties": {
        "independent_feasibility_governor": {
          "const": "DETERMINISTIC_FAIL_CLOSED"
        },
        "optimizer": {
          "const": "BOUNDED_MULTI_OBJECTIVE_PARETO_DISPATCH"
        },
        "future_information": {
          "const": "PROHIBITED"
        },
        "human_authority_for_discretionary_water": {
          "const": "REQUIRED"
        },
        "network_partition_fallback": {
          "const": "LOCAL_SAFE_POLICY_REQUIRED"
        }
      }
    },
    "required_metrics": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topology",
        "expected_arm_count",
        "expected_scenario_count",
        "expected_case_count",
        "case_state"
      ],
      "properties": {
        "topology": {
          "const": "CROSS_PRODUCT_ARCHITECTURE_ARMS_AND_SCENARIOS"
        },
        "expected_arm_count": {
          "const": 8
        },
        "expected_scenario_count": {
          "const": 9
        },
        "expected_case_count": {
          "const": 72
        },
        "case_state": {
          "const": "REGISTERED_NOT_EXECUTED"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_and_configuration",
        "native_event_time_and_trajectories",
        "water_rights_quality_and_instruments",
        "domain_physics",
        "independent_conservation_oracle"
      ],
      "properties": {
        "geometry_and_configuration": {
          "const": "SOL_ATLAS"
        },
        "native_event_time_and_trajectories": {
          "const": "SYMTROPY"
        },
        "water_rights_quality_and_instruments": {
          "const": "MYCELIX"
        },
        "domain_physics": {
          "const": "SPECIALIST_SOLVERS"
        },
        "independent_conservation_oracle": {
          "const": "INDEPENDENT"
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 50
    },
    "schema_engine": {
      "const": "NOT_RUN_GENERAL_JSON_SCHEMA_RUNTIME"
    }
  }
}
