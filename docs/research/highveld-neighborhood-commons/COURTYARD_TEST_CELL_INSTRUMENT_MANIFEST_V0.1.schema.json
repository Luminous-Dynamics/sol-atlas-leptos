{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-courtyard-test-cell-instrument-package-v0.1.schema.json",
  "title": "Highveld courtyard test-cell instrument package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "instrument_package_id",
    "maturity",
    "admission_state",
    "default_dynamic_sample_interval_s",
    "time_basis",
    "native_event_identity_owner",
    "event_identity_rule",
    "channels",
    "required_channel_metadata",
    "water_balance_terms",
    "thermal_balance_terms",
    "privacy_controls",
    "admission_gates",
    "missingness_rule",
    "execution_status"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-PASSIVE-COOLING-WATER-001"
    },
    "instrument_package_id": {
      "const": "HIGHVELD-COURTYARD-TEST-CELL-INSTRUMENT-PACKAGE-001"
    },
    "maturity": {
      "const": "FIELD_PROTOCOL_NOT_DEPLOYED"
    },
    "admission_state": {
      "const": "TEMPLATE_NOT_FIELD_ADMITTED"
    },
    "default_dynamic_sample_interval_s": {
      "const": 60
    },
    "time_basis": {
      "const": "UTC_WITH_EXPLICIT_LOCAL_DISPLAY"
    },
    "native_event_identity_owner": {
      "const": "SYMTROPY"
    },
    "event_identity_rule": {
      "const": "NO_SYNTHETIC_EVENT_IDS_OR_CLOCK_TICKS_IN_THIS_MANIFEST"
    },
    "channels": {
      "type": "array",
      "minItems": 35,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "quantity",
          "unit",
          "group",
          "sample_interval_s",
          "instrument_assignment",
          "calibration_state",
          "uncertainty_record_required",
          "raw_data_retention_required",
          "evidence_state"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "enum": [
              "THERMAL",
              "WEATHER",
              "WATER",
              "ELECTRICAL",
              "WATER_QUALITY",
              "PRIVACY"
            ]
          },
          "sample_interval_s": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "instrument_assignment": {
            "type": [
              "string",
              "null"
            ]
          },
          "calibration_state": {
            "const": "NOT_ADMITTED"
          },
          "uncertainty_record_required": {
            "const": true
          },
          "raw_data_retention_required": {
            "const": true
          },
          "evidence_state": {
            "const": "TEMPLATE_ONLY"
          }
        }
      }
    },
    "required_channel_metadata": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "water_balance_terms": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "thermal_balance_terms": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "privacy_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cameras_permitted",
        "individual_identity_required",
        "occupancy_mode",
        "household_data_requires_separate_exact_consent"
      ],
      "properties": {
        "cameras_permitted": {
          "const": false
        },
        "individual_identity_required": {
          "const": false
        },
        "occupancy_mode": {
          "const": "UNOCCUPIED_OR_PRIVACY_SAFE_COUNT_BAND"
        },
        "household_data_requires_separate_exact_consent": {
          "const": true
        }
      }
    },
    "admission_gates": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "missingness_rule": {
      "const": "MISSING_OR_UNCALIBRATED_SAFETY_OR_WATER_EVIDENCE_IS_UNKNOWN_NOT_ZERO"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    }
  }
}
