{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/highveld-johannesburg-weather-package-v0.1.schema.json",
  "title": "Highveld Johannesburg weather source register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "parent_study",
    "climate_context",
    "maturity",
    "acquisition_status",
    "site_definition_status",
    "candidate_sources",
    "required_temporal_packages",
    "required_variables",
    "source_admission_fields",
    "holdout_design",
    "hard_gates",
    "owner_roles",
    "claim_ceiling"
  ],
  "properties": {
    "format_version": {
      "const": "0.1"
    },
    "study_id": {
      "const": "HIGHVELD-JOHANNESBURG-WEATHER-PACKAGE-001"
    },
    "parent_study": {
      "const": "HIGHVELD-PASSIVE-COOLING-WATER-001"
    },
    "climate_context": {
      "const": "JOHANNESBURG_HIGHVELD"
    },
    "maturity": {
      "const": "WEATHER_SOURCE_REGISTER_ONLY_NOT_ADMITTED"
    },
    "acquisition_status": {
      "const": "NOT_ACQUIRED"
    },
    "site_definition_status": {
      "const": "OWNER_SITE_NOT_SELECTED"
    },
    "candidate_sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "data_type",
          "candidate_variables",
          "nominal_resolution",
          "candidate_period",
          "access_state",
          "commercial_use_state",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "data_type": {
            "type": "string",
            "minLength": 1
          },
          "candidate_variables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nominal_resolution": {
            "type": "string",
            "minLength": 1
          },
          "candidate_period": {
            "type": "string",
            "minLength": 1
          },
          "access_state": {
            "type": "string",
            "minLength": 1
          },
          "commercial_use_state": {
            "type": "string",
            "minLength": 1
          },
          "not_for_resale": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "required_temporal_packages": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "required_variables": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_admission_fields": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "holdout_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_split",
        "spatial_holdout_station_required_where_available",
        "preserve_raw_files_and_transforms",
        "no_random_hourly_shuffle_as_independent_validation",
        "candidate_outcome_blind_hot_tail_selection"
      ],
      "properties": {
        "temporal_split": {
          "const": "BLOCKED_BY_SEASON_AND_EVENT"
        },
        "spatial_holdout_station_required_where_available": {
          "type": "boolean"
        },
        "preserve_raw_files_and_transforms": {
          "type": "boolean"
        },
        "no_random_hourly_shuffle_as_independent_validation": {
          "type": "boolean"
        },
        "candidate_outcome_blind_hot_tail_selection": {
          "type": "boolean"
        }
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlicensed_use",
        "grid_data_relabelled_as_site_measurements",
        "hidden_critical_variable_imputation",
        "future_weather_in_causal_controller",
        "untraceable_source_transforms",
        "required_claims_without_representative_weather"
      ],
      "properties": {
        "unlicensed_use": {
          "const": 0
        },
        "grid_data_relabelled_as_site_measurements": {
          "const": 0
        },
        "hidden_critical_variable_imputation": {
          "const": 0
        },
        "future_weather_in_causal_controller": {
          "const": 0
        },
        "untraceable_source_transforms": {
          "const": 0
        },
        "required_claims_without_representative_weather": {
          "const": 0
        }
      }
    },
    "owner_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_geometry_and_representativeness",
        "licence_and_source_admission",
        "time_lineage_and_replay",
        "weather_boundary_physics"
      ],
      "properties": {
        "site_geometry_and_representativeness": {
          "const": "SOL_ATLAS"
        },
        "licence_and_source_admission": {
          "const": "MYCELIX"
        },
        "time_lineage_and_replay": {
          "const": "SYMTROPY"
        },
        "weather_boundary_physics": {
          "const": "SPECIALIST_SOLVERS"
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    }
  }
}
