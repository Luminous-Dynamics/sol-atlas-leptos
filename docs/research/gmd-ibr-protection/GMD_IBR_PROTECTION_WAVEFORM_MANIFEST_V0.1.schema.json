{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/gmd-ibr-waveform-manifest-v0.1.schema.json",
  "title": "GMD IBR / CT / protection waveform-set manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "waveform_set_id",
    "scenario_id",
    "evidence_class",
    "artifact",
    "recording_clock",
    "provenance",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "waveform_set_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "synthetic_fixture",
        "measured",
        "simulated",
        "published_derived",
        "hardware_test",
        "field_exercise"
      ]
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "recording_clock": {
      "$ref": "#/$defs/recordingClock"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transformation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "byte_length",
        "format",
        "format_edition"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": [
            "COMTRADE",
            "CSV",
            "HDF5",
            "MAT",
            "other"
          ]
        },
        "format_edition": {
          "type": "string",
          "minLength": 1
        },
        "exporter_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "exporter_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "recordingClock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_origin",
        "clock_reference",
        "synchronization_group",
        "start_offset_ns",
        "maximum_uncertainty_ns"
      ],
      "properties": {
        "time_origin": {
          "enum": [
            "relative_to_simulation_start",
            "UTC",
            "GPS",
            "IRIG_B",
            "PTP_IEEE_1588",
            "local_clock",
            "unknown"
          ]
        },
        "clock_reference": {
          "type": "string",
          "minLength": 1
        },
        "synchronization_group": {
          "type": "string",
          "minLength": 1
        },
        "start_offset_ns": {
          "type": "integer"
        },
        "maximum_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "absolute_start_epoch_ns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sampling_clock_drift_ppb": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_ref",
        "owner_ref",
        "source_revision",
        "processing_chain"
      ],
      "properties": {
        "producer_ref": {
          "type": "string",
          "minLength": 1
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "processing_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "tool_version",
              "input_sha256"
            ],
            "properties": {
              "operation": {
                "type": "string",
                "minLength": 1
              },
              "tool_version": {
                "type": "string",
                "minLength": 1
              },
              "input_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "role",
        "quantity",
        "unit",
        "data_type",
        "phase",
        "polarity_convention",
        "sampling_mode",
        "sample_count",
        "sample_rate_hz",
        "start_offset_ns",
        "measurement_path_ref"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "transformer_neutral_gic",
            "ct_primary_current",
            "ct_secondary_current",
            "relay_voltage_input",
            "relay_current_input",
            "relay_phasor_impedance",
            "relay_element_pickup",
            "relay_trip_output",
            "ibr_phase_current",
            "ibr_dc_component",
            "bus_voltage",
            "harmonic_spectrum",
            "other"
          ]
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "data_type": {
          "enum": [
            "analog",
            "boolean",
            "integer",
            "event"
          ]
        },
        "phase": {
          "enum": [
            "A",
            "B",
            "C",
            "N",
            "positive_sequence",
            "negative_sequence",
            "zero_sequence",
            "three_phase",
            "not_applicable",
            "unknown"
          ]
        },
        "polarity_convention": {
          "enum": [
            "positive_into_primary",
            "positive_out_of_primary",
            "positive_into_neutral",
            "positive_out_of_neutral",
            "positive_from_ct_s1_to_s2",
            "positive_from_ct_s2_to_s1",
            "as_recorded_mapping_declared",
            "not_applicable",
            "unknown"
          ]
        },
        "sampling_mode": {
          "enum": [
            "uniform",
            "event_timestamped"
          ]
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rate_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "start_offset_ns": {
          "type": "integer"
        },
        "measurement_path_ref": {
          "type": "string",
          "minLength": 1
        },
        "ct_configuration_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibration_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_flag_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "ct_primary_current",
                  "ct_secondary_current"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "ct_configuration_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sampling_mode": {
                "const": "uniform"
              }
            },
            "required": [
              "sampling_mode"
            ]
          },
          "then": {
            "properties": {
              "sample_rate_hz": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sampling_mode": {
                "const": "event_timestamped"
              }
            },
            "required": [
              "sampling_mode"
            ]
          },
          "then": {
            "properties": {
              "sample_rate_hz": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "input_sha256",
        "output_sha256",
        "tool_version"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
