{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component substitution matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "maturity",
    "decision_date",
    "assembly_id",
    "substitutions",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "const": "HOME-MATERIAL-INTELLIGENCE-001"
    },
    "maturity": {
      "const": "SYNTHETIC_FIXTURE"
    },
    "decision_date": {
      "type": "string"
    },
    "assembly_id": {
      "type": "string"
    },
    "substitutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "substitution_id",
          "from_component_id",
          "to_component_id",
          "required_interface_id",
          "required_properties",
          "expected_disposition",
          "invalidation_set",
          "evidence_class"
        ],
        "properties": {
          "substitution_id": {
            "type": "string"
          },
          "from_component_id": {
            "type": "string"
          },
          "to_component_id": {
            "type": "string"
          },
          "required_interface_id": {
            "type": "string"
          },
          "required_properties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_disposition": {
            "enum": [
              "QUALIFIED_IN_SCOPE",
              "BLOCKED_UNKNOWN",
              "REJECTED",
              "NOT_COMPARABLE"
            ]
          },
          "invalidation_set": {
            "type": "array",
            "minItems": 10,
            "items": {
              "type": "string"
            }
          },
          "evidence_class": {
            "const": "SYNTHETIC_FIXTURE"
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string"
    }
  }
}
