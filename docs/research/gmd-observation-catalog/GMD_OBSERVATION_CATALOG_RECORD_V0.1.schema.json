{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/gmd-observation-catalog/GMD_OBSERVATION_CATALOG_RECORD_V0.1.schema.json",
  "title": "GMD Observation Catalogue Record v0.1",
  "description": "Rights-aware source catalogue. Repository, station and dataset scopes are distinct; metadata presence is not scientific validity or data-use permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "provider_name", "owner_ref", "record_scope", "repository_uri",
    "source_evidence_uri", "verified_on_utc_date", "source_snapshot_sha256",
    "evidence_class", "instrument_classes", "searchable_metadata_fields",
    "network_coverage_description", "data_delivery_method", "access_terms_summary",
    "station", "dataset", "rights"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "provider_name": { "type": "string", "minLength": 1 },
    "owner_ref": { "type": "string", "minLength": 1 },
    "record_scope": {
      "type": "string",
      "enum": ["RepositoryCatalog", "StationInstrument", "DatasetProduct"]
    },
    "repository_uri": { "type": "string", "pattern": "^(https?://|urn:)" },
    "source_evidence_uri": { "type": "string", "pattern": "^(https?://|urn:)" },
    "verified_on_utc_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "source_snapshot_sha256": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "type": "null" }
      ]
    },
    "evidence_class": {
      "type": "string",
      "enum": ["CatalogueMetadata", "Measured", "PublishedDerived", "Simulated", "Unknown"]
    },
    "instrument_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "searchable_metadata_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "network_coverage_description": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "data_delivery_method": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "access_terms_summary": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "station": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "station_id", "latitude_deg", "longitude_deg", "coordinate_reference",
            "measured_quantity", "native_unit", "sensor_axis_orientation",
            "sampling_interval_seconds", "clock_basis", "calibration_reference"
          ],
          "properties": {
            "station_id": { "type": "string", "minLength": 1 },
            "latitude_deg": { "oneOf": [{ "type": "number", "minimum": -90, "maximum": 90 }, { "type": "null" }] },
            "longitude_deg": { "oneOf": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "null" }] },
            "coordinate_reference": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "measured_quantity": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "native_unit": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "sensor_axis_orientation": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "sampling_interval_seconds": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
            "clock_basis": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "calibration_reference": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
          }
        },
        { "type": "null" }
      ]
    },
    "dataset": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product_id", "product_uri", "processing_level",
            "coverage_start_epoch_seconds", "coverage_end_epoch_seconds", "artifact_sha256"
          ],
          "properties": {
            "product_id": { "type": "string", "minLength": 1 },
            "product_uri": { "type": "string", "pattern": "^(https?://|urn:)" },
            "processing_level": { "type": "string", "minLength": 1 },
            "coverage_start_epoch_seconds": { "type": "integer" },
            "coverage_end_epoch_seconds": { "type": "integer" },
            "artifact_sha256": {
              "oneOf": [
                { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                { "type": "null" }
              ]
            }
          }
        },
        { "type": "null" }
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_discovery", "dataset_download", "academic_analysis",
        "commercial_ingestion", "model_training", "derivative_redistribution"
      ],
      "properties": {
        "metadata_discovery": { "$ref": "#/$defs/rightGrant" },
        "dataset_download": { "$ref": "#/$defs/rightGrant" },
        "academic_analysis": { "$ref": "#/$defs/rightGrant" },
        "commercial_ingestion": { "$ref": "#/$defs/rightGrant" },
        "model_training": { "$ref": "#/$defs/rightGrant" },
        "derivative_redistribution": { "$ref": "#/$defs/rightGrant" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "record_scope": { "const": "RepositoryCatalog" } } },
      "then": {
        "properties": { "station": { "type": "null" }, "dataset": { "type": "null" } }
      }
    },
    {
      "if": { "properties": { "record_scope": { "const": "StationInstrument" } } },
      "then": {
        "properties": {
          "station": { "type": "object" },
          "dataset": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "record_scope": { "const": "DatasetProduct" } } },
      "then": { "properties": { "dataset": { "type": "object" } } }
    }
  ],
  "$defs": {
    "rightGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ref", "valid_from_epoch_seconds", "valid_until_epoch_seconds"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["Permitted", "RegistrationRequired", "AgreementRequired", "Prohibited", "Unknown"]
        },
        "evidence_ref": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "valid_from_epoch_seconds": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "valid_until_epoch_seconds": { "oneOf": [{ "type": "integer" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["Permitted", "RegistrationRequired", "AgreementRequired", "Prohibited"]
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ref": { "type": "string", "pattern": "^(https?://|urn:)", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
