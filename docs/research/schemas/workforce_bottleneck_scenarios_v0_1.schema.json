{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/schemas/workforce_bottleneck_scenarios_v0_1.schema.json",
  "title": "SA-WORKFORCE-DIAG-001 synthetic scenario corpus v0.1",
  "description": "Strict structural contract for synthetic-only workforce bottleneck diagnostic cases. Semantic correctness requires an independent oracle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "claim_ceiling",
    "units",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "SA-WORKFORCE-DIAG-001-V0.1"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staff_count",
        "work_items",
        "wait_hours",
        "currency"
      ],
      "properties": {
        "staff_count": {
          "type": "string",
          "minLength": 1
        },
        "work_items": {
          "type": "string",
          "minLength": 1
        },
        "wait_hours": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "cause": {
      "type": "string",
      "enum": [
        "SKILLS_CAPACITY",
        "FUNDING_OR_PAYER",
        "TOOLS_OR_SPARES",
        "AUTHORIZATION_OR_SAFETY_GATE",
        "DISPATCH_OR_GEOGRAPHY",
        "WAGE_OR_RETENTION",
        "DEMAND_DATA_QUALITY",
        "PRACTICAL_COMPETENCE_UNVERIFIED",
        "EVIDENCE_INSUFFICIENT",
        "INTERACTING_BOTTLENECKS"
      ]
    },
    "interventionLabel": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "DIAGNOSE_AND_INTERVENE",
        "FUNDING_GATE_BLOCKS_EXECUTION",
        "RESOURCE_GATE_BLOCKS_COMPLETION",
        "BLOCK_EXECUTION",
        "REDESIGN_DISPATCH",
        "REVIEW_JOB_QUALITY",
        "ABSTAIN_AND_GATHER_EVIDENCE",
        "SUPERVISED_ASSIST_AND_LEARN",
        "PLAN_DEPENDENT_INTERVENTION_BUNDLE",
        "CLEAN_DEMAND_BEFORE_ALLOCATION",
        "VERIFY_SCOPE_AND_COMPETENCE",
        "BOUNDED_DIAGNOSIS_AND_GATE_REMEDIATION"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "summary",
        "synthetic_only",
        "observations",
        "oracle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WBD-[0-9]{3}$"
        },
        "domain": {
          "type": "string",
          "enum": [
            "water_maintenance",
            "electricity_maintenance",
            "construction_maintenance"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 10
        },
        "synthetic_only": {
          "const": true
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "demand_status",
            "funding_status",
            "evidence_status"
          ],
          "properties": {
            "demand_status": {
              "type": "string",
              "enum": [
                "validated",
                "conflicting",
                "duplicate_and_misrouted"
              ]
            },
            "funding_status": {
              "type": "string",
              "enum": [
                "confirmed_synthetic",
                "absent",
                "unknown"
              ]
            },
            "required_task_capacity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "available_task_ready_capacity": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "tools_and_spares": {
              "type": "string",
              "enum": [
                "available",
                "critical_spare_missing",
                "unknown"
              ]
            },
            "authorization_status": {
              "type": "string",
              "enum": [
                "valid_for_scope",
                "inspection_pending",
                "supervised_scope_valid",
                "unknown"
              ]
            },
            "dispatch_status": {
              "type": "string",
              "enum": [
                "feasible",
                "travel_shift_mismatch",
                "unknown"
              ]
            },
            "wage_and_shift_status": {
              "type": "string",
              "enum": [
                "viable",
                "nonviable_synthetic",
                "unknown"
              ]
            },
            "evidence_status": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "stale_and_conflicting",
                "incomplete"
              ]
            },
            "novice_present": {
              "type": "boolean"
            },
            "qualified_supervisor_available": {
              "type": "boolean"
            },
            "credential_status": {
              "type": "string",
              "enum": [
                "present_but_scope_mismatch"
              ]
            },
            "practical_assessment_status": {
              "type": "string",
              "enum": [
                "missing"
              ]
            }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "causes",
            "admissible_interventions",
            "prohibited_interventions",
            "disposition"
          ],
          "properties": {
            "causes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cause"
              }
            },
            "admissible_interventions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/interventionLabel"
              }
            },
            "prohibited_interventions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/interventionLabel"
              }
            },
            "disposition": {
              "$ref": "#/$defs/disposition"
            }
          }
        }
      }
    }
  }
}
