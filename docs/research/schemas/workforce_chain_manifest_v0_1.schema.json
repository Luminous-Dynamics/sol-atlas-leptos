{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/schemas/workforce_chain_manifest_v0_1.schema.json",
  "title": "SA-WORKFORCE-CHAIN-CONFORMANCE manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_notice",
    "schema_version",
    "benchmark_id",
    "synthetic_only",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "fixture_notice": {
      "type": "string",
      "minLength": 30
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SA-WORKFORCE-CHAIN-CONFORMANCE-001"
    },
    "synthetic_only": {
      "const": true
    },
    "claim_ceiling": {
      "const": "synthetic_contract_only"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_scope_id",
        "task_scope_id",
        "geography",
        "period_start",
        "period_end",
        "decision_cutoff"
      ],
      "properties": {
        "case_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "task_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "period_start": {
          "type": "string",
          "format": "date"
        },
        "period_end": {
          "type": "string",
          "format": "date"
        },
        "decision_cutoff": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "stage_type",
        "artifact_path",
        "pinned_artifact_sha256",
        "observed_artifact_sha256",
        "schema_path",
        "pinned_schema_sha256",
        "observed_schema_sha256",
        "scope",
        "evidence_class",
        "claim_ceiling"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "stage_type": {
          "enum": [
            "source_profile",
            "active_evidence",
            "diagnosis",
            "intervention",
            "outcome",
            "robustness"
          ]
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "pinned_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_path": {
          "type": "string",
          "minLength": 1
        },
        "pinned_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "authorized_observation",
            "independently_verified_observation"
          ]
        },
        "claim_ceiling": {
          "enum": [
            "synthetic_contract_only",
            "descriptive_association_only",
            "verified_operational_outcome",
            "causal_impact"
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_stage_id",
        "to_stage_id",
        "required"
      ],
      "properties": {
        "from_stage_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "to_stage_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "required": {
          "const": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "stages",
        "links",
        "requested_claim_type",
        "requested_claim_strength",
        "used_query_ids",
        "permitted_query_ids",
        "authorization_status",
        "service_verification_status",
        "payment_evidence_status",
        "causal_design_status",
        "counterfactual_basis",
        "preregistration_status",
        "expected_verdict",
        "expected_failure_codes",
        "additionality_status",
        "net_additional_paid_hours_estimate",
        "displacement_status",
        "substitution_status",
        "deadweight_status",
        "spillover_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "requested_claim_type": {
          "enum": [
            "diagnosis",
            "intervention_feasibility",
            "service_restoration",
            "paid_work_outcome",
            "causal_impact"
          ]
        },
        "requested_claim_strength": {
          "enum": [
            "synthetic_contract_only",
            "descriptive_association_only",
            "verified_operational_outcome",
            "causal_impact"
          ]
        },
        "used_query_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "permitted_query_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorization_status": {
          "enum": [
            "permitted",
            "unknown",
            "denied",
            "not_required"
          ]
        },
        "service_verification_status": {
          "enum": [
            "not_applicable",
            "independently_verified",
            "not_verified",
            "unknown"
          ]
        },
        "payment_evidence_status": {
          "enum": [
            "not_applicable",
            "verified_payment_evidence",
            "missing",
            "unknown"
          ]
        },
        "causal_design_status": {
          "enum": [
            "not_applicable",
            "registered_credible",
            "missing",
            "invalid"
          ]
        },
        "counterfactual_basis": {
          "type": "string"
        },
        "preregistration_status": {
          "enum": [
            "not_applicable",
            "verified",
            "missing"
          ]
        },
        "expected_verdict": {
          "enum": [
            "conformant",
            "rejected",
            "indeterminate"
          ]
        },
        "expected_failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "additionality_status": {
          "enum": [
            "not_assessed",
            "descriptive_only",
            "estimated_with_preregistered_counterfactual"
          ]
        },
        "net_additional_paid_hours_estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "displacement_status": {
          "enum": [
            "not_assessed",
            "no_material_displacement_evidence_with_limits",
            "possible_displacement",
            "measured_displacement"
          ]
        },
        "substitution_status": {
          "enum": [
            "not_assessed",
            "no_material_substitution_evidence_with_limits",
            "possible_substitution",
            "measured_substitution"
          ]
        },
        "deadweight_status": {
          "enum": [
            "not_assessed",
            "no_material_deadweight_evidence_with_limits",
            "possible_deadweight",
            "measured_deadweight"
          ]
        },
        "spillover_status": {
          "enum": [
            "not_assessed",
            "not_detected_with_limits",
            "positive_spillover",
            "negative_spillover",
            "mixed_spillovers",
            "unresolved"
          ]
        }
      }
    }
  }
}
