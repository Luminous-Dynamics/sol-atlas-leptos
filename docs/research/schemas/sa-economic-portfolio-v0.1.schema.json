{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/schemas/sa-economic-portfolio-v0.1.schema.json",
  "title": "Synthetic South African economic portfolio benchmark v0.1",
  "description": "Structural contract for an explicitly synthetic portfolio test. Semantic constraints (unique IDs, dependency closure/order, caps, floors, interactions, complete scenario evaluation) require the evaluator as well as schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "synthetic_only",
    "claim_ceiling",
    "budgets_by_period",
    "scenarios",
    "service_baseline_by_scenario",
    "mandatory_floors",
    "objective_schema",
    "projects",
    "interaction_rules",
    "enumeration"
  ],
  "properties": {
    "schema_version": {
      "const": "sa-economic-portfolio-v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "synthetic_only": {
      "const": true
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "budgets_by_period": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/budget"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "service_baseline_by_scenario": {
      "type": "object",
      "required": [
        "nominal",
        "hot_dry_grid_stress"
      ],
      "additionalProperties": false,
      "properties": {
        "nominal": {
          "type": "number"
        },
        "hot_dry_grid_stress": {
          "type": "number"
        }
      }
    },
    "mandatory_floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/floor"
      }
    },
    "objective_schema": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "projects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "interaction_rules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/interaction"
      }
    },
    "enumeration": {
      "$ref": "#/$defs/enumeration"
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "cost_cap_u",
        "crew_cap_u"
      ],
      "properties": {
        "period": {
          "enum": [
            "P1",
            "P2"
          ]
        },
        "cost_cap_u": {
          "type": "number",
          "minimum": 0
        },
        "crew_cap_u": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weight",
        "probability",
        "notes"
      ],
      "properties": {
        "id": {
          "enum": [
            "nominal",
            "hot_dry_grid_stress"
          ]
        },
        "weight": {
          "type": "null"
        },
        "probability": {
          "type": "null"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "direction",
        "threshold",
        "apply_to_each_scenario",
        "source_class"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "const": "minimize violation"
        },
        "threshold": {
          "type": "number"
        },
        "apply_to_each_scenario": {
          "const": true
        },
        "source_class": {
          "const": "synthetic test invariant"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "unit"
      ],
      "properties": {
        "id": {
          "enum": [
            "economic_value_u",
            "essential_service_points",
            "paid_work_opportunity_points",
            "ecological_quality_points"
          ]
        },
        "direction": {
          "const": "maximize"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economic_value_u",
        "essential_service_points",
        "paid_work_opportunity_points",
        "ecological_quality_points"
      ],
      "properties": {
        "economic_value_u": {
          "type": "number"
        },
        "essential_service_points": {
          "type": "number"
        },
        "paid_work_opportunity_points": {
          "type": "number"
        },
        "ecological_quality_points": {
          "type": "number"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "period",
        "stage_order",
        "cost_u",
        "crew_u",
        "requires",
        "gate",
        "outcomes",
        "evidence_class"
      ],
      "properties": {
        "id": {
          "enum": [
            "T",
            "W",
            "A",
            "I",
            "R",
            "J",
            "F",
            "X"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "enum": [
            "P1",
            "P2"
          ]
        },
        "stage_order": {
          "type": "integer",
          "minimum": 1
        },
        "cost_u": {
          "type": "number",
          "minimum": 0
        },
        "crew_u": {
          "type": "number",
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "enum": [
              "T",
              "W",
              "A",
              "I",
              "R",
              "J",
              "F",
              "X"
            ]
          },
          "uniqueItems": true
        },
        "gate": {
          "enum": [
            "PASS",
            "BLOCK",
            "UNKNOWN"
          ]
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nominal",
            "hot_dry_grid_stress"
          ],
          "properties": {
            "nominal": {
              "$ref": "#/$defs/outcome"
            },
            "hot_dry_grid_stress": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "synthetic hostile negative control"
          ]
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "when_all_selected",
        "objective_adjustment_by_scenario",
        "reason"
      ],
      "properties": {
        "id": {
          "enum": [
            "T_W_COMPLEMENT",
            "A_F_ECOLOGY_OVERLAP"
          ]
        },
        "kind": {
          "enum": [
            "synergy",
            "overlap_adjustment"
          ]
        },
        "when_all_selected": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "T",
              "W",
              "A",
              "I",
              "R",
              "J",
              "F",
              "X"
            ]
          },
          "uniqueItems": true
        },
        "objective_adjustment_by_scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nominal",
            "hot_dry_grid_stress"
          ],
          "properties": {
            "nominal": {
              "$ref": "#/$defs/outcome"
            },
            "hot_dry_grid_stress": {
              "$ref": "#/$defs/outcome"
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enumeration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "candidate_subset_count",
        "over_cap_behavior",
        "objective_comparison",
        "canonicalization"
      ],
      "properties": {
        "method": {
          "const": "complete subset enumeration"
        },
        "candidate_subset_count": {
          "const": 256
        },
        "over_cap_behavior": {
          "const": "structured error; never return a partial frontier as complete"
        },
        "objective_comparison": {
          "const": "scenario-wise componentwise maximization over every declared scenario and objective; scenario cases have no probabilities"
        },
        "canonicalization": {
          "const": "sort project IDs within each portfolio and sort portfolio ID tuples lexicographically"
        }
      }
    }
  }
}
