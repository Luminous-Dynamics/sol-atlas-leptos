{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/schemas/workforce_recovery_v0_1.schema.json",
  "title": "SA-WORKFORCE-RECOVERY disruption corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_notice",
    "schema_version",
    "benchmark_id",
    "synthetic_only",
    "claim_ceiling",
    "scenarios"
  ],
  "properties": {
    "fixture_notice": {
      "type": "string",
      "minLength": 30
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SA-WORKFORCE-RECOVERY-001"
    },
    "synthetic_only": {
      "const": true
    },
    "claim_ceiling": {
      "const": "synthetic_contract_only"
    },
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified_person_shifts",
        "supervisor_hours",
        "tool_kits",
        "dispatch_hours",
        "cash_zar_cents"
      ],
      "properties": {
        "qualified_person_shifts": {
          "type": "integer",
          "minimum": 0
        },
        "supervisor_hours": {
          "type": "integer",
          "minimum": 0
        },
        "tool_kits": {
          "type": "integer",
          "minimum": 0
        },
        "dispatch_hours": {
          "type": "integer",
          "minimum": 0
        },
        "cash_zar_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staff_minutes",
        "delay_hours",
        "worker_burden_hours"
      ],
      "properties": {
        "staff_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "delay_hours": {
          "type": "integer",
          "minimum": 0
        },
        "worker_burden_hours": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "essential_water_units",
        "essential_power_units",
        "health_units",
        "housing_units",
        "other_service_units"
      ],
      "properties": {
        "essential_water_units": {
          "type": "integer",
          "minimum": 0
        },
        "essential_power_units": {
          "type": "integer",
          "minimum": 0
        },
        "health_units": {
          "type": "integer",
          "minimum": 0
        },
        "housing_units": {
          "type": "integer",
          "minimum": 0
        },
        "other_service_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "description",
        "available",
        "eligibility",
        "prerequisite_state",
        "funding_state",
        "authorization_state",
        "work_quality_state",
        "service_category",
        "service_units",
        "resource_demand",
        "cost_demand",
        "requires_selected_interventions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "eligibility": {
          "enum": [
            "permitted",
            "forbidden",
            "indeterminate"
          ]
        },
        "prerequisite_state": {
          "enum": [
            "satisfied",
            "unknown",
            "failed"
          ]
        },
        "funding_state": {
          "enum": [
            "confirmed",
            "unknown",
            "absent"
          ]
        },
        "authorization_state": {
          "enum": [
            "authorized",
            "unknown",
            "denied"
          ]
        },
        "work_quality_state": {
          "enum": [
            "viable",
            "unknown",
            "nonviable"
          ]
        },
        "service_category": {
          "enum": [
            "essential_water_units",
            "essential_power_units",
            "health_units",
            "housing_units",
            "other_service_units"
          ]
        },
        "service_units": {
          "type": "integer",
          "minimum": 0
        },
        "resource_demand": {
          "$ref": "#/$defs/resources"
        },
        "cost_demand": {
          "$ref": "#/$defs/costs"
        },
        "requires_selected_interventions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        }
      }
    },
    "frontier_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_intervention_ids",
        "service_benefits",
        "resource_use",
        "cost_vector",
        "added_bundle_ids",
        "removed_bundle_ids"
      ],
      "properties": {
        "selected_intervention_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        },
        "service_benefits": {
          "$ref": "#/$defs/services"
        },
        "resource_use": {
          "$ref": "#/$defs/resources"
        },
        "cost_vector": {
          "$ref": "#/$defs/costs"
        },
        "added_bundle_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        },
        "removed_bundle_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "baseline_plan_ids",
        "resource_caps",
        "worker_burden_cap_hours",
        "service_floors",
        "interventions",
        "expected_baseline_status",
        "expected_baseline_codes",
        "expected_recovery_status",
        "expected_infeasibility_codes",
        "expected_feasible_portfolio_count",
        "expected_frontier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "baseline_plan_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        },
        "resource_caps": {
          "$ref": "#/$defs/resources"
        },
        "worker_burden_cap_hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "service_floors": {
          "$ref": "#/$defs/services"
        },
        "interventions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/intervention"
          }
        },
        "expected_baseline_status": {
          "enum": [
            "feasible",
            "service_floor_unmet",
            "resource_capacity_infeasible",
            "worker_burden_cap_infeasible",
            "service_and_resource_infeasible",
            "service_and_worker_burden_infeasible",
            "resource_and_worker_burden_infeasible",
            "multiple_constraints_infeasible"
          ]
        },
        "expected_baseline_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "expected_recovery_status": {
          "enum": [
            "feasible",
            "infeasible_essential_floor",
            "infeasible_resource_capacity",
            "infeasible_worker_burden",
            "infeasible_resource_and_worker_burden"
          ]
        },
        "expected_infeasibility_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "expected_feasible_portfolio_count": {
          "type": "integer",
          "minimum": 0
        },
        "expected_frontier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontier_item"
          }
        }
      }
    }
  }
}
