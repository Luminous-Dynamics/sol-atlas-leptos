{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/city-neighborhood-evaluation-profile-v0.1.json",
  "title": "CityMaker Neighbourhood Evaluation Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "schema_version",
    "classification",
    "scope",
    "service_requirements",
    "alternatives",
    "scenarios",
    "hard_constraints",
    "owner_evidence"
  ],
  "properties": {
    "profile_id": {
      "const": "CITY-NEIGHBOURHOOD-EVALUATION-PROFILE-V0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "classification": {
      "enum": [
        "synthetic_fixture_only",
        "rights_cleared_research_profile",
        "restricted_pilot_profile"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_digest",
        "study_area",
        "time_horizon",
        "population_frame",
        "service_bundle_revision",
        "scenario_family_id"
      ],
      "properties": {
        "scope_digest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9:_-]{8,160}$"
        },
        "study_area": {
          "$ref": "#/$defs/geometryReference"
        },
        "time_horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string"
            }
          }
        },
        "population_frame": {
          "$ref": "#/$defs/evidenceReference"
        },
        "service_bundle_revision": {
          "type": "string",
          "minLength": 1
        },
        "scenario_family_id": {
          "type": "string",
          "minLength": 1
        },
        "functional_unit_policy": {
          "type": "string",
          "minLength": 1
        },
        "boundary_crosswalk_ref": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "service_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/serviceRequirement"
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/alternative"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "owner_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composite_score_permitted": {
          "const": false
        },
        "unknown_policy": {
          "const": "never_promote_to_favourable"
        },
        "not_comparable_policy": {
          "const": "retain_separately"
        },
        "resident_decision_rights": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_repository",
        "owner_contract",
        "schema_version",
        "subject_id",
        "subject_revision",
        "scope_digest",
        "evidence_state",
        "receipt_id",
        "claim_ceiling"
      ],
      "properties": {
        "owner_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "owner_contract": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_revision": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "minLength": 8
        },
        "evidence_state": {
          "enum": [
            "synthetic",
            "declared",
            "observed",
            "modelled",
            "calibrated_modelled",
            "measured",
            "independently_accepted",
            "unknown",
            "stale",
            "revoked",
            "disputed"
          ]
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "geometryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "revision",
        "content_digest",
        "crs",
        "native_spatial_support",
        "rights_state"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$"
        },
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "native_spatial_support": {
          "type": "string",
          "minLength": 1
        },
        "display_resolution_limit": {
          "type": "string"
        },
        "rights_state": {
          "enum": [
            "verified",
            "conditional",
            "request_required",
            "restricted",
            "unknown"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "serviceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "group_id",
        "service_category",
        "demand_value",
        "demand_unit",
        "time_window",
        "required_access_profile",
        "hard_floor"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "service_category": {
          "type": "string",
          "minLength": 1
        },
        "demand_value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "demand_unit": {
          "type": "string",
          "minLength": 1
        },
        "time_window": {
          "type": "string",
          "minLength": 1
        },
        "required_access_profile": {
          "type": "string",
          "minLength": 1
        },
        "affordability_limit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "affordability_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "hard_floor": {
          "type": "boolean"
        },
        "source_ref": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_id",
        "morphology_family",
        "scope_digest",
        "design_revision",
        "geometry_ref",
        "owner_receipts",
        "phase_ids"
      ],
      "properties": {
        "alternative_id": {
          "type": "string",
          "minLength": 1
        },
        "morphology_family": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "minLength": 8
        },
        "design_revision": {
          "type": "string",
          "minLength": 1
        },
        "geometry_ref": {
          "$ref": "#/$defs/geometryReference"
        },
        "owner_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "phase_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "resident_participation_ref": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "evidence_class",
        "event_trace_ref",
        "applies_to_all_alternatives"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "observed_event",
            "design_extreme",
            "typical_weather",
            "future_projection",
            "operational_replay"
          ]
        },
        "event_trace_ref": {
          "$ref": "#/$defs/evidenceReference"
        },
        "applies_to_all_alternatives": {
          "const": true
        },
        "event_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "probability_basis_ref": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "domain",
        "metric_id",
        "unit",
        "operator",
        "threshold",
        "source_ref"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "le",
            "ge",
            "eq",
            "in",
            "must_be_true"
          ]
        },
        "threshold": {},
        "source_ref": {
          "$ref": "#/$defs/evidenceReference"
        },
        "non_compensatory": {
          "const": true
        }
      }
    }
  }
}
