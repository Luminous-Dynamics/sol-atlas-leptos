  "symtropy_invariant_crosswalk": [
    {
      "invariant_id": "paired_trace_identical",
      "highveld_application": "every alternative consumes the same exact weather/outage/water/fault trace for each paired scenario"
    },
    {
      "invariant_id": "hard_floor_before_pareto",
      "highveld_application": "resident/task-specific hard service floors, accessibility and qualified life-safety constraints are checked before ranking"
    },
    {
      "invariant_id": "unknown_not_pass",
      "highveld_application": "unqualified weather, unknown thresholds, missing solver outputs and out-of-domain runs remain Unknown/Blocked"
    },
    {
      "invariant_id": "scope_revisions_bind_evidence",
      "highveld_application": "bind candidate, geometry, materials, weather, schedules, solver and service-profile revisions"
    },
    {
      "invariant_id": "explicit_units_required",
      "highveld_application": "temperature, energy, water, airflow, time and cost retain explicit units and time bases"
    },
    {
      "invariant_id": "stable_recovery_window_required",
      "highveld_application": "restoration is not stable recovery until the owner-defined uninterrupted stability window passes"
    },
    {
      "invariant_id": "missing_part_blocks_recovery",
      "highveld_application": "no assumed immediate repair when a qualified part or repair-access claim is absent"
    },
    {
      "invariant_id": "no_future_information",
      "highveld_application": "candidate policies see only observations available at the decision time"
    },
    {
      "invariant_id": "no_scalar_compensation",
      "highveld_application": "energy or cost gains cannot compensate for failed resident task, fire, accessibility or other declared hard floors"
    },
    {
      "invariant_id": "uncertainty_tolerance_enforced",
      "highveld_application": "ranking blocked when declared uncertainty exceeds the pre-registered stability tolerance"
    },
    {
      "invariant_id": "resident_priority_preserved",
      "highveld_application": "resident-stated task priorities remain attributable and revision-bound"
    },
    {
      "invariant_id": "service_access_is_constraint",
      "highveld_application": "access to service plant and resident-essential functions is a constraint, not a decorative score"
    },
    {
      "invariant_id": "duplicate_delivery_idempotent",
