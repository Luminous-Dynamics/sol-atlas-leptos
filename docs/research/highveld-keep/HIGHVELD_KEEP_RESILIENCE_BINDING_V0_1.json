    "stable_recovery": "USE_SYMTROPY_OWNER_ORACLE_STABILITY_WINDOW_AND_RECURRENCE_RULES",
    "pareto": "USE_SYMTROPY_OWNER_OUTPUT_ONLY_AFTER_HARD_FLOORS_AND_EVIDENCE_ADMISSION",
    "joint_event_dependency_semantics": "preserve_causal_and_temporal_dependencies_in_one_trace; do_not_assume_independence_or_multiply_marginal_probabilities_without_a_justified_calibrated_model"
  },
  "model_credibility": {
    "framework": "RISK_PROPORTIONATE_VVUQ",
    "guidance": "NIST AMS 100-85; model influence and decision consequence determine credibility effort",
    "stages": [
      {
        "stage": "software_capability",
        "examples": [
          "applicable ASHRAE 140-2023 test cases",
          "weather-format interpretation tests"
        ],
        "proves": "declared software capability cases only"
      },
      {
        "stage": "input_and_scope_validation",
        "examples": [
          "exact geometry model weather schedules materials units and boundary conditions"
        ],
        "proves": "input completeness and declared scope only"
      },
      {
        "stage": "numerical_verification",
        "examples": [
          "convergence residuals warnings missing outputs repeatability"
        ],
        "proves": "numerical status and output integrity within the run"
      },
      {
        "stage": "independent_reference_comparison",
        "examples": [
          "analytical cases accepted reference models or independent measurements"
        ],
        "proves": "agreement within a predeclared reference scope and tolerance"
      },
      {
        "stage": "calibration_and_uncertainty",
        "examples": [
          "held-out measured operation residuals sensitivity distribution propagation domain checks"
        ],
        "proves": "predictive validity only within the qualified target domain"
      },
      {
        "stage": "professional_and_field_review",
        "examples": [
          "responsible engineering fire accessibility public-health and statutory review; measured field evidence"
        ],
        "proves": "only the specific review or field claim within appointed scope"
      }
    ],
    "prohibited_shortcuts": [
      "process_exit_zero_as_model_validity",
      "ASHRAE_140_as_project_calibration",
      "TMY_as_extreme_event",
      "synthetic_oracle_PASS_as_building_safety",
      "surrogate_prediction_as_final_high_fidelity_result"
    ]
  },
