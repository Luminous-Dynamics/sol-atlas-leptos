  "design_hypotheses": {
    "solar_control": "compare orientation, winter solar access and summer shading; do not hardcode orientation before site survey",
    "thermal": "compare mass, insulation, shading, glazing and night purge as interacting variables",
    "ventilation": "admit only where outdoor temperature, air quality, noise, security and weather conditions support it",
    "water": "consider harvesting, storage and safe reuse; keep potable and non-potable systems separated",
    "energy": "consider PV, battery, load management and local/manual fallback; no capacity selected",
    "landscape": "use locally appropriate low-irrigation shade and habitat planting with site-specific fire/maintenance review",
    "stormwater": "design drainage, overflow, rain gardens and swales as engineered infrastructure",
