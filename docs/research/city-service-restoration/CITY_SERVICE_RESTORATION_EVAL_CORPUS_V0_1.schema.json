                "enum": [
                  "not_started",
                  "in_progress",
                  "failed",
                  "completed",
                  "unknown"
                ]
              },
              "inspection_state": {
                "enum": [
                  "not_performed",
                  "pass",
                  "fail",
                  "unknown"
                ]
