{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/city-service-restoration-eval-corpus-v0.1.schema.json",
  "title": "CityMaker Service Restoration Evaluator Corpus v0.1",
