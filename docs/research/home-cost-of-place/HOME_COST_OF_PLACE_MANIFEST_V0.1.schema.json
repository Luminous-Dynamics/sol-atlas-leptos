{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home cost-of-place manifest v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "study_id",
    "maturity",
    "execution_status",
    "tenure_models",
    "scenarios",
    "hard_gates",
    "metrics",
    "comparators",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "study_id": {
      "const": "HOME-COST-OF-PLACE-001"
    },
    "maturity": {
      "const": "PROPOSED_NOT_EVALUATED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "tenure_models": {
      "type": "array",
      "minItems": 5
    },
    "scenarios": {
      "type": "array",
      "minItems": 10
    },
    "hard_gates": {
      "type": "array",
      "minItems": 7
    },
    "metrics": {
      "type": "array",
      "minItems": 10
    },
    "comparators": {
      "type": "array",
      "minItems": 5
    },
    "claim_ceiling": {
      "type": "string"
    }
  }
}
