{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/research/highveld-compound-disruption/HIGHVELD_COMPOUND_EVENT_V0.1.schema.json",
  "title": "Highveld Compound Disruption Synthetic Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "evidence_class",
    "claim_ceiling",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "const": "highveld-compound-disruption-synthetic-v0.1"
    },
    "evidence_class": {
      "const": "SyntheticControlledEvent"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scope": {
      "enum": [
        "regional",
        "system",
        "feeder",
        "site",
        "dwelling",
        "room",
        "tap",
        "service",
        "component",
        "repair_supply",
        "network"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "kind",
        "start_offset_s",
        "end_offset_s",
        "scope",
        "temporal_resolution_s"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "kind": {
          "enum": [
            "heat_episode",
            "hot_night",
            "cold_episode",
            "grid_interruption",
            "water_interruption",
            "outdoor_air_event",
            "ventilation_restriction",
            "component_fault",
            "replacement_part_delay",
            "network_interruption",
            "service_restoration",
            "system_status_notice",
            "observation_window"
          ]
        },
        "start_offset_s": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset_s": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "temporal_resolution_s": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "temporal_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_event_id",
        "right_event_id",
        "expected_relation",
        "rationale"
      ],
      "properties": {
        "left_event_id": {
          "type": "string"
        },
        "right_event_id": {
          "type": "string"
        },
        "expected_relation": {
          "enum": [
            "overlaps",
            "meets",
            "precedes",
            "follows",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_event_id",
        "to_event_id",
        "relation",
        "basis",
        "rationale"
      ],
      "properties": {
        "from_event_id": {
          "type": "string"
        },
        "to_event_id": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "depends_on",
            "common_cause",
            "co_occurs_only",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "synthetic_declaration",
            "source_supported",
            "unresolved"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_offset_s",
        "end_offset_s"
      ],
      "properties": {
        "start_offset_s": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "scope",
        "record_status",
        "coverage_window",
        "temporal_resolution_s"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "record_status": {
          "enum": [
            "reported_event",
            "observed_normal",
            "no_report",
            "censored",
            "unknown"
          ]
        },
        "coverage_window": {
          "$ref": "#/$defs/coverage_window"
        },
        "temporal_resolution_s": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "title",
        "evidence_class",
        "timeline_basis",
        "interval_convention",
        "events",
        "expected_temporal_relations",
        "semantic_links",
        "claim_ceiling",
        "scope_join_guards"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "const": "SyntheticControlledEvent"
        },
        "timeline_basis": {
          "const": "integer_seconds_from_scenario_t0"
        },
        "interval_convention": {
          "const": "half_open"
        },
        "events": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "expected_temporal_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporal_relation"
          }
        },
        "semantic_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semantic_link"
          }
        },
        "coverage_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_record"
          }
        },
        "capability_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "scope_join_guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope_join_guard"
          }
        }
      }
    },
    "scope_join_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left_event_id",
        "right_event_id",
        "expected_disposition",
        "rationale"
      ],
      "properties": {
        "left_event_id": {
          "type": "string"
        },
        "right_event_id": {
          "type": "string"
        },
        "expected_disposition": {
          "enum": [
            "COMPARABLE_WITHIN_DECLARED_SCOPE",
            "NOT_COMPARABLE",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
