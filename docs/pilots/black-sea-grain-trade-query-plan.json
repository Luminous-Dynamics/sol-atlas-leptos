  "request_policy": {
    "periods_per_request_target": 1,
    "rationale": "The unauthenticated public preview endpoint is intentionally queried at its narrowest documented product/period scope: one commodity and one month per request. Seven years × 12 months × 2 commodities = 168 requests. Do not assume the broader authenticated API's multi-period capabilities apply to preview. A separate opt-in 84-request reporter/month availability pass uses the public getDa route to provide context for empty preview results; it cannot qualify product/partner/flow availability.",
    "public_preview_record_limit": 500,
    "fail_closed_if_count_exceeds_returned_rows": true,
    "fail_closed_if_returned_rows_reach_preview_limit": true,
    "preserve_exact_request_url_and_parameters": true,
    "preserve_raw_response_bytes_before_parsing": true,
    "store_raw_sha256_and_retrieval_timestamp": true,
    "never_store_subscription_keys": true,
    "minimum_seconds_between_comtrade_requests": 1,
    "no_parallel_comtrade_requests": true,
    "default_capture_scope": "companion_artifacts_only",
    "comtrade_calls_require_explicit_flag": "--include-comtrade",
    "stop_after_first_http_429": true,
    "preserve_retry_after_header": true,
    "preview_reporter_query_parameter": "reportercode",
    "response_reporter_field": "reporterCode",
    "casing_note": "The maintained UN Comtrade Python client's public-preview request builder uses lowercase reportercode; the captured response row field used for dimension validation is reporterCode. The availability route follows the maintained client's public getDa path and lowercase reportercode parameter.",
    "availability_query_count_target": 84,
    "availability_calls_require_explicit_flag": "--include-availability",
    "availability_period_semantics": "One request per unique YYYYMM period and reporter; preserve all returned fields. This query does not filter or qualify commodity, partner, or flow.",
    "minimum_seconds_between_comtrade_api_requests": 1
  },
  "fields_policy": {
    "preserve_all_returned_fields": true,
    "retain_dimensions": [
      "period",
      "reporterCode",
      "partnerCode",
      "flowCode",
      "cmdCode",
      "classificationCode",
      "classificationSearchCode",
      "isReported",
      "isAggregate",
      "isEstimated",
      "primaryValue",
      "netWgt",
      "qty",
      "qtyUnitCode",
      "qtyUnitAbbr",
      "motCode",
      "customsCode"
    ],
    "interpret_only_after_metadata_review": [
      "primaryValue",
      "netWgt",
      "qty",
      "qtyUnitCode",
      "qtyUnitAbbr",
      "isEstimated",
      "isAggregate",
      "isReported"
    ],
    "no_implicit_unit_conversion": true,
    "no_missing_value_to_zero_conversion": true,
    "no_row_deduplication_without_documented_key": true,
    "availability_dimension_limit": "Availability responses can confirm only reporter/month records; do not infer HS commodity, world-partner aggregate or export-flow availability from this endpoint."
  },
  "interpretation_ceiling": {
    "allowed": "Reported monthly aggregate exports for Ukraine, world partner aggregate, and selected HS product codes, conditional on response coverage and returned metadata.",
    "not_established": [
      "Individual shipments, bills of lading, named suppliers, warehouse inventory or physical routes.",
      "Which Ukrainian exports moved under the Black Sea Grain Initiative.",
      "Port-level throughput or route availability.",
      "Causal effect of the Initiative or conflict on world prices, food security or destination shortages."
    ]
  },
  "control_design": {
    "state": "not_preregistered",
    "selected_controls": [],
    "policy": "After metadata and coverage inspection but before looking at outcome patterns, write a dated control-design record. Justify comparator exporters/commodities, seasonality, COVID-period treatment, missingness, concurrent shocks and sensitivity analyses. Do not choose, drop or swap controls based on which gives a preferred result.",
    "baseline_caveat": "2017-2021 is a candidate descriptive baseline and includes COVID-era shocks; it is not a sufficient causal control by itself."
  },
  "validation_gates": {
    "query_executed": false,
    "all_chunks_captured": false,
    "raw_response_hashes_verified": false,
    "api_schema_and_coverage_reviewed": false,
    "classification_compatibility_reviewed": false,
    "units_and_valuation_semantics_reviewed": false,
    "incomplete_or_estimated_rows_reviewed": false,
    "control_plan_preregistered": false,
    "independent_review_completed": false
  },
