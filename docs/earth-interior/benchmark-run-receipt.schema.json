{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/docs/earth-interior/benchmark-run-receipt.schema.json",
  "title": "Earth Interior Observatory benchmark run receipt",
  "description": "Machine-readable provenance and qualification record for one frozen benchmark execution. A valid receipt is evidence metadata, not by itself proof that claims are scientifically correct.",
  "$comment": "Qualification requires an independent verifier to compare the recorded code/configuration/source digests and recompute the declared gates. Never infer pass from queued, skipped, cancelled, stale-head, or missing CI checks. Truth artifacts must not be visible to an estimator until scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "benchmark_id",
    "benchmark_specification",
    "run",
    "code",
    "configuration",
    "environment",
    "qualification_status",
    "artifacts",
    "metrics",
    "controls",
    "gates",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "benchmark_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "git_commit_sha"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_commit_sha": {
          "$ref": "#/$defs/gitSha"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "outcome",
        "command"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "runner_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_url",
        "commit_sha",
        "worktree_state",
        "toolchain"
      ],
      "properties": {
        "repository_url": {
          "type": "string",
          "format": "uri"
        },
        "commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree_state": {
          "enum": [
            "clean",
            "dirty",
            "unknown"
          ]
        },
        "diff_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "lockfile_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "canonicalization",
        "randomness"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalization": {
          "type": "string",
          "minLength": 1
        },
        "randomness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "algorithm",
            "seeds"
          ],
          "properties": {
            "mode": {
              "enum": [
                "prng",
                "deterministic_no_rng",
                "external_randomness"
              ]
            },
            "algorithm": {
              "type": [
                "string",
                "null"
              ]
            },
            "seeds": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              },
              "uniqueItems": true
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "prng"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "algorithm": {
                    "type": "string",
                    "minLength": 1
                  },
                  "seeds": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "deterministic_no_rng"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "algorithm": {
                    "type": "null"
                  },
                  "seeds": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "architecture",
        "locale",
        "timezone"
      ],
      "properties": {
        "operating_system": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "numerical_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardware": {
          "type": [
            "object",
            "null"
          ]
        },
        "dependency_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "qualification_status": {
      "enum": [
        "executed_unqualified",
        "qualified_synthetic",
        "source_adapter_qualified",
        "real_observation_evaluated"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "qualification_evidence": {
      "$ref": "#/$defs/qualificationEvidence"
    },
    "source_adapter": {
      "$ref": "#/$defs/sourceAdapter"
    },
    "real_observation_evaluation": {
      "$ref": "#/$defs/realObservationEvaluation"
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_claim",
        "forbidden_claims"
      ],
      "properties": {
        "permitted_claim": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification_status": {
            "enum": [
              "qualified_synthetic",
              "source_adapter_qualified",
              "real_observation_evaluated"
            ]
          }
        },
        "required": [
          "qualification_status"
        ]
      },
      "then": {
        "required": [
          "qualification_evidence"
        ],
        "properties": {
          "gates": {
            "minItems": 1,
            "items": {
              "properties": {
                "decision": {
                  "const": "passed"
                }
              }
            }
          },
          "controls": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "passed"
                }
              }
            }
          },
          "metrics": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualification_status": {
            "const": "qualified_synthetic"
          }
        },
        "required": [
          "qualification_status"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "contains": {
              "properties": {
                "role": {
                  "const": "truth_state"
                },
                "selector_visibility": {
                  "const": "withheld_until_scoring"
                }
              },
              "required": [
                "role",
                "selector_visibility"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qualification_status": {
            "const": "source_adapter_qualified"
          }
        },
        "required": [
          "qualification_status"
        ]
      },
      "then": {
        "required": [
          "source_adapter"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "qualification_status": {
            "const": "real_observation_evaluated"
          }
        },
        "required": [
          "qualification_status"
        ]
      },
      "then": {
        "required": [
          "source_adapter",
          "real_observation_evaluation"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "locator",
        "sha256",
        "byte_length",
        "media_type",
        "selector_visibility"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "truth_state",
            "synthetic_observations",
            "real_observations",
            "source_payload",
            "source_manifest",
            "configuration",
            "posterior_or_estimate",
            "raw_metrics",
            "summary_report",
            "parser_output",
            "qualification_output",
            "other"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "selector_visibility": {
          "enum": [
            "visible_to_selector",
            "withheld_until_scoring",
            "not_applicable",
            "unknown"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "name",
        "value",
        "unit",
        "sample_count",
        "uncertainty_method"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "uncertainty_method": {
          "enum": [
            "exact",
            "analytic",
            "bootstrap",
            "jackknife",
            "bayesian_posterior",
            "frequentist_interval",
            "none"
          ]
        },
        "lower_bound": {
          "type": "number"
        },
        "upper_bound": {
          "type": "number"
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "aggregation": {
          "type": "string"
        }
      },
      "dependentRequired": {
        "lower_bound": [
          "upper_bound",
          "confidence_level"
        ],
        "upper_bound": [
          "lower_bound",
          "confidence_level"
        ],
        "confidence_level": [
          "lower_bound",
          "upper_bound"
        ]
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "kind",
        "expected_behavior",
        "observed_behavior",
        "result"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "null_signal",
            "correlated_duplicate",
            "timestamp_shuffle",
            "truth_leakage",
            "model_misspecification",
            "coverage_gap",
            "prior_dominance",
            "parser_integrity",
            "other"
          ]
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 1
        },
        "observed_behavior": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated"
          ]
        },
        "evidence_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "criterion",
        "decision"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated"
          ]
        },
        "evidence_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qualificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifier_repository_url",
        "verifier_commit_sha",
        "verifier_result_sha256",
        "verification_outcome"
      ],
      "properties": {
        "verifier_repository_url": {
          "type": "string",
          "format": "uri"
        },
        "verifier_commit_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "verifier_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_outcome": {
          "enum": [
            "accepted",
            "rejected",
            "incomplete"
          ]
        }
      }
    },
    "sourceAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_doi_or_uri",
        "dataset_version",
        "file_identifier",
        "provider_md5",
        "local_sha256",
        "parser_identity",
        "units_audit",
        "time_axis_audit",
        "variable_shape_audit"
      ],
      "properties": {
        "dataset_doi_or_uri": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "file_identifier": {
          "type": "string",
          "minLength": 1
        },
        "provider_md5": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "local_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parser_identity": {
          "type": "string",
          "minLength": 1
        },
        "units_audit": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "time_axis_audit": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "variable_shape_audit": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        }
      }
    },
    "realObservationEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_strategy",
        "holdout_manifest_sha256",
        "leakage_audit",
        "reference_overlap_audit",
        "baseline_identity"
      ],
      "properties": {
        "holdout_strategy": {
          "enum": [
            "contiguous_temporal",
            "blocked_spatial",
            "heldout_site",
            "external_dataset",
            "predeclared_other"
          ]
        },
        "holdout_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "leakage_audit": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "reference_overlap_audit": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "baseline_identity": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
