{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-decision-frontier-report-v0.1.schema.json",
  "title": "IEAC Decision-Time Evidence Frontier Report v0.1",
  "description": "Temporal classification report. Candidate inclusion relies on separately pinned verifier facts; this report does not establish final admission, source truth or history completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "input_sha256",
    "decision_case_id",
    "decision_cutoff_interval",
    "classifications",
    "candidate_as_known_evidence_ids",
    "later_available_evidence_ids",
    "unresolved_evidence_ids",
    "summary",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-decision-frontier-report.v0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision_case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decision_cutoff_interval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "earliest_epoch_seconds",
            "latest_epoch_seconds"
          ],
          "properties": {
            "earliest_epoch_seconds": {
              "type": "integer"
            },
            "latest_epoch_seconds": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "artifact_sha256",
          "as_known_status",
          "reason_code",
          "observed_before_cutoff_by_source_clock",
          "availability_interval"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "as_known_status": {
            "enum": [
              "candidate_included",
              "excluded_after_cutoff",
              "unknown"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observed_before_cutoff_by_source_clock": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "availability_interval": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "earliest_epoch_seconds",
                  "latest_epoch_seconds"
                ],
                "properties": {
                  "earliest_epoch_seconds": {
                    "type": "integer"
                  },
                  "latest_epoch_seconds": {
                    "type": "integer"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "candidate_as_known_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "later_available_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unresolved_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_count",
        "candidate_as_known_count",
        "excluded_after_cutoff",
        "unknown",
        "history_completeness"
      ],
      "properties": {
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_as_known_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_after_cutoff": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "history_completeness": {
          "const": "not_established"
        }
      }
    },
    "claim_ceiling": {
      "const": "historical_information_boundary_only"
    },
    "action_authority": {
      "const": "none"
    }
  }
}
