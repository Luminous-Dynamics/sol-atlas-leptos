{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/eo-agent-assurance-result-v0.1.schema.json",
  "title": "Earth Observation Agent Assurance Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "manifest_sha256",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark_id": {
      "const": "EO_AGENT_ASSURANCE_001"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "tag",
        "factual",
        "provenance_complete",
        "source_refs",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "factual": {
          "type": "boolean"
        },
        "provenance_complete": {
          "type": "boolean"
        },
        "source_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "toolEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "attempt",
        "idempotency_key",
        "request_digest",
        "response_digest"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "request_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "response_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "disposition",
        "reason_codes",
        "claims",
        "source_refs",
        "evidence_refs",
        "used_purposes",
        "actions_attempted",
        "authority_asserted",
        "execution",
        "metrics",
        "replay"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^EOAA-[0-9]{3}$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "candidate_change_for_review",
            "no_change_within_envelope",
            "unresolved",
            "blocked",
            "request_more_evidence",
            "reopen_for_revalidation"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/stringArray"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringArray"
        },
        "used_purposes": {
          "$ref": "#/$defs/stringArray"
        },
        "actions_attempted": {
          "$ref": "#/$defs/stringArray"
        },
        "authority_asserted": {
          "type": "boolean"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retry_count",
            "unique_claim_ids",
            "tool_events"
          ],
          "properties": {
            "retry_count": {
              "type": "integer",
              "minimum": 0
            },
            "unique_claim_ids": {
              "$ref": "#/$defs/stringArray"
            },
            "tool_events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/toolEvent"
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numeric_values": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "geometry_iou": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "event_time_interval": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "statistical_significance_claimed": {
              "type": "boolean"
            },
            "prior_claim_revalidated_or_superseded": {
              "type": "boolean"
            },
            "derivative_lineage_reviewed": {
              "type": "boolean"
            }
          }
        },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "deterministic",
            "result_digest",
            "replay_digest"
          ],
          "properties": {
            "verified": {
              "type": "boolean"
            },
            "deterministic": {
              "type": "boolean"
            },
            "result_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "replay_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "source_refs": {
          "$ref": "#/$defs/stringArray"
        }
      }
    }
  }
}
