{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ieac-risk-control-truth-table-v0.2.schema.json",
  "title": "IEAC Risk Control Selector Truth Table v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_schema_version",
    "fixture_status",
    "note",
    "case_count",
    "cases"
  ],
  "properties": {
    "fixture_schema_version": {
      "const": "luminous.ieac-risk-control-truth-table.v0.2"
    },
    "fixture_status": {
      "const": "synthetic_only"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "case_count": {
      "const": 50
    },
    "cases": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_class",
          "decision_tier",
          "reviewed_class",
          "risk_dimensions",
          "expected_risk_assessment_state",
          "expected_control_ids"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "case_class": {
            "enum": [
              "dimension_value",
              "conflicted_alias",
              "reviewed_class",
              "decision_tier",
              "compound_trigger"
            ]
          },
          "decision_tier": {
            "enum": [
              "D0_descriptive",
              "D1_advisory",
              "D2_delegated_planning",
              "D3_autonomous_control"
            ]
          },
          "reviewed_class": {
            "enum": [
              "low",
              "moderate",
              "high",
              "critical",
              "unassessed"
            ]
          },
          "risk_dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "consequence",
              "model_influence",
              "exposure",
              "reversibility",
              "detectability",
              "fallback"
            ],
            "properties": {
              "consequence": {
                "enum": [
                  "negligible",
                  "minor",
                  "major",
                  "severe",
                  "catastrophic",
                  "unknown",
                  "conflicted"
                ]
              },
              "model_influence": {
                "enum": [
                  "informational",
                  "advisory",
                  "constraint_gating",
                  "selection",
                  "direct_actuation",
                  "unknown",
                  "conflicted"
                ]
              },
              "exposure": {
                "enum": [
                  "single_asset",
                  "site_or_facility",
                  "multi_site",
                  "regional",
                  "national_or_larger",
                  "unknown",
                  "conflicted"
                ]
              },
              "reversibility": {
                "enum": [
                  "readily_reversible",
                  "costly_or_delayed",
                  "difficult_or_irreversible",
                  "unknown",
                  "conflicted"
                ]
              },
              "detectability": {
                "enum": [
                  "immediate_and_reliable",
                  "delayed_or_partial",
                  "poor",
                  "unknown",
                  "conflicted"
                ]
              },
              "fallback": {
                "enum": [
                  "independent_tested_fallback",
                  "human_fallback",
                  "degraded_fallback",
                  "no_verified_fallback",
                  "unknown",
                  "conflicted"
                ]
              }
            }
          },
          "expected_risk_assessment_state": {
            "enum": [
              "reviewed",
              "contains_unknown",
              "contains_conflicted",
              "unassessed"
            ]
          },
          "expected_control_ids": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "enum": [
                "artifact_identity_integrity",
                "schema_interface_conformance",
                "source_rights_lineage",
                "numerical_known_answers",
                "unit_semantics_validation",
                "physical_reference_validation",
                "uncertainty_calibration",
                "out_of_domain_abstention",
                "human_review_override",
                "operational_monitoring",
                "prospective_outcome_reconciliation",
                "independent_constraint_reconstruction",
                "group_disjoint_holdout",
                "compound_fault_stress",
                "rollback_recovery_test",
                "dual_control_authorization",
                "shadow_hardware_in_loop_trial",
                "safe_fallback_validation",
                "independent_safety_case",
                "hazard_analysis",
                "independent_safety_assessment",
                "secure_control_boundary",
                "hardware_in_loop_qualification",
                "fail_safe_emergency_stop",
                "continuous_requalification",
                "field_operational_authorization",
                "cross_site_replication",
                "drift_detection",
                "common_cause_scenario_test",
                "regional_failover_drill",
                "staged_rollout",
                "incident_response_playbook",
                "independent_monitoring",
                "redundant_measurement",
                "human_response_sla",
                "degraded_mode_qualification",
                "tested_safe_stop",
                "request_measurement_or_abstain"
              ]
            }
          }
        }
      }
    }
  }
}
