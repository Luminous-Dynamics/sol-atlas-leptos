{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-cause-report-v0.1.schema.json",
  "title": "Sol-Atlas Heritage Change-Cause Evaluation Report",
  "description": "Multi-label cause classification metrics conditional on non-abstained, fully adjudicated samples. Unknown labels are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_count",
    "complete_cause_label_count",
    "confirmed_no_change_count",
    "unknown_label_count",
    "eligible_labelled_count",
    "covered_count",
    "abstained_count",
    "coverage",
    "supported_macro_f1",
    "predicted_archaeological_claim_count",
    "true_archaeological_claim_count",
    "false_archaeological_claim_count",
    "archaeological_claim_precision",
    "false_archaeological_claims_per_100_covered_samples",
    "cause_threshold",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-cause-evaluation.v0.1"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "complete_cause_label_count": {
      "type": "integer",
      "minimum": 0
    },
    "confirmed_no_change_count": {
      "type": "integer",
      "minimum": 0
    },
    "unknown_label_count": {
      "type": "integer",
      "minimum": 0
    },
    "eligible_labelled_count": {
      "type": "integer",
      "minimum": 0
    },
    "covered_count": {
      "type": "integer",
      "minimum": 0
    },
    "abstained_count": {
      "type": "integer",
      "minimum": 0
    },
    "coverage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "supported_macro_f1": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "predicted_archaeological_claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "true_archaeological_claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "false_archaeological_claim_count": {
      "type": "integer",
      "minimum": 0
    },
    "archaeological_claim_precision": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "false_archaeological_claims_per_100_covered_samples": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cause_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "classes": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cause",
          "support_count",
          "predicted_positive_count",
          "true_positive",
          "false_positive",
          "false_negative",
          "precision",
          "recall",
          "f1",
          "brier_score"
        ],
        "properties": {
          "cause": {
            "enum": [
              "archaeological_excavation_looting",
              "agriculture_cultivation",
              "seasonal_vegetation_phenology",
              "erosion_geomorphic",
              "hydrology_flood",
              "fire_vegetation_clearance",
              "modern_construction_infrastructure",
              "quarry_mining",
              "military_conflict",
              "sensor_processing_artifact",
              "other_known_cause"
            ]
          },
          "support_count": {
            "type": "integer",
            "minimum": 0
          },
          "predicted_positive_count": {
            "type": "integer",
            "minimum": 0
          },
          "true_positive": {
            "type": "integer",
            "minimum": 0
          },
          "false_positive": {
            "type": "integer",
            "minimum": 0
          },
          "false_negative": {
            "type": "integer",
            "minimum": 0
          },
          "precision": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "recall": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "f1": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "brier_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
