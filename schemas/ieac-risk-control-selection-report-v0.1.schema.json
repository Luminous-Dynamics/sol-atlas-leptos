{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ieac-risk-control-selection-report-v0.1.schema.json",
  "title": "IEAC Risk Control Selection Report v0.1",
  "description": "Auditable requirements report. Does not establish control evidence, qualify a profile, change its tier or authorize external action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "selector_version",
    "selector_build_id",
    "evaluated_at",
    "decision_tier",
    "indeterminate",
    "selector_status",
    "required_controls",
    "controls_with_reported_verified_evidence",
    "controls_missing_or_unverified",
    "human_approval_controls",
    "operational_obligations",
    "reason_codes",
    "action_authority",
    "qualification_attested"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-risk-control-selection-report.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selector_version": {
      "const": "0.1.0"
    },
    "selector_build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evaluated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "decision_tier": {
      "enum": [
        "D0_descriptive",
        "D1_advisory",
        "D2_delegated_planning",
        "D3_autonomous_control"
      ]
    },
    "indeterminate": {
      "type": "boolean"
    },
    "selector_status": {
      "enum": [
        "requirements_selected",
        "indeterminate_requirements"
      ]
    },
    "required_controls": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "description",
          "reason_codes",
          "human_approval",
          "obligations",
          "evidence_status",
          "evidence_artifact_sha256",
          "evidence_verifier_id"
        ],
        "properties": {
          "control_id": {
            "enum": [
              "artifact_identity_integrity",
              "schema_interface_conformance",
              "source_rights_lineage",
              "numerical_known_answers",
              "unit_semantics_validation",
              "physical_reference_validation",
              "uncertainty_calibration",
              "out_of_domain_abstention",
              "human_review_override",
              "operational_monitoring",
              "prospective_outcome_reconciliation",
              "independent_constraint_reconstruction",
              "group_disjoint_holdout",
              "compound_fault_stress",
              "rollback_recovery_test",
              "dual_control_authorization",
              "shadow_hardware_in_loop_trial",
              "safe_fallback_validation",
              "independent_safety_case",
              "hazard_analysis",
              "independent_safety_assessment",
              "secure_control_boundary",
              "hardware_in_loop_qualification",
              "fail_safe_emergency_stop",
              "continuous_requalification",
              "field_operational_authorization",
              "cross_site_replication",
              "drift_detection",
              "common_cause_scenario_test",
              "regional_failover_drill",
              "staged_rollout",
              "incident_response_playbook",
              "independent_monitoring",
              "redundant_measurement",
              "human_response_sla",
              "degraded_mode_qualification",
              "tested_safe_stop",
              "request_measurement_or_abstain"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "human_approval": {
            "type": "boolean"
          },
          "obligations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "evidence_status": {
            "enum": [
              "missing",
              "reported_verified",
              "unverified",
              "stale",
              "conflicted"
            ]
          },
          "evidence_artifact_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "evidence_verifier_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      }
    },
    "controls_with_reported_verified_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "artifact_identity_integrity",
          "schema_interface_conformance",
          "source_rights_lineage",
          "numerical_known_answers",
          "unit_semantics_validation",
          "physical_reference_validation",
          "uncertainty_calibration",
          "out_of_domain_abstention",
          "human_review_override",
          "operational_monitoring",
          "prospective_outcome_reconciliation",
          "independent_constraint_reconstruction",
          "group_disjoint_holdout",
          "compound_fault_stress",
          "rollback_recovery_test",
          "dual_control_authorization",
          "shadow_hardware_in_loop_trial",
          "safe_fallback_validation",
          "independent_safety_case",
          "hazard_analysis",
          "independent_safety_assessment",
          "secure_control_boundary",
          "hardware_in_loop_qualification",
          "fail_safe_emergency_stop",
          "continuous_requalification",
          "field_operational_authorization",
          "cross_site_replication",
          "drift_detection",
          "common_cause_scenario_test",
          "regional_failover_drill",
          "staged_rollout",
          "incident_response_playbook",
          "independent_monitoring",
          "redundant_measurement",
          "human_response_sla",
          "degraded_mode_qualification",
          "tested_safe_stop",
          "request_measurement_or_abstain"
        ]
      }
    },
    "controls_missing_or_unverified": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "artifact_identity_integrity",
          "schema_interface_conformance",
          "source_rights_lineage",
          "numerical_known_answers",
          "unit_semantics_validation",
          "physical_reference_validation",
          "uncertainty_calibration",
          "out_of_domain_abstention",
          "human_review_override",
          "operational_monitoring",
          "prospective_outcome_reconciliation",
          "independent_constraint_reconstruction",
          "group_disjoint_holdout",
          "compound_fault_stress",
          "rollback_recovery_test",
          "dual_control_authorization",
          "shadow_hardware_in_loop_trial",
          "safe_fallback_validation",
          "independent_safety_case",
          "hazard_analysis",
          "independent_safety_assessment",
          "secure_control_boundary",
          "hardware_in_loop_qualification",
          "fail_safe_emergency_stop",
          "continuous_requalification",
          "field_operational_authorization",
          "cross_site_replication",
          "drift_detection",
          "common_cause_scenario_test",
          "regional_failover_drill",
          "staged_rollout",
          "incident_response_playbook",
          "independent_monitoring",
          "redundant_measurement",
          "human_response_sla",
          "degraded_mode_qualification",
          "tested_safe_stop",
          "request_measurement_or_abstain"
        ]
      }
    },
    "human_approval_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "artifact_identity_integrity",
          "schema_interface_conformance",
          "source_rights_lineage",
          "numerical_known_answers",
          "unit_semantics_validation",
          "physical_reference_validation",
          "uncertainty_calibration",
          "out_of_domain_abstention",
          "human_review_override",
          "operational_monitoring",
          "prospective_outcome_reconciliation",
          "independent_constraint_reconstruction",
          "group_disjoint_holdout",
          "compound_fault_stress",
          "rollback_recovery_test",
          "dual_control_authorization",
          "shadow_hardware_in_loop_trial",
          "safe_fallback_validation",
          "independent_safety_case",
          "hazard_analysis",
          "independent_safety_assessment",
          "secure_control_boundary",
          "hardware_in_loop_qualification",
          "fail_safe_emergency_stop",
          "continuous_requalification",
          "field_operational_authorization",
          "cross_site_replication",
          "drift_detection",
          "common_cause_scenario_test",
          "regional_failover_drill",
          "staged_rollout",
          "incident_response_playbook",
          "independent_monitoring",
          "redundant_measurement",
          "human_response_sla",
          "degraded_mode_qualification",
          "tested_safe_stop",
          "request_measurement_or_abstain"
        ]
      }
    },
    "operational_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "action_authority": {
      "const": "none"
    },
    "qualification_attested": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "indeterminate": {
            "const": true
          }
        },
        "required": [
          "indeterminate"
        ]
      },
      "then": {
        "properties": {
          "selector_status": {
            "const": "indeterminate_requirements"
          }
        }
      },
      "else": {
        "properties": {
          "selector_status": {
            "const": "requirements_selected"
          }
        }
      }
    }
  ]
}
