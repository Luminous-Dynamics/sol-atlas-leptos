{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ieac-risk-control-selection-report-v0.1.schema.json",
  "title": "IEAC Risk Control Selection Report v0.1",
  "description": "Auditable requirements report derived from an IEAC profile. It does not establish control evidence, qualify a profile, change its tier or authorize external action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "decision_tier",
    "risk_assessment_state",
    "risk_assessment_class",
    "risk_dimensions",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "selector_version",
    "selector_build_id",
    "input_profile_sha256",
    "required_controls",
    "controls_with_evidence",
    "missing_controls",
    "unknown_controls",
    "conflicted_controls",
    "not_applicable_controls",
    "human_approvals",
    "operational_obligations",
    "tier_compatibility",
    "requirements_disposition",
    "independent_qualification_attested",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-risk-control-selection-report.v0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decision_tier": {
      "enum": [
        "D0_descriptive",
        "D1_advisory",
        "D2_delegated_planning",
        "D3_autonomous_control"
      ]
    },
    "risk_assessment_state": {
      "enum": [
        "reviewed",
        "contains_unknown",
        "contains_conflicted",
        "unassessed"
      ]
    },
    "risk_assessment_class": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical",
        "unassessed"
      ]
    },
    "risk_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consequence",
        "model_influence",
        "exposure",
        "reversibility",
        "detectability",
        "fallback"
      ],
      "properties": {
        "consequence": {
          "enum": [
            "negligible",
            "minor",
            "major",
            "severe",
            "catastrophic",
            "unknown",
            "conflicted"
          ]
        },
        "model_influence": {
          "enum": [
            "informational",
            "advisory",
            "constraint_gating",
            "selection",
            "direct_actuation",
            "unknown",
            "conflicted"
          ]
        },
        "exposure": {
          "enum": [
            "single_asset",
            "site_or_facility",
            "multi_site",
            "regional",
            "national_or_larger",
            "unknown",
            "conflicted"
          ]
        },
        "reversibility": {
          "enum": [
            "readily_reversible",
            "costly_or_delayed",
            "difficult_or_irreversible",
            "unknown",
            "conflicted"
          ]
        },
        "detectability": {
          "enum": [
            "immediate_and_reliable",
            "delayed_or_partial",
            "poor",
            "unknown",
            "conflicted"
          ]
        },
        "fallback": {
          "enum": [
            "independent_tested_fallback",
            "human_fallback",
            "degraded_fallback",
            "no_verified_fallback",
            "unknown",
            "conflicted"
          ]
        }
      }
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selector_version": {
      "const": "0.2.0"
    },
    "selector_build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_controls": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "evidence_dimension",
          "description",
          "evidence_state",
          "evidence_count",
          "human_approval",
          "obligations",
          "reason_codes"
        ],
        "properties": {
          "control_id": {
            "enum": [
              "artifact_identity_integrity",
              "schema_interface_conformance",
              "source_rights_lineage",
              "numerical_known_answers",
              "unit_semantics_validation",
              "physical_reference_validation",
              "uncertainty_calibration",
              "out_of_domain_abstention",
              "human_review_override",
              "operational_monitoring",
              "prospective_outcome_reconciliation",
              "independent_constraint_reconstruction",
              "group_disjoint_holdout",
              "compound_fault_stress",
              "rollback_recovery_test",
              "dual_control_authorization",
              "shadow_hardware_in_loop_trial",
              "safe_fallback_validation",
              "independent_safety_case",
              "hazard_analysis",
              "independent_safety_assessment",
              "secure_control_boundary",
              "hardware_in_loop_qualification",
              "fail_safe_emergency_stop",
              "continuous_requalification",
              "field_operational_authorization",
              "cross_site_replication",
              "drift_detection",
              "common_cause_scenario_test",
              "regional_failover_drill",
              "staged_rollout",
              "incident_response_playbook",
              "independent_monitoring",
              "redundant_measurement",
              "human_response_sla",
              "degraded_mode_qualification",
              "tested_safe_stop",
              "request_measurement_or_abstain"
            ]
          },
          "evidence_dimension": {
            "enum": [
              "software_conformance",
              "numerical_verification",
              "physical_validation",
              "data_integrity_rights",
              "uncertainty_credibility",
              "generalization",
              "robustness",
              "operational_assurance",
              "safety_security_authority",
              "prospective_outcomes"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "evidence_state": {
            "enum": [
              "established",
              "missing",
              "unknown",
              "conflicted",
              "not_applicable"
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
          },
          "human_approval": {
            "type": "boolean"
          },
          "obligations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          }
        }
      }
    },
