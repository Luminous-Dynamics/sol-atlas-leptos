    "operational_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "tier_compatibility": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "requirements_disposition": {
      "enum": [
        "requirements_satisfied",
        "requirements_missing",
        "indeterminate"
      ]
    },
    "independent_qualification_attested": {
      "const": false
    },
    "action_authority": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier_compatibility": {
            "const": "blocked"
          }
        },
        "required": [
          "tier_compatibility"
        ]
      },
      "then": {
        "properties": {
          "requirements_disposition": {
            "const": "indeterminate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_assessment_state": {
            "enum": [
              "contains_unknown",
              "contains_conflicted",
              "unassessed"
            ]
          }
        },
        "required": [
          "risk_assessment_state"
        ]
      },
      "then": {
        "properties": {
          "requirements_disposition": {
            "const": "indeterminate"
          }
        }
      }
    }
  ]
