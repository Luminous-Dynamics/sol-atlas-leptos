{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-storage-request-v0.1.schema.json",
  "title": "Energy storage request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "storage_id", "synthetic", "carrier", "thermal_temperature_c", "capacity_kwh",
    "opening_energy_kwh", "max_charge_power_kw", "max_discharge_power_kw",
    "charge_efficiency", "discharge_efficiency", "standing_loss_fraction_per_hour",
    "terminal_reserve_kwh", "evidence_class", "intervals"
  ],
  "properties": {
    "schema_version": { "const": "energy-storage-v0.1" },
    "storage_id": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "carrier": { "type": "string", "enum": ["electricity", "thermal_heat"] },
    "thermal_temperature_c": { "type": ["number", "null"] },
    "capacity_kwh": { "type": "number", "minimum": 0 },
    "opening_energy_kwh": { "type": "number", "minimum": 0 },
    "max_charge_power_kw": { "type": "number", "minimum": 0 },
    "max_discharge_power_kw": { "type": "number", "minimum": 0 },
    "charge_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "discharge_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "standing_loss_fraction_per_hour": { "type": "number", "minimum": 0, "maximum": 1 },
    "terminal_reserve_kwh": { "type": "number", "minimum": 0 },
    "evidence_class": {
      "type": "string",
      "enum": ["analyst_assumption", "published_model", "component_test", "field_pilot", "operating_plant", "replicated_fleet", "independently_audited"]
    },
    "evidence_ref": { "type": ["string", "null"] },
    "evidence_as_of": { "type": ["string", "null"] },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interval_id", "duration_hours", "charge_available_kwh", "discharge_requested_kwh"],
        "properties": {
          "interval_id": { "type": "string", "minLength": 1 },
          "duration_hours": { "type": "number", "exclusiveMinimum": 0 },
          "charge_available_kwh": { "type": "number", "minimum": 0 },
          "discharge_requested_kwh": { "type": "number", "minimum": 0 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "charge_available_kwh": { "exclusiveMinimum": 0 } },
              "required": ["charge_available_kwh"]
            },
            "then": { "properties": { "discharge_requested_kwh": { "const": 0 } } }
          },
          {
            "if": {
              "properties": { "discharge_requested_kwh": { "exclusiveMinimum": 0 } },
              "required": ["discharge_requested_kwh"]
            },
            "then": { "properties": { "charge_available_kwh": { "const": 0 } } }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "carrier": { "const": "thermal_heat" } },
        "required": ["carrier"]
      },
      "then": {
        "properties": { "thermal_temperature_c": { "type": "number" } }
      },
      "else": {
        "properties": { "thermal_temperature_c": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_class": { "not": { "const": "analyst_assumption" } }
        },
        "required": ["evidence_class"]
      },
      "then": {
        "required": ["evidence_ref"],
        "properties": {
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
