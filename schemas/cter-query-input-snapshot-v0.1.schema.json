{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cter-query-input-snapshot-v0.1.schema.json",
  "title": "CTER query input snapshot v0.1",
  "description": "Custodian-side frozen query-input projection bound to a named frontier and predicate. Hash validity is not source truth or source-owner attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_ref",
    "profile_ref",
    "frontier_ref",
    "frontier_version",
    "frontier_commitment",
    "query_profile_ref",
    "query_commitment",
    "attribute_projection_profile_ref",
    "items",
    "snapshot_commitment"
  ],
  "properties": {
    "schema": {
      "const": "luminous.cter.query-input-snapshot.v0.1"
    },
    "snapshot_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "profile_ref": {
      "const": "urn:luminous:cter:query-input-json-v0.1"
    },
    "frontier_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "frontier_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "frontier_commitment": {
      "$ref": "#/$defs/sha256_digest"
    },
    "query_profile_ref": {
      "const": "urn:luminous:cter:predicate-json-v0.1"
    },
    "query_commitment": {
      "$ref": "#/$defs/sha256_digest"
    },
    "attribute_projection_profile_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "snapshot_commitment": {
      "$ref": "#/$defs/sha256_digest",
      "description": "SHA-256 over the domain-separated JCS canonical snapshot preimage. It is not an owner signature."
    }
  },
  "$defs": {
    "opaque_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\\\s]+$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "scalar": {
      "type": [
        "string",
        "boolean",
        "number",
        "null"
      ],
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "availability_state",
        "attribute_source_bindings"
      ],
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "availability_state": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "query_input": {
          "type": "object",
          "description": "Private attribute projection consumed by the query predicate. Never copied to public verifier views.",
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        },
        "attribute_source_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute_source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability_state": {
                "const": "available"
              }
            },
            "required": [
              "availability_state"
            ]
          },
          "then": {
            "required": [
              "query_input"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "availability_state": {
                "enum": [
                  "unavailable",
                  "unknown"
                ]
              }
            },
            "required": [
              "availability_state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "query_input"
              ]
            }
          }
        }
      ]
    },
    "attribute_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_object_ref",
        "source_content_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "source_object_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "source_content_digest": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    }
  }
}
