{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-storage-report-v1.schema.json",
  "title": "Energy storage assessment report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "assessment"],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_version", "evaluator_version", "digest_algorithm", "digest_scope",
        "input_sha256", "assessment_sha256", "input_bytes", "storage_id", "synthetic",
        "claim_ceiling", "verification_boundary"
      ],
      "properties": {
        "receipt_schema_version": { "const": "1" },
        "evaluator_version": { "const": "energy-storage-v0.1" },
        "digest_algorithm": { "const": "SHA-256" },
        "digest_scope": { "const": "exact_input_bytes_and_compact_assessment_json" },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assessment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "storage_id": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "verification_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_schema_version", "storage_id", "carrier", "thermal_temperature_c", "synthetic", "claim_ceiling",
        "initial_energy_kwh", "final_energy_kwh", "capacity_kwh", "terminal_reserve_kwh",
        "terminal_reserve_met", "terminal_reserve_shortfall_kwh", "total_charge_accepted_kwh",
        "total_charge_curtailed_kwh", "total_discharge_delivered_kwh", "total_discharge_unserved_kwh",
        "total_standing_loss_kwh", "total_charging_loss_kwh", "total_discharging_loss_kwh",
        "total_loss_kwh", "trajectory_balance_residual_kwh", "evidence_class", "evidence_ref",
        "evidence_as_of", "intervals"
      ],
      "properties": {
        "assessment_schema_version": { "const": "1" },
        "storage_id": { "type": "string", "minLength": 1 },
        "carrier": { "type": "string", "enum": ["electricity", "thermal_heat"] },
        "thermal_temperature_c": { "type": ["number", "null"] },
        "synthetic": { "type": "boolean" },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "initial_energy_kwh": { "type": "number", "minimum": 0 },
        "final_energy_kwh": { "type": "number", "minimum": 0 },
        "capacity_kwh": { "type": "number", "minimum": 0 },
        "terminal_reserve_kwh": { "type": "number", "minimum": 0 },
        "terminal_reserve_met": { "type": "boolean" },
        "terminal_reserve_shortfall_kwh": { "type": "number", "minimum": 0 },
        "total_charge_accepted_kwh": { "type": "number", "minimum": 0 },
        "total_charge_curtailed_kwh": { "type": "number", "minimum": 0 },
        "total_discharge_delivered_kwh": { "type": "number", "minimum": 0 },
        "total_discharge_unserved_kwh": { "type": "number", "minimum": 0 },
        "total_standing_loss_kwh": { "type": "number", "minimum": 0 },
        "total_charging_loss_kwh": { "type": "number", "minimum": 0 },
        "total_discharging_loss_kwh": { "type": "number", "minimum": 0 },
        "total_loss_kwh": { "type": "number", "minimum": 0 },
        "trajectory_balance_residual_kwh": { "type": "number" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "evidence_ref": { "type": ["string", "null"] },
        "evidence_as_of": { "type": ["string", "null"] },
        "intervals": { "type": "array", "items": { "$ref": "#/$defs/intervalAssessment" } }
      },
      "allOf": [
        {
          "if": {
            "properties": { "carrier": { "const": "thermal_heat" } },
            "required": ["carrier"]
          },
          "then": {
            "properties": { "thermal_temperature_c": { "type": "number" } }
          },
          "else": {
            "properties": { "thermal_temperature_c": { "type": "null" } }
          }
        }
      ]
    }
  },
  "$defs": {
    "evidenceClass": {
      "type": "string",
      "enum": ["analyst_assumption", "published_model", "component_test", "field_pilot", "operating_plant", "replicated_fleet", "independently_audited"]
    },
    "intervalAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_id", "duration_hours", "opening_energy_kwh", "standing_loss_kwh",
        "energy_after_standing_loss_kwh", "charge_available_kwh", "charge_accepted_kwh",
        "charge_curtailed_kwh", "stored_charge_gain_kwh", "charging_loss_kwh",
        "discharge_requested_kwh", "discharge_delivered_kwh", "discharge_unserved_kwh",
        "stored_energy_withdrawn_kwh", "discharging_loss_kwh", "closing_energy_kwh",
        "energy_balance_residual_kwh"
      ],
      "properties": {
        "interval_id": { "type": "string", "minLength": 1 },
        "duration_hours": { "type": "number", "exclusiveMinimum": 0 },
        "opening_energy_kwh": { "type": "number", "minimum": 0 },
        "standing_loss_kwh": { "type": "number", "minimum": 0 },
        "energy_after_standing_loss_kwh": { "type": "number", "minimum": 0 },
        "charge_available_kwh": { "type": "number", "minimum": 0 },
        "charge_accepted_kwh": { "type": "number", "minimum": 0 },
        "charge_curtailed_kwh": { "type": "number", "minimum": 0 },
        "stored_charge_gain_kwh": { "type": "number", "minimum": 0 },
        "charging_loss_kwh": { "type": "number", "minimum": 0 },
        "discharge_requested_kwh": { "type": "number", "minimum": 0 },
        "discharge_delivered_kwh": { "type": "number", "minimum": 0 },
        "discharge_unserved_kwh": { "type": "number", "minimum": 0 },
        "stored_energy_withdrawn_kwh": { "type": "number", "minimum": 0 },
        "discharging_loss_kwh": { "type": "number", "minimum": 0 },
        "closing_energy_kwh": { "type": "number", "minimum": 0 },
        "energy_balance_residual_kwh": { "type": "number" }
      }
    }
  }
}
