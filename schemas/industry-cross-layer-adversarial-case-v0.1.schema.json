{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-cross-layer-adversarial-case-v0.1.schema.json",
  "title": "IEAC Cross-Layer Adversarial Case v0.1",
  "description": "Frozen synthetic expected-gate vector. It is not a verifier result, evidence of real attacks, or an authorization decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_status",
    "case_id",
    "scenario",
    "mutations",
    "gates",
    "claim_ceiling",
    "expected_disposition",
    "expected_blocking_gate_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-cross-layer-adversarial-case.v0.1"
    },
    "fixture_status": {
      "const": "synthetic_only"
    },
    "case_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "mutations": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "state",
          "mandatory",
          "evidence_sha256"
        ],
        "properties": {
          "gate_id": {
            "enum": [
              "statement_signature",
              "statement_issuer_authorization",
              "receipt_issuer_policy",
              "receipt_to_statement_binding",
              "vds_inclusion",
              "same_ts_consistency",
              "cross_ts_statement_coverage",
              "witness_operator_independence",
              "issuer_history_completeness",
              "source_identity_and_lineage",
              "source_rights",
              "source_freshness",
              "source_semantics_and_units",
              "holder_key_binding",
              "presentation_case_and_audience_binding",
              "ieac_admission",
              "action_authorization",
              "execution_receipt",
              "outcome_receipt_binding",
              "outcome_missingness",
              "causal_claim_ceiling",
              "verifier_build_provenance"
            ]
          },
          "state": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "evidence_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "mandatory": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "pass"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    },
    "claim_ceiling": {
      "enum": [
        "record_only",
        "observation_only",
        "before_after_difference",
        "descriptive_association",
        "not_identified",
        "incomplete_or_indeterminate"
      ]
    },
    "expected_disposition": {
      "enum": [
        "admit_descriptive",
        "abstain",
        "reject"
      ]
    },
    "expected_blocking_gate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "statement_signature",
          "statement_issuer_authorization",
          "receipt_issuer_policy",
          "receipt_to_statement_binding",
          "vds_inclusion",
          "same_ts_consistency",
          "cross_ts_statement_coverage",
          "witness_operator_independence",
          "issuer_history_completeness",
          "source_identity_and_lineage",
          "source_rights",
          "source_freshness",
          "source_semantics_and_units",
          "holder_key_binding",
          "presentation_case_and_audience_binding",
          "ieac_admission",
          "action_authorization",
          "execution_receipt",
          "outcome_receipt_binding",
          "outcome_missingness",
          "causal_claim_ceiling",
          "verifier_build_provenance"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gates": {
            "contains": {
              "properties": {
                "mandatory": {
                  "const": true
                },
                "state": {
                  "const": "fail"
                }
              },
              "required": [
                "mandatory",
                "state"
              ]
            }
          }
        },
        "required": [
          "gates"
        ]
      },
      "then": {
        "properties": {
          "expected_disposition": {
            "const": "reject"
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "gates": {
              "contains": {
                "properties": {
                  "mandatory": {
                    "const": true
                  },
                  "state": {
                    "const": "fail"
                  }
                },
                "required": [
                  "mandatory",
                  "state"
                ]
              }
            }
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "gates": {
              "contains": {
                "properties": {
                  "mandatory": {
                    "const": true
                  },
                  "state": {
                    "const": "unknown"
                  }
                },
                "required": [
                  "mandatory",
                  "state"
                ]
              }
            }
          },
          "required": [
            "gates"
          ]
        },
        "then": {
          "properties": {
            "expected_disposition": {
              "const": "abstain"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_disposition": {
            "const": "admit_descriptive"
          }
        },
        "required": [
          "expected_disposition"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "not": {
              "contains": {
                "properties": {
                  "mandatory": {
                    "const": true
                  },
                  "state": {
                    "enum": [
                      "fail",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "mandatory",
                  "state"
                ]
              }
            }
          },
          "expected_blocking_gate_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_disposition": {
            "const": "reject"
          }
        },
        "required": [
          "expected_disposition"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "contains": {
              "properties": {
                "mandatory": {
                  "const": true
                },
                "state": {
                  "const": "fail"
                }
              },
              "required": [
                "mandatory",
                "state"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_disposition": {
            "const": "abstain"
          }
        },
        "required": [
          "expected_disposition"
        ]
      },
      "then": {
        "properties": {
          "gates": {
            "contains": {
              "properties": {
                "mandatory": {
                  "const": true
                },
                "state": {
                  "const": "unknown"
                }
              },
              "required": [
                "mandatory",
                "state"
              ]
            },
            "not": {
              "contains": {
                "properties": {
                  "mandatory": {
                    "const": true
                  },
                  "state": {
                    "const": "fail"
                  }
                },
                "required": [
                  "mandatory",
                  "state"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
