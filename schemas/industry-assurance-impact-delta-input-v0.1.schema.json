{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-assurance-impact-delta-input-v0.1.schema.json",
  "title": "IEAC Impact Delta Input v0.1",
  "description": "Frozen input envelope for a batch of append-only invalidation events and one fixed evaluation profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events", "metadata"],
  "properties": {
    "schema_version": { "const": "luminous.ieac-assurance-impact-delta-input.v0.1" },
    "note": { "type": "string", "maxLength": 1024 },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "type": "object" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated_at", "impact_policy_sha256", "impact_engine_build_sha256"],
      "properties": {
        "evaluated_at": { "type": "string", "format": "date-time" },
        "impact_policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "impact_engine_build_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}