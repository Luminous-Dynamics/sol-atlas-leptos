{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ieac-independence-registry-v0.1.schema.json",
  "title": "IEAC Independence Registry v0.1",
  "description": "Versioned registry model for common-cause dependency qualification. This schema does not authenticate the registry authority or prove completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "authority_id",
    "issued_at",
    "valid_from",
    "valid_until",
    "common_cause_groups",
    "dependency_nodes",
    "dependency_edges",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-independence-registry.v0.1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "registry_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issued_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "common_cause_groups": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "cause_type"
        ],
        "properties": {
          "group_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "cause_type": {
            "enum": [
              "upstream_data_feed",
              "calibration_lineage",
              "reference_standard",
              "software_build",
              "test_harness",
              "operator_process",
              "facility",
              "power_supply",
              "communications",
              "shared_environment",
              "maintenance_process",
              "other"
            ]
          }
        }
      }
    },
    "dependency_nodes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "dependency_type",
          "status",
          "common_cause_group_ids"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "dependency_type": {
            "enum": [
              "upstream_data_feed",
              "calibration_chain",
              "reference_standard",
              "software_build",
              "test_harness",
              "operator_process",
              "facility",
              "power_supply",
              "communications",
              "shared_environment",
              "maintenance_process",
              "other"
            ]
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "common_cause_group_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "depends_on_dependency_id"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "depends_on_dependency_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_id",
          "organization_id",
          "status",
          "dependency_completeness",
          "dependency_ids",
          "common_cause_group_ids",
          "valid_from",
          "valid_until"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "dependency_completeness": {
            "enum": [
              "complete",
              "unknown",
              "disputed"
            ]
          },
          "dependency_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "common_cause_group_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "valid_from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    }
  }
}
