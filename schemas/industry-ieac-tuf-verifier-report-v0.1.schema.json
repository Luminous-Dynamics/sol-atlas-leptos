{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-tuf-verifier-report-v0.1.schema.json",
  "title": "IEAC External TUF Verifier Report v0.1",
  "description": "Facts emitted by a separately pinned TUF client/verifier after validating repository metadata and exact targets. This schema and downstream auditor do not verify TUF signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "root",
    "timestamp",
    "snapshot",
    "target_roles",
    "channel_binding",
    "root_update_chain",
    "verification_checks",
    "evaluation_time",
    "verifier"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-tuf-verifier-report.v0.1"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    },
    "target_roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_name",
          "version",
          "metadata_sha256",
          "expires_at",
          "target_path",
          "target_length",
          "target_sha256"
        ],
        "properties": {
          "role_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "metadata_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "target_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "target_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "channel_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relying_party_id",
        "channel_id",
        "tenant_scope",
        "purpose",
        "ledger_id",
        "sequence_namespace",
        "sequence_epoch",
        "last_sequence",
        "channel_manifest",
        "checkpoint_state",
        "epoch_transition"
      ],
      "properties": {
        "relying_party_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "channel_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role_name",
            "target_path",
            "target_length",
            "target_sha256"
          ],
          "properties": {
            "role_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "target_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "target_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            },
            "target_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "checkpoint_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role_name",
            "target_path",
            "target_length",
            "target_sha256"
          ],
          "properties": {
            "role_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "target_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "target_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            },
            "target_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "epoch_transition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "from_epoch",
                "to_epoch",
                "authorization_target_sha256"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "failed",
                    "unknown"
                  ]
                },
                "from_epoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "to_epoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "authorization_target_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "root_update_chain": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_version",
          "from_sha256",
          "to_version",
          "to_sha256",
          "old_threshold_verified",
          "new_threshold_verified"
        ],
        "properties": {
          "from_version": {
            "type": "integer",
            "minimum": 1
          },
          "from_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "to_version": {
            "type": "integer",
            "minimum": 1
          },
          "to_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "old_threshold_verified": {
            "type": "boolean"
          },
          "new_threshold_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "verification_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_snapshot_binding_verified",
        "snapshot_targets_binding_verified",
        "delegation_authorization_verified",
        "target_hash_length_verified",
        "root_chain_verified"
      ],
      "properties": {
        "timestamp_snapshot_binding_verified": {
          "type": "boolean"
        },
        "snapshot_targets_binding_verified": {
          "type": "boolean"
        },
        "delegation_authorization_verified": {
          "type": "boolean"
        },
        "target_hash_length_verified": {
          "type": "boolean"
        },
        "root_chain_verified": {
          "type": "boolean"
        }
      }
    },
    "evaluation_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_utc",
        "uncertainty_before_seconds",
        "uncertainty_after_seconds",
        "clock_id",
        "verification_status",
        "proof_sha256",
        "verifier_build_sha256",
        "verification_policy_sha256",
        "trust_bundle_sha256"
      ],
      "properties": {
        "time_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "uncertainty_before_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "uncertainty_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "clock_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verification_status": {
          "enum": [
            "verified",
            "failed",
            "unknown",
            "not_checked",
            "disputed"
          ]
        },
        "proof_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier_build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "build_sha256",
        "policy_sha256",
        "trust_bundle_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "failed",
            "unknown",
            "not_supported"
          ]
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
