{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-water-energy-stress-intervention-batch-assessment-v0.1.schema.json",
  "title": "Spatial-Economic Joint-Failure Intervention Batch Assessment",
  "description": "Compact deterministic summaries across candidates; preserves provenance and protected-floor outcome without serializing every candidate's full step trace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "baseline_experiment_id",
    "requested_candidate_count",
    "evaluated_candidate_count",
    "baseline_sweep_evaluation_count",
    "candidate_sweep_evaluation_count",
    "total_service_step_assessments",
    "candidates",
    "baseline_supporting_evidence_ids",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "evaluated_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_sweep_evaluation_count": {
      "const": 1
    },
    "candidate_sweep_evaluation_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_service_step_assessments": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "candidate_experiment_id",
          "declared_failure_scenario_count",
          "compared_case_count",
          "exhaustive_over_paired_declared_scenarios",
          "total_paired_service_step_assessments",
          "effect",
          "possible_protected_floor_regression",
          "worst_case_unmet_demand_reduction_lower_bound_m3",
          "worst_case_unmet_demand_reduction_upper_bound_m3",
          "worst_case_customer_delivery_delta_lower_bound_m3",
          "worst_case_customer_delivery_delta_upper_bound_m3",
          "worst_case_floor_compliance_delta_lower_bound",
          "worst_case_floor_compliance_delta_upper_bound",
          "baseline_supporting_evidence_ids",
          "candidate_supporting_evidence_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "declared_failure_scenario_count": {
            "type": "integer",
            "minimum": 0
          },
          "compared_case_count": {
            "type": "integer",
            "minimum": 1
          },
          "exhaustive_over_paired_declared_scenarios": {
            "type": "boolean"
          },
          "total_paired_service_step_assessments": {
            "type": "integer",
            "minimum": 0
          },
          "effect": {
            "type": "string",
            "enum": [
              "robust_improvement",
              "robust_regression",
              "no_material_change",
              "protected_floor_regression",
              "mixed_effects",
              "indeterminate"
            ]
          },
          "possible_protected_floor_regression": {
            "type": "boolean"
          },
          "worst_case_unmet_demand_reduction_lower_bound_m3": {
            "type": "number"
          },
          "worst_case_unmet_demand_reduction_upper_bound_m3": {
            "type": "number"
          },
          "worst_case_customer_delivery_delta_lower_bound_m3": {
            "type": "number"
          },
          "worst_case_customer_delivery_delta_upper_bound_m3": {
            "type": "number"
          },
          "worst_case_floor_compliance_delta_lower_bound": {
            "type": "number"
          },
          "worst_case_floor_compliance_delta_upper_bound": {
            "type": "number"
          },
          "baseline_supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "candidate_supporting_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "baseline_supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "interpretation_boundary": {
      "const": "modeled_counterfactual_not_causal_evidence"
    }
  }
}
