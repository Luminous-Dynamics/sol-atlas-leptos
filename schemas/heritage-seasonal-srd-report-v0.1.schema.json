{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-seasonal-srd-report-v0.1.schema.json",
  "title": "Sol-Atlas Fixed-Reference Seasonal Robust Deviation Report",
  "description": "Per-month robust deviations and optional two-sided CUSUM. Scores and alerts are not calibrated probabilities or archaeological cause labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata",
    "config",
    "scored_month_count",
    "unobserved_month_count",
    "insufficient_reference_month_count",
    "single_month_alert_count",
    "cusum_alert_count",
    "points"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-seasonal-srd.v0.1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "site_id",
        "feature_id",
        "feature_units",
        "channel_semantics",
        "feature_definition_ref",
        "source_ref",
        "source_asset_sha256"
      ],
      "properties": {
        "series_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_units": {
          "type": "string",
          "minLength": 1
        },
        "channel_semantics": {
          "type": "string",
          "minLength": 1
        },
        "feature_definition_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_asset_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_interval",
        "evaluation_interval",
        "month_window",
        "min_reference_years",
        "scale_floor",
        "alert_threshold_abs",
        "alert_threshold_policy_ref",
        "cusum"
      ],
      "properties": {
        "reference_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_month",
            "end_month"
          ],
          "properties": {
            "start_month": {
              "type": "integer"
            },
            "end_month": {
              "type": "integer"
            }
          }
        },
        "evaluation_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_month",
            "end_month"
          ],
          "properties": {
            "start_month": {
              "type": "integer"
            },
            "end_month": {
              "type": "integer"
            }
          }
        },
        "month_window": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "min_reference_years": {
          "type": "integer",
          "minimum": 1
        },
        "scale_floor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alert_threshold_abs": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alert_threshold_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "cusum": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "drift_allowance",
            "alert_threshold",
            "min_valid_observations",
            "reset_after_missing_months"
          ],
          "properties": {
            "drift_allowance": {
              "type": "number",
              "minimum": 0
            },
            "alert_threshold": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_valid_observations": {
              "type": "integer",
              "minimum": 1
            },
            "reset_after_missing_months": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "scored_month_count": {
      "type": "integer",
      "minimum": 0
    },
    "unobserved_month_count": {
      "type": "integer",
      "minimum": 0
    },
    "insufficient_reference_month_count": {
      "type": "integer",
      "minimum": 0
    },
    "single_month_alert_count": {
      "type": "integer",
      "minimum": 0
    },
    "cusum_alert_count": {
      "type": "integer",
      "minimum": 0
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month_ordinal",
          "state",
          "observation_value",
          "reference_observation_count",
          "reference_year_count",
          "reference_median",
          "reference_mad",
          "robust_scale",
          "signed_residual",
          "robust_z_score",
          "single_month_alert",
          "cusum_positive",
          "cusum_negative",
          "cusum_valid_observation_count",
          "cusum_reset_applied",
          "cusum_alert"
        ],
        "properties": {
          "month_ordinal": {
            "type": "integer"
          },
          "state": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "scored"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "unobserved"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "observed_reference_years",
                  "required_reference_years"
                ],
                "properties": {
                  "kind": {
                    "const": "insufficient_reference"
                  },
                  "observed_reference_years": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "required_reference_years": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "observation_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "reference_observation_count": {
            "type": "integer",
            "minimum": 0
          },
          "reference_year_count": {
            "type": "integer",
            "minimum": 0
          },
          "reference_median": {
            "type": [
              "number",
              "null"
            ]
          },
          "reference_mad": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "robust_scale": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "signed_residual": {
            "type": [
              "number",
              "null"
            ]
          },
          "robust_z_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "single_month_alert": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "cusum_positive": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cusum_negative": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "cusum_valid_observation_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "cusum_reset_applied": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "cusum_alert": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
