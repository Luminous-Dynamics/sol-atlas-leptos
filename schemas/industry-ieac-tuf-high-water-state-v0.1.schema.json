{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-tuf-high-water-state-v0.1.schema.json",
  "title": "IEAC TUF Persisted High-Water State v0.1",
  "description": "Relying-party persisted anti-rollback state. This file must be stored outside the untrusted request channel using a protected/monotonic local state mechanism.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "state_revision",
    "repository_id",
    "relying_party_id",
    "channel_id",
    "tenant_scope",
    "purpose",
    "ledger_id",
    "sequence_namespace",
    "sequence_epoch",
    "last_sequence",
    "root",
    "timestamp",
    "snapshot",
    "target_roles",
    "manifest_sha256",
    "checkpoint_state_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-tuf-high-water-state.v0.1"
    },
    "state_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "relying_party_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "channel_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tenant_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "last_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "expires_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      }
    },
    "target_roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_name",
          "version",
          "metadata_sha256"
        ],
        "properties": {
          "role_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "metadata_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkpoint_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
