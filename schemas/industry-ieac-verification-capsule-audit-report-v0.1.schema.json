{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-verification-capsule-audit-report-v0.1.schema.json",
  "title": "IEAC Offline Verification Capsule Audit Report v0.1",
  "description": "Unsigned output from independent local replay of capsule inventory, TUF metadata and available target bytes. It is not an admission token.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "capsule_id",
    "capsule_mode",
    "replayability",
    "capsule_manifest_sha256",
    "file_inventory_sha256",
    "trust_pin_sha256",
    "policy_sha256",
    "repository_id",
    "repository_origin",
    "bootstrap_root_sha256",
    "bootstrap_root_version",
    "latest_root_version",
    "timestamp_version",
    "snapshot_version",
    "top_level_targets_version",
    "evaluation_time",
    "tufs_evaluation_time_upper_bound",
    "tuf_implementation",
    "metadata_verification",
    "targets",
    "unsigned_report",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-verification-capsule-audit-report.v0.1"
    },
    "status": {
      "enum": [
        "fully_replayed",
        "metadata_verified_target_replay_incomplete",
        "metadata_verified_commitment_only"
      ]
    },
    "capsule_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "capsule_mode": {
      "enum": [
        "self_contained",
        "metadata_complete_target_referenced",
        "commitment_only",
        "mixed"
      ]
    },
    "replayability": {
      "enum": [
        "fully_replayable",
        "conditionally_replayable",
        "commitment_only"
      ]
    },
    "capsule_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_pin_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repository_origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "bootstrap_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bootstrap_root_version": {
      "type": "integer",
      "minimum": 1
    },
    "latest_root_version": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp_version": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_version": {
      "type": "integer",
      "minimum": 1
    },
    "top_level_targets_version": {
      "type": "integer",
      "minimum": 1
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time"
    },
    "tufs_evaluation_time_upper_bound": {
      "type": "string",
      "format": "date-time"
    },
    "tuf_implementation": {
      "const": "sigstore-tuf/0.15.1"
    },
    "metadata_verification": {
      "const": "verified_in_process_offline_from_pinned_root"
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_path",
          "metadata_authorization",
          "target_bytes",
          "expected_length",
          "expected_sha256",
          "content_mode"
        ],
        "properties": {
          "id": {
            "enum": [
              "channel_manifest",
              "checkpoint_state",
              "completeness_attestation",
              "availability_audit_report"
            ]
          },
          "repository_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "metadata_authorization": {
            "const": "verified"
          },
          "target_bytes": {
            "enum": [
              "verified",
              "not_replayable"
            ]
          },
          "expected_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "expected_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_mode": {
            "enum": [
              "embedded",
              "referenced",
              "withheld"
            ]
          }
        }
      }
    },
    "unsigned_report": {
      "const": true
    },
    "claim_ceiling": {
      "const": "included_signed_tuf_metadata_and_replayed_target_byte_integrity_only"
    },
    "action_authority": {
      "const": "none"
    }
  }
}
