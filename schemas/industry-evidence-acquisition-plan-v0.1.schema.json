{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-evidence-acquisition-plan-v0.1.schema.json",
  "title": "IEAC Evidence Acquisition Plan v0.1",
  "description": "A non-executing advisory plan for resolving existing evidence obligations; it cannot admit, execute, renew, or widen authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "profile_id",
    "asset_id",
    "decision_id",
    "created_at",
    "decision_tier_ceiling",
    "advisory_only",
    "execution_authorized",
    "profile_mutation_authorized",
    "obligations",
    "candidates",
    "ranking_status",
    "ordered_candidate_ids",
    "planner_calibration",
    "human_review_required",
    "audit",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-evidence-acquisition-plan.v0.1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_tier_ceiling": {
      "enum": [
        "D0_descriptive",
        "D1_advisory"
      ]
    },
    "advisory_only": {
      "const": true
    },
    "execution_authorized": {
      "const": false
    },
    "profile_mutation_authorized": {
      "const": false
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "source_artifact_id",
          "source_class",
          "covers_obligation_ids",
          "rights_state",
          "independence_state",
          "dependency_artifact_ids",
          "acquisition_cost",
          "acquisition_latency_seconds",
          "information_value",
          "eligible",
          "exclusion_reasons"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "covers_obligation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "rights_state": {
            "enum": [
              "verified",
              "restricted",
              "unknown",
              "not_applicable"
            ]
          },
          "independence_state": {
            "enum": [
              "independent",
              "dependent",
              "unknown",
              "not_assessed"
            ]
          },
          "dependency_artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "acquisition_cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "unit"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "acquisition_latency_seconds": {
            "type": "number",
            "minimum": 0
          },
          "information_value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estimate",
              "unit",
              "calibration_state"
            ],
            "properties": {
              "estimate": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "calibration_state": {
                "enum": [
                  "calibrated",
                  "uncalibrated",
                  "not_estimated"
                ]
              },
              "model_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          },
          "eligible": {
            "type": "boolean"
          },
          "exclusion_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "eligible": {
                  "const": true
                }
              },
              "required": [
                "eligible"
              ]
            },
            "then": {
              "properties": {
                "rights_state": {
                  "const": "verified"
                },
                "independence_state": {
                  "const": "independent"
                },
                "exclusion_reasons": {
                  "maxItems": 0
                },
                "information_value": {
                  "properties": {
                    "calibration_state": {
                      "const": "calibrated"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "eligible": {
                  "const": false
                }
              },
              "required": [
                "eligible"
              ]
            },
            "then": {
              "properties": {
                "exclusion_reasons": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "ranking_status": {
      "enum": [
        "ranked",
        "abstain_from_ranking"
      ]
    },
    "ordered_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "planner_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decision_value_model_id",
        "cost_model_id",
        "source_independence_assessed",
        "rights_complete",
        "uncertainty_note"
      ],
      "properties": {
        "state": {
          "enum": [
            "calibrated",
            "uncalibrated",
            "not_applicable"
          ]
        },
        "decision_value_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "cost_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_independence_assessed": {
          "type": "boolean"
        },
        "rights_complete": {
          "type": "boolean"
        },
        "uncertainty_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "human_review_required": {
      "const": true
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_rationale",
        "excluded_candidate_ids",
        "preserves_prior_abstention",
        "requires_new_admission_request"
      ],
      "properties": {
        "selection_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "excluded_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "preserves_prior_abstention": {
          "const": true
        },
        "requires_new_admission_request": {
          "const": true
        }
      }
    },
    "claim_ceiling": {
      "const": "advisory_evidence_acquisition_only"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ranking_status": {
            "const": "ranked"
          }
        },
        "required": [
          "ranking_status"
        ]
      },
      "then": {
        "properties": {
          "planner_calibration": {
            "properties": {
              "state": {
                "const": "calibrated"
              },
              "source_independence_assessed": {
                "const": true
              },
              "rights_complete": {
                "const": true
              }
            }
          },
          "ordered_candidate_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ranking_status": {
            "const": "abstain_from_ranking"
          }
        },
        "required": [
          "ranking_status"
        ]
      },
      "then": {
        "properties": {
          "ordered_candidate_ids": {
            "maxItems": 0
          }
        },
        "required": [
          "human_review_required"
        ]
      }
    }
  ],
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "obligation_id",
        "request_id",
        "profile_id",
        "asset_id",
        "decision_id",
        "issued_at",
        "reason_codes",
        "resolution_state",
        "required_evidence",
        "source_constraints",
        "independence",
        "authority",
        "claim_ceiling"
      ],
      "properties": {
        "schema_version": {
          "const": "luminous.ieac-evidence-obligation.v0.1"
        },
        "obligation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          }
        },
        "resolution_state": {
          "enum": [
            "resolvable_with_new_evidence",
            "conditionally_resolvable",
            "not_resolvable_without_profile_review"
          ]
        },
        "required_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variable",
            "accepted_unit",
            "operating_bounds",
            "uncertainty_limit",
            "observation_window",
            "max_age_seconds"
          ],
          "properties": {
            "variable": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "accepted_unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "operating_bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              }
            },
            "uncertainty_limit": {
              "type": "number",
              "minimum": 0
            },
            "observation_window": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "not_before",
                "not_after"
              ],
              "properties": {
                "not_before": {
                  "type": "string",
                  "format": "date-time"
                },
                "not_after": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "max_age_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "sampling_requirements": {
              "type": "string",
              "maxLength": 2000
            },
            "calibration_requirements": {
              "type": "string",
              "maxLength": 2000
            },
            "payload_digest_required": {
              "const": true
            }
          }
        },
        "source_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permitted_artifact_ids",
            "permitted_source_classes",
            "rights_state_required"
          ],
          "properties": {
            "permitted_artifact_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            },
            "permitted_source_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,63}$"
              }
            },
            "rights_state_required": {
              "const": "verified"
            },
            "excluded_artifact_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dependency_dimensions",
            "dependencies_must_be_declared",
            "required_independent_of",
            "unknown_independence_policy"
          ],
          "properties": {
            "dependency_dimensions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "sensor",
                  "calibration_chain",
                  "gateway",
                  "clock",
                  "network_path",
                  "model",
                  "operator",
                  "upstream_source",
                  "power_supply",
                  "physical_location"
                ]
              }
            },
            "dependencies_must_be_declared": {
              "const": true
            },
            "required_independent_of": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            },
            "unknown_independence_policy": {
              "const": "do_not_rank_or_treat_as_independent"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_authorization_source_ids",
            "trust_state_required",
            "profile_review_can_be_automated"
          ],
          "properties": {
            "required_authorization_source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            },
            "trust_state_required": {
              "enum": [
                "operator_pinned",
                "cryptographically_authenticated"
              ]
            },
            "profile_review_can_be_automated": {
              "const": false
            }
          }
        },
        "human_review_required": {
          "type": "boolean"
        },
        "not_resolvable_reason": {
          "type": "string",
          "maxLength": 2000
        },
        "claim_ceiling": {
          "const": "advisory_evidence_obligation_only"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution_state": {
                "const": "not_resolvable_without_profile_review"
              }
            },
            "required": [
              "resolution_state"
            ]
          },
          "then": {
            "required": [
              "human_review_required",
              "not_resolvable_reason"
            ],
            "properties": {
              "human_review_required": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
