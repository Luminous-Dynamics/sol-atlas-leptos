{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-evidence-acquisition-plan-v0.1.schema.json",
  "title": "IEAC Evidence Acquisition Plan v0.1",
  "description": "A non-executing advisory plan for resolving existing evidence obligations; it cannot admit, execute, renew, or widen authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "profile_id",
    "asset_id",
    "decision_id",
    "created_at",
    "decision_tier_ceiling",
    "advisory_only",
    "execution_authorized",
    "profile_mutation_authorized",
    "obligations",
    "candidates",
    "ranking_status",
    "ordered_candidate_ids",
    "planner_calibration",
    "human_review_required",
    "audit",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-evidence-acquisition-plan.v0.1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_tier_ceiling": {
      "enum": [
        "D0_descriptive",
        "D1_advisory"
      ]
    },
    "advisory_only": {
      "const": true
    },
    "execution_authorized": {
      "const": false
    },
    "profile_mutation_authorized": {
      "const": false
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "industry-evidence-obligation-v0.1.schema.json"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "source_artifact_id",
          "source_class",
          "covers_obligation_ids",
          "rights_state",
          "independence_state",
          "dependency_artifact_ids",
          "acquisition_cost",
          "acquisition_latency_seconds",
          "information_value",
          "eligible",
          "exclusion_reasons"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source_class": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "covers_obligation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "rights_state": {
            "enum": [
              "verified",
              "restricted",
              "unknown",
              "not_applicable"
            ]
          },
          "independence_state": {
            "enum": [
              "independent",
              "dependent",
              "unknown",
              "not_assessed"
            ]
          },
          "dependency_artifact_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "acquisition_cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "unit"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "acquisition_latency_seconds": {
            "type": "number",
            "minimum": 0
          },
          "information_value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "estimate",
              "unit",
              "calibration_state"
            ],
            "properties": {
              "estimate": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "calibration_state": {
                "enum": [
                  "calibrated",
                  "uncalibrated",
                  "not_estimated"
                ]
              },
              "model_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          },
          "eligible": {
            "type": "boolean"
          },
          "exclusion_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "eligible": {
                  "const": true
                }
              },
              "required": [
                "eligible"
              ]
            },
            "then": {
              "properties": {
                "rights_state": {
                  "const": "verified"
                },
                "independence_state": {
                  "const": "independent"
                },
                "exclusion_reasons": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "eligible": {
                  "const": false
                }
              },
              "required": [
                "eligible"
              ]
            },
            "then": {
              "properties": {
                "exclusion_reasons": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "ranking_status": {
      "enum": [
        "ranked",
        "abstain_from_ranking"
      ]
    },
    "ordered_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      }
    },
    "planner_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decision_value_model_id",
        "cost_model_id",
        "source_independence_assessed",
        "rights_complete",
        "uncertainty_note"
      ],
      "properties": {
        "state": {
          "enum": [
            "calibrated",
            "uncalibrated",
            "not_applicable"
          ]
        },
        "decision_value_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "cost_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source_independence_assessed": {
          "type": "boolean"
        },
        "rights_complete": {
          "type": "boolean"
        },
        "uncertainty_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "human_review_required": {
      "type": "boolean"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_rationale",
        "excluded_candidate_ids",
        "preserves_prior_abstention",
        "requires_new_admission_request"
      ],
      "properties": {
        "selection_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "excluded_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        },
        "preserves_prior_abstention": {
          "const": true
        },
        "requires_new_admission_request": {
          "const": true
        }
      }
    },
    "claim_ceiling": {
      "const": "advisory_evidence_acquisition_only"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ranking_status": {
            "const": "ranked"
          }
        },
        "required": [
          "ranking_status"
        ]
      },
      "then": {
        "properties": {
          "planner_calibration": {
            "properties": {
              "state": {
                "const": "calibrated"
              },
              "source_independence_assessed": {
                "const": true
              },
              "rights_complete": {
                "const": true
              }
            }
          },
          "ordered_candidate_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ranking_status": {
            "const": "abstain_from_ranking"
          }
        },
        "required": [
          "ranking_status"
        ]
      },
      "then": {
        "properties": {
          "ordered_candidate_ids": {
            "maxItems": 0
          }
        },
        "required": [
          "human_review_required"
        ]
      }
    }
  ]
}
