{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-cause-sample-v0.1.schema.json",
  "title": "Sol-Atlas Heritage Change-Cause Evaluation Sample",
  "description": "A candidate with complete adjudicated multi-label causes, a confirmed no-relevant-change negative control, or unknown cause labels, plus one score for each taxonomy cause.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "ground_truth",
    "prediction"
  ],
  "properties": {
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "ground_truth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "causes",
            "adjudication_ref"
          ],
          "properties": {
            "kind": {
              "const": "complete_causes"
            },
            "causes": {
              "type": "array",
              "items": {
                "enum": [
                  "archaeological_excavation_looting",
                  "agriculture_cultivation",
                  "seasonal_vegetation_phenology",
                  "erosion_geomorphic",
                  "hydrology_flood",
                  "fire_vegetation_clearance",
                  "modern_construction_infrastructure",
                  "quarry_mining",
                  "military_conflict",
                  "sensor_processing_artifact",
                  "other_known_cause"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "adjudication_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "adjudication_ref"
          ],
          "properties": {
            "kind": {
              "const": "confirmed_no_relevant_change"
            },
            "adjudication_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abstained",
        "scores"
      ],
      "properties": {
        "abstained": {
          "type": "boolean"
        },
        "scores": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cause",
              "probability",
              "evidence_refs"
            ],
            "properties": {
              "cause": {
                "enum": [
                  "archaeological_excavation_looting",
                  "agriculture_cultivation",
                  "seasonal_vegetation_phenology",
                  "erosion_geomorphic",
                  "hydrology_flood",
                  "fire_vegetation_clearance",
                  "modern_construction_infrastructure",
                  "quarry_mining",
                  "military_conflict",
                  "sensor_processing_artifact",
                  "other_known_cause"
                ]
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
