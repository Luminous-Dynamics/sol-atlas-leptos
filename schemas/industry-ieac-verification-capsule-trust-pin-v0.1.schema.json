{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-verification-capsule-trust-pin-v0.1.schema.json",
  "title": "IEAC Verification Capsule Trust Pin v0.1",
  "description": "Separately provisioned relying-party trust configuration. Never accept this file from the capsule or untrusted request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pin_id",
    "repository_id",
    "repository_origin",
    "root_sha256",
    "policy_id",
    "policy_sha256",
    "evaluation_time",
    "uncertainty_before_ms",
    "uncertainty_after_ms",
    "clock_id",
    "targets",
    "max_capsule_bytes",
    "max_file_count",
    "allowed_capsule_modes",
    "action_authority",
    "policy_scope_id",
    "policy_kind",
    "time_policy_sha256",
    "time_verifier_build_sha256",
    "time_verifier_trust_bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-verification-capsule-trust-pin.v0.1"
    },
    "pin_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "repository_origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "uncertainty_before_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "uncertainty_after_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "clock_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_path"
        ],
        "properties": {
          "id": {
            "enum": [
              "channel_manifest",
              "checkpoint_state",
              "completeness_attestation",
              "availability_audit_report"
            ]
          },
          "repository_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          }
        }
      }
    },
    "max_capsule_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "max_file_count": {
      "type": "integer",
      "minimum": 4,
      "maximum": 4096
    },
    "allowed_capsule_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "self_contained",
          "metadata_complete_target_referenced",
          "commitment_only",
          "mixed"
        ]
      }
    },
    "action_authority": {
      "const": "none"
    },
    "policy_scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "policy_kind": {
      "enum": [
        "industrial_assurance",
        "channel_completeness",
        "decision_time",
        "composite"
      ]
    },
    "time_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time_verifier_build_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time_verifier_trust_bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "properties": {
        "targets": {
          "contains": {
            "properties": {
              "id": {
                "const": "channel_manifest"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "targets": {
          "contains": {
            "properties": {
              "id": {
                "const": "checkpoint_state"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "targets": {
          "contains": {
            "properties": {
              "id": {
                "const": "completeness_attestation"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "targets": {
          "contains": {
            "properties": {
              "id": {
                "const": "availability_audit_report"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ]
}
