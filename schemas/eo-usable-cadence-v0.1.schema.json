{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/eo-usable-cadence-v0-1/schemas/eo-usable-cadence-v0.1.schema.json",
  "title": "Sol-Atlas EO Usable Cadence Timeline v0.1",
  "description": "A frozen per-support timeline distinguishing expected acquisitions, acquired scenes, quality-qualified observations, externally rights-blocked opportunities, delivery availability and evidence-backed event-time bounds. Schema validation is structural only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timeline_id",
    "support_id",
    "opportunities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timeline_id": {
      "$ref": "#/$defs/identifier"
    },
    "support_id": {
      "$ref": "#/$defs/identifier"
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "nullableTimestamp": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_unix_ms",
        "end_unix_ms"
      ],
      "properties": {
        "start_unix_ms": {
          "$ref": "#/$defs/timestamp"
        },
        "end_unix_ms": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "nullableAcquisition": {
      "oneOf": [
        {
          "$ref": "#/$defs/acquisition"
        },
        {
          "type": "null"
        }
      ]
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "support_id",
        "source_id",
        "sensor_id",
        "modality",
        "expected_at_unix_ms",
        "acquisition",
        "asset_id",
        "source_event_id",
        "state",
        "delivered_at_unix_ms",
        "assessment",
        "coverage_qualification_receipt_sha256",
        "detection_qualification_receipt_sha256"
      ],
      "properties": {
        "opportunity_id": {
          "$ref": "#/$defs/identifier"
        },
        "support_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "sensor_id": {
          "$ref": "#/$defs/identifier"
        },
        "modality": {
          "enum": [
            "optical",
            "synthetic_aperture_radar",
            "thermal_infrared",
            "hyperspectral",
            "multispectral",
            "other"
          ]
        },
        "expected_at_unix_ms": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "acquisition": {
          "$ref": "#/$defs/nullableAcquisition"
        },
        "asset_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "source_event_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "state": {
          "enum": [
            "qualified_usable",
            "cloud_contaminated",
            "shadow_contaminated",
            "haze_or_smoke_contaminated",
            "saturated",
            "incomplete_coverage",
            "invalid_processing",
            "out_of_domain",
            "awaiting_delivery",
            "rights_blocked",
            "no_acquisition"
          ]
        },
        "delivered_at_unix_ms": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "assessment": {
          "oneOf": [
            {
              "enum": [
                "no_change_within_envelope",
                "change_detected",
                "unresolved"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_qualification_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "detection_qualification_receipt_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "no_acquisition"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "expected_at_unix_ms": {
                "$ref": "#/$defs/timestamp"
              },
              "acquisition": {
                "type": "null"
              },
              "asset_id": {
                "type": "null"
              },
              "source_event_id": {
                "type": "null"
              },
              "delivered_at_unix_ms": {
                "type": "null"
              },
              "assessment": {
                "type": "null"
              },
              "coverage_qualification_receipt_sha256": {
                "type": "null"
              },
              "detection_qualification_receipt_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "qualified_usable"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "acquisition": {
                "$ref": "#/$defs/acquisition"
              },
              "asset_id": {
                "$ref": "#/$defs/identifier"
              },
              "source_event_id": {
                "$ref": "#/$defs/identifier"
              },
              "delivered_at_unix_ms": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assessment": {
                "const": "no_change_within_envelope"
              }
            },
            "required": [
              "assessment"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "qualified_usable"
              },
              "coverage_qualification_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "detection_qualification_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assessment": {
                "const": "change_detected"
              }
            },
            "required": [
              "assessment"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "qualified_usable"
              },
              "detection_qualification_receipt_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  }
}
