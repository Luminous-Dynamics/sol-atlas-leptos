{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-performance-registry-v0.schema.json",
  "title": "Luminous Landscape Performance Metric Registry v0",
  "description": "A definition registry only; it does not contain measured outcomes and does not authorize defaulting missing metrics to zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_uri",
    "registry_version",
    "status",
    "principles",
    "evidence_classes",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "luminous.landscape-performance-registry.v0"
    },
    "schema_uri": {
      "const": "https://luminousdynamics.io/schemas/landscape-performance-registry-v0.schema.json"
    },
    "registry_version": {
      "const": "landscape-performance-registry-v0"
    },
    "status": {
      "const": "specification-only-no-field-values"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_classes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "observed",
          "curated",
          "synthetic",
          "modelled",
          "assumed",
          "missing"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "family",
          "label",
          "unit",
          "semantic_type",
          "formula",
          "required_inputs",
          "valid_scales",
          "v0_status",
          "failure_modes",
          "uncertainty_requirements",
          "target_policy",
          "external_references",
          "candidate_sources",
          "unprovided_inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "family": {
            "enum": [
              "heat-and-comfort",
              "water",
              "ecology",
              "access-and-equity",
              "materials-and-lifecycle",
              "resilience-and-stewardship",
              "economics-and-community"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "semantic_type": {
            "enum": [
              "spatial_ratio",
              "physical_quantity",
              "evidence_completeness_ratio",
              "maximum_over_geometry",
              "lifecycle_inventory_sum",
              "governance_coverage_ratio",
              "range"
            ]
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "required_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "valid_scales": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "site-parcel",
                "district",
                "watershed",
                "bioregion"
              ]
            }
          },
          "v0_status": {
            "enum": [
              "not-computable",
              "requires-myclix-stewardship-contract",
              "specification-only"
            ]
          },
          "failure_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "uncertainty_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_policy": {
            "type": "string",
            "minLength": 1
          },
          "external_references": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "candidate_sources": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "role",
                "limitation"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "limitation": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "unprovided_inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
