{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cter-private-coverage-v0.1.schema.json",
  "title": "CTER private evidence coverage record v0.1",
  "description": "Custodian-side partition and package-binding structure. Schema validity is not cryptographic proof, source completeness, authorization, or proof of global absence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "coverage_ref",
    "frontier",
    "query_binding",
    "receipt_binding",
    "receipt_assessment",
    "private_partition",
    "package_binding",
    "public_verifier_view",
    "fixture_notice",
    "query_input_snapshot"
  ],
  "properties": {
    "schema": {
      "const": "luminous.cter.private-coverage.v0.1"
    },
    "coverage_ref": {
      "$ref": "#/$defs/opaque_ref"
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontier_ref",
        "version",
        "commitment",
        "source_owner_ref",
        "receipt_ref",
        "object_refs"
      ],
      "properties": {
        "frontier_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "source_owner_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "receipt_ref": {
          "$ref": "#/$defs/opaque_ref",
          "description": "Reference only. Mycelix must resolve and verify the actual typed receipt/VDS proof."
        },
        "object_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque_ref"
          }
        }
      }
    },
    "query_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_ref",
        "query_commitment",
        "request_commitment",
        "principal_ref",
        "subject_ref",
        "operation",
        "purpose_ref",
        "recipient_ref",
        "resource_ref",
        "data_classes",
        "jurisdiction_profile_ref",
        "project_snapshot_sha256",
        "query_profile_ref",
        "predicate",
        "input_snapshot_ref",
        "input_snapshot_commitment"
      ],
      "properties": {
        "query_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "query_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "request_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "principal_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "subject_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "community",
              "restricted",
              "culturally_protected"
            ]
          }
        },
        "operation": {
          "enum": [
            "export_evidence",
            "publish_observation"
          ]
        },
        "purpose_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "recipient_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "resource_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "jurisdiction_profile_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "project_snapshot_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "query_profile_ref": {
          "$ref": "#/$defs/opaque_ref",
          "description": "Versioned deterministic predicate-semantics profile used to interpret this query."
        },
        "predicate": {
          "$ref": "#/$defs/query_predicate",
          "description": "Private, deterministic query AST; its canonical commitment is carried by query_commitment."
        },
        "input_snapshot_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "input_snapshot_commitment": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    },
    "receipt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_ref",
        "frontier_ref",
        "frontier_version",
        "frontier_commitment",
        "query_commitment",
        "request_commitment",
        "package_commitment",
        "principal_ref",
        "subject_ref",
        "operation",
        "data_classes",
        "purpose_ref",
        "recipient_ref",
        "resource_ref",
        "jurisdiction_profile_ref",
        "project_snapshot_sha256",
        "query_profile_ref",
        "input_snapshot_ref",
        "input_snapshot_commitment"
      ],
      "properties": {
        "receipt_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "frontier_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "frontier_version": {
          "type": "string",
          "minLength": 1
        },
        "frontier_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "query_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "request_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "principal_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "subject_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "community",
              "restricted",
              "culturally_protected"
            ]
          }
        },
        "operation": {
          "enum": [
            "export_evidence",
            "publish_observation"
          ]
        },
        "purpose_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "recipient_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "resource_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "jurisdiction_profile_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "project_snapshot_sha256": {
          "$ref": "#/$defs/sha256_hex"
        },
        "package_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "query_profile_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "input_snapshot_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "input_snapshot_commitment": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    },
    "receipt_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_ref",
        "resolution_status",
        "status_snapshot_ref"
      ],
      "properties": {
        "assessment_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "resolution_status": {
          "enum": [
            "current",
            "stale",
            "unavailable",
            "revoked",
            "unknown"
          ]
        },
        "status_snapshot_ref": {
          "$ref": "#/$defs/opaque_ref"
        }
      }
    },
    "private_partition": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/partition_item"
      }
    },
    "package_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_commitment",
        "terminal_source_leaf_refs"
      ],
      "properties": {
        "package_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "terminal_source_leaf_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaque_ref"
          }
        }
      }
    },
    "public_verifier_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontier_commitment",
        "query_commitment",
        "request_commitment",
        "package_commitment",
        "proof_ref",
        "non_inclusion_scope"
      ],
      "properties": {
        "frontier_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "query_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "request_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "package_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "proof_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "non_inclusion_scope": {
          "const": "frontier_version_only"
        }
      }
    },
    "fixture_notice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "query_input_snapshot": {
      "$ref": "#/$defs/query_input_snapshot"
    }
  },
  "$defs": {
    "opaque_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha256_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "value": {
          "$ref": "#/$defs/sha256_hex"
        }
      }
    },
    "partition_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "scope_state",
        "disposition",
        "query_input_snapshot_item_ref"
      ],
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "scope_state": {
          "enum": [
            "in_scope",
            "out_of_scope",
            "unknown"
          ]
        },
        "disposition": {
          "enum": [
            "included",
            "withheld",
            "unavailable",
            "excluded",
            "unresolved"
          ]
        },
        "query_input_snapshot_item_ref": {
          "$ref": "#/$defs/opaque_ref"
        }
      }
    },
    "query_predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "all"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/query_predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "any"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/query_predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/query_predicate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "value"
          ],
          "properties": {
            "op": {
              "const": "eq"
            },
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "value": {
              "type": [
                "string",
                "boolean",
                "number",
                "null"
              ],
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "values"
          ],
          "properties": {
            "op": {
              "const": "in"
            },
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": [
                  "string",
                  "boolean",
                  "number",
                  "null"
                ],
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path"
          ],
          "properties": {
            "op": {
              "const": "exists"
            },
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z][A-Za-z0-9_-]*$",
              "maxLength": 128
            }
          }
        }
      ]
    },
    "query_input_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_ref",
        "profile_ref",
        "frontier_ref",
        "frontier_version",
        "frontier_commitment",
        "query_profile_ref",
        "query_commitment",
        "attribute_projection_profile_ref",
        "items",
        "snapshot_commitment",
        "schema"
      ],
      "properties": {
        "schema": {
          "const": "luminous.cter.query-input-snapshot.v0.1"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "profile_ref": {
          "const": "urn:luminous:cter:query-input-json-v0.1"
        },
        "frontier_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "frontier_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "frontier_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "query_profile_ref": {
          "const": "urn:luminous:cter:predicate-json-v0.1"
        },
        "query_commitment": {
          "$ref": "#/$defs/sha256_digest"
        },
        "attribute_projection_profile_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/query_input_snapshot_item"
          }
        },
        "snapshot_commitment": {
          "$ref": "#/$defs/sha256_digest",
          "description": "SHA-256 over the domain-separated JCS canonical snapshot preimage. It is not an owner signature."
        }
      }
    },
    "query_input_snapshot_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_ref",
        "availability_state",
        "attribute_source_bindings"
      ],
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "availability_state": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "query_input": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "number",
              "null"
            ],
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "attribute_source_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attribute_source_binding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability_state": {
                "const": "available"
              }
            },
            "required": [
              "availability_state"
            ]
          },
          "then": {
            "required": [
              "query_input"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "availability_state": {
                "enum": [
                  "unavailable",
                  "unknown"
                ]
              }
            },
            "required": [
              "availability_state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "query_input"
              ]
            }
          }
        }
      ]
    },
    "attribute_source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_object_ref",
        "source_content_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z][A-Za-z0-9_-]*$",
          "maxLength": 128
        },
        "source_object_ref": {
          "$ref": "#/$defs/opaque_ref"
        },
        "source_content_digest": {
          "$ref": "#/$defs/sha256_digest"
        }
      }
    }
  }
}
