{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-evaluation-split-v0.1.schema.json",
  "title": "Sol-Atlas Heritage Evaluation Split Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_sha256",
    "split_protocol_sha256",
    "coordinate_reference_id",
    "profile",
    "samples"
  ],
  "properties": {
    "schema_version": { "const": "luminous.heritage-evaluation-split.v0.1" },
    "dataset_sha256": { "$ref": "#/$defs/digest" },
    "split_protocol_sha256": { "$ref": "#/$defs/digest" },
    "coordinate_reference_id": { "type": "string", "minLength": 1 },
    "profile": {
      "enum": [
        "paper_faithful_random_tiles",
        "source_footprint_independent",
        "buffered_spatial_blocks",
        "leave_one_site_out",
        "cross_sensor_transfer",
        "cross_epoch_transfer"
      ]
    },
    "random_seed": { "type": "integer", "minimum": 0 },
    "reference_paper_split_manifest_sha256": { "$ref": "#/$defs/digest" },
    "held_out_site_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "held_out_sensor_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "held_out_epoch_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "spatial_buffer_basis": {
      "enum": ["empirical_correlation_range", "declared_deployment_distance"]
    },
    "spatial_buffer_m": { "type": "number", "exclusiveMinimum": 0 },
    "spatial_correlation_range_m": { "type": "number", "exclusiveMinimum": 0 },
    "buffer_basis_receipt_ref": { "type": "string", "minLength": 1 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile": { "const": "buffered_spatial_blocks" } },
        "required": ["profile"]
      },
      "then": {
        "required": [
          "spatial_buffer_basis",
          "spatial_buffer_m",
          "buffer_basis_receipt_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "leave_one_site_out" }
        },
        "required": ["profile"]
      },
      "then": {
        "required": ["held_out_site_ids"],
        "properties": { "held_out_site_ids": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "cross_sensor_transfer" }
        },
        "required": ["profile"]
      },
      "then": {
        "required": ["held_out_sensor_ids"],
        "properties": { "held_out_sensor_ids": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "profile": { "const": "cross_epoch_transfer" }
        },
        "required": ["profile"]
      },
      "then": {
        "required": ["held_out_epoch_ids"],
        "properties": { "held_out_epoch_ids": { "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "pixel_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x_px", "min_y_px", "max_x_px", "max_y_px"],
      "properties": {
        "min_x_px": { "type": "integer", "minimum": 0 },
        "min_y_px": { "type": "integer", "minimum": 0 },
        "max_x_px": { "type": "integer", "minimum": 1 },
        "max_y_px": { "type": "integer", "minimum": 1 }
      }
    },
    "metric_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x_m", "min_y_m", "max_x_m", "max_y_m"],
      "properties": {
        "min_x_m": { "type": "number" },
        "min_y_m": { "type": "number" },
        "max_x_m": { "type": "number" },
        "max_y_m": { "type": "number" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "role",
        "site_id",
        "region_id",
        "sensor_id",
        "acquisition_epoch_id",
        "source_capture_id",
        "source_capture_sha256",
        "source_tile_sha256",
        "source_image_width_px",
        "source_image_height_px",
        "source_pixel_window",
        "metric_bounds"
      ],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["train", "validation", "test", "buffer_excluded"] },
        "site_id": { "type": "string", "minLength": 1 },
        "region_id": { "type": "string", "minLength": 1 },
        "sensor_id": { "type": "string", "minLength": 1 },
        "acquisition_epoch_id": { "type": "string", "minLength": 1 },
        "block_id": { "type": "string", "minLength": 1 },
        "source_capture_id": { "type": "string", "minLength": 1 },
        "source_capture_sha256": { "$ref": "#/$defs/digest" },
        "source_tile_sha256": { "$ref": "#/$defs/digest" },
        "source_image_width_px": { "type": "integer", "minimum": 1 },
        "source_image_height_px": { "type": "integer", "minimum": 1 },
        "source_pixel_window": { "$ref": "#/$defs/pixel_window" },
        "metric_bounds": { "$ref": "#/$defs/metric_bounds" },
        "physical_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusion_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "buffer_excluded" } },
            "required": ["role"]
          },
          "then": { "required": ["exclusion_reason"] }
        }
      ]
    }
  }
}
