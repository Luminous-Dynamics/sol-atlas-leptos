{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-verification-capsule-build-template-v0.1.schema.json",
  "title": "IEAC Verification Capsule Build Template v0.1",
  "description": "Operator-authored source mapping for deterministic capsule packaging. It contains TUF metadata claims but is not a verification verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsule_id",
    "capsule_mode",
    "replayability",
    "created_at",
    "bootstrap_root",
    "policy_file",
    "verifier_identity",
    "metadata_artifacts",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-verification-capsule-build-template.v0.1"
    },
    "capsule_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "capsule_mode": {
      "enum": [
        "self_contained",
        "metadata_complete_target_referenced",
        "commitment_only",
        "mixed"
      ]
    },
    "replayability": {
      "enum": [
        "fully_replayable",
        "conditionally_replayable",
        "commitment_only"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "bootstrap_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "staged_path",
        "capsule_file_path"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "staged_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
        },
        "capsule_file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
        }
      }
    },
    "policy_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staged_path",
        "capsule_file_path"
      ],
      "properties": {
        "staged_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
        },
        "capsule_file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
        }
      }
    },
    "verifier_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "build_sha256",
        "independent_verifier_required"
      ],
      "properties": {
        "implementation": {
          "const": "sigstore-tuf"
        },
        "version": {
          "const": "0.15.1"
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_verifier_required": {
          "const": true
        }
      }
    },
    "metadata_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_name",
          "version",
          "repository_path",
          "staged_path",
          "capsule_file_path",
          "expires_at"
        ],
        "properties": {
          "role_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "repository_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._~-]+\\.json$"
          },
          "staged_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "capsule_file_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_path",
          "length",
          "sha256",
          "content_mode"
        ],
        "properties": {
          "id": {
            "enum": [
              "channel_manifest",
              "checkpoint_state",
              "completeness_attestation",
              "availability_audit_report"
            ]
          },
          "repository_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_mode": {
            "enum": [
              "embedded",
              "referenced",
              "withheld"
            ]
          },
          "staged_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "content_mode": {
                  "const": "embedded"
                }
              },
              "required": [
                "content_mode"
              ]
            },
            "then": {
              "required": [
                "staged_path"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "content_mode": {
                  "enum": [
                    "referenced",
                    "withheld"
                  ]
                }
              },
              "required": [
                "content_mode"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "staged_path"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "targets": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "channel_manifest"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "targets": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "checkpoint_state"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "targets": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "completeness_attestation"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "targets": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "availability_audit_report"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "if": {
        "properties": {
          "capsule_mode": {
            "const": "self_contained"
          }
        },
        "required": [
          "capsule_mode"
        ]
      },
      "then": {
        "properties": {
          "replayability": {
            "const": "fully_replayable"
          },
          "targets": {
            "items": {
              "properties": {
                "content_mode": {
                  "const": "embedded"
                }
              },
              "required": [
                "content_mode"
              ]
            }
          }
        },
        "required": [
          "replayability"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capsule_mode": {
            "const": "metadata_complete_target_referenced"
          }
        },
        "required": [
          "capsule_mode"
        ]
      },
      "then": {
        "properties": {
          "replayability": {
            "const": "conditionally_replayable"
          },
          "targets": {
            "items": {
              "properties": {
                "content_mode": {
                  "enum": [
                    "embedded",
                    "referenced"
                  ]
                }
              },
              "required": [
                "content_mode"
              ]
            }
          }
        },
        "required": [
          "replayability"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capsule_mode": {
            "const": "commitment_only"
          }
        },
        "required": [
          "capsule_mode"
        ]
      },
      "then": {
        "properties": {
          "replayability": {
            "const": "commitment_only"
          },
          "targets": {
            "items": {
              "properties": {
                "content_mode": {
                  "const": "withheld"
                }
              },
              "required": [
                "content_mode"
              ]
            }
          }
        },
        "required": [
          "replayability"
        ]
      }
    }
  ]
}
