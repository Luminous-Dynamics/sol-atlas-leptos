{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-runtime-admission-request-v0.1.schema.json",
  "title": "IEAC Runtime Admission Request v0.1",
  "description": "A single decision request bound to exact profile, model, evaluator, configuration, topology, measurement snapshot and current revocation/authorization state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "profile_id",
    "profile_sha256",
    "capability_id",
    "instance_id",
    "decision_id",
    "decision_tier",
    "action",
    "intended_user",
    "model_id",
    "model_artifact_id",
    "model_sha256",
    "evaluator_id",
    "evaluator_artifact_id",
    "evaluator_sha256",
    "configuration_id",
    "configuration_artifact_id",
    "configuration_sha256",
    "topology_id",
    "topology_artifact_id",
    "topology_sha256",
    "asset_id",
    "snapshot_id",
    "snapshot_sha256",
    "as_of",
    "snapshot",
    "revocation_snapshot_sha256",
    "revocation_snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-runtime-admission-request.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decision_tier": {
      "enum": [
        "D0_descriptive",
        "D1_advisory",
        "D2_delegated_planning",
        "D3_autonomous_control"
      ]
    },
    "action": {
      "enum": [
        "view",
        "annotate",
        "recommend",
        "rank_options",
        "prepare_plan",
        "schedule_within_envelope",
        "execute_external_action"
      ]
    },
    "intended_user": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evaluator_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "evaluator_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "configuration_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "topology_artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "topology_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "as_of",
        "asset_id",
        "topology_sha256",
        "conditions"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "topology_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variable",
              "unit",
              "value",
              "lower",
              "upper",
              "observed_at",
              "evidence_artifact_id",
              "evidence_sha256"
            ],
            "properties": {
              "variable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "value": {
                "type": "number"
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "evidence_artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      }
    },
    "revocation_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "revocation_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "as_of",
        "status",
        "authorization_status",
        "revoked_profile_ids",
        "revoked_artifact_ids",
        "revoked_sha256",
        "allowed_actions"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "as_of": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "status": {
          "enum": [
            "current",
            "unknown",
            "unavailable"
          ]
        },
        "authorization_status": {
          "enum": [
            "authorized",
            "denied",
            "unknown"
          ]
        },
        "revoked_profile_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revoked_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revoked_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "enum": [
              "view",
              "annotate",
              "recommend",
              "rank_options",
              "prepare_plan",
              "schedule_within_envelope",
              "execute_external_action"
            ]
          }
        }
      }
    }
  }
}
