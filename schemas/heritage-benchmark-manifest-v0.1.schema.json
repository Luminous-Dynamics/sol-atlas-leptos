{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-benchmark-manifest-v0.1.schema.json",
  "title": "Heritage Discovery Benchmark Manifest",
  "description": "A frozen, reproducible benchmark specification for HDB-1 to HDB-8. Dataset and split references must resolve to rights-cleared, independently governed site packs. HDB-7 adds probability-sampled negative-space audits; HDB-8 adds sequential non-invasive survey policy evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "task_id",
    "created_at",
    "dataset_inventory_digest",
    "split_protocol",
    "splits",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-benchmark-manifest.v0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "enum": [
        "HDB-1",
        "HDB-2",
        "HDB-3",
        "HDB-4",
        "HDB-5",
        "HDB-6",
        "HDB-7",
        "HDB-8"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dataset_inventory_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "split_protocol": {
      "enum": [
        "within_site_spatial_block",
        "held_out_site",
        "held_out_region",
        "leave_one_biome_out",
        "leave_one_sensor_out",
        "temporal_holdout",
        "external_blind"
      ]
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "split_id",
          "train_site_ids",
          "validation_site_ids",
          "test_site_ids"
        ],
        "properties": {
          "split_id": {
            "type": "string",
            "minLength": 1
          },
          "train_site_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "validation_site_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "test_site_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "spatial_buffer_m": {
            "type": "number",
            "minimum": 0
          },
          "estimated_spatial_dependence_m": {
            "type": "number",
            "minimum": 0
          },
          "held_out_region_id": {
            "type": "string"
          },
          "held_out_biome_id": {
            "type": "string"
          },
          "held_out_sensor_id": {
            "type": "string"
          },
          "temporal_cutoff_at": {
            "type": "string",
            "format": "date-time"
          },
          "split_manifest_digest": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric",
        "review_budget",
        "metrics",
        "blind_labels"
      ],
      "properties": {
        "primary_metric": {
          "type": "string",
          "minLength": 1
        },
        "review_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "limit"
          ],
          "properties": {
            "unit": {
              "enum": [
                "analyst_minutes",
                "analyst_hours",
                "candidate_count",
                "square_kilometres",
                "survey_cost"
              ]
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence_interval_method": {
          "type": "string"
        },
        "bootstrap_unit": {
          "enum": [
            "feature",
            "site",
            "landscape",
            "region"
          ]
        },
        "blind_labels": {
          "type": "boolean"
        },
        "evaluation_code_revision": {
          "type": "string"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sampling_design_ref": {
          "type": "string",
          "minLength": 1
        },
        "population_frame_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "inclusion_probability_unit": {
          "enum": [
            "feature",
            "candidate",
            "site",
            "landscape_block",
            "grid_cell"
          ]
        },
        "variance_method": {
          "enum": [
            "joint_inclusion_probability",
            "stratified_srswor",
            "psu_cluster_variance",
            "not_computed_requires_design"
          ]
        },
        "decision_horizon_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "policy_baselines": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "random",
              "uniform_grid",
              "expert_prioritized",
              "highest_anomaly_first",
              "cost_only",
              "myopic_eig",
              "finite_horizon_eig"
            ]
          }
        },
        "likelihood_model_inventory_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "authorization_policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "non_invasive_only": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "HDB-7"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "required": [
              "sampling_design_ref",
              "population_frame_digest",
              "inclusion_probability_unit",
              "variance_method"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_id": {
            "const": "HDB-8"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "required": [
              "decision_horizon_steps",
              "policy_baselines",
              "likelihood_model_inventory_digest",
              "authorization_policy_ref",
              "non_invasive_only"
            ],
            "properties": {
              "non_invasive_only": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
