{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-benchmark-manifest-v0.1.schema.json",
  "title": "Heritage Discovery Benchmark Manifest",
  "description": "A frozen, reproducible benchmark specification. Dataset and split references must resolve to rights-cleared, independently governed site packs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "benchmark_version",
    "task_id",
    "created_at",
    "dataset_inventory_digest",
    "split_protocol",
    "splits",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-benchmark-manifest.v0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "enum": [
        "HDB-1",
        "HDB-2",
        "HDB-3",
        "HDB-4",
        "HDB-5",
        "HDB-6"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dataset_inventory_digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "split_protocol": {
      "enum": [
        "within_site_spatial_block",
        "held_out_site",
        "held_out_region",
        "leave_one_biome_out",
        "leave_one_sensor_out",
        "temporal_holdout",
        "external_blind"
      ]
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "split_id",
          "train_site_ids",
          "validation_site_ids",
          "test_site_ids"
        ],
        "properties": {
          "split_id": {
            "type": "string",
            "minLength": 1
          },
          "train_site_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "validation_site_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "test_site_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "spatial_buffer_m": {
            "type": "number",
            "minimum": 0
          },
          "estimated_spatial_dependence_m": {
            "type": "number",
            "minimum": 0
          },
          "held_out_region_id": {
            "type": "string"
          },
          "held_out_biome_id": {
            "type": "string"
          },
          "held_out_sensor_id": {
            "type": "string"
          },
          "temporal_cutoff_at": {
            "type": "string",
            "format": "date-time"
          },
          "split_manifest_digest": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_metric",
        "review_budget",
        "metrics",
        "blind_labels"
      ],
      "properties": {
        "primary_metric": {
          "type": "string",
          "minLength": 1
        },
        "review_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "limit"
          ],
          "properties": {
            "unit": {
              "enum": [
                "analyst_minutes",
                "analyst_hours",
                "candidate_count",
                "square_kilometres",
                "survey_cost"
              ]
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence_interval_method": {
          "type": "string"
        },
        "bootstrap_unit": {
          "enum": [
            "feature",
            "site",
            "landscape",
            "region"
          ]
        },
        "blind_labels": {
          "type": "boolean"
        },
        "evaluation_code_revision": {
          "type": "string"
        },
        "environment_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
