{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-water-energy-intervention-v0.1.schema.json",
  "title": "Spatial-Economic Water-Energy Intervention Comparison Request",
  "description": "Paired baseline/candidate electricity-coupled water-service scenarios. The comparison requires an identical service entity, ordered sample IDs, timestamps and interval durations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "baseline",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "$ref": "https://luminousdynamics.io/schemas/spatial-economic-water-energy-coupling-v0.1.schema.json"
    },
    "candidate": {
      "$ref": "https://luminousdynamics.io/schemas/spatial-economic-water-energy-coupling-v0.1.schema.json"
    }
  }
}
