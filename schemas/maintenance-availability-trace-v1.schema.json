{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/maintenance-availability-trace-v1.schema.json",
  "title": "Maintenance Availability Trace v1",
  "description": "Study-scoped, one-asset maintenance availability projection. This schema validates representation only; semantic ordering and complete interval partition are checked by validate_trace_structure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "study_id",
    "study_window",
    "target",
    "work_order_id",
    "source_event_refs",
    "intervals",
    "disposition",
    "late_start",
    "late_completion",
    "late_return_to_service",
    "overdue_unresolved",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable length-prefixed composite key derived from the exact study and source inputs; not a cryptographic content digest."
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "study_window": {
      "$ref": "#/$defs/study_window"
    },
    "target": {
      "$ref": "#/$defs/asset_identity"
    },
    "work_order_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_refs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      },
      "description": "Includes baseline and work-order source refs. The Rust validator rejects duplicate reference identities."
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/availability_interval"
      },
      "description": "Half-open Unix-second intervals; the Rust validator enforces complete, ordered, gap-free, non-overlapping coverage of study_window."
    },
    "disposition": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "not_evaluable"
      ]
    },
    "late_start": {
      "type": "boolean"
    },
    "late_completion": {
      "type": "boolean"
    },
    "late_return_to_service": {
      "type": "boolean"
    },
    "overdue_unresolved": {
      "type": "boolean"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "study_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_unix_seconds",
        "end_unix_seconds"
      ],
      "properties": {
        "start_unix_seconds": {
          "type": "integer"
        },
        "end_unix_seconds": {
          "type": "integer"
        }
      }
    },
    "asset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "configuration_digest"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest",
        "observed_at_unix_seconds",
        "configuration_digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque source digest/reference; authenticity is checked upstream."
        },
        "observed_at_unix_seconds": {
          "type": "integer"
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "availability_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_unix_seconds",
        "end_unix_seconds",
        "state",
        "configuration_digest"
      ],
      "properties": {
        "start_unix_seconds": {
          "type": "integer"
        },
        "end_unix_seconds": {
          "type": "integer"
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "planned_outage",
            "unknown"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
