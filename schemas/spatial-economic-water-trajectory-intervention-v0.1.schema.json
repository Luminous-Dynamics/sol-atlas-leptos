{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-water-trajectory-intervention-v0.1.schema.json",
  "title": "Water Service Trajectory Intervention Request",
  "description": "Aligned baseline/candidate trajectory counterfactual comparison; candidate assumptions do not prove an intervention was executed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "rationale",
    "baseline",
    "candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "$ref": "https://luminousdynamics.io/schemas/spatial-economic-water-service-trajectory-v0.1.schema.json"
    },
    "candidate": {
      "$ref": "https://luminousdynamics.io/schemas/spatial-economic-water-service-trajectory-v0.1.schema.json"
    }
  }
}
