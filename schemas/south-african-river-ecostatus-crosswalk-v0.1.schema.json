{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/south-african-river-ecostatus-crosswalk-v0.1.schema.json",
  "title": "South African River Eco-status Crosswalk v0.1",
  "description": "Machine-readable crosswalk of DWS REMP river assessment tools to SER ecological attributes. It describes framework semantics and candidate mapping, not admitted Jukskei measurements or equivalence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "crosswalk_id",
    "purpose",
    "sources",
    "sampling_semantics",
    "indices",
    "ser_attribute_crosswalk",
    "non_equivalence_rules",
    "admission_requirements",
    "adversarial_controls",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "crosswalk_id": {
      "const": "DWS-REMP-SER-CROSSWALK-0.1"
    },
    "purpose": {
      "const": "framework_interoperability_not_measurement_equivalence"
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "sampling_semantics": {
      "$ref": "#/$defs/sampling"
    },
    "indices": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/index"
      }
    },
    "ser_attribute_crosswalk": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/attribute"
      }
    },
    "non_equivalence_rules": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "admission_requirements": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "adversarial_controls": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 12
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "publisher",
        "title",
        "document_status",
        "source_url",
        "relevant_scope"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "document_status": {
          "enum": [
            "official_programme_page",
            "final_national_report",
            "draft_guideline",
            "methodology_page"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "relevant_scope": {
          "type": "string",
          "minLength": 8
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programme_name",
        "programme_parent",
        "monitoring_purpose",
        "assessment_units",
        "reported_frequency",
        "reporting_frequency",
        "relative_reference_condition",
        "reference_drivers",
        "biotic_response_domains",
        "network_coverage_note"
      ],
      "properties": {
        "programme_name": {
          "const": "River Eco-status Monitoring Programme (REMP)"
        },
        "programme_parent": {
          "const": "National Aquatic Ecosystem Health Monitoring Programme (NAEHMP)"
        },
        "monitoring_purpose": {
          "type": "string",
          "minLength": 20
        },
        "assessment_units": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sub_quaternary_catchment_reach",
              "river_reach",
              "site"
            ]
          }
        },
        "reported_frequency": {
          "type": "string",
          "minLength": 8
        },
        "reporting_frequency": {
          "type": "string",
          "minLength": 8
        },
        "relative_reference_condition": {
          "type": "string",
          "minLength": 20
        },
        "reference_drivers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "enum": [
              "hydrology",
              "geomorphology",
              "physico_chemical_water_quality",
              "habitat_template"
            ]
          }
        },
        "biotic_response_domains": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "in_stream_biota",
              "riparian_biota"
            ]
          }
        },
        "network_coverage_note": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_id",
        "name",
        "domain",
        "assessment_target",
        "evidence_type",
        "interpretation_limit",
        "source_ids"
      ],
      "properties": {
        "index_id": {
          "enum": [
            "SASS",
            "MIRAI",
            "FRAI",
            "VEGRAI",
            "IHI",
            "HAI",
            "GAI",
            "PAI",
            "INTEGRATED_ECOSTATUS"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "biological_response",
            "driver",
            "integrated_summary"
          ]
        },
        "assessment_target": {
          "type": "string",
          "minLength": 8
        },
        "evidence_type": {
          "enum": [
            "field_biological_assessment",
            "habitat_assessment",
            "hydrological_assessment",
            "geomorphological_assessment",
            "physico_chemical_assessment",
            "integrated_derived_category"
          ]
        },
        "interpretation_limit": {
          "type": "string",
          "minLength": 12
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ser_attribute",
        "coverage_status",
        "mapped_indices",
        "uncovered_dimensions",
        "interpretation"
      ],
      "properties": {
        "ser_attribute": {
          "enum": [
            "absence_of_threats",
            "physical_conditions",
            "species_composition",
            "structural_diversity",
            "ecosystem_function",
            "external_exchanges"
          ]
        },
        "coverage_status": {
          "enum": [
            "direct",
            "partial_proxy",
            "gap",
            "mixed"
          ]
        },
        "mapped_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "SASS",
              "MIRAI",
              "FRAI",
              "VEGRAI",
              "IHI",
              "HAI",
              "GAI",
              "PAI",
              "INTEGRATED_ECOSTATUS"
            ]
          }
        },
        "uncovered_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "interpretation": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "fault",
        "expected_behavior",
        "severity"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^REMP-CTRL-[0-9]{3}$"
        },
        "fault": {
          "type": "string",
          "minLength": 12
        },
        "expected_behavior": {
          "type": "string",
          "minLength": 20
        },
        "severity": {
          "enum": [
            "hard_gate",
            "claim_downgrade",
            "scope_warning"
          ]
        }
      }
    }
  }
}
