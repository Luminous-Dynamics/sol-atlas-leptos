{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/decision-reliance-receipt-v0.1.schema.json",
  "title": "Engineering Decision Reliance Receipt v0.1",
  "description": "A time-qualified evaluation of whether an immutable engineering decision remains supportable for a declared purpose and scope. It does not grant construction, operational, or actuation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "evaluation_environment",
    "result",
    "case_id",
    "jurisdiction",
    "purpose",
    "scope",
    "decision",
    "evaluation_time",
    "knowledge_watermark",
    "input_bindings",
    "obligations",
    "revalidation_obligations",
    "actor_authorization",
    "action_authority",
    "claim_ceiling",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.engineering-decision-reliance-receipt.v0.1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evaluation_environment": {
      "enum": [
        "synthetic_only",
        "qualification",
        "field_evaluation"
      ]
    },
    "result": {
      "enum": [
        "reliable_for_declared_scope",
        "revalidation_required",
        "insufficient_evidence",
        "not_authorized",
        "invalid_evidence"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ids",
        "engineering_disciplines",
        "decision_boundary",
        "declared_profile_sha256",
        "required_proof_classes"
      ],
      "properties": {
        "subject_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "engineering_disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "decision_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "declared_profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_proof_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "decision_identity",
              "source_payload_bytes",
              "source_owner_authority",
              "source_snapshot_currentness",
              "source_rights",
              "source_inventory_coverage",
              "dependency_completeness",
              "projection_semantics",
              "impact_frontier_correctness",
              "lifecycle_currentness",
              "engineering_verification",
              "professional_review",
              "actor_authorization",
              "schema_interoperability"
            ]
          },
          "description": "The complete proof-class set required by the declared reliance profile. The evaluator must verify that each listed class has exactly one corresponding obligation row; it must not infer completeness from the obligation rows alone."
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_identity_sha256",
        "decision_payload_sha256",
        "decision_event_id",
        "decision_disposition",
        "decided_at",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "native_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "decision_disposition": {
          "enum": [
            "approve",
            "conditional",
            "reject",
            "defer",
            "superseded",
            "withdrawn"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time"
    },
    "knowledge_watermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_recorded_through",
        "trusted_registered_through",
        "source_snapshot_manifest_sha256"
      ],
      "properties": {
        "system_recorded_through": {
          "type": "string",
          "format": "date-time"
        },
        "trusted_registered_through": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_snapshot_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ieac_graph_sha256",
        "projection_receipt_sha256",
        "descriptor_catalog_sha256",
        "payload_byte_report_sha256",
        "coverage_report_sha256",
        "trust_evaluation_sha256",
        "lifecycle_report_sha256",
        "engineering_report_sha256",
        "impact_report_sha256"
      ],
      "properties": {
        "ieac_graph_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "projection_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "descriptor_catalog_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_byte_report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "coverage_report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_evaluation_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "lifecycle_report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "engineering_report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "impact_report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proof_class",
          "mandatory",
          "status",
          "evidence_refs",
          "evaluator_build_sha256",
          "evaluated_at",
          "expires_at",
          "reason_codes"
        ],
        "properties": {
          "proof_class": {
            "enum": [
              "decision_identity",
              "source_payload_bytes",
              "source_owner_authority",
              "source_snapshot_currentness",
              "source_rights",
              "source_inventory_coverage",
              "dependency_completeness",
              "projection_semantics",
              "impact_frontier_correctness",
              "lifecycle_currentness",
              "engineering_verification",
              "professional_review",
              "actor_authorization",
              "schema_interoperability"
            ]
          },
          "mandatory": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "qualified",
              "missing",
              "invalid",
              "stale",
              "unsupported",
              "not_comparable",
              "not_evaluated"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "sha256"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "evaluator_build_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]{3,96}$"
            }
          }
        }
      }
    },
    "revalidation_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "cause_code",
          "affected_decision_id",
          "required_action",
          "blocking"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "cause_code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{3,96}$"
          },
          "affected_decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "required_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "actor_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "capability",
        "status",
        "authority_evidence_sha256",
        "evaluated_at"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "capability": {
          "enum": [
            "view_reliance",
            "rely_for_declared_purpose",
            "change_decision",
            "release_construction",
            "operate_asset",
            "actuate_system"
          ]
        },
        "status": {
          "enum": [
            "authorized",
            "not_authorized",
            "unknown",
            "expired",
            "revoked"
          ]
        },
        "authority_evidence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "action_authority": {
      "const": "none"
    },
    "claim_ceiling": {
      "const": "decision_reliance_evaluation_only"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "reliable_for_declared_scope"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "actor_authorization": {
            "properties": {
              "status": {
                "const": "authorized"
              }
            }
          },
          "obligations": {
            "items": {
              "properties": {
                "status": {
                  "const": "qualified"
                }
              }
            }
          },
          "revalidation_obligations": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "revalidation_required"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "revalidation_obligations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "not_authorized"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "actor_authorization": {
            "properties": {
              "status": {
                "enum": [
                  "not_authorized",
                  "expired",
                  "revoked"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "invalid_evidence"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "obligations": {
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "invalid"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "insufficient_evidence"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "obligations": {
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "missing",
                    "stale",
                    "unsupported",
                    "not_comparable",
                    "not_evaluated"
                  ]
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    }
  ]
}
