{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-dispatch-report-v1.schema.json",
  "title": "Bounded exact microgrid dispatch assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_schema_version",
    "case_id",
    "synthetic",
    "evidence_class",
    "evidence_ref",
    "evidence_as_of",
    "claim_ceiling",
    "energy_quantum_kwh",
    "search_is_exact",
    "pareto_frontier_complete",
    "evaluated_action_expansions",
    "feasible_complete_schedules",
    "pareto_frontier_count",
    "pareto_alternatives"
  ],
  "properties": {
    "assessment_schema_version": { "const": "energy-dispatch-report-v1" },
    "case_id": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "evidence_class": { "$ref": "#/$defs/evidenceClass" },
    "evidence_ref": { "type": ["string", "null"] },
    "evidence_as_of": { "type": ["string", "null"] },
    "claim_ceiling": { "type": "string", "minLength": 1 },
    "energy_quantum_kwh": { "type": "number", "exclusiveMinimum": 0 },
    "search_is_exact": { "const": true },
    "pareto_frontier_complete": { "const": true },
    "evaluated_action_expansions": { "type": "integer", "minimum": 1 },
    "feasible_complete_schedules": { "type": "integer", "minimum": 1 },
    "pareto_frontier_count": { "type": "integer", "minimum": 1, "maximum": 128 },
    "pareto_alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/alternative" }
    }
  },
  "$defs": {
    "evidenceClass": {
      "type": "string",
      "enum": [
        "analyst_assumption",
        "published_model",
        "component_test",
        "field_pilot",
        "operating_plant",
        "replicated_fleet",
        "independently_audited"
      ]
    },
    "u16": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "u64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "essential_unserved_quanta",
        "flexible_unserved_quanta",
        "operating_cost_units",
        "grid_carbon_grams",
        "curtailed_pv_quanta",
        "terminal_soc_quanta"
      ],
      "properties": {
        "essential_unserved_quanta": { "$ref": "#/$defs/u64" },
        "flexible_unserved_quanta": { "$ref": "#/$defs/u64" },
        "operating_cost_units": { "$ref": "#/$defs/u64" },
        "grid_carbon_grams": { "$ref": "#/$defs/u64" },
        "curtailed_pv_quanta": { "$ref": "#/$defs/u64" },
        "terminal_soc_quanta": { "$ref": "#/$defs/u16" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_id",
        "start_unix_seconds",
        "duration_seconds",
        "grid_outage",
        "pv_available_quanta",
        "pv_used_quanta",
        "pv_curtailed_quanta",
        "grid_import_quanta",
        "battery_soc_before_quanta",
        "battery_charge_input_quanta",
        "battery_soc_withdrawal_quanta",
        "battery_discharge_delivered_quanta",
        "battery_soc_after_quanta",
        "essential_demand_quanta",
        "essential_served_quanta",
        "essential_unserved_quanta",
        "flexible_demand_quanta",
        "flexible_served_quanta",
        "flexible_unserved_quanta",
        "grid_cost_units_per_quantum",
        "grid_carbon_grams_per_quantum",
        "bus_energy_balance_residual_quanta"
      ],
      "properties": {
        "interval_id": { "type": "string", "minLength": 1 },
        "start_unix_seconds": { "type": "integer" },
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "grid_outage": { "type": "boolean" },
        "pv_available_quanta": { "$ref": "#/$defs/u16" },
        "pv_used_quanta": { "$ref": "#/$defs/u16" },
        "pv_curtailed_quanta": { "$ref": "#/$defs/u16" },
        "grid_import_quanta": { "$ref": "#/$defs/u16" },
        "battery_soc_before_quanta": { "$ref": "#/$defs/u16" },
        "battery_charge_input_quanta": { "$ref": "#/$defs/u16" },
        "battery_soc_withdrawal_quanta": { "$ref": "#/$defs/u16" },
        "battery_discharge_delivered_quanta": { "$ref": "#/$defs/u16" },
        "battery_soc_after_quanta": { "$ref": "#/$defs/u16" },
        "essential_demand_quanta": { "$ref": "#/$defs/u16" },
        "essential_served_quanta": { "$ref": "#/$defs/u16" },
        "essential_unserved_quanta": { "$ref": "#/$defs/u16" },
        "flexible_demand_quanta": { "$ref": "#/$defs/u16" },
        "flexible_served_quanta": { "$ref": "#/$defs/u16" },
        "flexible_unserved_quanta": { "$ref": "#/$defs/u16" },
        "grid_cost_units_per_quantum": { "$ref": "#/$defs/u32" },
        "grid_carbon_grams_per_quantum": { "$ref": "#/$defs/u32" },
        "bus_energy_balance_residual_quanta": { "const": 0 }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "schedule"],
      "properties": {
        "objective": { "$ref": "#/$defs/objective" },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    }
  }
}
