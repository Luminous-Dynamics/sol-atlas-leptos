{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-tuf-inprocess-report-v0.1.schema.json",
  "title": "IEAC In-process TUF Verification Report v0.1",
  "description": "Report produced after in-process TUF metadata refresh, delegation resolution and target byte verification. Not a decision or actuation authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "verification_method",
    "tuf_client",
    "repository_id",
    "repository_url",
    "bootstrap_root_path",
    "bootstrap_root_version",
    "timestamp_version",
    "snapshot_version",
    "top_level_targets_version",
    "update_started_at",
    "targets",
    "metadata_cache",
    "persistent_high_water",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-tuf-inprocess-report.v0.1"
    },
    "status": {
      "const": "cryptographically_verified"
    },
    "verification_method": {
      "const": "in_process_sigstore_tuf_updater"
    },
    "tuf_client": {
      "const": "sigstore-tuf/0.15.1"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "bootstrap_root_path": {
      "type": "string",
      "minLength": 1
    },
    "bootstrap_root_version": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp_version": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_version": {
      "type": "integer",
      "minimum": 1
    },
    "top_level_targets_version": {
      "type": "integer",
      "minimum": 1
    },
    "update_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "length",
          "sha256",
          "cached_bytes_used",
          "verification"
        ],
        "properties": {
          "id": {
            "enum": [
              "channel_manifest",
              "checkpoint_state",
              "completeness_attestation",
              "availability_audit_report"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cached_bytes_used": {
            "type": "boolean"
          },
          "verification": {
            "const": "verified_by_sigstore_tuf_target_length_and_hash"
          }
        }
      }
    },
    "metadata_cache": {
      "const": "sigstore_tuf_file_store_reverified_from_pinned_bootstrap_root"
    },
    "persistent_high_water": {
      "const": "not_managed_by_this_binary"
    },
    "claim_ceiling": {
      "const": "tuf_metadata_signatures_thresholds_expiry_rollback_delegation_and_target_integrity_only"
    },
    "action_authority": {
      "const": "none"
    }
  }
}
