{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-measurement-selection-report-v0.1.schema.json",
  "title": "Landscape measurement selection report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "conformance_status",
    "data_origin",
    "claim_ceiling",
    "input_sha256",
    "budget_cost_units",
    "selected_cost_units",
    "unspent_budget_units",
    "candidate_count",
    "eligible_candidate_count",
    "ineligible_candidate_count",
    "selected_candidate_count",
    "eligible_not_selected_count",
    "selected_candidate_ids",
    "total_weighted_discrimination_nats",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.landscape_measurement_selection_report.v0.1"
    },
    "suite_id": {
      "const": "LANDSCAPE-MEASUREMENT-PLANNER-V0.1"
    },
    "conformance_status": {
      "const": "PASS_SYNTHETIC_SELECTION_ONLY"
    },
    "data_origin": {
      "const": "synthetic_fixture"
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_SELECTION_ONLY"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "budget_cost_units": {
      "type": "integer",
      "minimum": 1
    },
    "selected_cost_units": {
      "type": "integer",
      "minimum": 0
    },
    "unspent_budget_units": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "eligible_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "ineligible_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "eligible_not_selected_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "total_weighted_discrimination_nats": {
      "type": "number",
      "minimum": 0
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "decision",
        "reason",
        "correlation_group",
        "cost_units",
        "symmetric_kl_nats",
        "weighted_discrimination_nats"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "selected",
            "not_selected"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_group": {
          "type": "string",
          "minLength": 1
        },
        "cost_units": {
          "type": "integer",
          "minimum": 1
        },
        "symmetric_kl_nats": {
          "type": "number",
          "minimum": 0
        },
        "weighted_discrimination_nats": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
