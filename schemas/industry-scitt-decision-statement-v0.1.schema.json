{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-scitt-decision-statement-v0.1.schema.json",
  "title": "IEAC SCITT Decision Statement Payload v0.1",
  "description": "Strict payload contract only. It does not encode or verify the outer SCITT COSE_Sign1 object, CWT protected claims, SCITT receipt, VDS inclusion or consistency proofs, signer authorization, event-chain completeness, or truth of the claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_kind",
    "issuer_id",
    "subject_id",
    "decision_case_id",
    "issuer_stream_id",
    "issuer_sequence",
    "previous_event_payload_sha256",
    "causal_parent_payload_sha256",
    "issued_at",
    "ieac_profile",
    "artifact_bindings",
    "disposition",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-scitt-decision-statement.v0.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "event_kind": {
      "enum": [
        "request_committed",
        "admission_verdict",
        "authorization_record",
        "execution_receipt",
        "outcome_reconciliation",
        "supersession",
        "revocation_checkpoint"
      ]
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "decision_case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "issuer_stream_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issuer_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_event_payload_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "causal_parent_payload_sha256": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 64
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "ieac_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_sha256"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "role",
          "media_type",
          "sha256",
          "disclosure"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "enum": [
              "ieac_signed_envelope",
              "evidence_ledger",
              "candidate_report",
              "independent_verifier_report",
              "source_snapshot",
              "outcome_record",
              "build_provenance",
              "authorization_record"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "disclosure": {
            "enum": [
              "digest_only",
              "encrypted_external_reference"
            ]
          }
        }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "admit_descriptive",
            "abstain",
            "reject"
          ]
        }
      ]
    },
    "claim_ceiling": {
      "const": "record_only"
    },
    "action_authority": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "issuer_sequence": {
            "const": 1
          }
        },
        "required": [
          "issuer_sequence"
        ]
      },
      "then": {
        "properties": {
          "previous_event_payload_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_event_payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_kind": {
            "const": "admission_verdict"
          }
        },
        "required": [
          "event_kind"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "enum": [
              "admit_descriptive",
              "abstain",
              "reject"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "disposition": {
            "type": "null"
          }
        }
      }
    }
  ]
}
