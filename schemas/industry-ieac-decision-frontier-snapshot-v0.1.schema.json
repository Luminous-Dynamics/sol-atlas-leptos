    "schema_version": {
      "const": "luminous.ieac-decision-frontier-snapshot.v0.1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_case_id",
        "decision_event_sha256",
        "subject_pseudonym",
        "relying_party_id",
        "profile_sha256",
        "policy_sha256",
        "evaluator_build_sha256"
      ],
      "properties": {
        "decision_case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_event_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject_pseudonym": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "relying_party_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluator_build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision_cutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_utc",
        "uncertainty_before_seconds",
        "uncertainty_after_seconds",
        "clock_id",
        "basis",
        "verification_status",
        "proof_sha256",
        "verifier_build_sha256",
        "verification_policy_sha256"
      ],
      "properties": {
        "time_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "description": "v0.1 accepts normalized UTC whole seconds only; offsets, fractional seconds and leap seconds are refused."
        },
        "uncertainty_before_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "uncertainty_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "clock_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "basis": {
          "enum": [
            "trusted_clock_attestation",
            "authenticated_ingest_log",
            "scitt_receipt",
            "rfc3161_timestamp_token",
            "source_assertion",
            "system_wall_clock"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "failed",
            "unknown",
            "not_checked",
            "disputed"
          ]
        },
        "proof_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifier_build_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification_policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
