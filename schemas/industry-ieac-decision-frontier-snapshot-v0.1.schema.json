  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-decision-frontier-snapshot-v0.1.schema.json",
  "title": "IEAC Decision-Time Evidence Frontier Snapshot v0.1",
  "description": "A snapshot contract for distinguishing valid time, source observation time, source-recorded time and independently evidenced relying-party availability relative to a trusted decision cutoff. Structural schema only; verifier facts and source truth remain externally governed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "decision",
    "decision_cutoff",
    "evidence",
    "claim_ceiling",
    "action_authority"
  ],
