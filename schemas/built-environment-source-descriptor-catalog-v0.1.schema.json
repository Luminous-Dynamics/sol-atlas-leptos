{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/built-environment-source-descriptor-catalog-v0.1.schema.json",
  "title": "Built Environment Source Descriptor Catalogue v0.1",
  "description": "An additive sidecar for owner-native identity and exact source payload metadata. Structural validity does not authenticate the source owner, bytes, rights, or attestations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "case_id",
    "case_representation_sha256",
    "captured_at",
    "descriptors",
    "claim_ceiling",
    "action_authority",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.built-environment-source-descriptor-catalog.v0.1"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "case_representation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_kind",
          "case_record_id",
          "owner_namespace",
          "native_identity_components",
          "source_payload",
          "source_snapshot",
          "observation_time",
          "rights",
          "attestation"
        ],
        "properties": {
          "record_kind": {
            "enum": [
              "evidence",
              "artifact",
              "engineering_receipt",
              "decision"
            ]
          },
          "case_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "owner_namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "native_identity_components": {
            "type": "array",
            "minItems": 2,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "const": "native_id"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              },
              {
                "contains": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "native_record_id"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "native_revision"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "native_sequence"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "const": "native_observation_id"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    }
                  ]
                }
              }
            ]
          },
          "source_payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "digest_basis",
              "bytes_retrieved",
              "byte_length",
              "payload_object_ref",
              "media_type",
              "schema_id",
              "schema_version",
              "schema_sha256"
            ],
            "properties": {
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "digest_basis": {
                "enum": [
                  "locally_retrieved_and_hashed",
                  "source_owner_attested",
                  "external_reference",
                  "unavailable"
                ]
              },
              "bytes_retrieved": {
                "type": "boolean"
              },
              "byte_length": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "payload_object_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^cas:sha256:[0-9a-f]{64}$"
              },
              "media_type": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 3,
                "maxLength": 256
              },
              "schema_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2048
              },
              "schema_version": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "schema_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "digest_basis": {
                      "const": "locally_retrieved_and_hashed"
                    }
                  },
                  "required": [
                    "digest_basis"
                  ]
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes_retrieved": {
                      "const": true
                    },
                    "byte_length": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "payload_object_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "digest_basis": {
                      "const": "source_owner_attested"
                    }
                  },
                  "required": [
                    "digest_basis"
                  ]
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes_retrieved": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "digest_basis": {
                      "const": "external_reference"
                    }
                  },
                  "required": [
                    "digest_basis"
                  ]
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "bytes_retrieved": {
                      "const": false
                    },
                    "payload_object_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "digest_basis": {
                      "const": "unavailable"
                    }
                  },
                  "required": [
                    "digest_basis"
                  ]
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "type": "null"
                    },
                    "bytes_retrieved": {
                      "const": false
                    },
                    "byte_length": {
                      "type": "null"
                    },
                    "payload_object_ref": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "source_snapshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_system_id",
              "snapshot_id",
              "snapshot_sha256",
              "captured_at",
              "retrieved_at"
            ],
            "properties": {
              "snapshot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "captured_at": {
                "type": "string",
                "format": "date-time"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "source_system_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "Stable source-system identifier matching the corresponding federated source inventory manifest."
              }
            }
          },
          "observation_time": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "recorded_at"
            ],
            "properties": {
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "permitted_uses",
              "rights_evidence_ref"
            ],
            "properties": {
              "state": {
                "enum": [
                  "verified",
                  "restricted",
                  "unknown",
                  "not_applicable"
                ]
              },
              "permitted_uses": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "impact_analysis",
                    "design_review",
                    "engineering_review",
                    "construction_release_review",
                    "maintenance_review",
                    "benchmarking"
                  ]
                }
              },
              "rights_evidence_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "unknown"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "properties": {
                    "permitted_uses": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "properties": {
                    "permitted_uses": {
                      "minItems": 1
                    },
                    "rights_evidence_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "attestation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement_ref",
              "key_id",
              "trust_evaluation"
            ],
            "properties": {
              "statement_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 2048
              },
              "key_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 512
              },
              "trust_evaluation": {
                "const": "not_evaluated_by_descriptor_catalog"
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "descriptor_integrity_only"
    },
    "action_authority": {
      "const": "none"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  }
}
