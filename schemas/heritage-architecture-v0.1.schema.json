{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-architecture-v0.1.schema.json",
  "title": "Sol-Atlas Heritage Architecture Input v0.1",
  "description": "Structural contract for source-bound architectural measurement observations and stone-to-settlement assembly graphs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "site_id",
    "snapshot_id",
    "coordinate_reference_id",
    "captures",
    "elements"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-architecture.v0.1"
    },
    "project_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "coordinate_reference_id": { "type": "string", "minLength": 1 },
    "captures": {
      "type": "array",
      "items": { "$ref": "#/$defs/capture" }
    },
    "elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id",
        "site_id",
        "snapshot_id",
        "modality",
        "source_sha256",
        "coordinate_reference_id",
        "rights_state"
      ],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 },
        "site_id": { "type": "string", "minLength": 1 },
        "snapshot_id": { "type": "string", "minLength": 1 },
        "modality": {
          "enum": [
            "drone_image",
            "orthomosaic",
            "satellite_image",
            "photogrammetry",
            "point_cloud",
            "field_survey",
            "total_station",
            "rtk_gnss",
            "derived_model"
          ]
        },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "coordinate_reference_id": { "type": "string", "minLength": 1 },
        "calibration_id": { "type": "string", "minLength": 1 },
        "ground_sample_distance_m": { "type": "number", "exclusiveMinimum": 0 },
        "rights_state": {
          "enum": ["verified", "pending", "unknown", "restricted", "denied"]
        },
        "rights_receipt_ref": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "rights_state": { "const": "verified" } },
            "required": ["rights_state"]
          },
          "then": { "required": ["rights_receipt_ref"] }
        }
      ]
    },
    "parentage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["assigned", "unassigned", "ambiguous", "not_assessed"]
        },
        "parent_element_id": { "type": "string", "minLength": 1 },
        "candidate_parent_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "assigned" } },
            "required": ["status"]
          },
          "then": {
            "required": ["parent_element_id"],
            "properties": {
              "candidate_parent_element_ids": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "ambiguous" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "candidate_parent_element_ids": { "minItems": 2 }
            },
            "not": { "required": ["parent_element_id"] }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["unassigned", "not_assessed"] }
            },
            "required": ["status"]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["parent_element_id"] },
                {
                  "properties": {
                    "candidate_parent_element_ids": { "minItems": 1 }
                  },
                  "required": ["candidate_parent_element_ids"]
                }
              ]
            }
          }
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "area_standard_deviation_m2": { "type": "number", "minimum": 0 },
        "area_interval_90_m2": {
          "type": "array",
          "items": { "type": "number", "minimum": 0 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "geometry_sha256",
        "origin",
        "measurement_basis",
        "source_capture_ids"
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "geometry_sha256": { "$ref": "#/$defs/digest" },
        "origin": {
          "enum": [
            "direct_measurement",
            "human_digitization",
            "model_output",
            "simulation"
          ]
        },
        "measurement_basis": {
          "enum": [
            "pixel_only",
            "calibrated_planar2d",
            "calibrated_surface3d"
          ]
        },
        "source_capture_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "spatial_reference_id": { "type": "string", "minLength": 1 },
        "calibration_id": { "type": "string", "minLength": 1 },
        "pixel_area_pixels2": { "type": "number", "exclusiveMinimum": 0 },
        "metric_area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "metric_area_semantics": {
          "enum": ["plan_footprint", "surface_area"]
        },
        "metric_perimeter_m": { "type": "number", "exclusiveMinimum": 0 },
        "mrr_area_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "elongation_ratio": { "type": "number", "minimum": 1 },
        "uncertainty": { "$ref": "#/$defs/uncertainty" },
        "method_build_sha256": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "measurement_basis": { "const": "pixel_only" } },
            "required": ["measurement_basis"]
          },
          "then": {
            "required": ["pixel_area_pixels2"],
            "not": {
              "anyOf": [
                { "required": ["metric_area_m2"] },
                { "required": ["metric_area_semantics"] },
                { "required": ["metric_perimeter_m"] },
                { "required": ["spatial_reference_id"] },
                { "required": ["calibration_id"] },
                { "required": ["uncertainty"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "measurement_basis": { "const": "calibrated_planar2d" } },
            "required": ["measurement_basis"]
          },
          "then": {
            "required": [
              "metric_area_m2",
              "metric_area_semantics",
              "spatial_reference_id",
              "calibration_id"
            ],
            "properties": {
              "metric_area_semantics": { "const": "plan_footprint" }
            }
          }
        },
        {
          "if": {
            "properties": { "measurement_basis": { "const": "calibrated_surface3d" } },
            "required": ["measurement_basis"]
          },
          "then": {
            "required": [
              "metric_area_m2",
              "metric_area_semantics",
              "spatial_reference_id",
              "calibration_id"
            ],
            "properties": {
              "metric_area_semantics": { "const": "surface_area" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": { "enum": ["model_output", "simulation"] }
            },
            "required": ["origin"]
          },
          "then": { "required": ["method_build_sha256"] }
        }
      ]
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "level",
        "parentage",
        "observations"
      ],
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "level": {
          "enum": [
            "stone",
            "wall_segment",
            "wall",
            "building",
            "compound",
            "insula",
            "neighbourhood",
            "settlement"
          ]
        },
        "physical_identity_id": { "type": "string", "minLength": 1 },
        "parentage": { "$ref": "#/$defs/parentage" },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "level": { "const": "stone" } },
            "required": ["level"]
          },
          "then": { "required": ["physical_identity_id"] }
        }
      ]
    }
  }
}
