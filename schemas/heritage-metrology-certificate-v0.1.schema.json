{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-metrology-certificate-v0.1.schema.json",
  "title": "Sol-Atlas Heritage Metrology Certificate v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibration_id",
    "site_id",
    "snapshot_id",
    "coordinate_reference_id",
    "reference_survey_id",
    "method_build_sha256",
    "source_capture_ids",
    "control_point_ids",
    "independent_checkpoints",
    "assessment_profile",
    "independence_attestation_ref",
    "rights_receipt_ref"
  ],
  "properties": {
    "schema_version": { "const": "luminous.heritage-metrology.v0.1" },
    "calibration_id": { "type": "string", "minLength": 1 },
    "site_id": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "coordinate_reference_id": { "type": "string", "minLength": 1 },
    "reference_survey_id": { "type": "string", "minLength": 1 },
    "method_build_sha256": { "$ref": "#/$defs/digest" },
    "source_capture_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "control_point_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "independent_checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "assessment_profile": {
      "enum": ["exploratory", "project_defined", "asprs2024_core"]
    },
    "target_rmse_h_m": { "type": "number", "exclusiveMinimum": 0 },
    "target_rmse_v_m": { "type": "number", "exclusiveMinimum": 0 },
    "independence_attestation_ref": { "type": "string", "minLength": 1 },
    "rights_receipt_ref": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "assessment_profile": { "const": "asprs2024_style" } },
        "required": ["assessment_profile"]
      },
      "then": {
        "required": ["target_rmse_h_m", "target_rmse_v_m"],
        "properties": { "independent_checkpoints": { "minItems": 30 } }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "xyz": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "stratum",
        "reference_xyz_m",
        "product_xyz_m",
        "reference_sigma_h_m",
        "reference_sigma_v_m"
      ],
      "properties": {
        "checkpoint_id": { "type": "string", "minLength": 1 },
        "stratum": { "type": "string", "minLength": 1 },
        "reference_xyz_m": { "$ref": "#/$defs/xyz" },
        "product_xyz_m": { "$ref": "#/$defs/xyz" },
        "reference_sigma_h_m": { "type": "number", "minimum": 0 },
        "reference_sigma_v_m": { "type": "number", "minimum": 0 }
      }
    }
  }
}
