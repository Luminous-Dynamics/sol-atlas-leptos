{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-fitness-for-purpose-report-v0.1.schema.json",
  "title": "Heritage Fitness-for-Purpose Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_sha256",
    "intended_use",
    "intended_claim",
    "independent_unit_kind",
    "descriptor_id",
    "descriptor_units",
    "submitted_unit_count",
    "evaluated_unit_count",
    "not_assessed_unit_count",
    "scored_detection_unit_count",
    "macro_precision",
    "macro_recall",
    "macro_f1",
    "pooled_precision",
    "pooled_recall",
    "pooled_f1",
    "macro_matched_iou",
    "descriptor_mean_absolute_error",
    "descriptor_mean_signed_error",
    "descriptor_rank_spearman",
    "gates",
    "passed",
    "maximum_claim_ceiling",
    "population_uncertainty_claimed",
    "metric_definition_sha256",
    "reference_dataset_sha256",
    "prediction_dataset_sha256",
    "split_manifest_sha256",
    "validation_receipt_ref",
    "validation_receipt_sha256",
    "method_build_sha256",
    "rights_decision_id",
    "rights_receipt_ref",
    "unit_metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-fitness-for-purpose.v0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "$ref": "#/$defs/digest"
    },
    "intended_use": {
      "enum": [
        "feature_extraction",
        "site_descriptor_estimation",
        "between_site_comparison"
      ]
    },
    "intended_claim": {
      "type": "string",
      "minLength": 1
    },
    "independent_unit_kind": {
      "enum": [
        "site",
        "region",
        "acquisition"
      ]
    },
    "descriptor_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "descriptor_units": {
      "type": [
        "string",
        "null"
      ]
    },
    "submitted_unit_count": {
      "type": "integer",
      "minimum": 1
    },
    "evaluated_unit_count": {
      "type": "integer",
      "minimum": 1
    },
    "not_assessed_unit_count": {
      "type": "integer",
      "minimum": 0
    },
    "scored_detection_unit_count": {
      "type": "integer",
      "minimum": 0
    },
    "macro_precision": {
      "$ref": "#/$defs/nullableUnit"
    },
    "macro_recall": {
      "$ref": "#/$defs/nullableUnit"
    },
    "macro_f1": {
      "$ref": "#/$defs/nullableUnit"
    },
    "pooled_precision": {
      "$ref": "#/$defs/nullableUnit"
    },
    "pooled_recall": {
      "$ref": "#/$defs/nullableUnit"
    },
    "pooled_f1": {
      "$ref": "#/$defs/nullableUnit"
    },
    "macro_matched_iou": {
      "$ref": "#/$defs/nullableUnit"
    },
    "descriptor_mean_absolute_error": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "descriptor_mean_signed_error": {
      "type": [
        "number",
        "null"
      ]
    },
    "descriptor_rank_spearman": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -1,
      "maximum": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "passed": {
      "type": "boolean"
    },
    "maximum_claim_ceiling": {
      "enum": [
        "not_fit_for_declared_use",
        "feature_extraction_only",
        "site_descriptor_estimation",
        "between_site_comparison"
      ]
    },
    "population_uncertainty_claimed": {
      "const": false
    },
    "metric_definition_sha256": {
      "$ref": "#/$defs/digest"
    },
    "reference_dataset_sha256": {
      "$ref": "#/$defs/digest"
    },
    "prediction_dataset_sha256": {
      "$ref": "#/$defs/digest"
    },
    "split_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "validation_receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "validation_receipt_sha256": {
      "$ref": "#/$defs/digest"
    },
    "method_build_sha256": {
      "$ref": "#/$defs/digest"
    },
    "rights_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "rights_receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "unit_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unitMetric"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "nullableUnit": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "passed",
        "observed_value",
        "threshold_value",
        "explanation"
      ],
      "properties": {
        "gate": {
          "enum": [
            "minimum_macro_precision",
            "minimum_macro_recall",
            "minimum_macro_f1",
            "minimum_macro_matched_iou",
            "maximum_descriptor_mae",
            "maximum_absolute_descriptor_bias",
            "minimum_rank_spearman",
            "minimum_independent_unit_count",
            "minimum_scored_detection_unit_count",
            "all_units_have_matched_iou",
            "all_units_have_descriptor_values"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "observed_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "threshold_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unitMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "true_positives",
        "false_positives",
        "false_negatives",
        "precision",
        "recall",
        "f1",
        "mean_matched_iou",
        "reference_descriptor",
        "predicted_descriptor",
        "descriptor_absolute_error",
        "descriptor_signed_error",
        "assessment_state",
        "not_assessed_reason"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "true_positives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "false_positives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "false_negatives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "precision": {
          "$ref": "#/$defs/nullableUnit"
        },
        "recall": {
          "$ref": "#/$defs/nullableUnit"
        },
        "f1": {
          "$ref": "#/$defs/nullableUnit"
        },
        "mean_matched_iou": {
          "$ref": "#/$defs/nullableUnit"
        },
        "reference_descriptor": {
          "type": [
            "number",
            "null"
          ]
        },
        "predicted_descriptor": {
          "type": [
            "number",
            "null"
          ]
        },
        "descriptor_absolute_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "descriptor_signed_error": {
          "type": [
            "number",
            "null"
          ]
        },
        "assessment_state": {
          "enum": [
            "evaluated",
            "not_assessed"
          ]
        },
        "not_assessed_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
