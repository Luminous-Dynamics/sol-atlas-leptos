{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-assurance-invalidation-event-v0.2.schema.json",
  "title": "IEAC Assurance Invalidation Event v0.2",
  "description": "Append-only bitemporal invalidation input bound to an exact IEAC v0.2 graph snapshot and native node identity plus exact artifact content. The contract does not authenticate the revoker or effective-time authority. Event digest is computed over canonical JSON excluding event_sha256. Target identity_sha256 and artifact_sha256 are both mandatory and are never interchangeable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "issuer_id",
    "authority_sequence",
    "previous_event_sha256",
    "statement_sha256",
    "cause_class",
    "targets",
    "scope",
    "valid_time",
    "system_time",
    "invalidation_semantics",
    "evidence_references",
    "authority",
    "dispute_state",
    "action_authority",
    "graph_schema_version",
    "graph_snapshot_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-assurance-invalidation-event.v0.2"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "authority_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "previous_event_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "statement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cause_class": {
      "enum": [
        "issuer_key_compromised",
        "issuer_key_revoked_or_rotated",
        "transparency_service_key_compromised",
        "trust_root_changed",
        "source_corrected",
        "rights_revoked_or_expired",
        "model_superseded",
        "engineering_artifact_superseded",
        "engineering_receipt_corrected",
        "schema_superseded",
        "verifier_vulnerable",
        "policy_changed",
        "authority_revoked",
        "execution_corrected",
        "outcome_corrected",
        "evidence_disputed"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "artifact_sha256",
          "identity_sha256"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:identity-sha256:[0-9a-f]{64}$"
          },
          "node_type": {
            "enum": [
              "source_measurement",
              "signed_statement",
              "transparency_receipt",
              "issuer_key",
              "transparency_service_key",
              "schema",
              "transformation",
              "model",
              "policy",
              "authority_grant",
              "decision",
              "action_authorization",
              "execution",
              "outcome",
              "verifier_build",
              "trust_bundle",
              "source_evidence",
              "engineering_artifact",
              "engineering_receipt"
            ]
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Must equal the graph node's recomputed native identity digest; independent of artifact_sha256."
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "subject_pseudonyms",
        "purposes"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "subject_pseudonyms": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "purposes": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_at",
        "effective_until",
        "effective_time_confidence"
      ],
      "properties": {
        "effective_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_time_confidence": {
          "enum": [
            "verified",
            "authority_asserted",
            "unknown",
            "disputed"
          ]
        }
      }
    },
    "system_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "trusted_at",
        "trusted_timestamp_receipt_sha256"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "trusted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trusted_timestamp_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "invalidation_semantics": {
      "enum": [
        "prospective_only",
        "retroactive_from_effective_time",
        "reverify_required",
        "superseded_only",
        "quarantined_pending_review"
      ]
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "artifact_sha256",
          "media_type"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "key_id",
        "scope_policy_sha256",
        "authorization_receipt_sha256",
        "independent_review"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_review": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "dispute_state": {
      "enum": [
        "undisputed",
        "disputed",
        "contested"
      ]
    },
    "action_authority": {
      "const": "none"
    },
    "graph_schema_version": {
      "const": "luminous.ieac-assurance-dependency-graph.v0.2"
    },
    "graph_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Exact graph snapshot digest to which every target resolves."
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical event object excluding this event_sha256 member; runtime recomputes it."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid_time": {
            "properties": {
              "effective_time_confidence": {
                "enum": [
                  "authority_asserted",
                  "unknown",
                  "disputed"
                ]
              }
            },
            "required": [
              "effective_time_confidence"
            ]
          }
        },
        "required": [
          "valid_time"
        ]
      },
      "then": {
        "properties": {
          "invalidation_semantics": {
            "enum": [
              "prospective_only",
              "reverify_required",
              "superseded_only",
              "quarantined_pending_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dispute_state": {
            "enum": [
              "disputed",
              "contested"
            ]
          }
        },
        "required": [
          "dispute_state"
        ]
      },
      "then": {
        "properties": {
          "invalidation_semantics": {
            "const": "quarantined_pending_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "invalidation_semantics": {
            "const": "retroactive_from_effective_time"
          }
        },
        "required": [
          "invalidation_semantics"
        ]
      },
      "then": {
        "properties": {
          "valid_time": {
            "properties": {
              "effective_time_confidence": {
                "const": "verified"
              },
              "effective_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_sequence": {
            "const": 1
          }
        },
        "required": [
          "authority_sequence"
        ]
      },
      "then": {
        "properties": {
          "previous_event_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
