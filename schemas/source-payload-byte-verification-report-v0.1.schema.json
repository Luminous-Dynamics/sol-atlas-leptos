{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/source-payload-byte-verification-report-v0.1.schema.json",
  "title": "Source payload byte verification report v0.1",
  "description": "Bounded streaming SHA-256 and byte-length verification against descriptor-declared payload identities. Byte equality does not authenticate source owners, rights, signatures, or source truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_representation_sha256",
    "catalog_id",
    "catalog_sha256",
    "descriptor_validation_disposition",
    "verifier_version",
    "verifier_build_sha256",
    "verifier_build_identity_authenticated",
    "limits",
    "disposition",
    "records",
    "bytes_read_total",
    "payload_count",
    "verified_count",
    "unavailable_count",
    "failed_count",
    "action_authority",
    "source_owner_authentication",
    "rights_authentication",
    "source_attestation_authentication",
    "report_sha256",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.source-payload-byte-verification.v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "case_representation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "descriptor_validation_disposition": {
      "enum": [
        "internally_consistent_for_declared_case",
        "incomplete_or_indeterminate",
        "invalid_input"
      ]
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "verifier_build_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "verifier_build_identity_authenticated": {
      "const": false
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buffer_size_bytes",
        "max_bytes_per_payload",
        "max_total_bytes"
      ],
      "properties": {
        "buffer_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_bytes_per_payload": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "disposition": {
      "enum": [
        "fully_verified",
        "incomplete_or_indeterminate",
        "invalid_input"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_key",
          "digest_basis",
          "object_reference",
          "expected_sha256",
          "observed_sha256",
          "expected_byte_length",
          "observed_byte_length",
          "bytes_read",
          "disposition",
          "findings"
        ],
        "properties": {
          "record_key": {
            "type": "string",
            "minLength": 1
          },
          "digest_basis": {
            "enum": [
              "locally_retrieved_and_hashed",
              "source_owner_attested",
              "external_reference",
              "unavailable"
            ]
          },
          "object_reference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 2048
          },
          "expected_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "observed_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          },
          "expected_byte_length": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "observed_byte_length": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "bytes_read": {
            "type": "integer",
            "minimum": 0
          },
          "disposition": {
            "enum": [
              "verified",
              "bytes_unavailable",
              "object_not_found",
              "read_failed",
              "byte_limit_exceeded",
              "digest_mismatch",
              "byte_length_mismatch",
              "invalid_descriptor",
              "not_attempted_invalid_catalog",
              "not_attempted_aggregate_limit"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "severity",
                "code",
                "record_key",
                "detail"
              ],
              "properties": {
                "severity": {
                  "enum": [
                    "incomplete",
                    "invalid"
                  ]
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "record_key": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "bytes_read_total": {
      "type": "integer",
      "minimum": 0
    },
    "payload_count": {
      "type": "integer",
      "minimum": 1
    },
    "verified_count": {
      "type": "integer",
      "minimum": 0
    },
    "unavailable_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "action_authority": {
      "const": "none"
    },
    "source_owner_authentication": {
      "const": "not_performed"
    },
    "rights_authentication": {
      "const": "not_performed"
    },
    "source_attestation_authentication": {
      "const": "not_performed"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "fully_verified"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "descriptor_validation_disposition": {
            "const": "internally_consistent_for_declared_case"
          },
          "verified_count": {
            "minimum": 1
          },
          "unavailable_count": {
            "const": 0
          },
          "failed_count": {
            "const": 0
          },
          "records": {
            "items": {
              "properties": {
                "disposition": {
                  "const": "verified"
                }
              },
              "required": [
                "disposition"
              ]
            }
          }
        }
      }
    }
  ]
}
