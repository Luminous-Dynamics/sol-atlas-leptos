{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-assurance-decision-reliance-report-v0.1.schema.json",
  "title": "IEAC Decision Reliance Continuity Report v0.1",
  "description": "Three-axis composition report. It preserves historical knowledge, retrospective state at decision time, and current reliance without authorizing action.",
