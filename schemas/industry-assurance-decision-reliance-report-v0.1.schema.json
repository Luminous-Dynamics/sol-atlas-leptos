              "reverify_rights",
              "reverify_signature_and_trust",
              "recompute_engineering",
              "reinspect_physical_work",
              "review_authority",
              "resolve_dispute",
              "restore_coverage",
              "manual_review"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
