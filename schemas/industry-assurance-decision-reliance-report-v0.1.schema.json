                  "status": {
                    "enum": [
                      "qualified",
                      "failed",
                      "unknown",
                      "revalidation_required",
                      "quarantined",
                      "not_applicable"
                    ]
                  },
                  "receipt_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
