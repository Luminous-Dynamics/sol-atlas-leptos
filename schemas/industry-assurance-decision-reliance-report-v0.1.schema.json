  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "input_sha256",
    "decision",
    "evaluated_at",
    "views",
    "temporal_events",
    "historical_record_preserved",
    "input_authentication",
    "impact_recomputation",
    "action_authority",
    "claim_ceiling",
    "not_checked",
    "obligations"
