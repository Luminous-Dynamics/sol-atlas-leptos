{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-source-catalog-v0.schema.json",
  "title": "Luminous Landscape Source Catalog v0",
  "description": "Provenance-only candidate dataset registry. Metadata registration is not ingestion, license clearance, or scientific validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_uri",
    "catalog_id",
    "catalog_status",
    "reviewed_on",
    "scope",
    "principles",
    "pilot",
    "records",
    "integration_contract",
    "references"
  ],
  "properties": {
    "schema": {
      "const": "luminous.landscape-source-catalog.v0"
    },
    "schema_uri": {
      "const": "https://luminousdynamics.io/schemas/landscape-source-catalog-v0.schema.json"
    },
    "catalog_id": {
      "const": "south-africa-johannesburg-highveld-v0"
    },
    "catalog_status": {
      "enum": [
        "metadata-only-not-ingested",
        "partially-ingested",
        "active"
      ]
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "site-parcel",
          "district",
          "watershed",
          "bioregion"
        ]
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "purpose",
        "known_limitation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "known_limitation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "service_uri",
          "metadata_uri",
          "access_protocol",
          "reported_geometry",
          "reported_crs",
          "supported_service_formats",
          "spatial_suitability",
          "temporal_currency",
          "attribution",
          "license",
          "uses",
          "not_for",
          "ingestion_state",
          "validation_gates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "service_uri": {
            "type": "string",
            "format": "uri"
          },
          "metadata_uri": {
            "type": "string",
            "format": "uri"
          },
          "access_protocol": {
            "type": "string",
            "minLength": 1
          },
          "reported_geometry": {
            "type": "string",
            "minLength": 1
          },
          "reported_crs": {
            "type": "string",
            "minLength": 1
          },
          "supported_service_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "spatial_suitability": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "site-parcel",
                "site-parcel-context",
                "district",
                "watershed",
                "bioregion",
                "national-screening",
                "regional-climate-context",
                "regional-terrain-screening",
                "site-screening-only"
              ]
            }
          },
          "temporal_currency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_version",
              "access_checked",
              "observed_at",
              "refresh_policy"
            ],
            "properties": {
              "source_version": {
                "type": "string",
                "minLength": 1
              },
              "access_checked": {
                "type": "string",
                "format": "date"
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refresh_policy": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "note",
              "uri"
            ],
            "properties": {
              "status": {
                "enum": [
                  "review-required",
                  "review-required-for-product-specific-terms",
                  "registration-and-license-check-required",
                  "open-data-with-obligations",
                  "verify-selected-provider-terms",
                  "verified-open",
                  "denied"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            }
          },
          "uses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "not_for": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ingestion_state": {
            "enum": [
              "not-ingested",
              "metadata-verified",
              "ingested",
              "blocked"
            ]
          },
          "validation_gates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "integration_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_ingestion",
        "required_visual_distinctions",
        "rule"
      ],
      "properties": {
        "required_before_ingestion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_visual_distinctions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
