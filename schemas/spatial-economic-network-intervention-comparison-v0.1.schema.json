{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-network-intervention-comparison-v0.1.schema.json",
  "title": "Spatial-Economic Network Intervention Comparison",
  "description": "What-if comparison ranked by modeled conservative capacity gain only. Does not score cost, equity, rights, causal outcomes or implementation feasibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparisons"
  ],
  "properties": {
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      }
    }
  },
  "$defs": {
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "link_id"
          ],
          "properties": {
            "kind": {
              "const": "assume_link_active"
            },
            "link_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "link_id",
            "target_capacity_value",
            "target_uncertainty_abs",
            "unit"
          ],
          "properties": {
            "kind": {
              "const": "increase_link_capacity"
            },
            "link_id": {
              "type": "string",
              "minLength": 1
            },
            "target_capacity_value": {
              "type": "number",
              "minimum": 0
            },
            "target_uncertainty_abs": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "baseline_scenario_id",
        "intervention_id",
        "rationale",
        "action",
        "baseline_state",
        "after_state",
        "baseline_conservative_capacity",
        "after_conservative_capacity",
        "conservative_capacity_gain",
        "baseline_optimistic_capacity",
        "after_optimistic_capacity",
        "optimistic_capacity_gain",
        "baseline_min_cut_link_ids",
        "after_min_cut_link_ids",
        "baseline_capacity_evidence_ids",
        "after_capacity_evidence_ids",
        "baseline_availability_evidence_ids",
        "after_availability_evidence_ids",
        "topology_complete",
        "ranking_basis"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "baseline_scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "intervention_id": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "baseline_state": {
          "enum": [
            "adequate",
            "degraded",
            "unavailable",
            "indeterminate"
          ]
        },
        "after_state": {
          "enum": [
            "adequate",
            "degraded",
            "unavailable",
            "indeterminate"
          ]
        },
        "baseline_conservative_capacity": {
          "type": "number",
          "minimum": 0
        },
        "after_conservative_capacity": {
          "type": "number",
          "minimum": 0
        },
        "conservative_capacity_gain": {
          "type": "number"
        },
        "baseline_optimistic_capacity": {
          "type": "number",
          "minimum": 0
        },
        "after_optimistic_capacity": {
          "type": "number",
          "minimum": 0
        },
        "optimistic_capacity_gain": {
          "type": "number"
        },
        "baseline_min_cut_link_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after_min_cut_link_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline_capacity_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after_capacity_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baseline_availability_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "after_availability_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "topology_complete": {
          "const": true
        },
        "ranking_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
