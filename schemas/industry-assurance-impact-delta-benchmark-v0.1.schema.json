{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-assurance-impact-delta-benchmark-v0.1.schema.json",
  "title": "IEAC Sparse Impact Delta Benchmark Report v0.1",
  "description": "Synthetic matched-work comparison between full impact-report recomputation and the sparse batch state engine. This is not a production or SOTA claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "classification", "benchmark_mode", "baseline", "candidate",
    "repetitions_per_case", "case_count", "cases", "claim_ceiling",
    "action_authority", "limitations"
  ],
  "properties": {
    "schema_version": { "const": "luminous.ieac-assurance-impact-delta-benchmark.v0.1" },
    "classification": { "const": "synthetic_only" },
    "benchmark_mode": { "enum": ["smoke_100_to_10000_nodes", "full_100_to_100000_nodes"] },
    "baseline": { "const": "B0_full_recompute_after_every_event" },
    "candidate": { "const": "B2_reused_index_mutable_rows_one_final_report" },
    "repetitions_per_case": { "type": "integer", "minimum": 3, "maximum": 5 },
    "case_count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "graph_node_count", "graph_edge_count", "impact_fraction_basis_points",
          "event_count", "affected_node_count_per_event", "repetitions",
          "full_recompute_p50_ns", "full_recompute_p95_ns",
          "sparse_batch_p50_ns", "sparse_batch_p95_ns", "p50_speedup_ratio",
          "full_report_bytes", "sparse_delta_bytes", "delta_to_report_byte_ratio",
          "graph_index_build_count", "state_row_map_initializations",
          "full_report_materializations", "total_closure_node_memberships",
          "exact_report_digest_agreement"
        ],
        "properties": {
          "graph_node_count": { "type": "integer", "minimum": 100, "maximum": 100000 },
          "graph_edge_count": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "impact_fraction_basis_points": { "enum": [10, 100, 1000, 5000, 8000] },
          "event_count": { "const": 2 },
          "affected_node_count_per_event": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "repetitions": { "type": "integer", "minimum": 3, "maximum": 5 },
          "full_recompute_p50_ns": { "type": "integer", "minimum": 1 },
          "full_recompute_p95_ns": { "type": "integer", "minimum": 1 },
          "sparse_batch_p50_ns": { "type": "integer", "minimum": 1 },
          "sparse_batch_p95_ns": { "type": "integer", "minimum": 1 },
          "p50_speedup_ratio": { "type": "number", "minimum": 0 },
          "full_report_bytes": { "type": "integer", "minimum": 1 },
          "sparse_delta_bytes": { "type": "integer", "minimum": 1 },
          "delta_to_report_byte_ratio": { "type": "number", "minimum": 0 },
          "graph_index_build_count": { "const": 1 },
          "state_row_map_initializations": { "const": 1 },
          "full_report_materializations": { "const": 1 },
          "total_closure_node_memberships": { "type": "integer", "minimum": 1, "maximum": 2000000 },
          "exact_report_digest_agreement": { "const": true }
        }
      }
    },
    "claim_ceiling": { "const": "incomplete_or_indeterminate" },
    "action_authority": { "const": "none" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  }
}