{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-pathway-report-v1.schema.json",
  "title": "Energy Pathway Assessment Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "assessment"],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_version", "evaluator_version", "digest_algorithm", "digest_scope",
        "input_sha256", "assessment_sha256", "input_bytes", "scenario_id", "synthetic",
        "claim_ceiling", "verification_boundary"
      ],
      "properties": {
        "receipt_schema_version": { "const": "1" },
        "evaluator_version": { "const": "energy-pathway-v0.1" },
        "digest_algorithm": { "const": "SHA-256" },
        "digest_scope": { "const": "exact_input_bytes_and_compact_assessment_json" },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assessment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "verification_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_schema_version", "scenario_id", "synthetic", "claim_ceiling",
        "source_form", "source_energy_kwh", "source_evidence_class", "source_evidence_ref", "source_evidence_as_of", "delivered_form", "gross_delivered_energy_kwh",
        "total_conversion_loss_kwh", "total_curtailed_energy_kwh", "total_auxiliary_electricity_kwh",
        "net_electric_output_kwh", "stream_balance_residual_kwh", "stages"
      ],
      "properties": {
        "assessment_schema_version": { "const": "1" },
        "scenario_id": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "source_form": { "$ref": "#/$defs/energyForm" },
        "source_energy_kwh": { "type": "number", "minimum": 0 },
        "source_evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "source_evidence_ref": { "type": ["string", "null"] },
        "source_evidence_as_of": { "type": ["string", "null"] },
        "delivered_form": { "$ref": "#/$defs/energyForm" },
        "gross_delivered_energy_kwh": { "type": "number", "minimum": 0 },
        "total_conversion_loss_kwh": { "type": "number", "minimum": 0 },
        "total_curtailed_energy_kwh": { "type": "number", "minimum": 0 },
        "total_auxiliary_electricity_kwh": { "type": "number", "minimum": 0 },
        "net_electric_output_kwh": { "type": ["number", "null"] },
        "stream_balance_residual_kwh": { "type": "number" },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/$defs/stageResult" }
        }
      }
    }
  },
  "$defs": {
    "energyForm": {
      "type": "string",
      "enum": ["electricity", "thermal_heat", "mechanical", "chemical", "radiant"]
    },
    "evidenceClass": {
      "type": "string",
      "enum": ["analyst_assumption", "published_model", "component_test", "field_pilot", "operating_plant", "replicated_fleet", "independently_audited"]
    },
    "stageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id", "input_form", "output_form", "available_input_kwh", "accepted_input_kwh",
        "curtailed_input_kwh", "gross_output_kwh", "conversion_loss_kwh",
        "auxiliary_electricity_kwh", "efficiency", "evidence_class", "evidence_ref", "evidence_as_of"
      ],
      "properties": {
        "stage_id": { "type": "string", "minLength": 1 },
        "input_form": { "$ref": "#/$defs/energyForm" },
        "output_form": { "$ref": "#/$defs/energyForm" },
        "available_input_kwh": { "type": "number", "minimum": 0 },
        "accepted_input_kwh": { "type": "number", "minimum": 0 },
        "curtailed_input_kwh": { "type": "number", "minimum": 0 },
        "gross_output_kwh": { "type": "number", "minimum": 0 },
        "conversion_loss_kwh": { "type": "number", "minimum": 0 },
        "auxiliary_electricity_kwh": { "type": "number", "minimum": 0 },
        "efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "evidence_ref": { "type": ["string", "null"] },
        "evidence_as_of": { "type": ["string", "null"] }
      }
    }
  }
}
