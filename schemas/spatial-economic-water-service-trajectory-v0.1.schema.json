{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-water-service-trajectory-v0.1.schema.json",
  "title": "Spatial-Economic Water Service Trajectory",
  "description": "Contiguous time-dependent aggregate water service assumptions and initial inventory. Not a hydraulic solver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "service_entity_id",
    "initial_storage",
    "storage_capacity",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "service_entity_id": {
      "type": "string",
      "minLength": 1
    },
    "initial_storage": {
      "$ref": "#/$defs/storage_measurement"
    },
    "storage_capacity": {
      "$ref": "#/$defs/storage_measurement"
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_abs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "quantity",
        "basis",
        "rationale"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "basis": {
          "enum": [
            "assumed",
            "observed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "observed"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "supporting_evidence_ids"
            ],
            "properties": {
              "supporting_evidence_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "assumed"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "properties": {
              "supporting_evidence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "flow_measurement": {
      "allOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "properties": {
            "quantity": {
              "properties": {
                "unit": {
                  "const": "m3/h"
                }
              }
            }
          }
        }
      ]
    },
    "storage_measurement": {
      "allOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "properties": {
            "quantity": {
              "properties": {
                "unit": {
                  "const": "m3"
                }
              }
            }
          }
        }
      ]
    },
    "loss_measurement": {
      "allOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "properties": {
            "quantity": {
              "properties": {
                "unit": {
                  "const": "1"
                },
                "value": {
                  "maximum": 1
                },
                "uncertainty_abs": {
                  "maximum": 1
                }
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "as_of",
        "step_hours",
        "source_flow_rate",
        "pump_capacity",
        "treatment_capacity",
        "distribution_capacity",
        "demand_rate",
        "distribution_loss_fraction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "step_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_flow_rate": {
          "$ref": "#/$defs/flow_measurement"
        },
        "pump_capacity": {
          "$ref": "#/$defs/flow_measurement"
        },
        "treatment_capacity": {
          "$ref": "#/$defs/flow_measurement"
        },
        "distribution_capacity": {
          "$ref": "#/$defs/flow_measurement"
        },
        "demand_rate": {
          "$ref": "#/$defs/flow_measurement"
        },
        "distribution_loss_fraction": {
          "$ref": "#/$defs/loss_measurement"
        }
      }
    }
  }
}
