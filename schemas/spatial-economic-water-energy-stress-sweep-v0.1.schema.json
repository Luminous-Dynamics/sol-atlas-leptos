{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-water-energy-stress-sweep-v0.1.schema.json",
  "title": "Spatial-Economic Water-Energy Joint Failure Stress Sweep",
  "description": "Explicit declared failure-scenario sweep over independent water-energy service cells with protected floors. The runtime rejects shared physical asset IDs across cells and enforces caller and hard evaluation budgets. Scenario counts are not probabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "baseline_services",
    "failure_scenarios",
    "protected_service_floors",
    "max_failure_scenarios",
    "max_service_step_assessments"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/spatial-economic-water-energy-coupling-v0.1.schema.json"
      }
    },
    "failure_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/failure_scenario"
      }
    },
    "protected_service_floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/protected_floor"
      }
    },
    "max_failure_scenarios": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_service_step_assessments": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "$defs": {
    "failure_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_request_id",
        "step_id",
        "target",
        "forced_value"
      ],
      "properties": {
        "service_request_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "source_flow_rate",
            "pump_mechanical_capacity",
            "pump_available_power",
            "pump_specific_energy",
            "treatment_capacity",
            "distribution_capacity",
            "demand_rate",
            "distribution_loss_fraction"
          ]
        },
        "forced_value": {
          "type": "number",
          "minimum": 0
        },
        "forced_uncertainty_abs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "failure_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "rationale",
        "overrides"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "common_cause",
            "hazard_bundle",
            "other"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/failure_override"
          }
        }
      }
    },
    "protected_floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_request_id",
        "community_id",
        "beneficiary_weight",
        "essential_coverage_floor"
      ],
      "properties": {
        "service_request_id": {
          "type": "string",
          "minLength": 1
        },
        "community_id": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary_weight": {
          "type": "integer",
          "minimum": 1
        },
        "essential_coverage_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
