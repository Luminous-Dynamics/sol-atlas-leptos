{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/eo-agent-assurance-agent-view-v0.1.schema.json",
  "title": "Earth Observation Agent Assurance Agent View v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "manifest_sha256",
    "corpus_kind",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark_id": {
      "const": "EO_AGENT_ASSURANCE_001"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "corpus_kind": {
      "const": "public_development_projection_not_blind"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "record_type",
        "summary"
      ],
      "properties": {
        "record_id": {
          "type": "string"
        },
        "record_type": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "title",
        "track",
        "agent_visible",
        "policy"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^EOAA-[0-9]{3}$"
        },
        "title": {
          "type": "string"
        },
        "track": {
          "type": "string"
        },
        "agent_visible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "available_tools",
            "available_records",
            "constraints"
          ],
          "properties": {
            "request": {
              "type": "string"
            },
            "available_tools": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "available_records": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/record"
              }
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_purposes",
            "denied_purposes",
            "consequential_write_allowed"
          ],
          "properties": {
            "allowed_purposes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "denied_purposes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "consequential_write_allowed": {
              "const": false
            }
          }
        }
      }
    }
  }
}
