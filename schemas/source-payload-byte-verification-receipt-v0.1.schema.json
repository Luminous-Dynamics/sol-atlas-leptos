{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/source-payload-byte-verification-receipt-v0.1.schema.json",
  "title": "Source Payload Byte Verification Receipt v0.1",
  "description": "Independent hash comparison over caller-supplied payload/schema bytes. Does not authenticate source origin, owner identity, rights, or engineering correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "catalog_id",
    "catalog_sha256",
    "case_representation_sha256",
    "descriptor_validation_disposition",
    "payload_input_manifest_sha256",
    "schema_input_manifest_sha256",
    "records",
    "record_count",
    "payload_bytes_verified",
    "payload_bytes_missing",
    "payload_digests_unavailable",
    "payload_digest_mismatches",
    "payload_length_mismatches",
    "schema_bytes_verified",
    "schema_bytes_missing",
    "schema_digest_mismatches",
    "unreferenced_payload_input_count",
    "unreferenced_schema_input_count",
    "disposition",
    "payload_byte_verification",
    "source_owner_authentication",
    "source_attestation_authentication",
    "rights_authentication",
    "source_universe_completeness",
    "engineering_correctness",
    "action_authority",
    "findings",
    "limitations",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.source-payload-byte-verification-receipt.v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_representation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "descriptor_validation_disposition": {
      "enum": [
        "internally_consistent_for_declared_case",
        "incomplete_or_indeterminate",
        "invalid_input"
      ]
    },
    "payload_input_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "schema_input_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "payload_bytes_verified": {
      "type": "integer",
      "minimum": 0
    },
    "payload_bytes_missing": {
      "type": "integer",
      "minimum": 0
    },
    "payload_digests_unavailable": {
      "type": "integer",
      "minimum": 0
    },
    "payload_digest_mismatches": {
      "type": "integer",
      "minimum": 0
    },
    "payload_length_mismatches": {
      "type": "integer",
      "minimum": 0
    },
    "schema_bytes_verified": {
      "type": "integer",
      "minimum": 0
    },
    "schema_bytes_missing": {
      "type": "integer",
      "minimum": 0
    },
    "schema_digest_mismatches": {
      "type": "integer",
      "minimum": 0
    },
    "unreferenced_payload_input_count": {
      "type": "integer",
      "minimum": 0
    },
    "unreferenced_schema_input_count": {
      "type": "integer",
      "minimum": 0
    },
    "disposition": {
      "enum": [
        "complete_for_supplied_claims",
        "incomplete_or_indeterminate",
        "invalid_input"
      ]
    },
    "payload_byte_verification": {
      "enum": [
        "complete_for_supplied_payload_claims",
        "partial_or_incomplete",
        "not_established"
      ]
    },
    "source_owner_authentication": {
      "const": "not_performed"
    },
    "source_attestation_authentication": {
      "const": "not_performed"
    },
    "rights_authentication": {
      "const": "not_performed"
    },
    "source_universe_completeness": {
      "const": "not_performed"
    },
    "engineering_correctness": {
      "const": "not_performed"
    },
    "action_authority": {
      "const": "none"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "record_key",
        "detail"
      ],
      "properties": {
        "severity": {
          "enum": [
            "invalid",
            "incomplete"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "record_key": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "record_key",
        "digest_basis",
        "expected_payload_sha256",
        "computed_payload_sha256",
        "expected_byte_length",
        "actual_byte_length",
        "payload_result",
        "schema_id",
        "schema_version",
        "expected_schema_sha256",
        "computed_schema_sha256",
        "schema_result"
      ],
      "properties": {
        "record_kind": {
          "enum": [
            "source_evidence",
            "engineering_artifact",
            "engineering_receipt",
            "decision"
          ]
        },
        "record_key": {
          "type": "string",
          "minLength": 1
        },
        "digest_basis": {
          "enum": [
            "locally_retrieved_and_hashed",
            "source_owner_attested",
            "external_reference",
            "unavailable"
          ]
        },
        "expected_payload_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "computed_payload_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_byte_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "actual_byte_length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "payload_result": {
          "enum": [
            "verified_supplied_bytes_match_local_digest_claim",
            "supplied_bytes_match_owner_attested_digest",
            "verified_supplied_bytes_match_external_digest_claim",
            "invalid_expected_digest",
            "digest_mismatch",
            "length_mismatch",
            "invalid_unavailable_digest_state",
            "missing_bytes",
            "observed_bytes_without_source_digest_claim",
            "source_digest_unavailable"
          ]
        },
        "schema_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expected_schema_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "computed_schema_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_result": {
          "enum": [
            "schema_bytes_match_declared_digest",
            "schema_digest_mismatch",
            "schema_bytes_missing",
            "schema_digest_unavailable",
            "schema_identity_unavailable"
          ]
        }
      }
    }
  }
}
