{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ieac-cross-role-independence-request-v0.1.schema.json",
  "title": "IEAC Cross-Role Independence Binding Request v0.1",
  "description": "Maps operational assurance roles to an exact pinned CCF registry/report. This contract does not independently authenticate the registry or source identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "evaluated_at",
    "channel_manifest_sha256",
    "availability_attestation_sha256",
    "ccf_reference",
    "independence_policy_sha256",
    "role_assignments",
    "separation_requirements",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-cross-role-independence-request.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "channel_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "availability_attestation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ccf_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "registry_version",
        "registry_authority_id",
        "registry_sha256",
        "ccf_request_sha256",
        "ccf_report_sha256",
        "ccf_auditor_build_sha256",
        "source_mapping_status"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "registry_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "registry_authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ccf_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ccf_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ccf_auditor_build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_mapping_status": {
          "enum": [
            "verified",
            "unknown",
            "disputed"
          ]
        }
      }
    },
    "independence_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role_assignments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assignment_id",
          "role_id",
          "principal_id",
          "organization_id",
          "ccf_source_id",
          "ccf_domain_id",
          "source_identity_sha256",
          "dependency_completeness",
          "binding_status",
          "identity_evidence_sha256",
          "dependency_tokens"
        ],
        "properties": {
          "assignment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role_id": {
            "enum": [
              "channel_policy_owner",
              "ledger_operator",
              "query_signer",
              "transparency_service_operator",
              "witness_operator",
              "verifier_build_release_authority",
              "verifier_deployment_operator",
              "trust_root_key_manager",
              "relying_party_policy_owner",
              "independent_reviewer"
            ]
          },
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ccf_source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "ccf_domain_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_identity_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dependency_completeness": {
            "enum": [
              "complete",
              "unknown",
              "disputed"
            ]
          },
          "binding_status": {
            "enum": [
              "verified",
              "unknown",
              "disputed"
            ]
          },
          "identity_evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dependency_tokens": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "token_id",
                "token_type",
                "ccf_reference_id",
                "binding_status",
                "evidence_sha256"
              ],
              "properties": {
                "token_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "token_type": {
                  "enum": [
                    "principal",
                    "organization",
                    "cloud_account",
                    "control_plane",
                    "cluster",
                    "shared_database",
                    "kms_admin_domain",
                    "ci_release_pipeline",
                    "trust_root_admin_domain",
                    "break_glass_authority",
                    "dns_control_plane",
                    "identity_provider",
                    "common_cause_group",
                    "dependency_node",
                    "other"
                  ]
                },
                "ccf_reference_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "binding_status": {
                  "enum": [
                    "verified",
                    "unknown",
                    "disputed"
                  ]
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "separation_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "assignment_id_a",
          "assignment_id_b",
          "required_distinctions",
          "minimum_independent_sources",
          "mandatory"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "assignment_id_a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "assignment_id_b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "required_distinctions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "enum": [
                "different_principal",
                "different_organization",
                "different_cloud_account",
                "different_control_plane",
                "different_kms_admin_domain",
                "different_ci_release_pipeline",
                "different_trust_root_admin",
                "different_break_glass_authority",
                "disjoint_ccf_dependency_closure",
                "disjoint_ccf_common_cause_groups"
              ]
            }
          },
          "minimum_independent_sources": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "mandatory": {
            "type": "boolean"
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "independence_under_exact_pinned_ccf_registry_only"
    },
    "action_authority": {
      "const": "none"
    }
  }
}
