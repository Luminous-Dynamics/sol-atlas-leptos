{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-seasonal-feature-series-v0.1.schema.json",
  "title": "Sol-Atlas Seasonal Feature Series",
  "description": "One provenance-bound temporal feature with Gregorian month ordinals. Missing months are absent; explicit null values represent present but invalid observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "units",
    "source_ref",
    "feature_definition_sha256",
    "observations"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "feature_definition_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "month_ordinal",
          "value"
        ],
        "properties": {
          "month_ordinal": {
            "type": "integer",
            "minimum": 12,
            "maximum": 119999
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
