{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-risk-control-selector-report-v0.1.schema.json",
  "title": "IEAC Risk Control Selector Report v0.1",
  "description": "Requirements-only report. It cannot qualify a profile, attest independence, authorize an action or upgrade a decision tier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "decision_tier",
    "risk_assessment_state",
    "risk_dimensions",
    "risk_assessment_class",
    "policy_id",
    "policy_version",
    "policy_sha256",
    "selector_version",
    "input_profile_sha256",
    "required_controls",
    "missing_controls",
    "unknown_controls",
    "conflicted_controls",
    "not_applicable_controls",
    "human_approvals",
    "monitoring_obligations",
    "fallback_obligations",
    "tier_compatibility",
    "requirements_disposition",
    "independent_qualification_attested",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-risk-control-selector-report.v0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_tier": {
      "enum": [
        "D0_descriptive",
        "D1_advisory",
        "D2_delegated_planning",
        "D3_autonomous_control"
      ]
    },
    "risk_assessment_state": {
      "enum": [
        "reviewed",
        "contains_unknown",
        "unassessed"
      ]
    },
    "risk_assessment_class": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical",
        "unassessed"
      ]
    },
    "risk_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consequence",
        "model_influence",
        "exposure",
        "reversibility",
        "detectability",
        "fallback"
      ],
      "properties": {
        "consequence": {
          "type": "string"
        },
        "model_influence": {
          "type": "string"
        },
        "exposure": {
          "type": "string"
        },
        "reversibility": {
          "type": "string"
        },
        "detectability": {
          "type": "string"
        },
        "fallback": {
          "type": "string"
        }
      }
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selector_version": {
      "type": "string",
      "minLength": 1
    },
    "input_profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "evidence_dimension",
          "description",
          "evidence_state",
          "evidence_count",
          "reason_codes"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "evidence_dimension": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence_state": {
            "enum": [
              "established",
              "missing",
              "unknown",
              "conflicted",
              "not_applicable"
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 0
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "missing_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unknown_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "conflicted_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "not_applicable_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "human_approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "monitoring_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "fallback_obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tier_compatibility": {
      "enum": [
        "compatible",
        "blocked"
      ]
    },
    "requirements_disposition": {
      "enum": [
        "requirements_satisfied",
        "requirements_missing",
        "indeterminate"
      ]
    },
    "independent_qualification_attested": {
      "const": false
    },
    "action_authority": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier_compatibility": {
            "const": "blocked"
          }
        },
        "required": [
          "tier_compatibility"
        ]
      },
      "then": {
        "properties": {
          "requirements_disposition": {
            "const": "indeterminate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_assessment_state": {
            "enum": [
              "contains_unknown",
              "unassessed"
            ]
          }
        },
        "required": [
          "risk_assessment_state"
        ]
      },
      "then": {
        "properties": {
          "requirements_disposition": {
            "const": "indeterminate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "missing_controls": {
            "minItems": 1
          }
        },
        "required": [
          "missing_controls"
        ]
      },
      "then": {
        "properties": {
          "requirements_disposition": {
            "enum": [
              "requirements_missing",
              "indeterminate"
            ]
          }
        }
      }
    }
  ]
}
