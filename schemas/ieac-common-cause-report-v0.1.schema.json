{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ieac-common-cause-report-v0.1.schema.json",
  "title": "IEAC Common-Cause Independence Report v0.1",
  "description": "Independence disposition under the exact pinned registry model. This does not prove registry completeness or qualify the IEAC profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "registry_sha256",
    "registry_id",
    "registry_version",
    "evaluated_at",
    "control_results",
    "source_resolutions",
    "conflict_edges",
    "action_authority",
    "profile_qualification_attested"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-common-cause-report.v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "registry_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "source_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "domain_id",
          "dependency_completeness",
          "dependency_closure",
          "common_cause_group_ids",
          "registry_model_status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "domain_id": {
            "type": "string"
          },
          "dependency_completeness": {
            "enum": [
              "complete",
              "unknown",
              "disputed"
            ]
          },
          "dependency_closure": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "common_cause_group_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "registry_model_status": {
            "enum": [
              "resolved",
              "unknown_dependency",
              "disputed_dependency"
            ]
          }
        }
      }
    },
    "conflict_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id_a",
          "source_id_b",
          "reason_codes",
          "shared_dependency_ids",
          "shared_common_cause_group_ids"
        ],
        "properties": {
          "source_id_a": {
            "type": "string"
          },
          "source_id_b": {
            "type": "string"
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "shared_dependency_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "shared_common_cause_group_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "control_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "minimum_independent_sources",
          "candidate_source_ids",
          "conflicting_source_pairs",
          "maximum_independent_source_ids",
          "maximum_independent_count",
          "threshold_met",
          "method",
          "optimality_status",
          "registry_model_disposition"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "minimum_independent_sources": {
            "type": "integer",
            "minimum": 1
          },
          "candidate_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "conflicting_source_pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id_a",
                "source_id_b",
                "reason_codes"
              ],
              "properties": {
                "source_id_a": {
                  "type": "string"
                },
                "source_id_b": {
                  "type": "string"
                },
                "reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "maximum_independent_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "maximum_independent_count": {
            "type": "integer",
            "minimum": 0
          },
          "threshold_met": {
            "type": "boolean"
          },
          "method": {
            "enum": [
              "exact_maximum_independent_set",
              "deterministic_greedy_lower_bound"
            ]
          },
          "optimality_status": {
            "enum": [
              "proven_optimal",
              "lower_bound_not_proven"
            ]
          },
          "registry_model_disposition": {
            "enum": [
              "qualified_by_registry_model",
              "not_qualified_by_registry_model",
              "indeterminate_under_registry_model"
            ]
          }
        }
      }
    },
    "action_authority": {
      "const": "none"
    },
    "profile_qualification_attested": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "control_results": {
            "contains": {
              "properties": {
                "method": {
                  "const": "deterministic_greedy_lower_bound"
                }
              },
              "required": [
                "method"
              ]
            }
          }
        },
        "required": [
          "control_results"
        ]
      },
      "then": {
        "properties": {
          "control_results": {
            "items": {}
          }
        }
      }
    }
  ]
}
