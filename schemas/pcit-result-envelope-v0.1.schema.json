{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/pcit-result-envelope-v0.1.schema.json",
  "title": "PCIT v0.1 submitted result envelope",
  "description": "Agent-submitted metadata-only dispositions for the public PCIT synthetic development corpus. This is not a field-scientific result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "corpus_sha256",
    "candidate_id",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "PCIT-SYNTHETIC-CORPUS-0.1"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "disposition"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^PCIT-SYN-[0-9]{3}$"
          },
          "disposition": {
            "enum": [
              "PHYSICAL_CHANGE_SUPPORTED_WITHIN_ENVELOPE",
              "NO_CHANGE_DETECTED_WITHIN_ENVELOPE",
              "MEASUREMENT_SHIFT_EXPLAINS_APPARENT_CHANGE",
              "INSUFFICIENT_OBSERVABILITY",
              "UNRESOLVED_CONFOUNDING"
            ]
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    }
  }
}
