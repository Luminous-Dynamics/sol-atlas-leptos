{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/source-payload-catalog-resource-budget-v0.1.schema.json",
  "title": "Source Payload Catalogue Resource Budget Report v0.1",
  "description": "Bounded sequential source payload verification. The report preserves skipped denominators and deterministic truncation digests. It does not authenticate source owners, rights, signatures, source-universe completeness, or engineering correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report",
    "budget",
    "descriptor_count",
    "evaluated_descriptor_count",
    "skipped_budget_count",
    "total_payload_bytes_hashed",
    "total_bytes_read",
    "resolver_open_attempts",
    "resolver_retries",
    "max_concurrency_used",
    "report_truncated",
    "omitted_record_count",
    "omitted_records_sha256",
    "omitted_finding_count",
    "omitted_findings_sha256",
    "omitted_descriptor_validation_finding_count",
    "omitted_descriptor_validation_findings_sha256",
    "serialized_report_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.source-payload-catalog-budget-report.v0.1"
    },
    "report": {
      "$ref": "#/$defs/payload_report"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_descriptors",
        "max_total_payload_bytes",
        "max_total_bytes_read",
        "max_bytes_per_payload",
        "max_resolver_open_attempts",
        "max_retries_per_payload",
        "max_report_bytes"
      ],
      "properties": {
        "max_descriptors": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_payload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "max_bytes_per_payload": {
          "type": "integer",
          "minimum": 0
        },
        "max_resolver_open_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_retries_per_payload": {
          "const": 0
        },
        "max_report_bytes": {
          "type": "integer",
          "minimum": 8192
        }
      }
    },
    "descriptor_count": {
      "type": "integer",
      "minimum": 0
    },
    "evaluated_descriptor_count": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_budget_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_payload_bytes_hashed": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes_read": {
      "type": "integer",
      "minimum": 0
    },
    "resolver_open_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "resolver_retries": {
      "const": 0
    },
    "max_concurrency_used": {
      "const": 1
    },
    "report_truncated": {
      "type": "boolean"
    },
    "omitted_record_count": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_records_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "omitted_finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_findings_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "omitted_descriptor_validation_finding_count": {
      "type": "integer",
      "minimum": 0
    },
    "omitted_descriptor_validation_findings_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "serialized_report_bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "record_key",
        "detail"
      ],
      "properties": {
        "severity": {
          "enum": [
            "incomplete",
            "invalid"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "record_key": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload_report": {
      "description": "Report of bounded local rehashing of descriptor-referenced source bytes. Byte equality is not source-owner, rights, attestation, source-completeness, or engineering-correctness authentication.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "disposition",
        "case_id",
        "case_representation_sha256",
        "catalog_id",
        "catalog_representation_sha256",
        "verifier_build_sha256",
        "verified_at_utc",
        "max_bytes_per_payload",
        "descriptor_validation_disposition",
        "descriptor_validation_findings",
        "descriptor_count",
        "descriptor_extra_count",
        "descriptor_missing_count",
        "verified_count",
        "unavailable_count",
        "resolver_open_failed_count",
        "resolver_access_denied_count",
        "object_not_found_count",
        "read_failed_count",
        "byte_limit_exceeded_count",
        "invalid_count",
        "invalid_finding_count",
        "incomplete_finding_count",
        "records",
        "findings",
        "source_owner_authentication",
        "source_snapshot_authentication",
        "rights_authentication",
        "attestation_authentication",
        "source_inventory_completeness",
        "engineering_correctness",
        "action_authority",
        "no_impact_eligibility",
        "skipped_budget_count"
      ],
      "properties": {
        "schema_version": {
          "const": "luminous.source-payload-byte-verification.v0.1"
        },
        "disposition": {
          "enum": [
            "all_declared_payload_references_verified",
            "incomplete_or_indeterminate",
            "invalid_input"
          ]
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_representation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1
        },
        "catalog_representation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_build_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "verified_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "max_bytes_per_payload": {
          "type": "integer",
          "minimum": 0
        },
        "descriptor_validation_disposition": {
          "enum": [
            "internally_consistent_for_declared_case",
            "incomplete_or_indeterminate",
            "invalid_input"
          ]
        },
        "descriptor_validation_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "descriptor_count": {
          "type": "integer",
          "minimum": 0
        },
        "verified_count": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_count": {
          "type": "integer",
          "minimum": 0
        },
        "read_failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "byte_limit_exceeded_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_key",
              "status",
              "digest_basis",
              "object_ref",
              "expected_sha256",
              "actual_sha256",
              "expected_byte_length",
              "actual_byte_length",
              "bytes_read",
              "read_error_kind",
              "findings"
            ],
            "properties": {
              "record_key": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "source_bytes_unavailable",
                  "read_failed",
                  "byte_limit_exceeded",
                  "invalid_descriptor",
                  "digest_mismatch",
                  "length_mismatch",
                  "skipped_budget"
                ]
              },
              "digest_basis": {
                "enum": [
                  "locally_retrieved_and_hashed",
                  "source_owner_attested",
                  "external_reference",
                  "unavailable"
                ]
              },
              "object_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "expected_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "actual_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "expected_byte_length": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "actual_byte_length": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "bytes_read": {
                "type": "integer",
                "minimum": 0
              },
              "read_error_kind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "findings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/finding"
                }
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "source_owner_authentication": {
          "const": "not_performed"
        },
        "source_snapshot_authentication": {
          "const": "not_performed"
        },
        "rights_authentication": {
          "const": "not_performed"
        },
        "attestation_authentication": {
          "const": "not_performed"
        },
        "source_inventory_completeness": {
          "const": "not_performed"
        },
        "engineering_correctness": {
          "const": "not_performed"
        },
        "action_authority": {
          "const": "none"
        },
        "no_impact_eligibility": {
          "const": "none"
        },
        "invalid_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "descriptor_missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "descriptor_extra_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_budget_count": {
          "type": "integer",
          "minimum": 0
        },
        "object_not_found_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolver_access_denied_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolver_open_failed_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "$defs": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "finding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "severity",
            "code",
            "record_key",
            "detail"
          ],
          "properties": {
            "severity": {
              "enum": [
                "incomplete",
                "invalid"
              ]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "record_key": {
              "type": "string",
              "minLength": 1
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
