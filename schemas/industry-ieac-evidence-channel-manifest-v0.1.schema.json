{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-evidence-channel-manifest-v0.1.schema.json",
  "title": "IEAC Evidence Channel Manifest v0.1",
  "description": "Declares relying-party access scope, capture policy, instrumented paths, bypass paths, ledger identity and loss semantics. Structural contract only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "channel",
    "capture_contract",
    "ledger",
    "known_bypass_paths",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-evidence-channel-manifest.v0.1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relying_party_id",
        "evidence_channel_id",
        "log_service_id",
        "operator_id",
        "tenant_scope",
        "purpose_scope",
        "subject_scope",
        "artifact_digest_algorithm"
      ],
      "properties": {
        "relying_party_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "log_service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "tenant_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose_scope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "subject_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifact_digest_algorithm": {
          "const": "sha-256"
        }
      }
    },
    "capture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_sha256",
        "policy_version",
        "event_types",
        "instrumented_access_paths",
        "unmonitored_access_paths",
        "durability",
        "loss_handling",
        "policy_change_semantics",
        "authorized_completeness_query_signers"
      ],
      "properties": {
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "event_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ingest",
              "read",
              "cache_hit",
              "replica_fetch",
              "export",
              "delegated_access",
              "operator_console",
              "offline_import",
              "other"
            ]
          }
        },
        "instrumented_access_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "unmonitored_access_paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "durability": {
          "enum": [
            "synchronous_durable",
            "bounded_durable",
            "best_effort",
            "unknown"
          ]
        },
        "loss_handling": {
          "enum": [
            "fail_closed",
            "explicit_unknown_on_loss",
            "best_effort_continue"
          ]
        },
        "policy_change_semantics": {
          "enum": [
            "append_only_versioned",
            "mutable_with_audit",
            "unknown"
          ]
        },
        "authorized_completeness_query_signers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledger_id",
        "sequence_namespace",
        "sequence_epoch",
        "monotonic_sequence",
        "checkpoint_interval_seconds",
        "minimum_retention_seconds",
        "reset_semantics"
      ],
      "properties": {
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "monotonic_sequence": {
          "type": "boolean"
        },
        "checkpoint_interval_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "minimum_retention_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "reset_semantics": {
          "enum": [
            "authenticated_epoch_transition",
            "never_reset",
            "unknown"
          ]
        }
      }
    },
    "known_bypass_paths": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "claim_ceiling": {
      "const": "declared_access_channel_capture_scope_only"
    },
    "action_authority": {
      "const": "none"
    }
  }
}
