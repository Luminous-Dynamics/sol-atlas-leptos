{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/heat-pump-report-v1.schema.json",
  "title": "Multi-stream heat pump assessment report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "assessment"],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_version", "evaluator_version", "digest_algorithm", "digest_scope",
        "input_sha256", "assessment_sha256", "input_bytes", "scenario_id", "synthetic",
        "claim_ceiling", "verification_boundary"
      ],
      "properties": {
        "receipt_schema_version": { "const": "1" },
        "evaluator_version": { "const": "heat-pump-v0.1" },
        "digest_algorithm": { "const": "SHA-256" },
        "digest_scope": { "const": "exact_input_bytes_and_compact_assessment_json" },
        "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assessment_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "input_bytes": { "type": "integer", "minimum": 0 },
        "scenario_id": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "verification_boundary": { "type": "string", "minLength": 1 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_schema_version", "scenario_id", "synthetic", "claim_ceiling",
        "temperatures", "source_heat_available_kwh", "source_heat_used_kwh",
        "source_heat_curtailed_kwh", "compressor_electricity_available_kwh",
        "compressor_electricity_used_kwh", "compressor_electricity_curtailed_kwh",
        "auxiliary_electricity_kwh", "gross_heat_output_kwh", "distribution_loss_kwh",
        "useful_heat_delivered_kwh", "total_electricity_consumed_kwh",
        "compressor_cop", "system_cop", "carnot_cop_upper_bound",
        "first_law_balance_residual_kwh", "evidence_class", "evidence_ref", "evidence_as_of"
      ],
      "properties": {
        "assessment_schema_version": { "const": "1" },
        "scenario_id": { "type": "string", "minLength": 1 },
        "synthetic": { "type": "boolean" },
        "claim_ceiling": { "type": "string", "minLength": 1 },
        "temperatures": { "$ref": "#/$defs/temperatures" },
        "source_heat_available_kwh": { "type": "number", "minimum": 0 },
        "source_heat_used_kwh": { "type": "number", "minimum": 0 },
        "source_heat_curtailed_kwh": { "type": "number", "minimum": 0 },
        "compressor_electricity_available_kwh": { "type": "number", "minimum": 0 },
        "compressor_electricity_used_kwh": { "type": "number", "minimum": 0 },
        "compressor_electricity_curtailed_kwh": { "type": "number", "minimum": 0 },
        "auxiliary_electricity_kwh": { "type": "number", "minimum": 0 },
        "gross_heat_output_kwh": { "type": "number", "minimum": 0 },
        "distribution_loss_kwh": { "type": "number", "minimum": 0 },
        "useful_heat_delivered_kwh": { "type": "number", "minimum": 0 },
        "total_electricity_consumed_kwh": { "type": "number", "minimum": 0 },
        "compressor_cop": { "type": ["number", "null"], "minimum": 0 },
        "system_cop": { "type": ["number", "null"], "minimum": 0 },
        "carnot_cop_upper_bound": { "type": "number", "exclusiveMinimum": 1 },
        "first_law_balance_residual_kwh": { "type": "number" },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "evidence_ref": { "type": ["string", "null"] },
        "evidence_as_of": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "temperatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_c", "delivery_c"],
      "properties": {
        "source_c": { "type": "number" },
        "delivery_c": { "type": "number" }
      }
    },
    "evidenceClass": {
      "type": "string",
      "enum": ["analyst_assumption", "published_model", "component_test", "field_pilot", "operating_plant", "replicated_fleet", "independently_audited"]
    }
  }
}
