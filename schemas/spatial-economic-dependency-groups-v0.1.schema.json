{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-dependency-groups-v0.1.schema.json",
  "title": "Spatial-Economic Dependency Groups",
  "description": "Qualitative dependency logic only. No failure probabilities or independence assumptions are implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "logic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "all_required"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "any_one"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "minimum"
          ],
          "properties": {
            "mode": {
              "const": "at_least"
            },
            "minimum": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dependent_entity_id",
        "logic",
        "relation_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dependent_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "logic": {
          "$ref": "#/$defs/logic"
        },
        "relation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
