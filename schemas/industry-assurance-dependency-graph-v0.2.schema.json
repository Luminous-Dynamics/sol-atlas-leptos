{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-assurance-dependency-graph-v0.2.schema.json",
  "title": "IEAC Assurance Dependency Graph v0.2",
  "description": "Typed dependency graph with native identity independent from exact payload content. Schema validates shape only; runtime recomputes identity and graph digests, edge resolution, graph acyclicity and scope propagation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "captured_at",
    "graph_snapshot_sha256",
    "nodes",
    "edges",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-assurance-dependency-graph.v0.2"
    },
    "graph_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "graph_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest of the canonical graph core excluding this digest field; runtime must recompute."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_type",
          "identity",
          "identity_sha256",
          "artifact_sha256",
          "artifact_media_type",
          "schema_version",
          "issuer_id",
          "scope",
          "valid_time",
          "observation_time",
          "verification"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:identity-sha256:[0-9a-f]{64}$"
          },
          "node_type": {
            "enum": [
              "source_measurement",
              "signed_statement",
              "transparency_receipt",
              "issuer_key",
              "transparency_service_key",
              "schema",
              "transformation",
              "model",
              "policy",
              "authority_grant",
              "decision",
              "action_authorization",
              "execution",
              "outcome",
              "verifier_build",
              "trust_bundle"
            ]
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the exact referenced payload bytes. Equal payload digests do not imply equal native identities."
          },
          "artifact_media_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          },
          "schema_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "issuer_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "domain",
              "subject_pseudonyms",
              "purposes"
            ],
            "properties": {
              "domain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "subject_pseudonyms": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 1000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "purposes": {
                "type": "array",
                "uniqueItems": true,
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "valid_time": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valid_from",
              "valid_until"
            ],
            "properties": {
              "valid_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "valid_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "observation_time": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_created_at",
              "recorded_at",
              "trusted_at"
            ],
            "properties": {
              "artifact_created_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "trusted_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result",
              "policy_sha256",
              "verifier_build_sha256",
              "trust_bundle_sha256",
              "checked_at",
              "fresh_until"
            ],
            "properties": {
              "result": {
                "enum": [
                  "verified",
                  "failed",
                  "unknown",
                  "not_applicable"
                ]
              },
              "policy_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "verifier_build_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "trust_bundle_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "checked_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "fresh_until": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            }
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity_namespace",
              "components"
            ],
            "description": "Source-native identity envelope. Identity digest is computed independently from artifact_sha256.",
            "properties": {
              "identity_namespace": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Stable owner/source namespace; do not replace it with a display name or inferred vendor."
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "description": "Unique named native identity components. Runtime canonicalizes by ASCII component name before hashing; string values are preserved byte-for-byte as UTF-8.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                    },
                    "value": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    }
                  }
                }
              }
            }
          },
          "identity_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the v0.2 domain-separated, length-prefixed identity encoding; not the payload digest."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 500000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from_node_id",
          "to_node_id",
          "relation"
        ],
        "properties": {
          "edge_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "from_node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:sha256:[0-9a-f]{64}$"
          },
          "to_node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:sha256:[0-9a-f]{64}$"
          },
          "relation": {
            "enum": [
              "signed_by",
              "registered_as",
              "derived_from",
              "transformed_by",
              "verified_by",
              "governed_by",
              "authorized_by",
              "evidence_for",
              "executed_under",
              "outcome_of",
              "measured_by",
              "superseded_by",
              "revoked_by"
            ]
          }
        }
      }
    },
    "claim_ceiling": {
      "enum": [
        "record_only",
        "observation_only",
        "before_after_difference",
        "descriptive_association",
        "causal_effect_estimate",
        "not_identified",
        "incomplete_or_indeterminate"
      ]
    },
    "action_authority": {
      "const": "none"
    }
  }
}
