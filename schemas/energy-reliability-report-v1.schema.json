{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-reliability-report-v1.schema.json",
  "title": "Chronological service reliability report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt",
    "assessment"
  ],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema_version",
        "evaluator_version",
        "digest_algorithm",
        "digest_scope",
        "input_sha256",
        "assessment_sha256",
        "input_bytes",
        "trace_id",
        "synthetic",
        "claim_ceiling",
        "verification_boundary"
      ],
      "properties": {
        "receipt_schema_version": {
          "const": "1"
        },
        "evaluator_version": {
          "const": "energy-reliability-v0.1"
        },
        "digest_algorithm": {
          "const": "SHA-256"
        },
        "digest_scope": {
          "const": "exact_input_bytes_and_compact_assessment_json"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assessment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "verification_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_schema_version",
        "trace_id",
        "synthetic",
        "claim_ceiling",
        "evidence_class",
        "evidence_ref",
        "evidence_as_of",
        "interval_count",
        "total_duration_seconds",
        "grid_outage_interval_count",
        "grid_outage_duration_seconds",
        "essential_deficit_interval_count",
        "essential_deficit_duration_seconds",
        "longest_consecutive_essential_deficit_seconds",
        "outage_essential_deficit_interval_count",
        "outage_essential_deficit_duration_seconds",
        "longest_consecutive_outage_essential_deficit_seconds",
        "essential_intervals_fully_met_count",
        "total_requested_service_kwh",
        "total_delivered_service_kwh",
        "total_unserved_service_kwh",
        "total_delivery_fraction",
        "essential_requested_service_kwh",
        "essential_delivered_service_kwh",
        "essential_unserved_service_kwh",
        "essential_delivery_fraction",
        "outage_essential_requested_service_kwh",
        "outage_essential_delivered_service_kwh",
        "outage_essential_unserved_service_kwh",
        "outage_essential_delivery_fraction",
        "total_service_balance_residual_kwh",
        "essential_service_balance_residual_kwh",
        "services",
        "intervals"
      ],
      "properties": {
        "assessment_schema_version": {
          "const": "1"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "synthetic": {
          "type": "boolean"
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "analyst_assumption",
            "published_model",
            "component_test",
            "field_pilot",
            "operating_plant",
            "replicated_fleet",
            "independently_audited"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "grid_outage_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "grid_outage_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "essential_deficit_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "essential_deficit_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "longest_consecutive_essential_deficit_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "outage_essential_deficit_interval_count": {
          "type": "integer",
          "minimum": 0
        },
        "outage_essential_deficit_duration_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "longest_consecutive_outage_essential_deficit_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "essential_intervals_fully_met_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_requested_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "total_delivered_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "total_unserved_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "total_delivery_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "essential_requested_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "essential_delivered_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "essential_unserved_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "essential_delivery_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "outage_essential_requested_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "outage_essential_delivered_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "outage_essential_unserved_service_kwh": {
          "type": "number",
          "minimum": 0
        },
        "outage_essential_delivery_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "total_service_balance_residual_kwh": {
          "type": "number"
        },
        "essential_service_balance_residual_kwh": {
          "type": "number"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service_id",
              "description",
              "essential",
              "required_form",
              "requested_energy_kwh",
              "delivered_energy_kwh",
              "unserved_energy_kwh",
              "delivery_fraction",
              "balance_residual_kwh"
            ],
            "properties": {
              "service_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "essential": {
                "type": "boolean"
              },
              "required_form": {
                "type": "string",
                "enum": [
                  "electricity",
                  "thermal_heat",
                  "mechanical",
                  "chemical",
                  "radiant"
                ]
              },
              "requested_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "delivered_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "unserved_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "delivery_fraction": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "balance_residual_kwh": {
                "type": "number"
              }
            }
          }
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interval_id",
              "start_unix_seconds",
              "duration_seconds",
              "grid_outage",
              "requested_energy_kwh",
              "delivered_energy_kwh",
              "unserved_energy_kwh",
              "essential_requested_energy_kwh",
              "essential_delivered_energy_kwh",
              "essential_unserved_energy_kwh",
              "essential_deficit",
              "services"
            ],
            "properties": {
              "interval_id": {
                "type": "string",
                "minLength": 1
              },
              "start_unix_seconds": {
                "type": "integer"
              },
              "duration_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "grid_outage": {
                "type": "boolean"
              },
              "requested_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "delivered_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "unserved_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "essential_requested_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "essential_delivered_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "essential_unserved_energy_kwh": {
                "type": "number",
                "minimum": 0
              },
              "essential_deficit": {
                "type": "boolean"
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "service_id",
                    "essential",
                    "required_form",
                    "requested_energy_kwh",
                    "delivered_energy_kwh",
                    "unserved_energy_kwh",
                    "delivered_temperature_c",
                    "service_balance_residual_kwh"
                  ],
                  "properties": {
                    "service_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "essential": {
                      "type": "boolean"
                    },
                    "required_form": {
                      "type": "string",
                      "enum": [
                        "electricity",
                        "thermal_heat",
                        "mechanical",
                        "chemical",
                        "radiant"
                      ]
                    },
                    "requested_energy_kwh": {
                      "type": "number",
                      "minimum": 0
                    },
                    "delivered_energy_kwh": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unserved_energy_kwh": {
                      "type": "number",
                      "minimum": 0
                    },
                    "delivered_temperature_c": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "service_balance_residual_kwh": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
