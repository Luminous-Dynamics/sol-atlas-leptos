{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-tuf-freshness-report-v0.1.schema.json",
  "title": "IEAC TUF Channel Freshness Audit Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason_codes",
    "trusted_state_id",
    "verifier_report_sha256",
    "policy_sha256",
    "trusted_state_sha256",
    "evaluation_interval",
    "accepted_metadata",
    "accepted_channel_state",
    "claim_ceiling",
    "action_authority",
    "state_transition"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-tuf-freshness-report.v0.1"
    },
    "status": {
      "enum": [
        "current",
        "unknown"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "trusted_state_id": {
      "type": "string"
    },
    "verifier_report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trusted_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "earliest_epoch_seconds",
        "latest_epoch_seconds"
      ],
      "properties": {
        "earliest_epoch_seconds": {
          "type": "integer"
        },
        "latest_epoch_seconds": {
          "type": "integer"
        }
      }
    },
    "accepted_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_version",
        "timestamp_version",
        "snapshot_version",
        "target_roles"
      ],
      "properties": {
        "root_version": {
          "type": "integer",
          "minimum": 1
        },
        "timestamp_version": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_version": {
          "type": "integer",
          "minimum": 1
        },
        "target_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role_name",
              "version"
            ],
            "properties": {
              "role_name": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "accepted_channel_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "checkpoint_state_sha256",
        "ledger_epoch",
        "last_sequence",
        "completeness_attestation_sha256",
        "availability_report_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoint_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledger_epoch": {
          "type": "string"
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "completeness_attestation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "availability_report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim_ceiling": {
      "const": "tuf_freshness_and_anti_rollback_only"
    },
    "action_authority": {
      "const": "none"
    },
    "state_transition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_previous_state_revision",
            "expected_previous_state_sha256",
            "next_state_revision",
            "next_state_sha256",
            "next_state",
            "commit_semantics"
          ],
          "properties": {
            "expected_previous_state_revision": {
              "type": "integer",
              "minimum": 1
            },
            "expected_previous_state_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "next_state_revision": {
              "type": "integer",
              "minimum": 2
            },
            "next_state_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "next_state": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-tuf-high-water-state-v0.1.schema.json",
              "title": "IEAC TUF Persisted High-Water State v0.1",
              "description": "Relying-party persisted anti-rollback state. This file must be stored outside the untrusted request channel using a protected/monotonic local state mechanism.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "state_id",
                "state_revision",
                "repository_id",
                "relying_party_id",
                "channel_id",
                "tenant_scope",
                "purpose",
                "ledger_id",
                "sequence_namespace",
                "sequence_epoch",
                "last_sequence",
                "root",
                "timestamp",
                "snapshot",
                "target_roles",
                "manifest_sha256",
                "checkpoint_state_sha256",
                "completeness_attestation_sha256",
                "availability_report_sha256"
              ],
              "properties": {
                "schema_version": {
                  "const": "luminous.ieac-tuf-high-water-state.v0.1"
                },
                "state_id": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 128
                },
                "state_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "repository_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "relying_party_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "channel_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "tenant_scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "ledger_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sequence_namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sequence_epoch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "last_sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "root": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "sha256",
                    "expires_at",
                    "timestamp_keyset_sha256",
                    "snapshot_keyset_sha256"
                  ],
                  "properties": {
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
                    },
                    "timestamp_keyset_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "snapshot_keyset_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                },
                "timestamp": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "sha256",
                    "expires_at"
                  ],
                  "properties": {
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
                    }
                  }
                },
                "snapshot": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "sha256",
                    "expires_at"
                  ],
                  "properties": {
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
                    }
                  }
                },
                "target_roles": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role_name",
                      "version",
                      "metadata_sha256"
                    ],
                    "properties": {
                      "role_name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "metadata_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "checkpoint_state_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "completeness_attestation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "availability_report_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "commit_semantics": {
              "const": "compare_and_swap_atomic"
            }
          }
        }
      ]
    }
  }
}
