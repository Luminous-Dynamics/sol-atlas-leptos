{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-risk-assurance-policy-v0.1.schema.json",
  "title": "IEAC Risk-to-Assurance Policy v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "selector_version",
    "control_catalog",
    "tier_minimums",
    "dimension_rules",
    "combination_rules",
    "unknown_policy",
    "reviewed_class_rules",
    "action_policy",
    "action_authority",
    "independent_qualification_attested"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-risk-assurance-policy.v0.1"
    },
    "policy_id": {
      "const": "IEAC-RISK-CONTROLS-001"
    },
    "policy_version": {
      "type": "string"
    },
    "selector_version": {
      "type": "string"
    },
    "control_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "evidence_dimension",
          "description"
        ],
        "properties": {
          "control_id": {
            "type": "string"
          },
          "evidence_dimension": {
            "enum": [
              "software_conformance",
              "numerical_verification",
              "physical_validation",
              "data_integrity_rights",
              "uncertainty_credibility",
              "generalization",
              "robustness",
              "operational_assurance",
              "safety_security_authority",
              "prospective_outcomes"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "tier_minimums": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_tier",
          "control_ids",
          "reason_code"
        ],
        "properties": {
          "decision_tier": {
            "enum": [
              "D0_descriptive",
              "D1_advisory",
              "D2_delegated_planning",
              "D3_autonomous_control"
            ]
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_code": {
            "type": "string"
          }
        }
      }
    },
    "dimension_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "value",
          "control_ids",
          "reason_code"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "consequence",
              "model_influence",
              "exposure",
              "reversibility",
              "detectability",
              "fallback"
            ]
          },
          "value": {
            "type": "string"
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_code": {
            "type": "string"
          }
        }
      }
    },
    "combination_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "conditions",
          "control_ids",
          "reason_code"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "values"
              ],
              "properties": {
                "dimension": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "control_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_code": {
            "type": "string"
          }
        }
      }
    },
    "unknown_policy": {
      "type": "object"
    },
    "reviewed_class_rules": {
      "type": "array"
    },
    "action_policy": {
      "type": "object"
    },
    "action_authority": {
      "const": "none"
    },
    "independent_qualification_attested": {
      "const": false
    }
  }
}
