{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-verification-capsule-v0.1.schema.json",
  "title": "IEAC Content-addressed Verification Capsule v0.1",
  "description": "A content-addressed manifest of TUF metadata and four IEAC targets. It carries inputs for independent replay; it is not itself a verification verdict or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capsule_id",
    "capsule_mode",
    "replayability",
    "canonicalization",
    "created_at",
    "trust_bootstrap",
    "replay_context",
    "policy",
    "verifier_identity",
    "metadata_artifacts",
    "targets",
    "file_inventory",
    "file_inventory_sha256",
    "claim_ceiling",
    "action_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-verification-capsule.v0.1"
    },
    "capsule_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "capsule_mode": {
      "enum": [
        "self_contained",
        "metadata_complete_target_referenced",
        "commitment_only",
        "mixed"
      ]
    },
    "replayability": {
      "enum": [
        "fully_replayable",
        "conditionally_replayable",
        "commitment_only"
      ]
    },
    "canonicalization": {
      "const": "RFC8785_JCS_FOR_CAPSULE_MANIFEST_ONLY"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "trust_bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "repository_origin",
        "root_metadata_path",
        "root_version",
        "root_sha256"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "repository_origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$"
        },
        "root_metadata_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
        },
        "root_version": {
          "type": "integer",
          "minimum": 1
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "replay_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_time",
        "uncertainty_before_ms",
        "uncertainty_after_ms",
        "clock_id",
        "time_policy_sha256",
        "time_verifier_build_sha256",
        "time_verifier_trust_bundle_sha256"
      ],
      "properties": {
        "evaluation_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "uncertainty_before_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "uncertainty_after_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "clock_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "time_policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time_verifier_build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "time_verifier_trust_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "policy_kind",
        "scope_id"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_kind": {
          "enum": [
            "industrial_assurance",
            "channel_completeness",
            "decision_time",
            "composite"
          ]
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "verifier_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "build_sha256",
        "independent_verifier_required"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "independent_verifier_required": {
          "const": true
        }
      }
    },
    "metadata_artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_name",
          "version",
          "repository_path",
          "length",
          "sha256",
          "expires_at",
          "authorized_by"
        ],
        "properties": {
          "role_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "repository_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "authorized_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository_path",
          "authorized_role",
          "length",
          "sha256",
          "content_mode"
        ],
        "properties": {
          "id": {
            "enum": [
              "channel_manifest",
              "checkpoint_state",
              "completeness_attestation",
              "availability_audit_report"
            ]
          },
          "repository_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "authorized_role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_mode": {
            "enum": [
              "embedded",
              "referenced",
              "withheld"
            ]
          },
          "capsule_file_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scheme",
              "locator"
            ],
            "properties": {
              "scheme": {
                "enum": [
                  "file",
                  "cas",
                  "https"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "content_mode": {
                  "const": "embedded"
                }
              },
              "required": [
                "content_mode"
              ]
            },
            "then": {
              "required": [
                "capsule_file_path"
              ],
              "not": {
                "required": [
                  "reference"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "content_mode": {
                  "const": "referenced"
                }
              },
              "required": [
                "content_mode"
              ]
            },
            "then": {
              "required": [
                "reference"
              ],
              "not": {
                "required": [
                  "capsule_file_path"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "content_mode": {
                  "const": "withheld"
                }
              },
              "required": [
                "content_mode"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "reference"
                    ]
                  },
                  {
                    "required": [
                      "capsule_file_path"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "file_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "length",
          "sha256",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*[\\\\?#])[^\\\\?#]+$"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "root",
              "root_history",
              "timestamp",
              "snapshot",
              "targets_role",
              "target_bytes",
              "policy",
              "other"
            ]
          }
        }
      }
    },
    "file_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claim_ceiling": {
      "const": "replayable_integrity_of_included_signed_metadata_and_target_bytes_only"
    },
    "action_authority": {
      "const": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capsule_mode": {
            "const": "self_contained"
          }
        },
        "required": [
          "capsule_mode"
        ]
      },
      "then": {
        "properties": {
          "targets": {
            "items": {
              "properties": {
                "content_mode": {
                  "const": "embedded"
                }
              },
              "required": [
                "content_mode"
              ]
            }
          }
        },
        "required": [
          "replayability"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capsule_mode": {
            "const": "metadata_complete_target_referenced"
          }
        },
        "required": [
          "capsule_mode"
        ]
      },
      "then": {
        "properties": {
          "targets": {
            "items": {
              "properties": {
                "content_mode": {
                  "enum": [
                    "embedded",
                    "referenced"
                  ]
                }
              },
              "required": [
                "content_mode"
              ]
            }
          }
        },
        "required": [
          "replayability"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "capsule_mode": {
            "const": "commitment_only"
          }
        },
        "required": [
          "capsule_mode"
        ]
      },
      "then": {
        "properties": {
          "targets": {
            "items": {
              "properties": {
                "content_mode": {
                  "const": "withheld"
                }
              },
              "required": [
                "content_mode"
              ]
            }
          }
        },
        "required": [
          "replayability"
        ]
      }
    }
  ]
}
