{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-pathway-request-v0.1.schema.json",
  "title": "Energy Pathway Request v0.1",
  "description": "A bounded single-stream source-to-service energy accounting request. Storage state and heat-pump COP are outside this schema's model scope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "synthetic", "source_form", "source_energy_kwh", "source_evidence_class", "stages"],
  "properties": {
    "schema_version": { "const": "energy-pathway-v0.1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "source_form": { "$ref": "#/$defs/energyForm" },
    "source_energy_kwh": { "type": "number", "minimum": 0 },
    "source_evidence_class": { "$ref": "#/$defs/evidenceClass" },
    "source_evidence_ref": { "type": ["string", "null"] },
    "source_evidence_as_of": { "type": ["string", "null"] },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "energyForm": {
      "type": "string",
      "enum": ["electricity", "thermal_heat", "mechanical", "chemical", "radiant"]
    },
    "evidenceClass": {
      "type": "string",
      "enum": ["analyst_assumption", "published_model", "component_test", "field_pilot", "operating_plant", "replicated_fleet", "independently_audited"]
    },
    "thermalEngineLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hot_reservoir_c", "cold_reservoir_c"],
      "properties": {
        "hot_reservoir_c": { "type": "number" },
        "cold_reservoir_c": { "type": "number" }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id", "input_form", "output_form", "efficiency", "max_input_kwh",
        "auxiliary_electricity_kwh_per_input_kwh", "evidence_class"
      ],
      "properties": {
        "stage_id": { "type": "string", "minLength": 1 },
        "input_form": { "$ref": "#/$defs/energyForm" },
        "output_form": { "$ref": "#/$defs/energyForm" },
        "efficiency": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_input_kwh": { "type": "number", "minimum": 0 },
        "auxiliary_electricity_kwh_per_input_kwh": { "type": "number", "minimum": 0 },
        "evidence_class": { "$ref": "#/$defs/evidenceClass" },
        "evidence_ref": { "type": ["string", "null"] },
        "evidence_as_of": { "type": ["string", "null"] },
        "thermal_engine_limits": {
          "oneOf": [
            { "$ref": "#/$defs/thermalEngineLimits" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "input_form": { "const": "thermal_heat" },
              "output_form": { "const": "electricity" }
            },
            "required": ["input_form", "output_form"]
          },
          "then": {
            "required": ["thermal_engine_limits"],
            "properties": {
              "thermal_engine_limits": { "$ref": "#/$defs/thermalEngineLimits" }
            }
          }
        }
      ]
    }
  }
}
