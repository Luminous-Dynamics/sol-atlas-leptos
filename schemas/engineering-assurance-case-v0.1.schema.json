{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/engineering-assurance-case-v0.1.schema.json",
  "title": "Luminous Engineering Assurance Case v0.1",
  "description": "A structured, versioned argument describing a claim, its subclaims, reasoning, evidence bindings, assumptions, defeaters, and verifier results. This schema does not certify engineering safety, authenticate evidence, or grant action authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_revision",
    "case_status",
    "subject",
    "decision_context",
    "ieac_graph_reference",
    "top_level_claim_id",
    "claims",
    "arguments",
    "evidence_bindings",
    "assumptions",
    "defeaters",
    "verifier_attestations",
    "relying_party_policy_reference",
    "relying_party_appraisal",
    "created_at",
    "recorded_at",
    "supersedes_case_id",
    "action_authority",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.engineering-assurance-case.v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1
    },
    "case_status": {
      "enum": [
        "draft",
        "under_review",
        "superseded",
        "withdrawn"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "native_key",
        "description",
        "jurisdiction"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "engineering_design",
            "component",
            "asset",
            "construction_operation",
            "operational_system",
            "infrastructure_project"
          ]
        },
        "native_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_decision",
        "purpose",
        "jurisdiction",
        "scope_statement",
        "scope_sha256",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "intended_decision": {
          "enum": [
            "design_review",
            "engineering_change_impact",
            "construction_release_review",
            "manufacturing_acceptance",
            "inspection_acceptance",
            "maintenance_review",
            "operational_release",
            "other_declared_review"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "scope_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "ieac_graph_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "graph_id",
            "graph_snapshot_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": "luminous.ieac-assurance-dependency-graph.v0.2"
            },
            "graph_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "graph_snapshot_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "top_level_claim_id": {
      "$ref": "#/$defs/id"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_type",
          "proposition",
          "subject_ref",
          "scope_statement",
          "status",
          "parent_claim_ids",
          "argument_ids",
          "evidence_binding_ids",
          "assumption_ids",
          "defeater_ids",
          "limitations"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/id"
          },
          "claim_type": {
            "enum": [
              "property",
              "conformance",
              "safety",
              "security",
              "reliability",
              "availability",
              "performance",
              "traceability",
              "provenance",
              "process",
              "operational_readiness",
              "decision_justification",
              "other"
            ]
          },
          "proposition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "scope_statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "status": {
            "enum": [
              "proposed",
              "appraised_supported",
              "appraised_refuted",
              "inconclusive",
              "withdrawn"
            ]
          },
          "parent_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "argument_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "evidence_binding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "assumption_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "defeater_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "arguments": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argument_id",
          "conclusion_claim_id",
          "premise_claim_ids",
          "evidence_binding_ids",
          "strategy",
          "warrant",
          "assumption_ids",
          "defeater_ids",
          "status"
        ],
        "properties": {
          "argument_id": {
            "$ref": "#/$defs/id"
          },
          "conclusion_claim_id": {
            "$ref": "#/$defs/id"
          },
          "premise_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "evidence_binding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "strategy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "warrant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "assumption_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "defeater_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "status": {
            "enum": [
              "proposed",
              "appraised",
              "rejected"
            ]
          }
        }
      }
    },
    "evidence_bindings": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "source_native_key",
          "source_node_id",
          "source_payload_sha256",
          "source_snapshot_sha256",
          "relation",
          "evidence_role",
          "binding_status",
          "limitations"
        ],
        "properties": {
          "binding_id": {
            "$ref": "#/$defs/id"
          },
          "source_native_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source_node_id": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/node_id"
              }
            ]
          },
          "source_payload_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "source_snapshot_sha256": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/sha256"
              }
            ]
          },
          "relation": {
            "enum": [
              "supports",
              "rebuts",
              "qualifies",
              "context_for"
            ]
          },
          "evidence_role": {
            "enum": [
              "primary",
              "corroborating",
              "contradictory",
              "contextual",
              "reference_value",
              "assurance_result"
            ]
          },
          "binding_status": {
            "enum": [
              "unresolved",
              "mapped",
              "conflicted",
              "unsupported"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "statement",
          "impact_if_false",
          "owner",
          "status",
          "review_due_at"
        ],
        "properties": {
          "assumption_id": {
            "$ref": "#/$defs/id"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "impact_if_false": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "enum": [
              "unreviewed",
              "accepted_for_analysis",
              "challenged",
              "invalidated"
            ]
          },
          "review_due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "defeaters": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defeater_id",
          "condition",
          "detection_method",
          "severity",
          "status",
          "last_evaluated_at",
          "evidence_binding_ids"
        ],
        "properties": {
          "defeater_id": {
            "$ref": "#/$defs/id"
          },
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "detection_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "severity": {
            "enum": [
              "informational",
              "moderate",
              "major",
              "critical"
            ]
          },
          "status": {
            "enum": [
              "not_evaluated",
              "active",
              "not_observed",
              "unknown"
            ]
          },
          "last_evaluated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "evidence_binding_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "verifier_attestations": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attestation_id",
          "verifier_id",
          "verifier_build_sha256",
          "appraisal_policy_sha256",
          "input_set_sha256",
          "result",
          "issued_at",
          "valid_until",
          "trust_bundle_sha256",
          "signature_reference"
        ],
        "properties": {
          "attestation_id": {
            "$ref": "#/$defs/id"
          },
          "verifier_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "verifier_build_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "appraisal_policy_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "input_set_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "trust_bundle_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "signature_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "relying_party_policy_reference": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "policy_version",
            "policy_sha256"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "policy_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "policy_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "relying_party_appraisal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision_record_sha256",
        "policy_sha256",
        "result"
      ],
      "properties": {
        "status": {
          "const": "not_evaluated"
        },
        "decision_record_sha256": {
          "type": "null"
        },
        "policy_sha256": {
          "type": "null"
        },
        "result": {
          "type": "null"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_case_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "action_authority": {
      "const": "none"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "maxLength": 512
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:identity-sha256:[0-9a-f]{64}$"
    }
  }
}
