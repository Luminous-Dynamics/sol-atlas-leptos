{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-water-service-assessment-v0.1.schema.json",
  "title": "Spatial-Economic Water Service Balance Assessment",
  "description": "Bounded water capacity and mass-balanced conservative/optimistic aggregate paths; not a hydraulic or public-health determination.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "service_entity_id",
    "as_of",
    "rate_unit",
    "volume_unit",
    "time_unit",
    "state",
    "step_hours",
    "demand_volume_lower_bound",
    "demand_volume_upper_bound",
    "treated_volume_lower_bound",
    "treated_volume_upper_bound",
    "customer_delivery_capacity_lower_bound",
    "customer_delivery_capacity_upper_bound",
    "conservative_path",
    "optimistic_path",
    "supporting_evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "service_entity_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "state": {
      "enum": [
        "adequate",
        "degraded",
        "unavailable",
        "indeterminate"
      ]
    },
    "step_hours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "demand_volume_lower_bound": {
      "type": "number",
      "minimum": 0
    },
    "demand_volume_upper_bound": {
      "type": "number",
      "minimum": 0
    },
    "treated_volume_lower_bound": {
      "type": "number",
      "minimum": 0
    },
    "treated_volume_upper_bound": {
      "type": "number",
      "minimum": 0
    },
    "customer_delivery_capacity_lower_bound": {
      "type": "number",
      "minimum": 0
    },
    "customer_delivery_capacity_upper_bound": {
      "type": "number",
      "minimum": 0
    },
    "coverage_lower_bound": {
      "type": "number",
      "minimum": 0
    },
    "coverage_upper_bound": {
      "type": "number",
      "minimum": 0
    },
    "conservative_path": {
      "$ref": "#/$defs/path"
    },
    "optimistic_path": {
      "$ref": "#/$defs/path"
    },
    "supporting_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rate_unit": {
      "const": "m3/h"
    },
    "volume_unit": {
      "const": "m3"
    },
    "time_unit": {
      "const": "h"
    }
  },
  "$defs": {
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demand_volume",
        "treated_volume",
        "available_water_volume",
        "raw_distribution_withdrawal",
        "customer_delivered_volume",
        "distribution_loss_volume",
        "ending_storage_volume",
        "spilled_volume",
        "mass_balance_residual"
      ],
      "properties": {
        "demand_volume": {
          "type": "number",
          "minimum": 0
        },
        "treated_volume": {
          "type": "number",
          "minimum": 0
        },
        "available_water_volume": {
          "type": "number",
          "minimum": 0
        },
        "raw_distribution_withdrawal": {
          "type": "number",
          "minimum": 0
        },
        "customer_delivered_volume": {
          "type": "number",
          "minimum": 0
        },
        "ending_storage_volume": {
          "type": "number",
          "minimum": 0
        },
        "spilled_volume": {
          "type": "number",
          "minimum": 0
        },
        "mass_balance_residual": {
          "type": "number"
        },
        "distribution_loss_volume": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
