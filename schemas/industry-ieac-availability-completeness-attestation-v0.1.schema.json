{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-ieac-availability-completeness-attestation-v0.1.schema.json",
  "title": "IEAC Evidence Channel Completeness Attestation v0.1",
  "description": "Binds a first access event to a declared relying-party/channel capture policy and checkpoint interval. It never makes a universal non-access claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "channel_manifest_sha256",
    "channel_identity",
    "scope",
    "decision_cutoff",
    "coverage",
    "first_access",
    "continuity",
    "capture_health",
    "absence_basis",
    "absence_proof",
    "verifier",
    "claim_ceiling",
    "action_authority",
    "coverage_start_checkpoint",
    "decision_boundary_checkpoint",
    "coverage_end_checkpoint",
    "absence_query"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.ieac-availability-completeness-attestation.v0.1"
    },
    "attestation_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "channel_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "channel_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relying_party_id",
        "evidence_channel_id",
        "log_service_id",
        "operator_id",
        "ledger_id",
        "sequence_namespace",
        "sequence_epoch"
      ],
      "properties": {
        "relying_party_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "log_service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_scope",
        "subject_pseudonym",
        "purpose",
        "artifact_sha256"
      ],
      "properties": {
        "tenant_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "subject_pseudonym": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision_cutoff": {
      "$ref": "#/$defs/timeBound"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_from",
        "coverage_through",
        "completeness"
      ],
      "properties": {
        "coverage_from": {
          "$ref": "#/$defs/timeBound"
        },
        "coverage_through": {
          "$ref": "#/$defs/timeBound"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown",
            "disputed"
          ]
        }
      }
    },
    "first_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_sha256",
        "artifact_sha256",
        "event_type",
        "sequence",
        "observed_at",
        "inclusion_receipt_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "event_type": {
          "enum": [
            "ingest",
            "read",
            "cache_hit",
            "replica_fetch",
            "export",
            "delegated_access",
            "operator_console",
            "offline_import",
            "other"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at": {
          "$ref": "#/$defs/timeBound"
        },
        "inclusion_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vds_id",
        "proof_type",
        "start_to_boundary_receipt_sha256",
        "boundary_to_end_receipt_sha256",
        "verifier_status"
      ],
      "properties": {
        "vds_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "proof_type": {
          "enum": [
            "rfc9162_sha256_consistency",
            "other_registered_vds_consistency",
            "unsupported"
          ]
        },
        "verifier_status": {
          "enum": [
            "verified",
            "failed",
            "unknown",
            "not_supported"
          ]
        },
        "verifier_build_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_policy_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_to_boundary_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "boundary_to_end_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_bundle_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verifier_status": {
                "const": "verified"
              }
            },
            "required": [
              "verifier_status"
            ]
          },
          "then": {
            "properties": {
              "proof_type": {
                "enum": [
                  "rfc9162_sha256_consistency",
                  "other_registered_vds_consistency"
                ]
              },
              "verifier_build_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "verification_policy_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "trust_bundle_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "capture_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dropped_events_count",
        "sequence_gap_count",
        "unresolved_outage_count",
        "backfilled_events_count",
        "policy_changes_count",
        "known_bypass_paths",
        "unmonitored_access_paths",
        "retention_loss",
        "clock_health"
      ],
      "properties": {
        "dropped_events_count": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_gap_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_outage_count": {
          "type": "integer",
          "minimum": 0
        },
        "backfilled_events_count": {
          "type": "integer",
          "minimum": 0
        },
        "policy_changes_count": {
          "type": "integer",
          "minimum": 0
        },
        "known_bypass_paths": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "unmonitored_access_paths": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "retention_loss": {
          "type": "boolean"
        },
        "clock_health": {
          "enum": [
            "healthy",
            "degraded",
            "unknown"
          ]
        }
      }
    },
    "absence_basis": {
      "enum": [
        "complete_channel_signed_query",
        "registered_vds_non_inclusion",
        "not_available"
      ]
    },
    "absence_proof": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vds_id",
            "proof_type",
            "proof_sha256",
            "receipt_sha256",
            "verifier_status"
          ],
          "properties": {
            "vds_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "proof_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "proof_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verifier_status": {
              "enum": [
                "verified",
                "failed",
                "unknown",
                "not_supported"
              ]
            },
            "verifier_build_sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "verification_policy_sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "build_sha256",
        "policy_sha256",
        "trust_bundle_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "failed",
            "unknown",
            "disputed"
          ]
        },
        "build_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trust_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim_ceiling": {
      "const": "absence_within_declared_access_channel_only"
    },
    "action_authority": {
      "const": "none"
    },
    "coverage_start_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "ledger_id",
        "sequence_namespace",
        "sequence_epoch",
        "sequence",
        "tree_size",
        "root_sha256",
        "signed_bytes_sha256",
        "receipt_sha256",
        "observed_at"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "tree_size": {
          "type": "integer",
          "minimum": 0
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signed_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "$ref": "#/$defs/timeBound"
        }
      }
    },
    "decision_boundary_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "ledger_id",
        "sequence_namespace",
        "sequence_epoch",
        "sequence",
        "tree_size",
        "root_sha256",
        "signed_bytes_sha256",
        "receipt_sha256",
        "observed_at"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "tree_size": {
          "type": "integer",
          "minimum": 0
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signed_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "$ref": "#/$defs/timeBound"
        }
      }
    },
    "coverage_end_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "ledger_id",
        "sequence_namespace",
        "sequence_epoch",
        "sequence",
        "tree_size",
        "root_sha256",
        "signed_bytes_sha256",
        "receipt_sha256",
        "observed_at"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ledger_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "tree_size": {
          "type": "integer",
          "minimum": 0
        },
        "root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signed_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "$ref": "#/$defs/timeBound"
        }
      }
    },
    "absence_query": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query_id",
            "query_sha256",
            "predicate_binding",
            "sequence_from_exclusive",
            "sequence_through_inclusive",
            "matching_event_count",
            "result_sha256",
            "signed_statement_sha256",
            "signer_id",
            "signature_sha256",
            "receipt_sha256",
            "verification_status",
            "verifier_build_sha256",
            "verification_policy_sha256",
            "trust_bundle_sha256"
          ],
          "properties": {
            "query_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "query_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "predicate_binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "relying_party_id",
                "evidence_channel_id",
                "tenant_scope",
                "subject_pseudonym",
                "purpose",
                "artifact_sha256",
                "event_types"
              ],
              "properties": {
                "relying_party_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "evidence_channel_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "tenant_scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "subject_pseudonym": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "artifact_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "event_types": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            },
            "sequence_from_exclusive": {
              "type": "integer",
              "minimum": 0
            },
            "sequence_through_inclusive": {
              "type": "integer",
              "minimum": 0
            },
            "matching_event_count": {
              "const": 0
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "signed_statement_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "signer_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "signature_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verification_status": {
              "enum": [
                "verified",
                "failed",
                "unknown",
                "not_supported"
              ]
            },
            "verifier_build_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "verification_policy_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "trust_bundle_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "properties": {
              "completeness": {
                "const": "complete"
              }
            },
            "required": [
              "completeness"
            ]
          }
        },
        "required": [
          "coverage"
        ]
      },
      "then": {
        "properties": {
          "absence_basis": {
            "const": "complete_channel_signed_query"
          },
          "absence_query": {
            "type": "object",
            "properties": {
              "verification_status": {
                "const": "verified"
              },
              "matching_event_count": {
                "const": 0
              }
            }
          },
          "absence_proof": {
            "type": "null"
          },
          "continuity": {
            "properties": {
              "verifier_status": {
                "const": "verified"
              }
            }
          },
          "decision_cutoff": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            }
          },
          "coverage": {
            "properties": {
              "coverage_from": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              },
              "coverage_through": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "coverage_start_checkpoint": {
            "properties": {
              "observed_at": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "decision_boundary_checkpoint": {
            "properties": {
              "observed_at": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "coverage_end_checkpoint": {
            "properties": {
              "observed_at": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "first_access": {
            "properties": {
              "observed_at": {
                "properties": {
                  "verification_status": {
                    "const": "verified"
                  }
                }
              }
            }
          },
          "capture_health": {
            "properties": {
              "dropped_events_count": {
                "const": 0
              },
              "sequence_gap_count": {
                "const": 0
              },
              "unresolved_outage_count": {
                "const": 0
              },
              "backfilled_events_count": {
                "const": 0
              },
              "policy_changes_count": {
                "const": 0
              },
              "known_bypass_paths": {
                "maxItems": 0
              },
              "unmonitored_access_paths": {
                "maxItems": 0
              },
              "retention_loss": {
                "const": false
              },
              "clock_health": {
                "const": "healthy"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "absence_basis": {
            "const": "complete_channel_signed_query"
          }
        },
        "required": [
          "absence_basis"
        ]
      },
      "then": {
        "properties": {
          "absence_query": {
            "type": "object"
          },
          "absence_proof": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "absence_query": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "absence_basis": {
            "const": "registered_vds_non_inclusion"
          }
        },
        "required": [
          "absence_basis"
        ]
      },
      "then": {
        "properties": {
          "absence_proof": {
            "type": "object"
