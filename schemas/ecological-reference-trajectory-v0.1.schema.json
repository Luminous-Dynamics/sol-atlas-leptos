{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/ecological-reference-trajectory-v0.1.schema.json",
  "title": "Ecological Reference Ensemble and Recovery Trajectory v0.1",
  "description": "Synthetic metadata-only contracts for dynamic reference ecosystems, multi-attribute indicators and recovery trajectories. No field condition is asserted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "purpose",
    "non_claims",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "ECOLOGICAL-REFERENCE-TRAJECTORY-SYNTHETIC-0.1"
    },
    "purpose": {
      "const": "synthetic_reference_model_qualification"
    },
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "attribute": {
      "enum": [
        "absence_of_threats",
        "physical_conditions",
        "species_composition",
        "structural_diversity",
        "ecosystem_function",
        "external_exchanges"
      ]
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indicator_id",
        "name",
        "unit",
        "spatial_support",
        "temporal_support",
        "method",
        "reference_lower",
        "reference_upper",
        "uncertainty_status",
        "source_record_ids"
      ],
      "properties": {
        "indicator_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "spatial_support": {
          "type": "string",
          "minLength": 1
        },
        "temporal_support": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "reference_lower": {
          "type": "number"
        },
        "reference_upper": {
          "type": "number"
        },
        "uncertainty_status": {
          "enum": [
            "quantified",
            "qualitative_only",
            "not_reported"
          ]
        },
        "source_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "referenceSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "included_in_model",
        "degradation_screening",
        "screening_method",
        "dependency_group",
        "source_record_ids"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "included_in_model": {
          "type": "boolean"
        },
        "degradation_screening": {
          "enum": [
            "screened_low_degradation",
            "degraded",
            "unknown",
            "not_assessed"
          ]
        },
        "screening_method": {
          "type": "string",
          "minLength": 1
        },
        "dependency_group": {
          "type": "string",
          "minLength": 1
        },
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trajectoryPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_id",
        "successional_stage",
        "scenario_id",
        "description",
        "plausibility"
      ],
      "properties": {
        "path_id": {
          "type": "string",
          "minLength": 1
        },
        "successional_stage": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 8
        },
        "plausibility": {
          "enum": [
            "supported",
            "plausible",
            "speculative",
            "rejected"
          ]
        }
      }
    },
    "knowledgeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "knowledge_type",
        "consent_status",
        "permitted_purposes",
        "requested_purpose"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_type": {
          "enum": [
            "scientific",
            "practitioner",
            "local_ecological_knowledge",
            "indigenous_knowledge",
            "community_observation"
          ]
        },
        "consent_status": {
          "enum": [
            "granted",
            "restricted",
            "unknown",
            "not_required"
          ]
        },
        "permitted_purposes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requested_purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attributeIndicators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "absence_of_threats",
        "physical_conditions",
        "species_composition",
        "structural_diversity",
        "ecosystem_function",
        "external_exchanges"
      ],
      "properties": {
        "absence_of_threats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        },
        "physical_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        },
        "species_composition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        },
        "structural_diversity": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        },
        "ecosystem_function": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        },
        "external_exchanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/indicator"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "ecosystem_context",
        "reference_model",
        "recovery_assessment",
        "expected_audit",
        "hard_invariants"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^REF-SYN-[0-9]{3}$"
        },
        "family": {
          "enum": [
            "qualified_dynamic_reference",
            "degraded_reference_baseline",
            "climate_nonstationarity",
            "alternative_succession_paths",
            "attribute_tradeoff",
            "indicator_undercoverage",
            "knowledge_consent_restriction",
            "reference_model_supersession",
            "unknown_reference_site",
            "unobserved_attribute_promotion"
          ]
        },
        "ecosystem_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ecosystem_type",
            "local_classification",
            "iucn_functional_group",
            "spatial_strata",
            "environmental_drivers"
          ],
          "properties": {
            "ecosystem_type": {
              "type": "string",
              "minLength": 1
            },
            "local_classification": {
              "type": "string",
              "minLength": 1
            },
            "iucn_functional_group": {
              "type": [
                "string",
                "null"
              ]
            },
            "spatial_strata": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "environmental_drivers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reference_model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "model_id",
            "model_version",
            "supersedes_model_id",
            "supersession_review_status",
            "model_type",
            "reference_sites",
            "indicators_by_attribute",
            "climate_context",
            "succession_context",
            "shifting_baseline",
            "knowledge_sources",
            "rights_status"
          ],
          "properties": {
            "status": {
              "enum": [
                "qualified",
                "provisional",
                "absent",
                "conflicted",
                "not_assessed"
              ]
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "model_version": {
              "type": "string",
              "minLength": 1
            },
            "supersedes_model_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "supersession_review_status": {
              "enum": [
                "complete",
                "pending",
                "not_applicable"
              ]
            },
            "model_type": {
              "enum": [
                "static_snapshot",
                "climate_adjusted",
                "successional_ensemble",
                "dynamic_ensemble"
              ]
            },
            "reference_sites": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/referenceSite"
              }
            },
            "indicators_by_attribute": {
              "$ref": "#/$defs/attributeIndicators"
            },
            "climate_context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assessment_status",
                "nonstationarity_detected",
                "adjustment_status",
                "scenario_ids",
                "hydrological_regime_included"
              ],
              "properties": {
                "assessment_status": {
                  "enum": [
                    "assessed",
                    "not_assessed"
                  ]
                },
                "nonstationarity_detected": {
                  "type": "boolean"
                },
                "adjustment_status": {
                  "enum": [
                    "adjusted",
                    "sensitivity_only",
                    "not_required",
                    "missing"
                  ]
                },
                "scenario_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "hydrological_regime_included": {
                  "type": "boolean"
                }
              }
            },
            "succession_context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dynamics_included",
                "alternative_state_count",
                "paths"
              ],
              "properties": {
                "dynamics_included": {
                  "type": "boolean"
                },
                "alternative_state_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/trajectoryPath"
                  }
                }
              }
            },
            "shifting_baseline": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assessment_status",
                "risk_level",
                "historical_context_reviewed",
                "degradation_screening_method"
              ],
              "properties": {
                "assessment_status": {
                  "enum": [
                    "assessed",
                    "not_assessed"
                  ]
                },
                "risk_level": {
                  "enum": [
                    "low",
                    "moderate",
                    "high",
                    "unknown"
                  ]
                },
                "historical_context_reviewed": {
                  "type": "boolean"
                },
                "degradation_screening_method": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "knowledge_sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/knowledgeSource"
              }
            },
            "rights_status": {
              "enum": [
                "cleared_for_declared_purpose",
                "restricted",
                "unknown",
                "cleared_synthetic"
              ]
            }
          }
        },
        "recovery_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_window",
            "reference_model_version",
            "attribute_states",
            "overall_claim"
          ],
          "properties": {
            "observation_window": {
              "type": "string",
              "minLength": 1
            },
            "reference_model_version": {
              "type": "string",
              "minLength": 1
            },
            "attribute_states": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "attribute",
                  "state",
                  "coverage_status",
                  "evidence_count"
                ],
                "properties": {
                  "attribute": {
                    "$ref": "#/$defs/attribute"
                  },
                  "state": {
                    "enum": [
                      "improving",
                      "stable",
                      "worsening",
                      "unknown"
                    ]
                  },
                  "coverage_status": {
                    "enum": [
                      "observed",
                      "partial",
                      "unobserved"
                    ]
                  },
                  "evidence_count": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "overall_claim": {
              "enum": [
                "positive_recovery",
                "mixed_recovery",
                "no_recovery",
                "unresolved"
              ]
            }
          }
        },
        "expected_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference_model_qualified",
            "overall_claim_permitted",
            "expected_blockers"
          ],
          "properties": {
            "reference_model_qualified": {
              "type": "boolean"
            },
            "overall_claim_permitted": {
              "type": "boolean"
            },
            "expected_blockers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hard_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    }
  }
}
