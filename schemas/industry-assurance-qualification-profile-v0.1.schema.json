{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/industry-assurance-qualification-profile-v0.1.schema.json",
  "title": "Industry Engineering Assurance Contract Qualification Profile v0.1",
  "description": "Request/profile binding an industrial claim to a decision tier, operating envelope, risk review, evidence vector and exact artifact identities. Schema conformance is not qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "claim",
    "decision_tier",
    "operating_envelope",
    "risk_assessment",
    "evidence_vector",
    "artifact_bindings",
    "authority",
    "validity",
    "disposition",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.industry-assurance-profile.v0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "capability_id",
        "instance_id",
        "decision_id",
        "description",
        "intended_user"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "intended_user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "model_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        },
        "prohibited_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        }
      }
    },
    "decision_tier": {
      "enum": [
        "D0_descriptive",
        "D1_advisory",
        "D2_delegated_planning",
        "D3_autonomous_control"
      ]
    },
    "operating_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "domain_description",
        "conditions",
        "excluded_domains",
        "out_of_domain_policy"
      ],
      "properties": {
        "envelope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "domain_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "variable",
              "unit",
              "support",
              "evidence_state"
            ],
            "properties": {
              "variable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "support": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "evidence_state": {
                "enum": [
                  "measured",
                  "validated_range",
                  "assumed",
                  "unknown"
                ]
              },
              "source_artifact_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "excluded_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "known_counterexamples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "out_of_domain_policy": {
          "enum": [
            "abstain",
            "request_measurement",
            "human_review",
            "validated_fallback",
            "reject"
          ]
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_class",
        "dimensions",
        "rationale",
        "reviewer_id",
        "reviewed_at",
        "rule_set_version"
      ],
      "properties": {
        "reviewed_class": {
          "enum": [
            "low",
            "moderate",
            "high",
            "critical",
            "unassessed"
          ]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "consequence",
            "model_influence",
            "exposure",
            "reversibility",
            "detectability",
            "fallback"
          ],
          "properties": {
            "consequence": {
              "enum": [
                "negligible",
                "minor",
                "major",
                "severe",
                "catastrophic",
                "unknown"
              ]
            },
            "model_influence": {
              "enum": [
                "informational",
                "advisory",
                "constraint_gating",
                "selection",
                "direct_actuation",
                "unknown"
              ]
            },
            "exposure": {
              "enum": [
                "single_asset",
                "site_or_facility",
                "multi_site",
                "regional",
                "national_or_larger",
                "unknown"
              ]
            },
            "reversibility": {
              "enum": [
                "readily_reversible",
                "costly_or_delayed",
                "difficult_or_irreversible",
                "unknown"
              ]
            },
            "detectability": {
              "enum": [
                "immediate_and_reliable",
                "delayed_or_partial",
                "poor",
                "unknown"
              ]
            },
            "fallback": {
              "enum": [
                "independent_tested_fallback",
                "human_fallback",
                "degraded_fallback",
                "no_verified_fallback",
                "unknown"
              ]
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "rule_set_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "evidence_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_conformance",
        "numerical_verification",
        "physical_validation",
        "data_integrity_rights",
        "uncertainty_credibility",
        "generalization",
        "robustness",
        "operational_assurance",
        "safety_security_authority",
        "prospective_outcomes"
      ],
      "properties": {
        "software_conformance": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "numerical_verification": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "physical_validation": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "data_integrity_rights": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "uncertainty_credibility": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "generalization": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "robustness": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "operational_assurance": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "safety_security_authority": {
          "$ref": "#/$defs/evidence_dimension"
        },
        "prospective_outcomes": {
          "$ref": "#/$defs/evidence_dimension"
        }
      }
    },
    "artifact_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "evidence_class",
          "rights_state"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence_class": {
            "enum": [
              "synthetic",
              "public_reference",
              "authorized_observation",
              "calibration",
              "validation",
              "field_trial",
              "hardware_in_loop",
              "operational_record"
            ]
          },
          "rights_state": {
            "enum": [
              "verified",
              "restricted",
              "unknown",
              "not_applicable"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          },
          "git_blob_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_uri": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "anyOf": [
          {
            "required": [
              "repository",
              "commit_sha",
              "path",
              "git_blob_sha"
            ]
          },
          {
            "required": [
              "source_uri",
              "content_sha256"
            ]
          }
        ]
      },
      "uniqueItems": true
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permitted_actions",
        "human_approval_required",
        "actuation_enabled",
        "fallback_action",
        "prohibited_actions"
      ],
      "properties": {
        "permitted_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "view",
              "annotate",
              "recommend",
              "rank_options",
              "prepare_plan",
              "schedule_within_envelope",
              "execute_external_action"
            ]
          }
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "actuation_enabled": {
          "type": "boolean"
        },
        "fallback_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "safety_case_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "operational_authorization_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "cybersecurity_assessment_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "independent_verifier_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "rollback_plan_artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_from",
        "review_by",
        "requalification_triggers",
        "revocation_triggers"
      ],
      "properties": {
        "valid_from": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "review_by": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "requalification_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "revocation_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        }
      }
    },
    "disposition": {
      "enum": [
        "qualified_for_profile",
        "not_qualified",
        "indeterminate",
        "revoked"
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence_independence_profile_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "$defs": {
    "evidence_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "requirement",
        "rationale",
        "evidence"
      ],
      "properties": {
        "state": {
          "enum": [
            "established",
            "not_established",
            "unknown",
            "conflicted",
            "not_applicable"
          ]
        },
        "requirement": {
          "enum": [
            "mandatory",
            "optional"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "artifact_id",
              "method",
              "scope",
              "result",
              "observed_at"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "result": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "observed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "valid_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "verifier_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_applicable"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "reviewer_id",
              "reviewed_at"
            ],
            "properties": {
              "requirement": {
                "const": "optional"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "enum": [
              "not_qualified",
              "indeterminate",
              "revoked"
            ]
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "actuation_enabled": {
                "const": false
              },
              "permitted_actions": {
                "items": {
                  "enum": [
                    "view",
                    "annotate"
                  ]
                },
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "qualified_for_profile"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "evidence_vector": {
            "properties": {
              "software_conformance": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "numerical_verification": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "physical_validation": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "data_integrity_rights": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "uncertainty_credibility": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "generalization": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "robustness": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "operational_assurance": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "safety_security_authority": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              },
              "prospective_outcomes": {
                "if": {
                  "properties": {
                    "requirement": {
                      "const": "mandatory"
                    }
                  },
                  "required": [
                    "requirement"
                  ]
                },
                "then": {
                  "properties": {
                    "state": {
                      "const": "established"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_tier": {
            "const": "D0_descriptive"
          },
          "disposition": {
            "const": "qualified_for_profile"
          }
        },
        "required": [
          "decision_tier",
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "actuation_enabled": {
                "const": false
              },
              "permitted_actions": {
                "items": {
                  "enum": [
                    "view",
                    "annotate"
                  ]
                },
                "minItems": 1,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_tier": {
            "const": "D1_advisory"
          },
          "disposition": {
            "const": "qualified_for_profile"
          }
        },
        "required": [
          "decision_tier",
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "required": [
              "human_approval_required"
            ],
            "properties": {
              "actuation_enabled": {
                "const": false
              },
              "human_approval_required": {
                "const": true
              },
              "permitted_actions": {
                "not": {
                  "contains": {
                    "enum": [
                      "schedule_within_envelope",
                      "execute_external_action"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_tier": {
            "const": "D2_delegated_planning"
          },
          "disposition": {
            "const": "qualified_for_profile"
          }
        },
        "required": [
          "decision_tier",
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "required": [
              "independent_verifier_artifact_id",
              "rollback_plan_artifact_id"
            ],
            "properties": {
              "actuation_enabled": {
                "const": false
              },
