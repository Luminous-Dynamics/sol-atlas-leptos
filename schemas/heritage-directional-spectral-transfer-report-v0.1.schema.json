{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-directional-spectral-transfer-report-v0.1.schema.json",
  "title": "Sol-Atlas Directional Spectral Transfer Report",
  "description": "Directional DSS report. Reverse direction is a separate report; DSS is not a symmetric site similarity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_region_id",
    "target_region_id",
    "task_scope",
    "positive_class_semantics",
    "background_class_semantics",
    "label_protocol_ref",
    "feature_definition_sha256",
    "distance_pipeline_sha256",
    "top_month_count",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-spectral-transfer.v0.1"
    },
    "source_region_id": {
      "type": "string",
      "minLength": 1
    },
    "target_region_id": {
      "type": "string",
      "minLength": 1
    },
    "task_scope": {
      "const": "cropmark_vegetation_proxy"
    },
    "positive_class_semantics": {
      "type": "string",
      "minLength": 1
    },
    "background_class_semantics": {
      "type": "string",
      "minLength": 1
    },
    "label_protocol_ref": {
      "type": "string",
      "minLength": 1
    },
    "feature_definition_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "distance_pipeline_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "top_month_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "metrics": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "shared_month_count",
          "monthly_ratios",
          "selected_calendar_months",
          "selected_reciprocal_strengths",
          "directional_strength_score"
        ],
        "properties": {
          "metric": {
            "enum": [
              "euclidean",
              "wasserstein",
              "kolmogorov_smirnov",
              "mahalanobis"
            ]
          },
          "shared_month_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "monthly_ratios": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "calendar_month",
                "ratio",
                "reciprocal_strength"
              ],
              "properties": {
                "calendar_month": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "reciprocal_strength": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "selected_calendar_months": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "selected_reciprocal_strengths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "directional_strength_score": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
