{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/research/eo-system-comparability-v0-1/schemas/eo-system-shift-control-matrix-v0.1.schema.json",
  "title": "Sol-Atlas EO system shift control matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "status",
    "claim_ceiling",
    "signature_fields",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark": {
      "const": "EO_SYSTEM_SHIFT_CONTROL_MATRIX"
    },
    "status": {
      "const": "synthetic_control_specification_not_executed"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "signature_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 13,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "nullableText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "platform_id",
        "sensor_id",
        "sensor_identity_origin",
        "instrument_id",
        "modality",
        "collection_id",
        "processing_baseline",
        "measurement_profile_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "platform_id": {
          "type": "string",
          "minLength": 1
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "sensor_identity_origin": {
          "enum": [
            "provider_declared",
            "derived_from_platform_and_instrument",
            "unknown"
          ]
        },
        "instrument_id": {
          "$ref": "#/$defs/nullableText"
        },
        "modality": {
          "enum": [
            "optical",
            "synthetic_aperture_radar",
            "thermal_infrared",
            "hyperspectral",
            "multispectral",
            "other"
          ]
        },
        "collection_id": {
          "$ref": "#/$defs/nullableText"
        },
        "processing_baseline": {
          "$ref": "#/$defs/nullableText"
        },
        "measurement_profile_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "physical_event",
        "system_a",
        "system_b",
        "bridge",
        "expected",
        "score_tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MS-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "physical_event": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "system_a": {
          "$ref": "#/$defs/signature"
        },
        "system_b": {
          "oneOf": [
            {
              "$ref": "#/$defs/signature"
            },
            {
              "type": "null"
            }
          ]
        },
        "bridge": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "enum": [
            "same_system_path",
            "blocked",
            "unresolved_or_blocked",
            "eligible_for_review",
            "unresolved",
            "reject_unnecessary_receipt",
            "unresolved_if_common_mode_not_excluded"
          ]
        },
        "score_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
