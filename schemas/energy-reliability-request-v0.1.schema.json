{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-reliability-request-v0.1.schema.json",
  "title": "Chronological service reliability request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "synthetic",
    "evidence_class",
    "services",
    "intervals"
  ],
  "properties": {
    "schema_version": {
      "const": "energy-reliability-v0.1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "evidence_class": {
      "$ref": "#/$defs/evidenceClass"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interval"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_class": {
            "not": {
              "const": "analyst_assumption"
            }
          }
        },
        "required": [
          "evidence_class"
        ]
      },
      "then": {
        "required": [
          "evidence_ref"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceClass": {
      "type": "string",
      "enum": [
        "analyst_assumption",
        "published_model",
        "component_test",
        "field_pilot",
        "operating_plant",
        "replicated_fleet",
        "independently_audited"
      ]
    },
    "energyForm": {
      "type": "string",
      "enum": [
        "electricity",
        "thermal_heat",
        "mechanical",
        "chemical",
        "radiant"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "description",
        "essential",
        "required_form",
        "minimum_temperature_c"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "essential": {
          "type": "boolean"
        },
        "required_form": {
          "$ref": "#/$defs/energyForm"
        },
        "minimum_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required_form": {
                "const": "thermal_heat"
              }
            },
            "required": [
              "required_form"
            ]
          },
          "then": {
            "properties": {
              "minimum_temperature_c": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "minimum_temperature_c": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "requested_energy_kwh",
        "delivered_energy_kwh",
        "delivered_temperature_c"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_energy_kwh": {
          "type": "number",
          "minimum": 0
        },
        "delivered_energy_kwh": {
          "type": "number",
          "minimum": 0
        },
        "delivered_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_id",
        "start_unix_seconds",
        "duration_seconds",
        "grid_outage",
        "services"
      ],
      "properties": {
        "interval_id": {
          "type": "string",
          "minLength": 1
        },
        "start_unix_seconds": {
          "type": "integer"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "grid_outage": {
          "type": "boolean"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        }
      }
    }
  }
}
