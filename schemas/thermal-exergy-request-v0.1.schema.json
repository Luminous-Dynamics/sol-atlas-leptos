{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/thermal-exergy-request-v0.1.schema.json",
  "title": "Thermal exergy request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_id", "synthetic", "heat_quantity_kwh",
    "heat_temperature_c", "reference_environment_temperature_c", "evidence_class"
  ],
  "properties": {
    "schema_version": { "const": "thermal-exergy-v0.1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "heat_quantity_kwh": { "type": "number", "minimum": 0 },
    "heat_temperature_c": { "type": "number" },
    "reference_environment_temperature_c": { "type": "number" },
    "evidence_class": {
      "type": "string",
      "enum": ["analyst_assumption", "published_model", "component_test", "field_pilot", "operating_plant", "replicated_fleet", "independently_audited"]
    },
    "evidence_ref": { "type": ["string", "null"] },
    "evidence_as_of": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_class": { "not": { "const": "analyst_assumption" } }
        },
        "required": ["evidence_class"]
      },
      "then": {
        "required": ["evidence_ref"],
        "properties": {
          "evidence_ref": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
