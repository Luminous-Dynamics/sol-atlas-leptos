{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-scenario-robustness-fixture-v0.1.schema.json",
  "title": "Landscape Scenario Robustness Fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "data_origin",
    "claim_ceiling",
    "utility_method_sha256",
    "minimum_worst_case_utility_points",
    "scenarios",
    "alternatives",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.landscape_scenario_robustness_fixture.v0.1"
    },
    "suite_id": {
      "const": "LANDSCAPE-SCENARIO-ROBUSTNESS-V0.1"
    },
    "data_origin": {
      "const": "synthetic_fixture"
    },
    "claim_ceiling": {
      "const": "SCENARIO_ROBUSTNESS_ONLY"
    },
    "utility_method_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "minimum_worst_case_utility_points": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "label"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative_id",
          "label"
        ],
        "properties": {
          "alternative_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "alternative_id",
          "utility_points"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "alternative_id": {
            "type": "string",
            "minLength": 1
          },
          "utility_points": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
