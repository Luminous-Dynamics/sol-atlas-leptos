{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-observation-batch-v0.schema.json",
  "title": "Luminous Landscape Observation Batch v0",
  "description": "Offline import envelope for immutable observation records. Identical repeated observation IDs are idempotent duplicates; conflicting content under one ID is an error.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_uri",
    "batch_id",
    "created_at_unix_ms",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "luminous.landscape-observation-batch.v0"
    },
    "schema_uri": {
      "const": "https://luminousdynamics.io/schemas/landscape-observation-batch-v0.schema.json"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^obs-batch-[A-Za-z0-9][A-Za-z0-9._:-]{3,123}$"
    },
    "created_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "https://luminousdynamics.io/schemas/landscape-observation-v0.schema.json"
      }
    }
  }
}
