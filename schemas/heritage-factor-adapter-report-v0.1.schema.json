{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/heritage-factor-adapter-report-v0.1.schema.json",
  "title": "Sol-Atlas Heritage Factor Adapter Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "factorization",
    "hdb11_profile_sha256",
    "hdb15_profile_sha256",
    "target_location_receipt_sha256",
    "target_location_probability",
    "detection_probability_wilson_95",
    "hdb15_geometric_coverage_fraction",
    "conditional_detection_stage_added",
    "footprint_coverage_stage_added",
    "joint_pod_used",
    "double_counting_guard",
    "non_detection_input",
    "non_detection_report"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.heritage-factor-adapter.v0.1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "factorization": {
      "const": "factorized_survival_exposure_observability_coverage_then_conditional_sensor_detection"
    },
    "hdb11_profile_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "hdb15_profile_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "target_location_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "target_location_probability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "detection_probability_wilson_95": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "hdb15_geometric_coverage_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "conditional_detection_stage_added": {
      "const": true
    },
    "footprint_coverage_stage_added": {
      "const": true
    },
    "joint_pod_used": {
      "const": false
    },
    "double_counting_guard": {
      "type": "string",
      "minLength": 1
    },
    "non_detection_input": {
      "type": "object"
    },
    "non_detection_report": {
      "type": "object",
      "required": [
        "disposition",
        "posterior_probability_originally_present"
      ],
      "properties": {
        "disposition": {
          "const": "qualified_negative_evidence_update"
        },
        "posterior_probability_originally_present": {
          "type": "object"
        }
      }
    }
  }
}
