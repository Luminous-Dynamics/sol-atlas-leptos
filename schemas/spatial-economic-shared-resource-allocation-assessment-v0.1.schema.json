{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-shared-resource-allocation-assessment-v0.1.schema.json",
  "title": "Spatial-Economic Shared-Resource Allocation Assessment",
  "description": "Policy-conditioned one-snapshot allocation outputs, capacity residuals and protected floor aggregation. Coverage bounds are endpoint outputs for the declared equal-coverage policy, not envelopes across every allocation policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "as_of",
    "policy",
    "service_count",
    "resource_count",
    "usage_constraint_count",
    "estimated_work_units",
    "conservative_allocation_iterations",
    "optimistic_allocation_iterations",
    "total_beneficiary_weight",
    "meets_floor_weight",
    "below_floor_weight",
    "indeterminate_floor_weight",
    "floor_compliance_lower_bound",
    "floor_compliance_upper_bound",
    "services",
    "resources",
    "communities",
    "supporting_evidence_ids",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "policy": {
      "const": "equal_coverage_progressive_fill"
    },
    "service_count": {
      "type": "integer",
      "minimum": 1
    },
    "resource_count": {
      "type": "integer",
      "minimum": 1
    },
    "usage_constraint_count": {
      "type": "integer",
      "minimum": 1
    },
    "estimated_work_units": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000000
    },
    "conservative_allocation_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "optimistic_allocation_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "total_beneficiary_weight": {
      "type": "integer",
      "minimum": 1
    },
    "meets_floor_weight": {
      "type": "integer",
      "minimum": 0
    },
    "below_floor_weight": {
      "type": "integer",
      "minimum": 0
    },
    "indeterminate_floor_weight": {
      "type": "integer",
      "minimum": 0
    },
    "floor_compliance_lower_bound": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "floor_compliance_upper_bound": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service_assessment"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource_assessment"
      }
    },
    "communities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/community_assessment"
      }
    },
    "supporting_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation_boundary": {
      "const": "equal_coverage_allocation_not_physical_network_simulation"
    }
  },
  "$defs": {
    "floor_status": {
      "enum": [
        "meets_floor",
        "below_floor",
        "indeterminate"
      ]
    },
    "service_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "service_entity_id",
        "community_id",
        "beneficiary_weight",
        "delivery_rate_unit",
        "demand_rate_lower_bound",
        "demand_rate_upper_bound",
        "conservative_allocated_delivery_rate",
        "optimistic_allocated_delivery_rate",
        "coverage_lower_bound",
        "coverage_upper_bound",
        "essential_coverage_floor",
        "floor_status",
        "supporting_evidence_ids"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1
        },
        "service_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "community_id": {
          "type": "string",
          "minLength": 1
        },
        "beneficiary_weight": {
          "type": "integer",
          "minimum": 1
        },
        "delivery_rate_unit": {
          "type": "string",
          "minLength": 1
        },
        "demand_rate_lower_bound": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "demand_rate_upper_bound": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conservative_allocated_delivery_rate": {
          "type": "number",
          "minimum": 0
        },
        "optimistic_allocated_delivery_rate": {
          "type": "number",
          "minimum": 0
        },
        "coverage_lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "coverage_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "essential_coverage_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "floor_status": {
          "$ref": "#/$defs/floor_status"
        },
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "capacity_unit",
        "capacity_lower_bound",
        "capacity_upper_bound",
        "conservative_allocated_capacity",
        "conservative_residual_capacity",
        "conservative_constraint_binding",
        "optimistic_allocated_capacity",
        "optimistic_residual_capacity",
        "optimistic_constraint_binding",
        "supporting_evidence_ids"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity_unit": {
          "type": "string",
          "minLength": 1
        },
        "capacity_lower_bound": {
          "type": "number",
          "minimum": 0
        },
        "capacity_upper_bound": {
          "type": "number",
          "minimum": 0
        },
        "conservative_allocated_capacity": {
          "type": "number",
          "minimum": 0
        },
        "conservative_residual_capacity": {
          "type": "number",
          "minimum": 0
        },
        "conservative_constraint_binding": {
          "type": "boolean"
        },
        "optimistic_allocated_capacity": {
          "type": "number",
          "minimum": 0
        },
        "optimistic_residual_capacity": {
          "type": "number",
          "minimum": 0
        },
        "optimistic_constraint_binding": {
          "type": "boolean"
        },
        "supporting_evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "community_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "community_id",
        "service_count",
        "beneficiary_weight",
        "floor_compliance_lower_bound",
        "floor_compliance_upper_bound",
        "meets_floor_weight",
        "below_floor_weight",
        "indeterminate_floor_weight"
      ],
      "properties": {
        "community_id": {
          "type": "string",
          "minLength": 1
        },
        "service_count": {
          "type": "integer",
          "minimum": 1
        },
        "beneficiary_weight": {
          "type": "integer",
          "minimum": 1
        },
        "floor_compliance_lower_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "floor_compliance_upper_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meets_floor_weight": {
          "type": "integer",
          "minimum": 0
        },
        "below_floor_weight": {
          "type": "integer",
          "minimum": 0
        },
        "indeterminate_floor_weight": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
