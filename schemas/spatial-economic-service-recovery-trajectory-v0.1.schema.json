{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spatial-economic-service-recovery-trajectory-v0.1.schema.json",
  "title": "Spatial-Economic Service Recovery Trajectory",
  "description": "A sequence of evidence-validated capacity/demand snapshots for one service. Recovery timing is bracketed by samples; integrated deficit assumes trapezoidal interpolation between samples and does not prove causal impact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "service_entity_id",
    "disruption_started_at",
    "max_sample_gap_seconds",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "service_entity_id": {
      "type": "string",
      "minLength": 1
    },
    "disruption_started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "max_sample_gap_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "snapshots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "spatial-economic-service-function-v0.1.schema.json"
      }
    }
  }
}
