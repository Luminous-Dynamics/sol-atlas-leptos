{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/energy-design-compilation-report-v1.schema.json",
  "title": "Energy design candidate to bounded dispatch compilation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema_version",
    "mapping_schema_version",
    "candidate_id",
    "candidate_sha256",
    "mapping_config_sha256",
    "mapping_config",
    "dispatch_request_sha256",
    "synthetic",
    "supported_boundary",
    "claim_ceiling",
    "objective_coverage",
    "requested_evaluations_not_executed",
    "dispatch_request"
  ],
  "properties": {
    "receipt_schema_version": {
      "const": "1"
    },
    "mapping_schema_version": {
      "const": "energy-dispatch-mapping-v0.1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mapping_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dispatch_request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "synthetic": {
      "const": true
    },
    "supported_boundary": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "objective_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective_id",
          "status",
          "mapped_metric",
          "reason"
        ],
        "properties": {
          "objective_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "mapped",
              "partial",
              "not_scored"
            ]
          },
          "mapped_metric": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requested_evaluations_not_executed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dispatch_request": {
      "$ref": "energy-dispatch-request-v0.1.schema.json"
    },
    "mapping_config": {
      "$ref": "energy-dispatch-mapping-config-v0.1.schema.json"
    }
  }
}
