{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/pcit-case-manifest-v0.1.schema.json",
  "title": "PCIT v0.1 synthetic qualification corpus",
  "description": "Synthetic protocol fixtures for target-conditional physical change invariance testing. Not field observations or scientific validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "purpose",
    "non_claims",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "PCIT-SYNTHETIC-CORPUS-0.1"
    },
    "purpose": {
      "const": "synthetic_protocol_qualification"
    },
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "truth_state",
        "target_estimand",
        "measurement_profiles",
        "perturbations",
        "reference_design",
        "expected_disposition",
        "hard_invariants"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^PCIT-SYN-[0-9]{3}$"
        },
        "family": {
          "enum": [
            "physical_change_positive",
            "null_stable_control",
            "sensor_shift",
            "processing_shift",
            "seasonal_shift",
            "spatial_support_shift",
            "georegistration_shift",
            "class_ontology_shift",
            "physical_measurement_interaction",
            "common_cause_dependency",
            "reference_leakage",
            "insufficient_reference",
            "unsupported_harmonization",
            "source_metadata_conflict",
            "area_reconciliation_conflict"
          ]
        },
        "truth_state": {
          "enum": [
            "physical_change",
            "no_physical_change",
            "not_identifiable"
          ]
        },
        "truth_note": {
          "type": "string",
          "minLength": 12
        },
        "target_estimand": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "support",
            "unit",
            "minimum_detectable_effect"
          ],
          "properties": {
            "quantity": {
              "enum": [
                "class_area_fraction",
                "class_transition_fraction",
                "object_presence",
                "boundary_displacement",
                "persistent_vegetation_fraction"
              ]
            },
            "support": {
              "enum": [
                "pixel",
                "object",
                "local_window",
                "transect",
                "subcatchment",
                "catchment"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "nominal_resolution_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minimum_mapping_unit_m2": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "minimum_detectable_effect": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "temporal_support": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "measurement_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "sensor_family",
              "instrument",
              "spatial_resolution_m",
              "spectral_profile",
              "processing_baseline",
              "season_window"
            ],
            "properties": {
              "profile_id": {
                "type": "string",
                "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
              },
              "sensor_family": {
                "type": "string",
                "minLength": 1
              },
              "instrument": {
                "type": "string",
                "minLength": 1
              },
              "spatial_resolution_m": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "spectral_profile": {
                "type": "string",
                "minLength": 1
              },
              "processing_baseline": {
                "type": "string",
                "minLength": 1
              },
              "season_window": {
                "type": "string",
                "minLength": 1
              },
              "harmonization_profile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "grid_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "perturbations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "axis",
              "transformation",
              "admissibility",
              "expected_effect"
            ],
            "properties": {
              "axis": {
                "enum": [
                  "sensor",
                  "spectral_response",
                  "processing",
                  "season",
                  "spatial_support",
                  "georegistration",
                  "class_ontology",
                  "evidence_dependency",
                  "reference_lineage",
                  "source_metadata",
                  "area_accounting"
                ]
              },
              "transformation": {
                "type": "string",
                "minLength": 1
              },
              "admissibility": {
                "enum": [
                  "admissible",
                  "stress_only",
                  "negative_control",
                  "out_of_envelope"
                ]
              },
              "expected_effect": {
                "enum": [
                  "estimand_preserved",
                  "observability_reduced",
                  "apparent_change_without_target_change",
                  "reference_independence_broken",
                  "corroboration_reduced",
                  "not_identifiable",
                  "source_metadata_conflict",
                  "area_total_nonclosure"
                ]
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              },
              "rationale": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "reference_design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "independence",
            "rights_status",
            "design_note"
          ],
          "properties": {
            "availability": {
              "enum": [
                "independent_sample",
                "derivative_product",
                "leaked_labels",
                "absent"
              ]
            },
            "independence": {
              "enum": [
                "independent",
                "partially_dependent",
                "dependent",
                "unknown",
                "not_applicable"
              ]
            },
            "rights_status": {
              "enum": [
                "cleared_synthetic",
                "cleared_public",
                "restricted",
                "unknown",
                "not_applicable"
              ]
            },
            "design_note": {
              "type": "string",
              "minLength": 8
            }
          }
        },
        "evidence_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "depends_on"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "expected_disposition": {
          "enum": [
            "PHYSICAL_CHANGE_SUPPORTED_WITHIN_ENVELOPE",
            "NO_CHANGE_DETECTED_WITHIN_ENVELOPE",
            "MEASUREMENT_SHIFT_EXPLAINS_APPARENT_CHANGE",
            "INSUFFICIENT_OBSERVABILITY",
            "UNRESOLVED_CONFOUNDING"
          ]
        },
        "hard_invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          },
          "uniqueItems": true
        },
        "source_metadata_conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "record_a",
              "value_a",
              "record_b",
              "value_b",
              "resolution_status",
              "notes"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "record_a": {
                "type": "string",
                "minLength": 1
              },
              "value_a": {
                "type": "string",
                "minLength": 1
              },
              "record_b": {
                "type": "string",
                "minLength": 1
              },
              "value_b": {
                "type": "string",
                "minLength": 1
              },
              "resolution_status": {
                "enum": [
                  "resolved",
                  "unresolved"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        },
        "numeric_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "reported_value_a",
            "reported_value_b",
            "tolerance",
            "resolution_status",
            "notes"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "reported_value_a": {
              "type": "number"
            },
            "reported_value_b": {
              "type": "number"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            },
            "resolution_status": {
              "enum": [
                "resolved",
                "unresolved"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 8
            }
          }
        }
      }
    }
  }
}
