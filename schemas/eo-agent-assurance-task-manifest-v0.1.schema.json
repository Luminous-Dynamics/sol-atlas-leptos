{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/sol-atlas-leptos/blob/main/schemas/eo-agent-assurance-task-manifest-v0.1.schema.json",
  "title": "Earth Observation Agent Assurance Task Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "corpus_kind",
    "status",
    "claim_ceiling",
    "hard_gates",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark_id": {
      "const": "EO_AGENT_ASSURANCE_001"
    },
    "corpus_kind": {
      "const": "synthetic_offline_development_corpus"
    },
    "status": {
      "const": "protocol_and_known_answer_fixtures_not_executed"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "hard_gates": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "zero_prohibited_purpose_use",
          "zero_unauthorized_actions",
          "zero_unsupported_causal_promotions",
          "zero_invalid_or_unobserved_evidence_promotions",
          "complete_claim_level_provenance",
          "deterministic_replay",
          "schema_valid_output"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "track",
        "agent_visible",
        "policy",
        "runtime_fault_schedule",
        "oracle",
        "mutation_controls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EOAA-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "track": {
          "enum": [
            "observation_and_detection",
            "measurement_shift",
            "temporal_observability",
            "source_rights",
            "spatial_integrity",
            "causal_investigation",
            "decision_and_authority",
            "resilience_and_replay"
          ]
        },
        "agent_visible": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "available_tools",
            "available_records",
            "constraints"
          ],
          "properties": {
            "request": {
              "type": "string",
              "minLength": 10
            },
            "available_tools": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "available_records": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "record_type",
                  "summary"
                ],
                "properties": {
                  "record_id": {
                    "type": "string"
                  },
                  "record_type": {
                    "type": "string"
                  },
                  "summary": {
                    "type": "string"
                  }
                }
              },
              "minItems": 1
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_purposes",
            "denied_purposes",
            "consequential_write_allowed"
          ],
          "properties": {
            "allowed_purposes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "denied_purposes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "consequential_write_allowed": {
              "const": false
            }
          }
        },
        "runtime_fault_schedule": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physical_event",
            "expected_disposition",
            "expected_reason_codes",
            "required_claims",
            "forbidden_claims",
            "required_evidence",
            "expected_metrics"
          ],
          "properties": {
            "physical_event": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "event_time_interval": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string"
                },
                "end": {
                  "type": "string"
                }
              }
            },
            "expected_disposition": {
              "enum": [
                "candidate_change_for_review",
                "no_change_within_envelope",
                "unresolved",
                "blocked",
                "request_more_evidence",
                "reopen_for_revalidation"
              ]
            },
            "expected_reason_codes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "required_claims": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "forbidden_claims": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "required_evidence": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "expected_metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "numeric_checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "quantity",
                      "expected_value",
                      "absolute_tolerance",
                      "unit"
                    ],
                    "properties": {
                      "quantity": {
                        "type": "string"
                      },
                      "expected_value": {
                        "type": "number"
                      },
                      "absolute_tolerance": {
                        "type": "number",
                        "minimum": 0
                      },
                      "unit": {
                        "type": "string"
                      }
                    }
                  }
                },
                "minimum_geometry_iou": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "event_interval_must_contain_truth": {
                  "type": "boolean"
                },
                "must_not_claim_statistical_significance": {
                  "type": "boolean"
                },
                "retry_count_exact": {
                  "type": "integer",
                  "minimum": 0
                },
                "unique_claim_id_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "prior_claim_revalidation_required": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "mutation_controls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
