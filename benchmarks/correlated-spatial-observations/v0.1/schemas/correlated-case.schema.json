{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:sol-atlas:correlated-observation-case:0.1",
  "type": "object",
  "required": [
    "benchmarkId",
    "version",
    "fixtureStatus",
    "decisionProblem"
  ],
  "properties": {
    "benchmarkId": {
      "const": "sol-atlas-correlated-spatial-observations"
    },
    "version": {
      "const": "0.1.0"
    },
    "fixtureStatus": {
      "const": "synthetic"
    },
    "decisionProblem": {
      "type": "object",
      "required": [
        "hypotheses",
        "actions",
        "maxEffortUnits",
        "surveys",
        "jointOutcomeLikelihoodsByHypothesis"
      ],
      "properties": {
        "hypotheses": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prior"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "prior": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1
        },
        "maxEffortUnits": {
          "type": "integer",
          "minimum": 0
        },
        "surveys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "id",
              "effortUnits",
              "utilityCost",
              "positiveLikelihoodByHypothesis"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "effortUnits": {
                "type": "integer",
                "minimum": 0
              },
              "utilityCost": {
                "type": "number",
                "minimum": 0
              },
              "positiveLikelihoodByHypothesis": {
                "type": "object"
              }
            }
          }
        },
        "jointOutcomeLikelihoodsByHypothesis": {
          "type": "object",
          "minProperties": 2
        }
      }
    }
  }
}
