  "reporting": {
    "latency_quantiles": ["p50", "p95", "p99", "max"],
    "required_hardware_metadata": [
      "cpu_model_and_microcode",
      "physical_core_and_thread_count",
      "ram_capacity_and_speed",
      "storage_model_and_filesystem",
      "os_and_kernel"
    ],
    "required_software_metadata": [
      "proof_implementation_and_version",
      "vds_profile_identifier",
      "receipt_profile_identifier",
      "cryptographic_algorithm_identifiers",
      "rust_toolchain",
      "node_version",
      "build_flags",
      "corpus_digest",
      "frontier_generation_seed"
    ],
    "proof_generation_and_verification_measured_separately": true,
    "hashing_and_graph_validation_measured_separately": true,
    "no_single_weighted_score": true,
    "energy": "report only when measured with declared meter or calibrated telemetry",
    "candidate_comparison_rule": "same exact frontier bytes, query, package graph, partition, audience, update schedule, fault schedule, host and resource limits"
  }
}