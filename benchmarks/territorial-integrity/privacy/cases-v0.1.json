      "case_id": "PRIVACY-STRICT-WORLD-EQUIVALENCE-001",
      "protected_delta": "A synthetic restricted record exists only in world B.",
      "canaries": ["SYNTH-CANARY-ALPHA-001"],
      "world_a": {"observables": {"primary_payload": {"records": []}, "http_status_or_error": {"status": 200}}},
      "world_b": {"observables": {"primary_payload": {"records": []}, "http_status_or_error": {"status": 200}}},
      "expected": "non_disclosure"
    },
    {
      "case_id": "PRIVACY-WITHHELD-NOT-ABSENT-001",
      "protected_delta": "Internal state is withheld in world B, but the public response intentionally does not reveal existence.",
      "canaries": ["SYNTH-CANARY-WITHHELD-002"],
      "world_a": {"observables": {"search_or_autocomplete": {"results": []}, "http_status_or_error": {"status": 200, "body": {"items": []}}}},
      "world_b": {"observables": {"search_or_autocomplete": {"results": []}, "http_status_or_error": {"status": 200, "body": {"items": []}}}},
      "expected": "non_disclosure"
    },
    {
      "case_id": "PRIVACY-FILENAME-LEAK-001",
      "protected_delta": "A private object path appears in one public archive.",
      "canaries": ["SYNTH-CANARY-FILENAME-003"],
      "world_a": {"observables": {"filename_or_path": {"name": "export-01.bin"}}},
      "world_b": {"observables": {"filename_or_path": {"name": "SYNTH-CANARY-FILENAME-003-sacred-site.bin"}}},
      "expected": "leak_detected"
