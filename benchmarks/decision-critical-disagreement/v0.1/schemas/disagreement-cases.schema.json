{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/decision-critical-disagreement-v0.1.json",
  "title": "Sol-Atlas Decision-Critical Disagreement Cases v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmarkId", "cases"],
  "properties": {
    "benchmarkId": {"const": "sol-atlas-decision-critical-disagreement"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "actions", "supportUnits", "hypotheses"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "actions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "supportUnits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unitId", "weight", "status"],
              "properties": {
                "unitId": {"type": "string", "minLength": 1},
                "weight": {"type": "number", "exclusiveMinimum": 0},
                "status": {"enum": ["known", "unknown"]}
              }
            }
          },
          "hypotheses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hypothesisId", "unitEvidence"],
              "properties": {
                "hypothesisId": {"type": "string", "minLength": 1},
                "unitEvidence": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["actionLosses"],
                    "properties": {
                      "prediction": {"type": ["number", "null"]},
                      "actionLosses": {
                        "type": "object",
                        "minProperties": 2,
                        "additionalProperties": {"type": "number", "minimum": 0}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
